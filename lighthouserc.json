{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/builds/",
        "http://localhost/crosssource/",
        "http://localhost/writing/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "blockedUrlPatterns": ["*static.cloudflareinsights.com*", "*cloud.umami.is*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}

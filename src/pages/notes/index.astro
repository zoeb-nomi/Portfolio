---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import { formatDate } from '../../lib/formatDate';
import { meta, notesPage as np } from '../../data/copy';
import { notes } from '../../data/notes';

// Newest first.
const posts = [...notes].sort((x, y) => y.date.localeCompare(x.date));
---

<Base title={meta.notesIndex.title} description={meta.notesIndex.description} path="/notes/" ogImage="/og/notes.png">
  <Masthead kicker={np.kicker} h1={np.title} standfirst={np.standfirst} h1Max="22ch" />

  <ul class="post-list" aria-label={np.indexAriaLabel}>
    {
      posts.map((p) => (
        <li>
          <a href={`/notes/${p.slug}/`} aria-labelledby={`note-${p.slug}`}>
            <div class="post-inner grid-margin">
              <p class="post-kicker margin-col">{p.kicker}</p>
              <div class="post-body body-col">
                <h2 class="post-title" id={`note-${p.slug}`}>{p.title}</h2>
                <p class="post-dek">{p.dek}</p>
                <p class="post-date tabular">
                  <time datetime={p.date}>{formatDate(p.date)}</time>
                </p>
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  /* Post list: uses the same two-column masthead grid (margin-col / body-col
     widths) so rows align with the post page above. */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    border-top: 1px solid var(--rule);
  }

  /* The masthead already closes with a strong rule: no second line here. */
  .post-list li:first-child {
    border-top: 0;
  }

  .post-list a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-inner {
    padding-block: var(--s-7);
  }

  /* Row cells sit on the site grid but draw no column rule and no vertical
     padding: the row owns its own rhythm. */
  .post-kicker {
    border: 0;
    padding: 0 var(--s-5) 0 var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .post-body {
    padding: 0 var(--gutter) 0 var(--body-inset);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    margin-bottom: var(--s-4);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--red-ink);
    transition: color var(--dur-fast) var(--ease-draw);
  }

  .post-dek {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--ink-body);
    max-width: 60ch;
    margin-bottom: var(--s-5);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-muted);
  }

  /* Card-level hover: the title colour follows the whole-card link. */
  .post-list a:hover .post-title {
    color: var(--red);
  }

  @media (max-width: 899px) {
    .post-inner {
      padding-block: var(--s-6);
    }

    .post-kicker {
      padding: 0 var(--gutter);
      margin-bottom: var(--s-3);
    }

    .post-body {
      padding: 0 var(--gutter);
    }
  }
</style>

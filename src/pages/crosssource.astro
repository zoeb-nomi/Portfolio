---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import DataTable from '../components/DataTable.astro';
import PullQuote from '../components/PullQuote.astro';
import CTASlab from '../components/CTASlab.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import EssayFigure from '../components/EssayFigure.astro';
import FailureOwners from '../components/FailureOwners.astro';
import PlayerStepper from '../components/PlayerStepper.astro';
import { meta, crosssource as cs, writingJudgeBug as wj, cta, home } from '../data/copy';
import { failureData } from '../lib/figureData';

const failures = failureData();

const table1Rows = cs.s3.table1.rows.map((r) => ({
  label: r.dimension,
  cells: [{ text: r.baseline }, { text: r.strict, win: r.strictWins }],
}));

const table2Rows = cs.s3.table2.rows.map((r) => ({
  label: r.type,
  cells: [{ text: r.baseline }, { text: r.strict, win: r.strictWins }],
}));
---

<Base
  title={meta.crosssource.title}
  description={meta.crosssource.description}
  path="/crosssource/"
  ogImage="/og/crosssource.png"
  includeSoftwareSourceCode
>
  <Masthead
    label="Case study specification"
    kicker={cs.kicker}
    h1={cs.title}
    standfirst={cs.standfirst}
    h1Max="22ch"
    spec={cs.specBlock}
    switcher="CrossSource"
    repo={{ href: cs.repoHref, label: cs.repoLabel }}
    narr
  >
    <AudioPlayer audio={cs.audio} articleId="crosssource" />
  </Masthead>

  <Section mark={cs.s1.mark} label={cs.s1.label} narrId="s1-cue">
    <p class="prose" data-narr="s1-p0">
      {cs.s1.paraPre}<em>{cs.s1.caseName}</em>{cs.s1.paraMid}<span class="highlight">{cs.s1.highlight}</span>{cs.s1.paraPost}
    </p>
  </Section>

  <Section mark={cs.s2.mark} label={cs.s2.label} narrId="s2-cue">
    <dl class="method-list" data-narr="s2-list">
      {cs.s2.rows.map((row) => (
        <div class="method-row">
          <dt>{row.term}</dt>
          <dd>
            {row.kind === 'plain' && row.body}
            {row.kind === 'code' && (
              <>
                {row.bodyPre}
                <code>{row.code}</code>
                {row.bodyPost}
              </>
            )}
            {row.kind === 'configs' && (
              <>
                <em>{row.italic1}</em>
                {row.mid}
                <em>{row.italic2}</em>
                {row.bodyPost}
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section mark={cs.s3.mark} label={cs.s3.label} narrId="s3-cue">
    <EssayFigure n={1} replay title="Who can fix each failure" source="Source: Tables 1 and 2 below. Wrong-passage citations are the failures a prompt can reach; missing-authority failures trace to retrieval." >
      <FailureOwners {...failures} />
    </EssayFigure>
    <div data-narr="s3-table1">
      <DataTable nowrap caption={cs.s3.table1.caption} columns={cs.s3.table1.columns} rows={table1Rows} />
    </div>
    <div class="table-gap" data-narr="s3-table2">
      <DataTable nowrap caption={cs.s3.table2.caption} columns={cs.s3.table2.columns} rows={table2Rows} />
    </div>
    <p class="prose finding" data-narr="s3-p0">
      <strong>{cs.s3.findingLeadIn}</strong>{cs.s3.findingPre}<em>{cs.s3.findingItalic}</em>{cs.s3.findingPost}
    </p>
  </Section>

  <Section mark={cs.s4.mark} label={cs.s4.label} note={cs.s4.marginNote} narrId="s4-cue">
    <p class="stat-lead" data-narr="s4-p0">{cs.s4.statPre}</p>
    <p class="stat-figure tabular" data-narr="s4-p1">{cs.s4.statQuote}{cs.s4.statPost}</p>
    <p class="prose" data-narr="s4-p2">{cs.s4.bugPara}</p>
    <EssayFigure n={2} title={wj.player.title} source="Source: this section and the judge essay. The spans drawn are placeholders, not real answer text." href="/writing/the-judge-caught-a-bug/" hrefLabel="Read the essay →">
      <PlayerStepper stages={wj.player.stages} />
    </EssayFigure>
    <div class="lesson" data-narr="s4-quote">
      <PullQuote rule="red">{cs.s4.lessonQuote}</PullQuote>
    </div>
  </Section>

  <Section mark={cs.s5.mark} label={cs.s5.label} narrId="s5-cue">
    <p class="prose intro" data-narr="s5-p0">{cs.s5.intro}</p>
    <ul class="rule-list" data-narr="s5-list">
      {cs.s5.items.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section mark={cs.s6.mark} label={cs.s6.label} narrId="s6-cue">
    <p class="status-line" data-narr="s6-p0">{cs.s6.status}</p>
    <ul class="mono-list" data-narr="s6-list">
      {cs.s6.items.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section mark="§7" label="Related writing" narrId="s7-cue">
    <p class="prose related-writing" data-narr="s7-p0">
      <a href="/writing/the-judge-caught-a-bug/">The judge caught a bug I didn't</a> — on validating the LLM judge behind these numbers.
    </p>
    <p class="prose related-writing" data-narr="s7-p1">
      <a href="/mirror-eval/">mirror-eval</a> — the same method pointed at what AI search engines say about me.
    </p>
    <p class="prose related-writing" data-narr="s7-p2">
      <a href="/screener-eval/">screener-eval</a> — the same counting discipline pointed at LLM résumé screeners, no judge at all.
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={cs.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={cs.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .prose em {
    font-family: var(--font-display);
    font-style: italic;
  }

  .related-writing a {
    /* WCAG 2.5.8: a standalone link needs a 24px hit area. */
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .related-writing + .related-writing {
    margin-top: var(--s-3);
  }

  .highlight {
    background-image: linear-gradient(transparent 62%, var(--red-tint) 62%);
  }

  .method-list {
    display: flex;
    flex-direction: column;
  }

  .method-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .method-row:first-child {
    border-top: 0;
  }

  .method-row dt {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .method-row dd {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--ink-body);
    max-width: 60ch;
  }

  .method-row dd em {
    font-family: var(--font-display);
    font-style: italic;
  }

  .method-row code {
    font-family: var(--font-mono);
    font-size: var(--t-data);
    background: var(--paper-raised);
    padding: 2px 4px;
  }

  .table-gap {
    margin-top: var(--s-9);
  }

  .finding {
    margin-top: var(--s-8);
  }

  .stat-lead {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--ink-body);
    max-width: 60ch;
    margin-bottom: var(--s-5);
  }

  /* The figure is the point of the section — it gets its own line rather than
     sitting 51px tall inside a 17px paragraph. */
  .stat-figure {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    margin-bottom: var(--s-7);
  }

  .lesson {
    margin-top: var(--s-8);
  }

  .rule-list {
    list-style: none;
    margin-top: var(--s-5);
  }

  .rule-list li {
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--ink-body);
    max-width: 60ch;
  }

  .rule-list li:first-child {
    border-top: 0;
  }

  .status-line {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--s-5);
  }

  .mono-list {
    list-style: none;
  }

  .mono-list li {
    font-family: var(--font-mono);
    font-size: var(--t-data);
    color: var(--ink-muted);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .mono-list li:first-child {
    border-top: 0;
  }

  @media (max-width: 899px) {
    .method-row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>

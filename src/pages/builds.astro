---
// /builds/ (The Pipeline): systems (TradeFrame first), eval harnesses, method (the old /evals/),
// contributions, shipping numbers. Rows come from `buildsLedger` in copy.ts, never typed here.
// Anchors that redirects and links target: #systems, #evals, #method, #contributions, #shipping.
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import BuildsLedger from '../components/BuildsLedger.astro';
import { meta, home, cta, builds as B, buildsLedger, evalsLedger, shipping, pipelineBuilds as PB, pipelineAbout } from '../data/copy';
import { isExternal } from '../lib/isExternal';

const systems = buildsLedger.filter((b) => b.group === 'systems');
const evals = buildsLedger.filter((b) => b.group === 'evals');
const contribs = buildsLedger.filter((b) => b.group === 'contributions');
const E = home.evals;
const pc = (n: number) => `${n}%`;

// velocity-public.json (I17) arrives by its own PR. Until it has >= 3 closed builds the summary
// line is absent, not softened (SPEC #22).
const velocityPath = path.join(process.cwd(), 'public', 'data', 'velocity-public.json');
let summary: string | null = null;
if (existsSync(velocityPath)) {
  try {
    const v = JSON.parse(readFileSync(velocityPath, 'utf8'));
    const s = v?.builds_summary;
    if (s && s.closed_n >= 3) {
      summary = B.summary
        .replaceAll('{shipped_n}', String(s.shipped_n))
        .replaceAll('{on_time_n}', String(s.on_time_n))
        .replaceAll('{median_days}', String(s.median_days))
        .replaceAll('{median_cost}', Number(s.median_cost_usd).toFixed(2));
    }
  } catch {
    summary = null;
  }
}
---

<Base title={meta.builds.title} description={meta.builds.description} path="/builds/" ogImage="/og/builds.png" page="builds">
  <section class="page-head gut">
    <div class="in">
      <p class="kick">{PB.kicker}</p>
      <h1 class="display split">{PB.h1}</h1>
      <div class="bd-legend" aria-label={PB.legendLabel}>
        {B.legend.map((l) => <div><b>{l.term}</b><span>{l.text.replace(/\.$/, '')}</span></div>)}
      </div>
      <div class="stats">
        {
          PB.stats.map((s) => (
            <div class="ro">
              <p class="v" data-num>{s.v}</p>
              <p class="u">{s.u}</p>
              <p class="s">{s.s}</p>
            </div>
          ))
        }
      </div>
      {summary && <p class="bd-note">{summary} {B.summarySource}</p>}
      <p class="bd-note">{B.close}</p>
    </div>
  </section>

  <section class="sec gut" id="systems">
    <div class="in">
      <p class="kick">{PB.systems.kicker}</p>
      <h2 class="h2 split">{PB.systems.h2}</h2>
      <p class="lab bd-sub">{PB.systems.sub}</p>
      <BuildsLedger entries={systems} openFirst />
    </div>
  </section>

  <section class="sec gut" id="evals">
    <div class="in">
      <p class="kick">{PB.harnesses.kicker}</p>
      <h2 class="h2 split">{PB.harnesses.h2}</h2>
      <div class="bd-legend">
        {PB.harnesses.legend.map((l) => <div><b>{l.term}</b><span>{l.text}</span></div>)}
      </div>
      <BuildsLedger entries={evals} />
    </div>
  </section>

  <section class="sec spined gut" id="method">
    <div class="spine" aria-hidden="true"></div>
    <div class="in">
      <p class="kick">{PB.method.kicker}</p>
      <h2 class="h2 split">{PB.method.h2}</h2>
      <p class="bd-quote" data-reveal>{E.methodLine}</p>

      <div class="bd-two">
        <figure class="bd-fig" data-bd-fig2>
          <figcaption class="bd-fcap"><span>{PB.fig2Caption}</span><b>{PB.fig2Unit}</b></figcaption>
          {
            PB.fig2Rows.map((r) => (
              <div class="bd-fr">
                <span class="bd-fl">
                  {r.label} <span class:list={['bd-tag', { null: r.tag === 'null' }]}>{r.tag}</span>
                </span>
                <span class="bd-tr">{r.x !== undefined && <i class:list={['bd-b', { r: r.red }]} style={`--x:${pc(r.x)}`} />}</span>
                <span class:list={['bd-fv', { r: r.red }]}>{r.v}</span>
              </div>
            ))
          }
          <div class="bd-ax">
            <span />
            <span>{PB.fig2Axis.map((a) => <i>{a}</i>)}</span>
            <span />
          </div>
          <p class="bd-fn">{E.figNote}</p>
        </figure>
        <div data-stagger>
          {
            PB.methodCards.map((c, i) => (
              <div class="card" style={i ? 'margin-top:12px' : undefined}>
                <div class="card-top">
                  <span>{c.name}</span>
                  {c.red ? <span class="lab red bd-status">{c.status}</span> : <span>{c.status}</span>}
                </div>
                <h3>{c.title}</h3>
                <p class="bd-fn" style="margin-top:10px">{c.note}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="tbl-wrap">
        <table class="tbl bd-tbl">
          <caption>{E.tableCaption}</caption>
          <thead>
            <tr>{E.tableColumns.map((c) => <th>{c}</th>)}</tr>
          </thead>
          <tbody>
            {
              evalsLedger.map((e) => (
                <tr>
                  <td>{e.name}</td>
                  <td>{e.question}</td>
                  <td>{e.table.judge}</td>
                  <td>{e.table.metric}</td>
                  <td>{e.table.sample}</td>
                  <td>{e.table.verdict}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="bd-close">{E.closeLine}</p>
    </div>
  </section>

  <section class="sec gut" id="contributions">
    <div class="in">
      <p class="kick">{PB.contributions.kicker}</p>
      <h2 class="h2 split">{PB.contributions.h2}</h2>
      <ol class="bd-prs" data-stagger>
        {
          contribs.map((c) => {
            const p = PB.prs[c.id];
            return (
              <li class="bd-pr">
                <a class="pn" href={c.primary.href} target="_blank" rel="noopener noreferrer">
                  {c.name}<span aria-hidden="true">↗</span>
                </a>
                <div>
                  <p>{p.desc}</p>
                  <div class="ros">
                    {
                      p.ros.map((r) => (
                        <div class="ro">
                          <p class="v">{r.v}</p>
                          <p class="u">{r.u}</p>
                          {r.s && <p class="s">{r.s}</p>}
                        </div>
                      ))
                    }
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <section class="sec gut" id="shipping">
    <div class="in">
      <p class="kick">{PB.shipping.kicker}</p>
      <h2 class="h2 split">{PB.shipping.h2}</h2>
      <p class="lab bd-sub">{PB.shipping.sub}</p>
      <div class="hud bd-hud">
        <div class="hud-in">
          {
            PB.shipping.hud.map((c) => (
              <div class="hud-c">
                <span>{c.label}</span>
                <b class={c.red ? 'r' : undefined} data-num>
                  {c.v}
                  {c.small && <small>{c.small}</small>}
                </b>
                <em>{c.em}</em>
              </div>
            ))
          }
        </div>
      </div>

      <div class="tbl-wrap">
        <table class="tbl">
          <caption>{PB.tableCaption}</caption>
          <thead>
            <tr>
              {shipping.table.columns.map((c, i) => <th class={i >= 2 && i <= 4 ? 'n' : undefined}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              shipping.table.rows.map((r) => (
                <tr>
                  {r.map((cell, i) => <td class={i >= 2 && i <= 4 ? 'n' : undefined}>{cell}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="bd-pilot"><b>{PB.shipping.pilotLead}</b>{PB.shipping.pilot}</p>
    </div>
  </section>

  <section class="sec gut">
    <div class="in">
      <p class="kick">{pipelineAbout.cta.kicker}</p>
      <h2 class="h2">{pipelineAbout.cta.h2}</h2>
      <p class="id" style="margin-top:18px">{pipelineAbout.cta.id}</p>
      <div class="ctas" style="margin-top:32px">
        <a class="btn" href={cta.email.href}><span class="mi">{pipelineAbout.cta.email}</span><span class="ar" aria-hidden="true">→</span></a>
        {[cta.bookACall, cta.linkedin, cta.github, cta.x].map((l) => <a class="tl" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .bd-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 22px;
  }

  .bd-legend div {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font: 400 var(--t-note) / var(--lh-snug) var(--font-data);
    color: var(--color-text-muted);
  }

  .bd-legend b {
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--t-label);
  }

  .bd-legend b::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    margin-right: 8px;
    vertical-align: 1px;
  }

  .bd-note {
    margin-top: 18px;
    font: 400 var(--t-note) / var(--lh-base) var(--font-data);
    color: var(--color-text-muted);
  }

  .bd-sub {
    margin-top: 14px;
  }

  /* ---------- method ---------- */
  .bd-quote {
    margin-top: 28px;
    max-width: 30ch;
    font-size: clamp(24px, 2.4vw, 38px);
    line-height: var(--lh-heading);
    letter-spacing: -0.02em;
    color: var(--color-text);
    font-variation-settings: 'wdth' 90, 'wght' 560;
    border-left: var(--line-pen);
    padding-left: 22px;
  }

  .bd-two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    margin-top: clamp(32px, 5vh, 56px);
    align-items: start;
  }

  @media (max-width: 899px) {
    .bd-two {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Fig. 2 reuses the small-figure grammar from the ledger rows. */
  .bd-fig {
    border: var(--line-hair);
    background: var(--color-surface-sunk);
    padding: 16px 18px 14px;
  }

  .bd-fcap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font: 500 var(--t-label) / var(--lh-label) var(--font-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 9px;
    border-bottom: var(--line-hair);
    margin-bottom: 14px;
  }

  .bd-fcap b {
    font-weight: 500;
    color: var(--color-accent);
  }

  .bd-fr {
    display: grid;
    grid-template-columns: minmax(0, 11em) minmax(0, 1fr) minmax(0, 5.6em);
    gap: 12px;
    align-items: center;
    padding: 7px 0;
  }

  .bd-fl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    font: 400 11.5px / var(--lh-label) var(--font-data);
    color: var(--color-text-body);
  }

  .bd-fv {
    font: 500 12.5px / 1.2 var(--font-data);
    color: var(--color-text);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bd-fv.r {
    color: var(--color-accent);
  }

  .bd-tr {
    position: relative;
    height: 12px;
    background: linear-gradient(var(--color-line-strong), var(--color-line-strong)) 0 50% / 100% 1px no-repeat;
  }

  .bd-b {
    position: absolute;
    left: 0;
    top: 2px;
    height: 8px;
    width: var(--x);
    background: var(--color-text-body);
    transform-origin: left;
    transform: scaleX(var(--k, 1));
  }

  .bd-b.r {
    background: var(--color-accent);
  }

  .bd-ax {
    display: grid;
    grid-template-columns: minmax(0, 11em) minmax(0, 1fr) minmax(0, 5.6em);
    gap: 12px;
    margin-top: 4px;
  }

  .bd-ax span:nth-child(2) {
    display: flex;
    justify-content: space-between;
    font: 400 var(--t-label) / 1 var(--font-data);
    color: var(--color-text-muted);
  }

  .bd-ax i {
    font-style: normal;
  }

  .bd-fn {
    margin-top: 10px;
    font: 400 var(--t-label) / var(--lh-base) var(--font-data);
    color: var(--color-text-muted);
  }

  .bd-tag {
    font: 500 var(--t-label) / 1 var(--font-data);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: var(--line-object);
    padding: 3px 6px;
    white-space: nowrap;
  }

  .bd-tag.null {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .bd-status {
    font-size: inherit;
  }

  @media (max-width: 599px) {
    .bd-fr,
    .bd-ax {
      grid-template-columns: minmax(0, 1fr) minmax(0, 4.6em);
    }

    .bd-fr .bd-fl {
      grid-column: 1 / -1;
    }

    .bd-ax span:first-child {
      display: none;
    }
  }

  .bd-tbl td {
    font-size: 14px;
    line-height: var(--lh-snug);
  }

  .bd-tbl td:first-child {
    color: var(--color-text);
    font-variation-settings: 'wght' 640;
    white-space: nowrap;
  }

  .bd-tbl {
    min-width: 860px;
  }

  .bd-close {
    margin-top: 22px;
    max-width: 62ch;
    font-size: 17px;
    line-height: var(--lh-base);
    color: var(--color-text-body);
  }

  /* ---------- contributions ---------- */
  .bd-prs {
    list-style: none;
    border-top: var(--line-heavy);
    margin-top: clamp(28px, 5vh, 48px);
  }

  .bd-pr {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    gap: 12px 40px;
    padding: 22px 0;
    border-bottom: var(--line-hair);
  }

  .bd-pr a.pn {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--color-text);
    font-variation-settings: 'wdth' 82, 'wght' 720;
    transition: font-variation-settings 0.6s var(--ease-out);
  }

  .bd-pr a.pn:hover,
  .bd-pr a.pn:focus-visible {
    font-variation-settings: 'wdth' 100, 'wght' 880;
  }

  .bd-pr a.pn span {
    font-family: var(--font-data);
    font-size: var(--t-data);
    color: var(--color-accent);
    margin-left: 6px;
  }

  .bd-pr p {
    font-size: var(--t-small);
    line-height: var(--lh-base);
    color: var(--color-text-body);
  }

  .bd-pr .ros {
    margin-top: 12px;
  }

  .bd-pr .ros .v {
    font-size: var(--t-num);
    color: var(--color-text);
  }

  @media (max-width: 599px) {
    .bd-pr {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- shipping ---------- */
  .bd-hud {
    margin-top: clamp(28px, 5vh, 48px);
  }

  .bd-hud .hud-c {
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .bd-hud .hud-c b {
    font-size: clamp(26px, 2.6vw, 40px);
    font-variation-settings: 'wdth' 88, 'wght' 800;
  }

  .bd-hud .hud-c em {
    display: block;
    font-style: normal;
    text-transform: none;
    letter-spacing: 0.02em;
    margin-top: 4px;
    color: var(--color-text-muted);
  }

  .tbl :global(td.n + td:not(.n)),
  .tbl :global(th.n + th:not(.n)) {
    padding-left: 28px;
  }

  .bd-pilot {
    margin-top: 14px;
    font: 400 11.5px / var(--lh-base) var(--font-data);
    color: var(--color-text-muted);
  }

  .bd-pilot b {
    color: var(--color-accent);
    font-weight: 500;
  }
</style>

<script>
  /* Builds: ledger rows expand in place (siblings slide, nothing jumps), the red edge and the
     guard / measure / ship chain draw on open, Fig. 2 bars grow once in view. Calm easing only.
     Without motion the toggle is instant. Without script every panel is open. */
  import { $, $$, motion, revealNumber } from '../scripts/ds';
  import { gsap, ScrollTrigger } from '../scripts/gsap';

  const M = motion();
  const lists = $$<HTMLElement>('[data-ledger]');
  lists.forEach((l) => l.classList.add('bd-js'));
  let busy = false;
  let refreshT = 0;
  const refresh = () => {
    if (!M) return;
    clearTimeout(refreshT);
    refreshT = window.setTimeout(() => ScrollTrigger.refresh(), 120);
  };

  const following = (item: HTMLElement) => {
    const out: Element[] = [];
    let n = item.nextElementSibling;
    while (n) {
      out.push(n);
      n = n.nextElementSibling;
    }
    let s = item.parentElement?.nextElementSibling ?? null;
    while (s) {
      out.push(s);
      s = s.nextElementSibling;
    }
    return out;
  };
  const tops = (els: Element[]) => els.map((e) => e.getBoundingClientRect().top);
  const slide = (sibs: Element[], b0: number[], b1: number[], dur: number) =>
    sibs.forEach((s, i) => {
      const dy = b0[i] - b1[i];
      if (Math.abs(dy) > 0.5) gsap.fromTo(s, { y: dy }, { y: 0, duration: dur, ease: 'expo.out', clearProps: 'transform' });
    });

  /* Draw the chain, bars and figure marks of one panel. */
  const drawDetail = (det: HTMLElement, instant: boolean) => {
    const chain = $<HTMLElement>('.bd-chain', det);
    const nodes = $$<HTMLElement>('.bd-node', det);
    const nums = $$<HTMLElement>('.bd-n', det);
    const bars = $$<HTMLElement>('.bd-b', det);
    const dds = $$<HTMLElement>('.bd-dd', det);
    if (!M || instant) {
      det.style.setProperty('--sp', '1');
      chain?.style.setProperty('--k', '1');
      nodes.forEach((n) => n.style.setProperty('--d', '1'));
      bars.forEach((b) => b.style.setProperty('--k', '1'));
      dds.forEach((x) => {
        x.style.setProperty('--k', '1');
        x.style.setProperty('--d', '1');
      });
      nums.forEach((n) => revealNumber(n, 1));
      return;
    }
    gsap.fromTo(det, { '--sp': 0 }, { '--sp': 1, duration: 0.9, ease: 'expo.out' });
    if (chain) gsap.fromTo(chain, { '--k': 0 }, { '--k': 1, duration: 1.1, ease: 'expo.inOut', delay: 0.1 });
    nodes.forEach((n, i) => gsap.fromTo(n, { '--d': 0 }, { '--d': 1, duration: 0.6, ease: 'power2.out', delay: 0.25 + i * 0.22 }));
    nums.forEach((n, i) => {
      const o = { t: 0 };
      revealNumber(n, 0);
      gsap.to(o, { t: 1, duration: 0.8, ease: 'none', delay: 0.4 + i * 0.2, onUpdate: () => revealNumber(n, o.t) });
    });
    bars.forEach((b, i) => gsap.fromTo(b, { '--k': 0 }, { '--k': 1, duration: 1, ease: 'expo.out', delay: 0.35 + i * 0.08 }));
    dds.forEach((x, i) => {
      gsap.set(x, { '--d': 0 });
      gsap.fromTo(x, { '--k': 0 }, { '--k': 1, duration: 1, ease: 'expo.inOut', delay: 0.4 + i * 0.1 });
      gsap.to(x, { '--d': 1, duration: 0.5, ease: 'power2.out', delay: 1.15 + i * 0.1 });
    });
  };

  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle('open', open);
    $('.bd-row', item)?.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  const toggle = (item: HTMLElement) => {
    if (busy) return;
    const det = $<HTMLElement>('.bd-detail', item)!;
    const open = !item.classList.contains('open');
    if (!M) {
      setOpen(item, open);
      if (open) drawDetail(det, true);
      return;
    }
    busy = true;
    const sibs = following(item);
    if (open) {
      const b0 = tops(sibs);
      setOpen(item, true);
      slide(sibs, b0, tops(sibs), 0.8);
      gsap.fromTo(det, { clipPath: 'inset(0% 0% 100% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.8, ease: 'expo.out', clearProps: 'clipPath', onComplete: () => { busy = false; refresh(); } });
      drawDetail(det, false);
    } else {
      gsap.to(det, {
        clipPath: 'inset(0% 0% 100% 0%)',
        duration: 0.24,
        ease: 'power2.in',
        onComplete: () => {
          const b0 = tops(sibs);
          setOpen(item, false);
          gsap.set(det, { clearProps: 'clipPath' });
          slide(sibs, b0, tops(sibs), 0.6);
          gsap.delayedCall(0.6, () => { busy = false; refresh(); });
        },
      });
    }
  };
  $$<HTMLElement>('.bd-item').forEach((item) => $('.bd-row', item)?.addEventListener('click', () => toggle(item)));

  /* The row that starts open draws on first view. */
  const first = $<HTMLElement>('.bd-item.open .bd-detail');
  if (first) {
    if (M) {
      gsap.set(first, { '--sp': 0 });
      const c = $<HTMLElement>('.bd-chain', first);
      if (c) gsap.set(c, { '--k': 0 });
      $$<HTMLElement>('.bd-node', first).forEach((n) => gsap.set(n, { '--d': 0 }));
      ScrollTrigger.create({ trigger: first, start: 'top 85%', once: true, onEnter: () => drawDetail(first, false) });
    } else drawDetail(first, true);
  }

  /* Fig. 2 bars grow once in view. */
  const f2 = $<HTMLElement>('[data-bd-fig2]');
  if (f2 && M) {
    const bs = $$<HTMLElement>('.bd-b', f2);
    gsap.set(bs, { '--k': 0 });
    ScrollTrigger.create({
      trigger: f2,
      start: 'top 82%',
      once: true,
      onEnter: () => bs.forEach((b, i) => gsap.to(b, { '--k': 1, duration: 1.1, ease: 'expo.out', delay: i * 0.12 })),
    });
  }
</script>

---
// /about/ (The Pipeline): who he is, the career track as one vertical line ending at Instead,
// the Keka video, the public builds and record, and contact. The record is #record because
// /work/ redirects to /about/#record. Copy: pipelineAbout in src/data/copy.ts.
import Base from '../layouts/Base.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { meta, about, work, cta, pipelineAbout as A } from '../data/copy';
import { arrowHtml } from '../lib/arrowHtml';
import { isExternal } from '../lib/isExternal';

const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const links = [cta.bookACall, cta.linkedin, cta.github, cta.x];
const companies = [work.instead, work.multiplier, work.keka, work.hurix];
const dates = (d: string) => d.replace('–', ' to ');
const pad = (n: number) => String(n).padStart(2, '0');
const srcset = (e: string) => `/img/headshot-480.${e} 480w, /img/headshot-960.${e} 960w`;
const shotSizes = '(max-width: 599px) 132px, 208px';
---

<Base title={meta.about.title} description={meta.about.description} path="/about/" ogImage="/og/about.png" page="about">
  <section class="page-head ab-head gut">
    <div class="in">
      <div>
        <p class="kick">{A.kicker}</p>
        <h1 class="display split">{A.h1}</h1>
        <p class="id" style="margin-top:20px">{A.id}</p>
        <div class="stats">
          {
            A.stats.map((s) => (
              <div class="ro">
                <p class="v" data-num>{s.v}</p>
                <p class="u">{s.u}</p>
                <p class="s">{s.s}</p>
              </div>
            ))
          }
        </div>
      </div>
      <figure class="ab-shot">
        <picture>
          <source type="image/avif" srcset={srcset('avif')} sizes={shotSizes} />
          <source type="image/webp" srcset={srcset('webp')} sizes={shotSizes} />
          <img
            src="/img/headshot-480.jpg"
            srcset={srcset('jpg')}
            sizes={shotSizes}
            width="480"
            height="480"
            alt={about.photoAlt}
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </section>

  <section class="sec gut" style="padding-top:clamp(56px,9vh,104px)">
    <div class="in">
      <p class="kick">{A.belief.kicker}</p>
      <div class="ab-belief">
        <blockquote data-reveal>{A.belief.pre}<b>{A.belief.strong}</b></blockquote>
        <div data-reveal>
          <p class="lab" style="margin-bottom:10px">{A.belief.listLabel}</p>
          <ul class="ab-three">
            {A.belief.list.map((t, i) => <li><span>{pad(i + 1)}</span>{t}</li>)}
          </ul>
          <p class="ab-arc"><b>{A.belief.arcStrong}</b>{A.belief.arcRest}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec gut ab-career" id="record" aria-labelledby="career-h">
    <div class="in">
      <p class="kick">{A.career.kicker}</p>
      <h2 class="h2 split" id="career-h">{A.career.h2}</h2>
      <div class="ab-track-wrap">
        <span class="ab-vfill" aria-hidden="true"></span>
        <ol class="ab-sts">
          {
            A.career.stations.map((st, i) => (
              <li class:list={['ab-st', 'on', { act: st.now }]}>
                <span class="ab-yr">{st.yr}</span>
                <span class="ab-node" aria-hidden="true" />
                <span class="ab-nm">{st.name}</span>
                <span class="ab-role">{st.role}</span>
                <article class="card ab-card">
                  <div class="card-top">
                    <span>
                      <span class="no">{pad(i + 1)}</span> / {st.top[0]}
                    </span>
                    <span>{st.top[1]}</span>
                  </div>
                  <h3>{st.title}</h3>
                  <div class:list={['ros', { n2: st.cols === 2 }]}>
                    {
                      st.ros.map((r) => (
                        <div class="ro">
                          <p class="v" set:html={arrowHtml(r.v)} />
                          <p class="u">{r.u}</p>
                          <p class="s" set:html={arrowHtml(r.s)} />
                        </div>
                      ))
                    }
                  </div>
                  {st.video && (
                    <VideoEmbed
                      youtubeId={work.keka.video.youtubeId}
                      title={work.keka.video.title}
                      caption={A.video.caption}
                      poster={work.keka.video.poster}
                      play={A.video.play}
                      open={A.video.open}
                      links={A.video.links}
                    />
                  )}
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="sec gut" id="in-full">
    <div class="in">
      <p class="kick">{A.full.kicker}</p>
      <h2 class="h2 split">{A.full.h2}</h2>
      <div class="ab-fulls" data-stagger>
        {
          companies.map((c) => (
            <details class="ab-full">
              <summary>
                <span class="bn">{c.company}</span>
                <span class="bk2">{c.role} · {dates(c.dateRange)}</span>
                <span class="ba" aria-hidden="true" />
              </summary>
              <div class="ab-fullbody">
                {c.descriptor && <p class="ab-desc">{c.descriptor}</p>}
                {'standfirst' in c && c.standfirst && <p class="ab-desc">{c.standfirst}</p>}
                <dl>
                  {
                    c.achievements.map((a) => (
                      <div>
                        <dt>{a.kicker ?? ''}</dt>
                        <dd>{a.text}</dd>
                      </div>
                    ))
                  }
                </dl>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec gut">
    <div class="in">
      <p class="kick">{A.method.kicker}</p>
      <h2 class="h2 split">{A.method.h2}</h2>
      <ul class="verb-row">
        {
          A.method.verbs.map((v) => (
            <li class="verb">
              <span class="vn">{v.n}</span>
              <h3>{v.h}</h3>
              {v.href ? (
                <a class="vp" href={v.href}>
                  <b>{v.b}</b>
                  {v.t}
                </a>
              ) : (
                <span class="vp">
                  <b set:html={arrowHtml(v.b)} />
                  {v.t}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec gut" id="public-builds">
    <div class="in">
      <p class="kick">{A.builds.kicker}</p>
      <h2 class="h2 split">{A.builds.h2}</h2>
      <ol class="blist" data-stagger>
        {
          A.builds.rows.map((r) => (
            <li>
              <a class="build" href={r.href} {...ext(r.href)}>
                <span class="bn">{r.name}</span>
                <span class="bk2">{r.kind}</span>
                <span class="bv" set:html={arrowHtml(r.value)} />
                <span class="ba" aria-hidden="true">{isExternal(r.href) ? '↗' : '→'}</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="ab-split" style="margin-top:clamp(56px,9vh,96px)">
        <div>
          <p class="kick">{A.builds.contribKicker}</p>
          <ol class="blist" data-stagger>
            {
              A.builds.contributions.map((r) => (
                <li>
                  <a class="build" href={r.href} {...ext(r.href)}>
                    <span class="bn">{r.name}</span>
                    <span class="bk2">{r.kind}</span>
                    <span class="bv">{r.value}</span>
                    <span class="ba" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <p class="ab-note">{work.contributions.note}</p>
        </div>
        <div>
          <p class="kick">{A.builds.recordKicker}</p>
          <ol class="blist ab-ext" data-stagger>
            {
              A.builds.record.map((r) => (
                <li>
                  <a class="build" href={r.href} {...ext(r.href)}>
                    <span class="bn">{r.name}</span>
                    <span class="bk2">{r.kind}</span>
                    <span class="bv">{r.value}</span>
                    <span class="ba" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <p class="ab-note">{A.builds.recordNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec gut" id="contact">
    <div class="in">
      <p class="kick">{A.cta.kicker}</p>
      <h2 class="h2 split">{A.cta.h2}</h2>
      <div class="ctas" style="margin-top:32px">
        <a class="btn" href={cta.email.href}>
          <span class="mi">{A.cta.email}</span><span class="ar" aria-hidden="true">→</span>
        </a>
        {links.map((l) => <a class="tl" href={l.href} {...ext(l.href)}>{l.label}</a>)}
      </div>
      <div class="ab-site" id="site">
        <span class="lab">{A.cta.site.label}</span>
        <a class="tl" href={A.cta.site.href}>{A.cta.site.link}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- page head ---------- */
  .ab-head .in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 56px;
    align-items: end;
  }

  .ab-shot {
    width: clamp(150px, 15vw, 208px);
    aspect-ratio: 4 / 5;
    border: var(--line-strong);
    background: var(--color-surface-sunk);
    position: relative;
    margin: 0;
  }

  .ab-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
  }

  /* Red registration corners. */
  .ab-shot::before,
  .ab-shot::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-width: 1.5px;
    border-style: solid;
    border-color: var(--color-accent);
  }

  .ab-shot::before {
    left: -1px;
    top: -1px;
    border-right: 0;
    border-bottom: 0;
  }

  .ab-shot::after {
    right: -1px;
    bottom: -1px;
    border-left: 0;
    border-top: 0;
  }

  .ab-belief {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px 56px;
    align-items: start;
    margin-top: clamp(36px, 6vh, 64px);
  }

  .ab-belief blockquote {
    font-size: clamp(24px, 2.6vw, 40px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    font-variation-settings: 'wdth' 88, 'wght' 640;
    color: var(--color-text);
    border-left: var(--line-pen);
    padding-left: 22px;
    max-width: 24ch;
  }

  .ab-belief blockquote b {
    font-weight: normal;
    font-variation-settings: 'wdth' 88, 'wght' 860;
  }

  .ab-three {
    list-style: none;
    display: grid;
    border-top: var(--line-hair);
  }

  .ab-three li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
    padding: 10px 0;
    border-bottom: var(--line-hair);
    font-size: 15.5px;
    color: var(--color-text);
    font-variation-settings: 'wght' 540;
  }

  .ab-three li span {
    font: 500 var(--t-label) / 1.9 var(--font-data);
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .ab-arc {
    margin-top: 22px;
    font: 400 var(--t-note) / 1.6 var(--font-data);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .ab-arc b {
    font-weight: 500;
    color: var(--color-text-body);
  }

  @media (max-width: 899px) {
    .ab-head .in {
      grid-template-columns: minmax(0, 1fr);
    }

    .ab-shot {
      width: 132px;
      order: -1;
    }

    .ab-belief {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- career track ----------
     Vertical at every width: a thin rule down the left, a red line that draws over it as you read,
     ending at the last station's node. Wide screens: station label left, its card right. No pinning. */
  .ab-track-wrap {
    position: relative;
    margin-top: clamp(32px, 6vh, 56px);
  }

  .ab-sts {
    list-style: none;
    position: relative;
    display: grid;
    gap: 0;
    padding-left: 34px;
  }

  .ab-sts::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: var(--trk-b, 8px);
    width: 1px;
    background: var(--color-line-strong);
  }

  .ab-vfill {
    position: absolute;
    left: 9px;
    top: 8px;
    bottom: var(--trk-b, 8px);
    width: 1.5px;
    margin-left: -0.25px;
    z-index: 1;
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(1);
  }

  .ab-st {
    position: relative;
    padding: 0 0 clamp(36px, 6vh, 56px);
  }

  .ab-st:last-child {
    padding-bottom: 0;
  }

  .ab-node {
    position: absolute;
    left: -34px;
    top: 1px;
    width: 20px;
    height: 20px;
    display: block;
    z-index: 2;
  }

  .ab-node::before {
    content: '';
    position: absolute;
    inset: 4px;
    border-width: 1.5px;
    border-style: solid;
    border-color: var(--color-line-strong);
    background: var(--color-surface);
    transition: border-color 0.6s ease;
  }

  .ab-node::after {
    content: '';
    position: absolute;
    inset: 8px;
    background: var(--color-line-strong);
    transition: background 0.6s ease;
  }

  .ab-st.on .ab-node::before {
    border-color: var(--color-accent);
  }

  .ab-st.on .ab-node::after {
    background: var(--color-text);
  }

  .ab-st.act .ab-node::after {
    background: var(--color-accent);
  }

  .ab-yr {
    display: block;
    font: 500 var(--t-label) / 1.2 var(--font-data);
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    transition: color 0.6s ease;
  }

  .ab-st.on .ab-yr {
    color: var(--color-accent);
  }

  .ab-nm {
    display: block;
    margin-top: 6px;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1;
    letter-spacing: -0.025em;
    font-variation-settings: 'wdth' 84, 'wght' 720;
    color: var(--color-text);
  }

  .ab-role {
    display: block;
    margin-top: 6px;
    font: 400 11.5px / var(--lh-snug) var(--font-data);
    color: var(--color-text-muted);
  }

  .ab-card {
    margin-top: 16px;
    max-width: 760px;
  }

  @media (min-width: 900px) {
    .ab-st {
      display: grid;
      grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      gap: 0 48px;
      align-items: start;
    }

    .ab-st > .ab-yr,
    .ab-st > .ab-nm,
    .ab-st > .ab-role {
      grid-column: 1;
    }

    .ab-card {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin-top: 0;
      max-width: none;
    }
  }

  @media (max-width: 599px) {
    .ab-card :global(.card-top) {
      flex-direction: column;
      gap: 4px;
    }

    .ab-card :global(.ros) {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .ab-card :global(.ros .v) {
      white-space: nowrap;
    }
  }

  /* ---------- the record in full: Zoeb's own text, one row per role, closed until asked ---------- */
  .ab-fulls {
    border-top: var(--line-heavy);
    margin-top: clamp(28px, 5vh, 48px);
  }

  .ab-full {
    border-bottom: var(--line-hair);
  }

  .ab-full summary {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr) 30px;
    gap: 20px;
    align-items: center;
    padding: 22px 0;
    cursor: pointer;
  }

  .ab-full summary::-webkit-details-marker {
    display: none;
  }

  .ab-full .bn {
    font-size: clamp(20px, 1.55vw, 26px);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    font-variation-settings: 'wdth' 80, 'wght' 700;
  }

  .ab-full .ba {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    justify-self: end;
    color: var(--color-accent);
    transition: transform 0.5s var(--ease-out);
  }

  .ab-full .ba::before {
    content: '+';
    font: 400 22px / 1 var(--font-data);
  }

  .ab-full[open] .ba {
    transform: rotate(45deg);
  }

  .ab-fullbody {
    padding: 0 0 28px;
    max-width: var(--measure);
  }

  .ab-desc {
    margin-bottom: 16px;
    font-size: var(--t-small);
    line-height: var(--lh-base);
    color: var(--color-text-body);
  }

  .ab-fullbody dl > div {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-top: var(--line-hair);
  }

  .ab-fullbody dt {
    font: 500 var(--t-label) / 1.6 var(--font-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .ab-fullbody dd {
    font-size: var(--t-small);
    line-height: var(--lh-base);
    color: var(--color-text-body);
  }

  @media (max-width: 599px) {
    .ab-full summary {
      grid-template-columns: minmax(0, 1fr) 30px;
    }

    .ab-full .bk2 {
      grid-column: 1;
      grid-row: 2;
    }

    .ab-full .ba {
      grid-column: 2;
      grid-row: 1;
    }

    .ab-fullbody dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  /* ---------- proof lists ---------- */
  .ab-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 56px;
  }

  .ab-split .bn {
    font-size: clamp(20px, 1.55vw, 26px);
  }

  .ab-split .build {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) auto 22px;
    gap: 16px;
  }

  .ab-ext .ba {
    font-size: var(--t-small);
  }

  .ab-note {
    margin-top: 14px;
    font: 400 11.5px / var(--lh-base) var(--font-data);
    color: var(--color-text-muted);
  }

  .ab-site {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 28px;
    margin-top: 22px;
  }

  @media (max-width: 899px) {
    .ab-split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  /* Career track: the red line draws down as you read and each station lights as it reaches the
     reading line. Vertical at every width, no pin. Without motion the final state is already in the HTML. */
  import { $, $$, motion } from '../scripts/ds';
  import { gsap, ScrollTrigger } from '../scripts/gsap';

  const root = $<HTMLElement>('.ab-career');
  const wrap = root && $<HTMLElement>('.ab-track-wrap', root);
  const lastNode = root && $<HTMLElement>('.ab-st:last-child .ab-node', root);

  if (root && wrap && lastNode) {
    // The line ends at the last station's node, not under its card.
    const endLine = () => {
      const w = wrap.getBoundingClientRect();
      const n = lastNode.getBoundingClientRect();
      wrap.style.setProperty('--trk-b', Math.max(0, w.bottom - (n.top + n.height / 2)).toFixed(1) + 'px');
    };
    endLine();
    window.addEventListener('resize', endLine);
    document.fonts?.ready.then(endLine);
    if (window.ResizeObserver) new ResizeObserver(endLine).observe(wrap);

    if (motion()) {
      const sts = $$<HTMLElement>('.ab-st', root);
      const vfill = $<HTMLElement>('.ab-vfill', root)!;
      const list = $<HTMLElement>('.ab-sts', root)!;
      gsap.set(vfill, { scaleY: 0 });
      gsap.to(vfill, { scaleY: 1, ease: 'none', scrollTrigger: { trigger: list, start: 'top 70%', end: 'bottom 70%', scrub: 0.6 } });
      sts.forEach((li, i) => {
        li.classList.remove('on', 'act');
        ScrollTrigger.create({
          trigger: li,
          start: 'top 70%',
          onEnter: () => {
            li.classList.add('on');
            sts.forEach((x) => x.classList.remove('act'));
            li.classList.add('act');
          },
          onLeaveBack: () => {
            li.classList.remove('on', 'act');
            sts[i - 1]?.classList.add('act');
          },
        });
        gsap.from($('.ab-card', li), { autoAlpha: 0, y: 10, duration: 1, ease: 'power2.out', scrollTrigger: { trigger: li, start: 'top 85%', once: true } });
      });
    }
  }
</script>

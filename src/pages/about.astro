---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import EmbedCard from '../components/EmbedCard.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, about, cta, home } from '../data/copy';

// Order matches the footer's, so the two link rows read as one list.
const links = [
  { label: cta.bookACall.label, href: cta.bookACall.href },
  { label: cta.email.label, href: cta.email.href },
  { label: cta.linkedin.label, href: cta.linkedin.href },
  { label: cta.github.label, href: cta.github.href },
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<Base title={meta.about.title} description={meta.about.description} path="/about/" ogImage="/og/about.png">
  <Masthead
    h1={about.h1}
    standfirst={about.dek}
    thumbnail={{ alt: about.photoAlt }}
    standfirstMax="640px"
  />

  <section class="body-section">
    <div class="body-inner grid-margin">
      <div class="margin-col" aria-hidden="true"></div>

      <div class="body-col">
        <h2 class="visually-hidden">The record</h2>
        <p class="prose">{about.bodyPara1}</p>

        <EmbedCard
          kicker={about.embed.kicker}
          title={about.embed.title}
          excerpt={about.embed.excerpt}
          byline={about.embed.byline}
          href={about.embed.href}
          linkLabel={about.embed.linkLabel}
          imageAlt={about.photoAlt}
          logo={{ src: '/img/logos/keka.png', width: 66, height: 24, alt: 'Keka' }}
        />

        <ul class="timeline">
          {about.timeline.map((t) => (
            <li class="timeline-row">
              <p class="timeline-year">{t.year}</p>
              <p class="timeline-body">{t.body}</p>
              <p class="timeline-source">
                {t.source && (
                  <a href={t.source.href} target="_blank" rel="noopener noreferrer">
                    {t.source.label}
                  </a>
                )}
              </p>
            </li>
          ))}
        </ul>

        <blockquote class="belief">
          <p>
            {about.beliefPre}<strong>{about.beliefStrong}</strong>{about.beliefPost}
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="facts-row">
    <ul>
      {about.factsRow.map((fact, i) => (
        <li>
          {i === about.factsRow.length - 1 ? (
            <a href={cta.bookACall.href}>{fact}</a>
          ) : (
            fact
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="links-list">
    <h2 class="visually-hidden">Contact</h2>
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            target={isExternal(l.href) ? '_blank' : undefined}
            rel={isExternal(l.href) ? 'noopener noreferrer' : undefined}
          >
            <span class="link-label">{l.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
      <li>
        <a class="has-detail" href={about.profileRow.href} target="_blank" rel="noopener noreferrer">
          <span class="link-label">{about.profileRow.label}</span>
          <span class="link-detail">{about.profileRow.detail}</span>
        </a>
      </li>
    </ul>
  </section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

<style>
  /* The body sits on the site's grid — same margin-col | body-col split as
     every other page — so its text starts at the same x as Work and Home. */
  .body-section {
    border-bottom: 1px solid var(--rule-strong);
  }

  .body-inner {
    --body-pad-end: var(--s-11);
  }

  .prose {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--ink-body);
    max-width: 68ch;
    margin-bottom: var(--s-8);
  }

  /* Timeline — mono year (kicker), a one-line body, and, where a public
     artefact exists, a source. A row with no source is a claim on trust. */
  .timeline {
    list-style: none;
    /* The embed card's bottom strong rule is the only rule above the
       timeline — no second strong line here. */
    margin-top: var(--s-9);
    margin-bottom: var(--s-9);
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) minmax(0, 220px);
    gap: var(--s-5);
    align-items: baseline;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  /* The belief block's own strong rule closes the timeline — a line here
     would double it. */
  .timeline-row:last-child {
    border-bottom: 0;
  }

  .timeline-year {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .timeline-body {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  .timeline-source {
    font-family: var(--font-mono);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
    text-align: right;
    /* The column is sized to hold the longest label; anywhere-wrapping is the
       fallback if a future label outgrows it, rather than nowrap overflowing
       silently. */
    overflow-wrap: anywhere;
  }

  .timeline-source a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .belief {
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-7);
  }

  .belief p {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.3;
    color: var(--ink);
    max-width: 46ch;
  }

  /* Instrument Serif ships a 400 face only — 500 would be synthesised. */
  .belief strong {
    font-weight: 400;
    font-style: italic;
  }

  .facts-row ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--rule-strong);
  }

  .facts-row li {
    padding: var(--s-7) var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--t-data);
    color: var(--ink-body);
    border-left: 1px solid var(--rule);
  }

  .facts-row li:first-child {
    border-left: 0;
  }

  .facts-row a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .links-list ul {
    list-style: none;
  }

  /* No top rule on the first row — the facts row above already closed with a
     strong rule, and two lines with nothing between them is one too many. */
  .links-list li {
    border-bottom: 1px solid var(--rule);
  }

  .links-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 56px;
    padding-block: 14px;
    padding-inline: var(--gutter);
    color: var(--ink);
    /* The label carries the (red) underline; without this the anchor's own ink
       underline stacks under it and every label reads as double-underlined. */
    text-decoration: none;
  }

  .link-label {
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--red-ink);
  }

  .link-detail {
    font-family: var(--font-mono);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
    text-align: right;
  }

  .links-list .arrow {
    color: var(--red-ink);
    transform: translateX(-4px);
    transition: transform var(--dur-fast) var(--ease-draw);
  }

  .links-list a:hover .arrow {
    transform: translateX(0);
  }

  @media (max-width: 899px) {
    .facts-row ul {
      grid-template-columns: 1fr;
    }

    .facts-row li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .facts-row li:first-child {
      border-top: 0;
    }

    .timeline-row {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }

    .timeline-source {
      text-align: left;
    }

    /* Only the row that carries a detail line stacks; the arrow rows keep the
       arrow on the label's line. */
    .links-list a.has-detail {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }

    /* The empty margin column would render as a ruled band under the masthead. */
    .body-inner > .margin-col {
      display: none;
    }

    .link-detail {
      text-align: left;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import MarginNote from '../components/MarginNote.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, about, cta, home } from '../data/copy';

// Order matches the footer's, so the two link rows read as one list.
const links = [
  { label: cta.bookACall.label, href: cta.bookACall.href },
  { label: cta.email.label, href: cta.email.href },
  { label: cta.linkedin.label, href: cta.linkedin.href },
  { label: cta.github.label, href: cta.github.href },
];

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<Base title={meta.about.title} description={meta.about.description} path="/about/" ogImage="/og/about.png">
  <section class="masthead">
    <div class="masthead-inner">
      <aside class="margin-col" aria-label="Photo">
        <Figure caption={about.figureCaption} alt={about.photoAlt} eager size="large" ratio="4/5" />
      </aside>
      <div class="body-col">
        <h1 class="page-h1">About</h1>
      </div>
    </div>
  </section>

  <section class="body-section">
    <div class="body-inner">
      <aside class="margin-col" aria-label="Profile note">
        <MarginNote as="div" label={about.profileNote.label}>
          {about.profileNote.body}
          <br />
          <a
            class="note-link"
            href={about.profileNote.href}
            target="_blank"
            rel="noopener noreferrer">{about.profileNote.linkLabel}</a
          >
        </MarginNote>
      </aside>

      <div class="body-col">
        <p class="prose">{about.bodyPara1}</p>

        <ul class="timeline">
          {about.timeline.map((t) => (
            <li class="timeline-row">
              <p class="timeline-year">{t.year}</p>
              <p class="timeline-body">{t.body}</p>
              <p class="timeline-source">
                {t.source && (
                  <a href={t.source.href} target="_blank" rel="noopener noreferrer">
                    {t.source.label}
                  </a>
                )}
              </p>
            </li>
          ))}
        </ul>

        <blockquote class="belief">
          <p>
            {about.beliefPre}<strong>{about.beliefStrong}</strong>{about.beliefPost}
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="facts-row">
    <ul>
      {about.factsRow.map((fact, i) => (
        <li>
          {i === about.factsRow.length - 1 ? (
            <a href={cta.bookACall.href}>{fact}</a>
          ) : (
            fact
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="links-list">
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            target={isExternal(l.href) ? '_blank' : undefined}
            rel={isExternal(l.href) ? 'noopener noreferrer' : undefined}
          >
            <span class="link-label">{l.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
      <li>
        <a href={about.profileRow.href} target="_blank" rel="noopener noreferrer">
          <span class="link-label">{about.profileRow.label}</span>
          <span class="link-detail">{about.profileRow.detail}</span>
        </a>
      </li>
    </ul>
  </section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    border-bottom: 1px solid var(--rule-strong);
  }

  .masthead-inner .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  /* The h1 sits on the photo's bottom edge — the original composition.
     The plate's width is deterministic from the grid (Figure breaks out of the
     margin column's padding by --s-2 on each side), so its height is too:
     plate = (--margin-col - 2 * --s-2), and at 4/5 that is x 5/4 tall. Fixing
     the body column to that height and bottom-aligning inside it lands the h1's
     baseline on the plate's bottom, without hard-coding a pixel offset or
     depending on how many lines the caption below the plate happens to run. */
  .masthead-inner .body-col {
    align-self: start;
    height: calc(var(--s-9) * 2 + (var(--margin-col) - 2 * var(--s-2)) * 5 / 4);
    padding: var(--s-9) var(--gutter) var(--s-9) var(--body-inset);
    display: flex;
    align-items: flex-end;
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--ink);
  }

  /* The body sits on the site's grid — same margin-col | body-col split as
     every other page — so its text starts at the same x as Work and Home. */
  .body-section {
    border-bottom: 1px solid var(--rule-strong);
  }

  .body-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
  }

  .body-inner .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .body-inner .body-col {
    padding: var(--s-9) var(--gutter) var(--s-11) var(--body-inset);
  }

  .body-inner :global(.margin-note) {
    margin-top: 0;
  }

  .note-link {
    display: inline-block;
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
    margin-bottom: var(--s-8);
  }

  /* Timeline — mono year (kicker), a one-line body, and, where a public
     artefact exists, a source. A row with no source is a claim on trust. */
  .timeline {
    list-style: none;
    margin-bottom: var(--s-9);
    border-top: 1px solid var(--rule-strong);
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) minmax(0, 220px);
    gap: var(--s-5);
    align-items: baseline;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  /* The belief block's own strong rule closes the timeline — a line here
     would double it. */
  .timeline-row:last-child {
    border-bottom: 0;
  }

  .timeline-year {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .08em;
    color: var(--red-ink);
    font-variant-numeric: tabular-nums;
  }

  .timeline-body {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--ink-body);
  }

  .timeline-source {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-muted);
    text-align: right;
    /* The column is sized to hold the longest label; anywhere-wrapping is the
       fallback if a future label outgrows it, rather than nowrap overflowing
       silently. */
    overflow-wrap: anywhere;
  }

  .timeline-source a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .belief {
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-7);
  }

  .belief p {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.3;
    color: var(--ink);
    max-width: 46ch;
  }

  /* Instrument Serif ships a 400 face only — 500 would be synthesised. */
  .belief strong {
    font-weight: 400;
    font-style: italic;
  }

  .facts-row ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--rule-strong);
  }

  .facts-row li {
    padding: var(--s-7) var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--t-data);
    color: var(--ink-body);
    border-left: 1px solid var(--rule);
  }

  .facts-row li:first-child {
    border-left: 0;
  }

  .facts-row a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links-list ul {
    list-style: none;
  }

  /* No top rule on the first row — the facts row above already closed with a
     strong rule, and two lines with nothing between them is one too many. */
  .links-list li {
    border-bottom: 1px solid var(--rule);
  }

  .links-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 56px;
    padding-block: 14px;
    padding-inline: var(--gutter);
    color: var(--ink);
  }

  .link-label {
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--red-ink);
  }

  .link-detail {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-muted);
    text-align: right;
  }

  .links-list .arrow {
    color: var(--red-ink);
    transform: translateX(-4px);
    transition: transform 120ms var(--ease-draw);
  }

  .links-list a:hover {
    color: var(--red-ink);
  }

  .links-list a:hover .link-label {
    text-decoration-color: currentColor;
  }

  .links-list a:hover .arrow {
    transform: translateX(0);
  }

  @media (max-width: 899px) {
    .masthead-inner,
    .body-inner {
      grid-template-columns: 1fr;
    }

    .masthead-inner .margin-col,
    .body-inner .margin-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: var(--s-6) var(--gutter);
    }

    .masthead-inner .body-col,
    .body-inner .body-col {
      padding: var(--s-7) var(--gutter);
    }

    /* One column: the photo is above the h1, so there is nothing to align to. */
    .masthead-inner .body-col {
      height: auto;
      align-self: auto;
    }

    .facts-row ul {
      grid-template-columns: 1fr;
    }

    .facts-row li {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .facts-row li:first-child {
      border-top: 0;
    }

    .timeline-row {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }

    .timeline-source {
      text-align: left;
    }

    .links-list a {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }

    .link-detail {
      text-align: left;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { meta } from '../../data/copy';
import { formatDate } from '../../lib/formatDate';

const kicker = 'Writing';
const title = 'Writing';
const standfirst =
  'Notes on eval methodology, LLM-as-judge reliability, and RAG output quality — drawn from CrossSource and production eval work. And, occasionally, an industry thesis written so it can be wrong.';

const posts = [
  {
    href: '/writing/the-bus-stop-nobody-notices/',
    title: 'The bus stop nobody notices',
    date: '2026-09-28',
    kicker: 'Industry thesis · Mobility',
    dek: 'A family business from Hubli built a fifty-year moat in Indian transport and just placed the largest private Volvo order in the country. What that says about premium intercity bus travel — and a ₹50,000 experiment to find out whether I actually understand it.',
  },
  {
    href: '/writing/two-levers-that-did-not-move/',
    title: '885 screenings, one résumé, and the two levers that did not move',
    date: '2026-09-11',
    kicker: 'Eval methodology · screener-eval',
    dek: 'I ran my own résumé through two LLM screeners against 21 open AI PM roles, five times each, with the employers swapped for fictional ones and the links deleted. Neither mattered. Something else did.',
  },
  {
    href: '/writing/eval-harness-at-my-own-reflection/',
    title: 'I pointed an eval harness at my own reflection',
    date: '2026-09-10',
    kicker: 'Eval methodology · mirror-eval',
    dek: 'What four AI search engines say about me, measured twice — and the three things that only showed up because the numbers were counted rather than scored.',
  },
  {
    href: '/writing/the-judge-caught-a-bug/',
    title: "The judge caught a bug I didn't",
    date: '2026-08-20',
    kicker: 'Eval methodology · CrossSource',
    dek: 'On validating LLM-as-judge evals — why a 15/15 blind agreement and a broken instrument can live in the same pipeline.',
  },
];
---

<Base title={meta.writingIndex.title} description={meta.writingIndex.description} path="/writing/" ogImage="/og/writing.png">
  <section class="masthead">
    <div class="masthead-inner">
      <aside class="margin-col" aria-label="Article kicker">
        <p class="kicker">{kicker}</p>
      </aside>
      <div class="body-col">
        <h1 class="page-h1">{title}</h1>
        <p class="standfirst">{standfirst}</p>
      </div>
    </div>
  </section>

  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <a href={p.href}>
            <div class="post-inner">
              <p class="post-kicker">{p.kicker}</p>
              <div class="post-body">
                <h2 class="post-title">{p.title}</h2>
                <p class="post-dek">{p.dek}</p>
                <p class="post-date tabular">
                  <time datetime={p.date}>{formatDate(p.date)}</time>
                </p>
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    border-bottom: 1px solid var(--rule-strong);
  }

  .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .body-col {
    padding: var(--s-9) var(--gutter) var(--s-11) var(--body-inset);
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--ink);
    margin-bottom: var(--s-6);
    max-width: 22ch;
  }

  .standfirst {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 62ch;
  }

  @media (max-width: 899px) {
    .masthead-inner {
      grid-template-columns: 1fr;
    }

    .margin-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: var(--s-6) var(--gutter);
    }

    .body-col {
      padding: var(--s-7) var(--gutter);
    }
  }

  /* Post list — uses the same two-column masthead grid (margin-col / body-col
     widths) so rows align with the post page above. */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    border-top: 1px solid var(--rule);
  }

  /* The masthead already closes with a strong rule — no second line here. */
  .post-list li:first-child {
    border-top: 0;
  }

  .post-list a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    padding-block: var(--s-7);
  }

  .post-kicker {
    padding: 0 var(--s-5) 0 var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .post-body {
    padding: 0 var(--gutter) 0 var(--body-inset);
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.1;
    letter-spacing: -.01em;
    color: var(--ink);
    margin-bottom: var(--s-4);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--red-ink);
    transition: color 120ms var(--ease-draw);
  }

  .post-dek {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--ink-body);
    max-width: 60ch;
    margin-bottom: var(--s-5);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--ink-muted);
  }

  /* Card-level hover: the title colour follows the whole-card link. */
  .post-list a:hover .post-title {
    color: var(--red);
  }

  @media (max-width: 899px) {
    .post-inner {
      grid-template-columns: 1fr;
      padding-block: var(--s-6);
    }

    .post-kicker {
      padding: 0 var(--gutter);
      margin-bottom: var(--s-3);
    }

    .post-body {
      padding: 0 var(--gutter);
    }
  }
</style>

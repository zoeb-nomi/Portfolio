---
// /writing/ (DESIGN v3 D-11, I-06..I-08): essays lead with their number; notes
// are grouped by build in compact rows (#notes, absorbing /notes/); the
// off-topic essay sits on the Other writing shelf (#other).
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import ReadAlongDemo from '../../components/ReadAlongDemo.astro';
import {
  meta,
  notesPage,
  writingIndex as W,
  writingDecisions,
  writingMisses,
  writingBusStop,
  writingTwoLevers,
  writingReflection,
  writingJudgeBug,
  writingJudgeBugAudio,
} from '../../data/copy';
import { notes } from '../../data/notes';
import { formatDate, formatClock } from '../../lib/formatDate';

// Order is the IA call (SPEC #42): Decisions API, Misses, Judge, Two levers, Reflection.
const essays = [
  { slug: 'decisions-api-legal-quiz', e: writingDecisions, audio: writingDecisions.audio.duration },
  { slug: 'nobody-reports-the-misses', e: writingMisses, audio: writingMisses.audio.duration },
  { slug: 'the-judge-caught-a-bug', e: writingJudgeBug, audio: writingJudgeBugAudio.duration },
  { slug: 'two-levers-that-did-not-move', e: writingTwoLevers, audio: writingTwoLevers.audio?.duration },
  { slug: 'eval-harness-at-my-own-reflection', e: writingReflection, audio: writingReflection.audio?.duration },
].map(({ slug, e, audio }) => ({ slug, href: `/writing/${slug}/`, title: e.title, kicker: e.kicker, dek: e.dek, date: e.date, readingTime: e.readingTime, audio, num: W.numbers[slug] }));

const other = [{ slug: 'the-bus-stop-nobody-notices', e: writingBusStop, audio: writingBusStop.audio?.duration }].map(({ slug, e, audio }) => ({
  slug,
  href: `/writing/${slug}/`,
  title: e.title,
  kicker: e.kicker,
  dek: e.dek,
  date: e.date,
  readingTime: e.readingTime,
  audio,
  num: W.numbers[slug],
}));

// Notes grouped by build, newest first inside each group.
const groups = notesPage.groups
  .map((g) => ({ ...g, notes: notes.filter((n) => n.group === g.id).sort((a, b) => b.date.localeCompare(a.date)) }))
  .filter((g) => g.notes.length > 0);
---

<Base title={meta.writingIndex.title} description={meta.writingIndex.description} path="/writing/" ogImage="/og/writing.png" motion>
  <Masthead kicker={W.kicker} h1={W.h1} standfirst={W.lead} h1Max="22ch" standfirstMax="60ch" />

  <Section mark={W.essaysLabel.mark} label={W.essaysLabel.label} anchorId={W.essaysLabel.anchorId}>
    <ReadAlongDemo />
    <ol class="essays" role="list">
      {
        essays.map((p) => (
          <li class="essay">
            <div class="essay-link">
              <span class="e-num" aria-hidden="true">
                {p.num?.display}
                {p.num && <span class="e-unit">{p.num.unit}</span>}
              </span>
              <span class="e-main">
                <span class="e-kicker">{p.kicker}</span>
                <a class="e-title" href={p.href} aria-describedby={`d-${p.slug}`}>{p.title}</a>
                <span class="e-dek" id={`d-${p.slug}`}>{p.dek}</span>
                <span class="e-meta">
                  <time datetime={p.date}>{formatDate(p.date)}</time> · {p.readingTime} read{p.audio ? ` · ${formatClock(p.audio)} audio` : ''}
                </span>
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section mark={W.notesLabel.mark} label={W.notesLabel.label} anchorId={W.notesLabel.anchorId}>
    <p class="notes-lead">{W.notesLead}</p>
    {
      groups.map((g) => (
        <div class="ngroup">
          <h3 class="ngroup-h">
            {g.label} <span>{g.notes.length} {g.notes.length === 1 ? 'note' : 'notes'}</span>
          </h3>
          <ul class="notes" role="list">
            {g.notes.map((n) => (
              <li>
                <a href={`/notes/${n.slug}/`}>
                  <span class="n-title">{n.title}</span>
                  <time class="n-date" datetime={n.date}>{formatDate(n.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </Section>

  <Section mark={W.otherLabel.mark} label={W.otherLabel.label} anchorId={W.otherLabel.anchorId} sub={W.otherNote}>
    <ol class="essays essays--other" role="list">
      {
        other.map((p) => (
          <li class="essay">
            <div class="essay-link">
              <span class="e-num" aria-hidden="true">
                {p.num?.display}
                {p.num && <span class="e-unit">{p.num.unit}</span>}
              </span>
              <span class="e-main">
                <span class="e-kicker">{p.kicker}</span>
                <a class="e-title" href={p.href} aria-describedby={`d-${p.slug}`}>{p.title}</a>
                <span class="e-dek" id={`d-${p.slug}`}>{p.dek}</span>
                <span class="e-meta">
                  <time datetime={p.date}>{formatDate(p.date)}</time> · {p.readingTime} read{p.audio ? ` · ${formatClock(p.audio)} audio` : ''}
                </span>
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</Base>

<style>
  .essays {
    list-style: none;
    margin-top: var(--s-9);
    border-top: var(--line-heavy);
    border-bottom: var(--line-heavy);
  }

  .essays--other {
    margin-top: 0;
  }

  .essay + .essay {
    border-top: var(--line-hair);
  }

  .essay:hover + .essay {
    border-top: var(--line-ink);
  }

  .essay {
    position: relative;
  }

  /* The title is the link; its ::after stretches over the whole row, so the
     row is one click target with a short, exact accessible name. */
  .e-title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .essay-link {
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr);
    column-gap: var(--s-7);
    padding-block: var(--s-6);
    text-decoration: none;
    color: inherit;
  }

  .e-num {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--t-num);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .e-unit {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0;
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .e-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .e-kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .e-title {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--red-ink);
    text-underline-offset: 5px;
    transition: color var(--dur-fast) var(--ease-draw);
  }

  .essay:hover .e-title {
    color: var(--red-ink);
  }

  .e-dek {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--ink-body);
    max-width: 62ch;
  }

  /* Hover reveals the dek on fine pointers (B: "hover reveals the dek"). It
     stays in the layout (visibility only) so nothing moves; touch and keyboard
     see it always. */
  @media (hover: hover) and (pointer: fine) {
    .js .e-dek {
      opacity: 0.0001;
      transition: opacity var(--dur-base) var(--ease-draw);
    }

    .js .essay:hover .e-dek,
    .js .essay:focus-within .e-dek {
      opacity: 1;
    }
  }

  .e-meta {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  .notes-lead {
    max-width: var(--measure);
    color: var(--ink-body);
    line-height: var(--lh-body);
    margin-bottom: var(--s-8);
  }

  .ngroup + .ngroup {
    margin-top: var(--s-8);
  }

  .ngroup-h {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: var(--line-ink);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink);
  }

  .ngroup-h span {
    color: var(--ink-muted);
    text-transform: none;
    letter-spacing: var(--track-wide);
  }

  .notes {
    list-style: none;
    border-bottom: var(--line-heavy);
  }

  .notes li + li {
    border-top: var(--line-hair);
  }

  .notes a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--s-5);
    align-items: baseline;
    padding-block: var(--s-3);
    min-height: var(--hit-touch);
    text-decoration: none;
    color: var(--ink);
  }

  .n-title {
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: var(--underline-offset);
  }

  .notes a:hover .n-title {
    color: var(--red-ink);
    text-decoration-color: var(--red-ink);
  }

  .n-date {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  @media (max-width: 599px) {
    .essay-link {
      grid-template-columns: 1fr;
      row-gap: var(--s-3);
    }

    .e-num {
      flex-direction: row;
      align-items: baseline;
      gap: var(--s-3);
    }

    .notes a {
      padding-block: var(--s-2);
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import EssayThumb from '../../components/EssayThumb.astro';
import ReadAlongDemo from '../../components/ReadAlongDemo.astro';
import {
  meta,
  writingDecisions,
  writingMisses,
  writingBusStop,
  writingTwoLevers,
  writingReflection,
  writingJudgeBug,
  writingJudgeBugAudio,
} from '../../data/copy';
import { formatDate, formatClock } from '../../lib/formatDate';

const kicker = 'Writing';
const title = 'Writing';
const standfirst =
  'Notes on eval methodology, LLM-as-judge reliability, and RAG output quality — drawn from CrossSource and production eval work. And, occasionally, an industry thesis written so it can be wrong.';

// One source of truth: each essay's own data object in copy.ts (title, dek, kicker, date, reading
// time, narration length). Newest first.
const essays = [
  { slug: 'decisions-api-legal-quiz', thumb: 'decisions', e: writingDecisions, audio: undefined },
  { slug: 'nobody-reports-the-misses', thumb: 'misses', e: writingMisses, audio: writingMisses.audio.duration },
  { slug: 'the-bus-stop-nobody-notices', thumb: 'bus', e: writingBusStop, audio: writingBusStop.audio?.duration },
  { slug: 'two-levers-that-did-not-move', thumb: 'levers', e: writingTwoLevers, audio: writingTwoLevers.audio?.duration },
  { slug: 'eval-harness-at-my-own-reflection', thumb: 'waves', e: writingReflection, audio: writingReflection.audio?.duration },
  { slug: 'the-judge-caught-a-bug', thumb: 'judge', e: writingJudgeBug, audio: writingJudgeBugAudio.duration },
] as const;

const posts = essays
  .map(({ slug, thumb, e, audio }) => ({
    href: `/writing/${slug}/`,
    thumb,
    title: e.title,
    date: e.date,
    kicker: e.kicker,
    dek: e.dek,
    readingTime: e.readingTime,
    audio,
  }))
  .sort((x, y) => y.date.localeCompare(x.date));

---

<Base title={meta.writingIndex.title} description={meta.writingIndex.description} path="/writing/" ogImage="/og/writing.png">
  <Masthead kicker={kicker} h1={title} standfirst={standfirst} h1Max="22ch" />
  <ReadAlongDemo />

  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <a href={p.href} aria-labelledby={`post-${p.href.split('/').filter(Boolean).pop()}`}>
            <div class="post-inner grid-margin">
              <p class="post-kicker margin-col">{p.kicker}</p>
              <div class="post-body body-col">
                <div class="post-text">
                  <h2 class="post-title" id={`post-${p.href.split('/').filter(Boolean).pop()}`}>{p.title}</h2>
                  <p class="post-dek">{p.dek}</p>
                  <p class="post-date tabular">
                    <time datetime={p.date}>{formatDate(p.date)}</time> · {p.readingTime} read{p.audio ? ` · ${formatClock(p.audio)} audio` : ''}
                  </p>
                </div>
                <EssayThumb kind={p.thumb} />
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  /* Post list — uses the same two-column masthead grid (margin-col / body-col
     widths) so rows align with the post page above. */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    border-top: 1px solid var(--rule);
  }

  /* The masthead already closes with a strong rule — no second line here. */
  .post-list li:first-child {
    border-top: 0;
  }

  .post-list a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-inner {
    padding-block: var(--s-7);
  }

  /* Row cells sit on the site grid but draw no column rule and no vertical
     padding — the row owns its own rhythm. */
  .post-kicker {
    border: 0;
    padding: 0 var(--s-5) 0 var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: var(--s-8);
    padding: 0 var(--gutter) 0 var(--body-inset);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    margin-bottom: var(--s-4);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--red-ink);
    transition: color var(--dur-fast) var(--ease-draw);
  }

  .post-dek {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--ink-body);
    max-width: 60ch;
    margin-bottom: var(--s-5);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-muted);
  }

  /* Card-level hover: the title colour follows the whole-card link. */
  .post-list a:hover .post-title {
    color: var(--red);
  }

  @media (max-width: 899px) {
    .post-inner {
      padding-block: var(--s-6);
    }

    .post-kicker {
      padding: 0 var(--gutter);
      margin-bottom: var(--s-3);
    }

    .post-body {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-5);
      padding: 0 var(--gutter);
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import DataTable from '../../components/DataTable.astro';
import EssayFigure from '../../components/EssayFigure.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { articleJsonLd } from '../../lib/articleJsonLd';
import { formatDate } from '../../lib/formatDate';
import { meta, writingDecisions as wd } from '../../data/copy';
import { jsonLdString } from '../../lib/jsonLdString';

const f = wd.figures;
const glance = f.glance;
const glanceRows = glance.rows.map((r) => ({ label: r.label, cells: r.cells.map((text) => ({ text })) }));

// A bare URL in a paragraph (the repo link in section 9) renders as a link whose text is the URL.
function withLinks(text: string): { text: string; href?: string }[] {
  return text
    .split(/(https?:\/\/\S*[^\s.,;:)])/)
    .filter(Boolean)
    .map((part) => (/^https?:\/\//.test(part) ? { text: part, href: part } : { text: part }));
}

const articleLd = articleJsonLd({
  slug: 'decisions-api-legal-quiz',
  headline: wd.title,
  description: meta.writingDecisions.description,
  date: wd.date,
  about: wd.about,
  audio: { src: wd.audio.src, duration: wd.audio.duration, captions: wd.audio.captions },
});
---

<Base
  title={meta.writingDecisions.title}
  description={meta.writingDecisions.description}
  path="/writing/decisions-api-legal-quiz/"
  ogImage="/og/decisions-api-legal-quiz.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={jsonLdString(articleLd)} is:inline />

  <Masthead kicker={wd.kicker} h1={wd.title} standfirst={wd.dek} h1Max="24ch" narr>
    <Fragment slot="byline"><time datetime={wd.date}>{formatDate(wd.date)}</time> · {wd.readingTime} read</Fragment>
    <AudioPlayer audio={wd.audio} articleId="decisions" />
    <p class="read-along">
      The text below follows the audio as it plays. <a href={wd.audio.captions} download>Download captions (.vtt)</a>
    </p>
    <div class="intro">
      {wd.intro.map((p, i) => <p class="prose" data-narr={`s0-p${i}`}>{p}</p>)}
    </div>
  </Masthead>

  {
    wd.sections.map((s, i) => (
      <Section mark={s.mark} label={s.label} anchorId={s.id} narrId={`s${i + 1}-cue`}>
        {s.paras.map((p, j) => (
          <>
            <p class="prose" data-narr={`s${i + 1}-p${j}`}>
              {withLinks(p).map((part) => (part.href ? <a class="prose-link" href={part.href}>{part.text}</a> : part.text))}
            </p>
            {s.after?.[j] === 'glance' && (
              <div class="summary">
                <div class="summary-table">
                  <DataTable caption={glance.caption} columns={glance.columns} rows={glanceRows} nowrap />
                </div>
                <div class="summary-cards">
                  <p class="summary-cap">{glance.caption}</p>
                  <ul class="summary-list">
                    {glance.rows.map((r) => (
                      <li class="summary-card">
                        <p class="summary-kind">{r.label}</p>
                        <dl class="summary-fields">
                          {r.cells.map((c, k) => (
                            <div class="summary-field">
                              <dt>{glance.columns[k + 1]}</dt>
                              <dd>{c}</dd>
                            </div>
                          ))}
                        </dl>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="summary-source">
                  {glance.source}{' '}
                  <a href={glance.href}>{glance.hrefLabel}</a>{' '}
                  <a href={glance.href2}>{glance.hrefLabel2}</a>
                </p>
              </div>
            )}
            {s.after?.[j] === 'trust' && (
              <EssayFigure n={f.trust.n} title={f.trust.title} source={f.trust.source} href={f.trust.href} hrefLabel={f.trust.hrefLabel}>
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-trust-curve
                  poster={f.trust.video.poster}
                  width={f.trust.video.width}
                  height={f.trust.video.height}
                  aria-label={f.trust.video.label}
                >
                  <source src={f.trust.video.src} type="video/mp4" />
                </video>
                <div class="fig-controls">
                  <button type="button" class="fig-toggle" data-trust-toggle hidden>Pause</button>
                </div>
                <p class="prose fig-caption" data-narr={`s${i + 1}-fig1`}>{f.trust.caption}</p>
              </EssayFigure>
            )}
          </>
        ))}
      </Section>
    ))
  }
</Base>

<script is:inline>
  // Fig. 1 plays muted on a loop while at least 35% of it is on screen. Reduced motion: the poster
  // only, and nothing downloads. The button holds the video paused until it is pressed again.
  for (const v of document.querySelectorAll('video[data-trust-curve]')) {
    const b = v.closest('figure').querySelector('[data-trust-toggle]'); let held = false;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.querySelector('source')?.remove(); v.load(); continue; }
    new IntersectionObserver(([e]) => { if (e.intersectionRatio >= 0.35 && !held) v.play().catch(() => {}); else v.pause(); }, { threshold: [0, 0.35] }).observe(v.closest('figure'));
    v.onplay = v.onpause = () => { b.textContent = v.paused ? 'Play' : 'Pause'; };
    b.hidden = false; b.onclick = () => { held = !v.paused; if (held) v.pause(); else v.play().catch(() => {}); };
  }
</script>

<style>
  .intro {
    margin-top: var(--s-8);
  }

  /* The trust-curve video fills its figure. */
  video {
    display: block;
    width: 100%;
    height: auto;
  }

  .fig-caption {
    margin-top: var(--s-3);
  }

  /* Pause / Play for Fig. 1, right-aligned above the caption. Shown by the script only. */
  .fig-controls {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--s-3);
  }

  .fig-toggle {
    min-block-size: var(--hit-min);
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: none;
    font-family: var(--font-mono);
    font-size: var(--t-note);
    line-height: var(--lh-label);
    color: var(--ink);
    cursor: pointer;
  }

  .fig-toggle[hidden] {
    display: none;
  }

  .prose-link {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    overflow-wrap: anywhere;
  }

  /* Standalone links in this page's source lines meet the 24px hit area. */
  .read-along a,
  .summary-source a,
  :global(.ef-source a) {
    display: inline-block;
    min-block-size: var(--hit-min);
    line-height: var(--lh-label);
  }

  .read-along {
    margin-top: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .read-along a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* A figure or table that follows a paragraph needs the same gap a paragraph
     would get. The figure supplies its own margin; the table wrapper does here. */
  .summary {
    margin-top: var(--s-8);
    margin-bottom: var(--s-8);
    max-width: var(--measure);
  }

  /* The Overall row closes the table: a 1px ink rule above it. Cell borders win over the
     row borders in the collapsed table, so the rule shows against Hearsay's hairline. */
  .summary-table :global(.data-table tbody tr:last-child > *) {
    border-top: 1px solid var(--rule-strong);
  }

  /* Wide screens: the table. Below 900px: one labelled card per row, so no
     sideways scrolling for six numeric columns. */
  .summary-cards {
    display: none;
  }

  @media (max-width: 899px) {
    .summary-table {
      display: none;
    }

    .summary-cards {
      display: block;
    }
  }

  .summary-cap {
    padding-bottom: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .summary-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .summary-card {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .summary-card:first-child {
    border-top: 1px solid var(--rule);
  }

  /* Overall: the same ink rule above it as in the table. */
  .summary-card:last-child {
    border-top: 1px solid var(--rule-strong);
  }

  .summary-card:nth-last-child(2) {
    border-bottom: 0;
  }

  .summary-kind {
    margin-bottom: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink);
  }

  .summary-fields {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  /* One row per field: label left, value right. */
  .summary-field {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    font-family: var(--font-mono);
  }

  .summary-field dt {
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .summary-field dd {
    margin: 0;
    flex: none;
    text-align: right;
    white-space: nowrap;
    font-size: var(--t-data);
    color: var(--ink);
  }

  /* Source line under the table, set like EssayFigure's. */
  .summary-source {
    margin-top: var(--s-5);
    font-family: var(--font-body);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .summary-source a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
</style>

---
import Base from '../../layouts/Base.astro';
import EssayShell from '../../components/EssayShell.astro';
import EssayHeading from '../../components/EssayHeading.astro';
import EssayFigure from '../../components/EssayFigure.astro';
import StatRow from '../../components/StatRow.astro';
import TextTable from '../../components/TextTable.astro';
import { articleJsonLd } from '../../lib/articleJsonLd';
import { meta, writingBusStop as wb, writingIndex } from '../../data/copy';
import { jsonLdString } from '../../lib/jsonLdString';

const articleLd = articleJsonLd({
  slug: 'the-bus-stop-nobody-notices',
  headline: wb.title,
  description: meta.writingBusStop.description,
  date: wb.date,
  about: 'Indian intercity bus industry, Vijayanand Travels, premiumisation, hypothesis-driven investing, Vijayanand Travels video coverage',
  audio: wb.audio && { src: wb.audio.src, duration: wb.audio.duration },
});

// §6 growth rows. The scale is symmetric (min -36, max +51, range 87), so the zero axis sits at 36/87 of each track.
const growth = [
  { label: 'ixigo bus revenue, FY26', v: 51, text: '+51%' },
  { label: 'Online bus journeys (redBus BusTrack), H2 FY26', v: 24, text: '+24%' },
  { label: 'MakeMyTrip bus revenue, Q1 FY27', v: 16, text: '+16%' },
  { label: 'Ashok Leyland M&HCV bus dispatches, Aug 2026', v: 12, text: '+12%' },
  { label: 'Whole intercity bus market, forecast CAGR FY23 to FY26 (VIDEC)', v: 8.5, text: '+8.5%' },
  { label: 'VECV heavy-duty buses, Q1 FY27', v: -36, text: '−36%' },
];
---

<Base
  title={meta.writingBusStop.title}
  description={meta.writingBusStop.description}
  path="/writing/the-bus-stop-nobody-notices/"
  ogImage="/og/bus-stop.png"
  ogType="article"
  page="writing"
>
  <script type="application/ld+json" set:html={jsonLdString(articleLd)} is:inline />

  <EssayShell
    slug="the-bus-stop-nobody-notices"
    kicker={wb.kicker}
    title={wb.title}
    dek={wb.dek}
    date={wb.date}
    readingTime={wb.readingTime}
    audio={wb.audio}
    articleId="bus-stop"
    related="link"
  >
    <EssayHeading mark={wb.s1.mark} label={wb.s1.label} narrId="s1-cue" />
    {wb.s1.paras.map((p, i) => <p data-narr={`s1-p${i}`}>{p}</p>)}
    {wb.photo.enabled && (
      <figure class="fig">
        <img class="bs-photo" src={wb.photo.src} alt={wb.photo.alt} loading="lazy" decoding="async" width="1600" height="1000" />
        <figcaption>{wb.photo.caption} · {wb.photo.credit}</figcaption>
      </figure>
    )}

    <EssayHeading mark={wb.s2.mark} label={wb.s2.label} narrId="s2-cue" />
    <p data-narr="s2-p0">{wb.s2.intro}</p>
    <div class="bs-stats" data-narr="s2-stats">
      {wb.s2.stats.map((s) => <StatRow value={s.value} label={s.label} provenance={s.provenance} />)}
    </div>
    {wb.s2.paras.map((p, i) => <p data-narr={`s2-p${i + 1}`}>{p}</p>)}

    <EssayHeading mark={wb.s3.mark} label={wb.s3.label} narrId="s3-cue" />
    {wb.s3.paras.map((p, i) => <p data-narr={`s3-p${i}`}>{p}</p>)}
    <div data-narr="s3-fig">
      <EssayFigure n={1} title="Revenue, ₹ crore, and EBITDA margin" source="CARE Ratings (Mar 2025), Tracxn">
        <svg class="bs-rev" viewBox="0 0 380 320" width="100%" role="img" aria-labelledby="fig1-title">
          <title id="fig1-title">Vijayanand Travels after the carve-out</title>
          <line class="rv-axis" x1="10" y1="260" x2="370" y2="260" />

          <rect class="rv-bar" x="20" y="235" width="80" height="25" />
          <text class="rv-margin" x="60" y="199" text-anchor="middle">13.2%</text>
          <text class="rv-value" x="60" y="223" text-anchor="middle">₹75 Cr</text>
          <text class="rv-year" x="60" y="280" text-anchor="middle">FY23</text>
          <text class="rv-note" x="60" y="294" text-anchor="middle">(partial year)</text>

          <rect class="rv-bar" x="150" y="142" width="80" height="118" />
          <text class="rv-margin" x="190" y="106" text-anchor="middle">14.9%</text>
          <text class="rv-value" x="190" y="130" text-anchor="middle">₹351 Cr</text>
          <text class="rv-year" x="190" y="280" text-anchor="middle">FY24</text>

          <rect class="rv-bar rv-bar--red" x="280" y="90" width="80" height="170" />
          <text class="rv-margin" x="320" y="54" text-anchor="middle">19.5%</text>
          <text class="rv-value" x="320" y="78" text-anchor="middle">₹504 Cr</text>
          <text class="rv-year" x="320" y="280" text-anchor="middle">FY25</text>
        </svg>
      </EssayFigure>
    </div>
    <blockquote data-narr="s3-quote">{wb.s3.quote}</blockquote>

    <EssayHeading mark={wb.s4.mark} label={wb.s4.label} narrId="s4-cue" />
    {wb.s4.paras.map((p, i) => <p data-narr={`s4-p${i}`}>{p}</p>)}

    <EssayHeading mark={wb.s5.mark} label={wb.s5.label} narrId="s5-cue" />
    <div data-narr="s5-table">
      <TextTable caption={wb.s5.table.caption} columns={wb.s5.table.columns} rows={wb.s5.table.rows} wide />
    </div>
    {wb.s5.paras.map((p, i) => <p data-narr={`s5-p${i}`}>{p}</p>)}

    <EssayHeading mark={wb.s6.mark} label={wb.s6.label} narrId="s6-cue" />
    <div data-narr="s6-fig">
      <EssayFigure n={2} title="One market, four growth rates" source="Latest reported growth, year on year · company releases, redBus BusTrack, VIDEC">
        <div class="bs-rows" role="list">
          {
            growth.map((g) => (
              <div class="bs-row" role="listitem" aria-label={`${g.label}: ${g.text}`}>
                <p class="bs-cat" aria-hidden="true">{g.label}</p>
                <div class="bs-track">
                  <div class="bs-area" style={`--v:${g.v}`}>
                    {g.v < 0 ? (
                      <span class="bs-bar bs-bar--red" aria-hidden="true">{g.text}</span>
                    ) : (
                      <>
                        <span class="bs-bar" aria-hidden="true" />
                        <span class="bs-value" aria-hidden="true">{g.text}</span>
                      </>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </EssayFigure>
    </div>
    {wb.s6.paras.map((p, i) => <p data-narr={`s6-p${i}`}>{p}</p>)}

    <EssayHeading mark={wb.s7.mark} label={wb.s7.label} narrId="s7-cue" />
    <div class="wr-p">
      <p data-narr="s7-p0">{wb.s7.intro}</p>
      <aside class="wr-mn"><b>{wb.s7.label}</b>{wb.disclaimer}</aside>
    </div>
    <div data-narr="s7-table">
      <TextTable caption={wb.s7.table.caption} columns={wb.s7.table.columns} rows={wb.s7.table.rows} wide />
    </div>
    {wb.s7.paras.map((p, i) => <p data-narr={`s7-p${i + 1}`}>{p}</p>)}

    <EssayHeading mark={wb.s8.mark} label={wb.s8.label} narrId="s8-cue" />
    {wb.s8.paras.map((p, i) => <p data-narr={`s8-p${i}`}>{p}</p>)}
    <p class="bs-disclaimer" data-narr="s8-disclaimer">{wb.disclaimer}</p>
    <p class="wr-links">
      {wb.sources.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="outbound-click"
            data-umami-event-section="sources"
            data-umami-event-href={link.href}
          >{link.label}</a>
        </>
      ))}
    </p>

    <EssayHeading mark={wb.watch.mark} label={wb.watch.label} narrId="s9-cue" />
    <p>{wb.watch.intro}</p>
    <div class="bs-watch" data-narr="s9-gallery">
      {wb.watch.items.map((item) => (
        <div
          class="watch-card"
          data-watch-embed
          data-embed-src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}?autoplay=1&rel=0&modestbranding=1`}
          data-embed-title={item.title}
          data-play-label={`Play: ${item.title}`}
        >
          <div class="watch-frame">
            <a
              class="watch-facade"
              href={`https://www.youtube.com/watch?v=${item.youtubeId}`}
              aria-label={`Play: ${item.title}`}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="watch-click"
              data-umami-event-video={item.youtubeId}
            >
              <img
                class="watch-poster"
                src={item.poster ?? `/img/watch/${item.youtubeId}.jpg`}
                alt=""
                width="1280"
                height="720"
                loading="lazy"
              />
              <span class="watch-plate" aria-hidden="true">PLAY ▶</span>
            </a>
          </div>
          <h3 class="watch-title">{item.title}</h3>
          <p class="watch-channel">{item.channel}</p>
          <p class="watch-why">{item.why}</p>
        </div>
      ))}
    </div>

    <div class="ctas wr-all">
      <a class="tl" href="/writing/">{writingIndex.moreWriting}</a>
    </div>
  </EssayShell>

  <script is:inline>
    for (const card of document.querySelectorAll('[data-watch-embed]')) {
      const anchor = card.querySelector('a.watch-facade');
      const frame = card.querySelector('.watch-frame');
      if (!anchor || !frame) continue;

      const poster = card.querySelector('img.watch-poster');
      if (poster) {
        const markFailed = () => poster.setAttribute('data-failed', '');
        poster.addEventListener('error', markFailed);
        if (poster.complete && poster.naturalWidth === 0) markFailed();
      }

      const button = document.createElement('button');
      button.type = 'button';
      // Copy every attribute except link-only ones, so the button keeps the
      // class AND Astro's data-astro-cid-* scoping attribute (scoped styles apply).
      for (const attr of Array.from(anchor.attributes)) {
        if (attr.name === 'href' || attr.name === 'target' || attr.name === 'rel') continue;
        button.setAttribute(attr.name, attr.value);
      }
      button.setAttribute('aria-label', card.dataset.playLabel || 'Play video');
      while (anchor.firstChild) button.appendChild(anchor.firstChild);
      anchor.replaceWith(button);

      button.addEventListener('click', () => {
        try {
          window.umami?.track('watch-play', { video: button.dataset.umamiEventVideo || '' });
        } catch {}
        const iframe = document.createElement('iframe');
        iframe.src = card.dataset.embedSrc || '';
        iframe.title = card.dataset.embedTitle || '';
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('loading', 'lazy');
        button.remove();
        frame.appendChild(iframe);
        iframe.focus();
      });
    }
  </script>
</Base>

<style>
  /* §3 revenue bars: an inline SVG on the figure frame. viewBox width is set close to the narrowest supported
     viewport so phones render near 1:1 and desktop scales up modestly. */
  .bs-rev {
    display: block;
    width: 100%;
    height: auto;
  }

  .rv-axis {
    stroke: var(--color-line-strong);
    stroke-width: 1;
  }

  .rv-bar {
    fill: var(--color-text-body);
  }

  .rv-bar--red {
    fill: var(--color-accent);
  }

  .rv-value {
    font-family: var(--font-data);
    font-weight: 500;
    fill: var(--color-text);
    font-size: 20px;
  }

  .rv-margin {
    font-family: var(--font-data);
    font-size: var(--t-note);
    fill: var(--color-text-muted);
  }

  .rv-year {
    font-family: var(--font-data);
    font-size: var(--t-data);
    fill: var(--color-text-body);
  }

  .rv-note {
    font-family: var(--font-data);
    font-size: var(--t-label);
    fill: var(--color-text-muted);
  }

  /* SVG text scales with the figure (viewBox 380 wide): about 0.92 at 390px and 0.84 at 360px, which would put the
     11-13px labels under the 11px mono floor. On phones the small labels step up so they still render at 11px or more. */
  @media (max-width: 599px) {
    .rv-margin,
    .rv-year,
    .rv-note {
      font-size: var(--t-small);
    }

    /* "(partial year)" is centred on the first bar, which sits near the left edge; at the larger size it would
       start left of the viewBox. */
    .rv-note {
      transform: translateX(var(--s-2));
    }
  }

  /* §6 growth rows: HTML and CSS, not SVG, so label and value text sit at fixed sizes and never shrink with a
     viewBox on narrow phones. The scale is symmetric (min -36, max +51, range 87); the zero axis sits at
     36/87 = 41.3793% from the left of each bar area. --v (set once per row, on .bs-area) drives the bar and its
     value; the value sits at the bar's outer end (inside the red bar for the one negative row). .bs-track keeps a
     3.6em blank reserve past the scale so the +51% value is never clipped. */
  .bs-rows {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .bs-row {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .bs-cat {
    font-family: var(--font-data);
    font-size: var(--t-data);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .bs-track {
    padding-right: 3.6em;
  }

  .bs-area {
    position: relative;
    height: 15px;
  }

  .bs-area::before {
    content: '';
    position: absolute;
    left: 41.3793%;
    top: -3px;
    bottom: -3px;
    width: 1px;
    background: var(--color-text-muted);
    z-index: 1;
  }

  .bs-bar {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--color-text-body);
    left: calc(41.3793% + min(0%, var(--v) * (100% / 87)));
    width: calc(abs(var(--v)) * (100% / 87));
  }

  .bs-bar--red {
    display: flex;
    align-items: center;
    background: var(--color-accent-fill);
    padding-left: 0.5em;
    font-family: var(--font-data);
    font-size: var(--t-data);
    font-weight: 500;
    color: var(--color-on-accent);
    white-space: nowrap;
  }

  .bs-value {
    position: absolute;
    top: 50%;
    left: calc(41.3793% + var(--v) * (100% / 87) + 0.5em);
    transform: translateY(-50%);
    font-family: var(--font-data);
    font-size: var(--t-data);
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .bs-area {
      height: 17px;
    }
  }

  /* The five readouts: a hairline grid that fills the reading column, three to a row where it fits. */
  .bs-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0 var(--s-6);
    margin-block: var(--s-7);
    border-top: var(--line-hair);
  }

  .bs-stats :global(.ro) {
    padding-block: var(--s-4);
    border-bottom: var(--line-hair);
  }

  .bs-disclaimer {
    font-family: var(--font-data);
    font-size: var(--t-label);
    color: var(--color-text-muted);
  }

  /* §1 photo (behind wb.photo.enabled). */
  .bs-photo {
    display: block;
    width: 100%;
    height: auto;
    border: var(--line-hair);
  }

  /* §9 watch: lite-embed cards, mirroring VideoEmbed's facade pattern. The row runs past the reading column. */
  .bs-watch {
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  @media (min-width: 900px) {
    .bs-watch {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .bs-watch {
      width: calc(var(--rs-w) + 306px);
      max-width: none;
    }
  }

  .watch-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .watch-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-sunk);
    border: var(--line-hair);
    overflow: hidden;
  }

  .watch-facade {
    position: absolute;
    inset: 0;
    display: block;
    border: 0;
    padding: 0;
    background: transparent;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  /* .watch-frame clips overflow for its 16:9 crop, which clips the global focus ring (drawn outside, offset 3px)
     to invisibility. Draw this one inside the frame instead. :global() because the inline script above replaces
     the <a class="watch-facade"> with a plain createElement('button') that copies the className string but not
     Astro's scoped data-astro-cid attribute, so a scoped selector would stop matching the swapped-in button. */
  :global(.watch-facade:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: -4px;
    box-shadow: inset 0 0 0 6px var(--color-surface-sunk);
  }

  .watch-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .watch-poster[data-failed] {
    display: none;
  }

  .watch-plate {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    padding: var(--s-1) var(--s-2);
    background: var(--color-accent-fill);
    font-family: var(--font-data);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--color-on-accent);
  }

  .watch-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .watch-title {
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--color-text);
    font-variation-settings: 'wdth' 92, 'wght' 640;
    margin: 0;
  }

  .watch-channel {
    font-family: var(--font-data);
    font-size: var(--t-label);
    color: var(--color-text-muted);
    margin: 0;
  }

  .watch-why {
    font-size: var(--t-data);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
    margin: 0;
  }
</style>

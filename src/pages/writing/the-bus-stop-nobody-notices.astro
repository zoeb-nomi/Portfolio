---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import StatRow from '../../components/StatRow.astro';
import DataTable from '../../components/DataTable.astro';
import PullQuote from '../../components/PullQuote.astro';
import CTASlab from '../../components/CTASlab.astro';
import { meta, cta, home, writingBusStop as wb } from '../../data/copy';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: wb.title,
  description: meta.writingBusStop.description,
  author: { '@type': 'Person', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  url: 'https://www.zoebnomi.com/writing/the-bus-stop-nobody-notices/',
  mainEntityOfPage: 'https://www.zoebnomi.com/writing/the-bus-stop-nobody-notices/',
  datePublished: wb.date,
  dateModified: wb.date,
  about: 'Indian intercity bus industry, Vijayanand Travels, premiumisation, hypothesis-driven investing, Vijayanand Travels video coverage',
  isPartOf: { '@type': 'WebSite', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
};
---

<Base
  title={meta.writingBusStop.title}
  description={meta.writingBusStop.description}
  path="/writing/the-bus-stop-nobody-notices/"
  ogImage="/og/bus-stop.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />

  <section class="masthead">
    <div class="masthead-inner">
      <aside class="margin-col" aria-label="Article kicker">
        <p class="kicker">{wb.kicker}</p>
      </aside>
      <div class="body-col">
        <h1 class="page-h1">{wb.title}</h1>
        <p class="standfirst">{wb.dek}</p>
        <p class="byline tabular">{wb.date} · {wb.readingTime} read</p>
      </div>
    </div>
  </section>

  <Section mark={wb.s1.mark} label={wb.s1.label}>
    {wb.s1.paras.map((p) => <p class="prose">{p}</p>)}
    {wb.photo.enabled && (
      <figure class="photo">
        <img
          src={wb.photo.src}
          alt={wb.photo.alt}
          loading="lazy"
          decoding="async"
          width="1600"
          height="1000"
        />
        <figcaption>{wb.photo.caption} · {wb.photo.credit}</figcaption>
      </figure>
    )}
  </Section>

  <Section mark={wb.s2.mark} label={wb.s2.label}>
    <p class="prose">{wb.s2.intro}</p>
    <div class="stats">
      {wb.s2.stats.map((s) => <StatRow value={s.value} label={s.label} provenance={s.provenance} />)}
    </div>
    {wb.s2.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wb.s3.mark} label={wb.s3.label}>
    {wb.s3.paras.map((p) => <p class="prose">{p}</p>)}
    <figure class="fig">
      <svg viewBox="0 0 380 320" width="100%" role="img" aria-labelledby="fig1-title">
        <title id="fig1-title">Vijayanand Travels after the carve-out</title>
        <line class="fig-axis" x1="10" y1="260" x2="370" y2="260" />

        <rect class="fig-bar" x="20" y="235" width="80" height="25" />
        <text class="fig-margin" x="60" y="199" text-anchor="middle">13.2%</text>
        <text class="fig-value" x="60" y="223" text-anchor="middle">₹75 Cr</text>
        <text class="fig-year" x="60" y="280" text-anchor="middle">FY23</text>
        <text class="fig-note" x="60" y="294" text-anchor="middle">(partial year)</text>

        <rect class="fig-bar" x="150" y="142" width="80" height="118" />
        <text class="fig-margin" x="190" y="106" text-anchor="middle">14.9%</text>
        <text class="fig-value" x="190" y="130" text-anchor="middle">₹351 Cr</text>
        <text class="fig-year" x="190" y="280" text-anchor="middle">FY24</text>

        <rect class="fig-bar fig-bar--accent" x="280" y="90" width="80" height="170" />
        <text class="fig-margin" x="320" y="54" text-anchor="middle">19.5%</text>
        <text class="fig-value" x="320" y="78" text-anchor="middle">₹504 Cr</text>
        <text class="fig-year" x="320" y="280" text-anchor="middle">FY25</text>
      </svg>
      <figcaption>Revenue, ₹ crore, and EBITDA margin · CARE Ratings (Mar 2025), Tracxn</figcaption>
    </figure>
    <div class="quote-gap">
      <PullQuote rule="red">{wb.s3.quote}</PullQuote>
    </div>
  </Section>

  <Section mark={wb.s4.mark} label={wb.s4.label}>
    {wb.s4.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wb.s5.mark} label={wb.s5.label}>
    <div class="textual table-wrap">
      <DataTable caption={wb.s5.table.caption} columns={wb.s5.table.columns} rows={wb.s5.table.rows} />
    </div>
    {wb.s5.paras.map((p) => <p class="prose table-follow">{p}</p>)}
  </Section>

  <Section mark={wb.s6.mark} label={wb.s6.label}>
    <figure class="fig">
      <svg viewBox="0 0 420 365" width="100%" role="img" aria-labelledby="fig2-title">
        <title id="fig2-title">One market, four growth rates</title>
        <line class="fig-axis" x1="180" y1="20" x2="180" y2="354" />

        <text class="hbar-cat" x="10" y="22">ixigo bus revenue, FY26</text>
        <rect class="fig-bar" x="180" y="28" width="170" height="16" />
        <text class="hbar-value" x="356" y="40">+51%</text>

        <text class="hbar-cat" x="10" y="74">Online bus journeys</text>
        <text class="hbar-cat" x="10" y="88">(redBus BusTrack), H2 FY26</text>
        <rect class="fig-bar" x="180" y="94" width="80" height="16" />
        <text class="hbar-value" x="266" y="106">+24%</text>

        <text class="hbar-cat" x="10" y="140">MakeMyTrip bus revenue, Q1 FY27</text>
        <rect class="fig-bar" x="180" y="146" width="53.33" height="16" />
        <text class="hbar-value" x="239.33" y="158">+16%</text>

        <text class="hbar-cat" x="10" y="192">Ashok Leyland M&amp;HCV bus dispatches,</text>
        <text class="hbar-cat" x="10" y="206">Aug 2026</text>
        <rect class="fig-bar" x="180" y="212" width="40" height="16" />
        <text class="hbar-value" x="226" y="224">+12%</text>

        <text class="hbar-cat" x="10" y="258">Whole intercity bus market,</text>
        <text class="hbar-cat" x="10" y="272">forecast CAGR FY23–26 (VIDEC)</text>
        <rect class="fig-bar" x="180" y="278" width="28.33" height="16" />
        <text class="hbar-value" x="214.33" y="290">+8.5%</text>

        <text class="hbar-cat" x="10" y="324">VECV heavy-duty buses, Q1 FY27</text>
        <rect class="fig-bar fig-bar--accent" x="60" y="330" width="120" height="16" />
        <text class="hbar-value" x="54" y="342" text-anchor="end">−36%</text>
      </svg>
      <figcaption>Latest reported growth, year on year · company releases, redBus BusTrack, VIDEC</figcaption>
    </figure>
    {wb.s6.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wb.s7.mark} label={wb.s7.label} note={wb.disclaimer}>
    <p class="prose">{wb.s7.intro}</p>
    <div class="table-gap basket textual">
      <div class="table-wrap basket-table-wrap">
        <DataTable caption={wb.s7.table.caption} columns={wb.s7.table.columns} rows={wb.s7.table.rows} />
      </div>
      <div class="basket-cards">
        <p class="basket-cards-caption">{wb.s7.table.caption}</p>
        <ul class="basket-cards-list">
          {wb.s7.table.rows.map((row) => (
            <li class="basket-card">
              <h3 class="basket-card-heading">{row.label}</h3>
              <dl class="basket-card-fields">
                {row.cells.map((cell, i) => (
                  <div class="basket-card-field">
                    <dt>{wb.s7.table.columns.slice(1)[i]}</dt>
                    <dd class:list={[{ win: cell.win }]}>{cell.text}</dd>
                  </div>
                ))}
              </dl>
            </li>
          ))}
        </ul>
      </div>
    </div>
    {wb.s7.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wb.s8.mark} label={wb.s8.label}>
    {wb.s8.paras.map((p) => <p class="prose">{p}</p>)}
    <p class="prose disclaimer">{wb.disclaimer}</p>
    <p class="prose links-line">
      {wb.sources.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="outbound-click"
            data-umami-event-section="sources"
            data-umami-event-href={link.href}
          >{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <Section mark={wb.watch.mark} label={wb.watch.label}>
    <p class="prose">{wb.watch.intro}</p>
    <div class="watch-grid">
      {wb.watch.items.map((item) => (
        <div
          class="watch-card"
          data-watch-embed
          data-embed-src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}?autoplay=1&rel=0&modestbranding=1`}
          data-embed-title={item.title}
          data-play-label={`Play: ${item.title}`}
        >
          <div class="watch-frame">
            <a
              class="watch-facade"
              href={`https://www.youtube.com/watch?v=${item.youtubeId}`}
              aria-label={`Play: ${item.title}`}
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event="watch-click"
              data-umami-event-video={item.youtubeId}
            >
              <img
                class="watch-poster"
                src={`/img/watch/${item.youtubeId}.jpg`}
                alt=""
                width="1280"
                height="720"
                loading="lazy"
              />
              <span class="watch-plate" aria-hidden="true">PLAY ▶</span>
            </a>
          </div>
          <h3 class="watch-title">{item.title}</h3>
          <p class="watch-channel">{item.channel}</p>
          <p class="watch-why">{item.why}</p>
        </div>
      ))}
    </div>
  </Section>

  <script is:inline>
    for (const card of document.querySelectorAll('[data-watch-embed]')) {
      const anchor = card.querySelector('a.watch-facade');
      const frame = card.querySelector('.watch-frame');
      if (!anchor || !frame) continue;

      const poster = card.querySelector('img.watch-poster');
      if (poster) {
        const markFailed = () => poster.setAttribute('data-failed', '');
        poster.addEventListener('error', markFailed);
        if (poster.complete && poster.naturalWidth === 0) markFailed();
      }

      const button = document.createElement('button');
      button.type = 'button';
      button.className = anchor.className;
      button.setAttribute('aria-label', card.dataset.playLabel || 'Play video');
      for (const attr of anchor.attributes) {
        if (attr.name.startsWith('data-umami-')) button.setAttribute(attr.name, attr.value);
      }
      while (anchor.firstChild) button.appendChild(anchor.firstChild);
      anchor.replaceWith(button);

      button.addEventListener('click', () => {
        try {
          window.umami?.track('watch-play', { video: button.dataset.umamiEventVideo || '' });
        } catch {}
        const iframe = document.createElement('iframe');
        iframe.src = card.dataset.embedSrc || '';
        iframe.title = card.dataset.embedTitle || '';
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('loading', 'lazy');
        button.remove();
        frame.appendChild(iframe);
        iframe.focus();
      });
    }
  </script>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel="More writing →"
    buttonHref="/writing/"
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    border-bottom: 1px solid var(--rule-strong);
  }

  .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .body-col {
    padding: var(--s-9) var(--gutter) var(--s-11) var(--body-inset);
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--ink);
    margin-bottom: var(--s-6);
    max-width: 24ch;
  }

  .standfirst {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 62ch;
    margin-bottom: var(--s-4);
  }

  .byline {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--ink-muted);
  }

  .prose {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose,
  .stats + .prose,
  .table-gap + .prose,
  .table-follow {
    margin-top: var(--s-6);
  }

  .stats {
    margin-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .quote-gap,
  .table-gap {
    margin-top: var(--s-6);
  }

  .disclaimer {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--ink-muted);
    margin-top: var(--s-7);
  }

  .links-line {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
  }

  .links-line a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links-line .sep {
    color: var(--ink-muted);
  }

  /* Inline-SVG data figures (§3, §6): thin marks, direct value labels, no
     axis scale required of the reader. viewBox width is set close to the
     narrowest supported viewport so mobile renders near 1:1 and desktop
     scales up modestly. */
  .fig {
    margin: 0;
  }

  .prose + .fig {
    margin-top: var(--s-6);
  }

  .fig + .prose,
  .fig + .quote-gap {
    margin-top: var(--s-6);
  }

  .fig svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .fig figcaption {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .fig-axis {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .fig-bar {
    fill: var(--ink);
  }

  .fig-bar--accent {
    fill: var(--red-ink);
  }

  .fig-value,
  .hbar-value {
    font-family: var(--font-mono);
    font-weight: 600;
    fill: var(--ink);
  }

  .fig-value {
    font-size: 20px;
  }

  .hbar-value {
    font-size: 15px;
  }

  .fig-margin {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--ink-muted);
  }

  .fig-year {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--ink-body);
  }

  .fig-note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-muted);
  }

  .hbar-cat {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--ink-body);
  }

  @media (max-width: 899px) {
    .masthead-inner {
      grid-template-columns: 1fr;
    }

    .margin-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: var(--s-6) var(--gutter);
    }

    .body-col {
      padding: var(--s-7) var(--gutter);
    }
  }

  /* Left-align text cells in this page's tables, on desktop and beyond.
     Scoped to .textual so DataTable's default (right-aligned, numeric-table)
     behaviour is untouched everywhere else. */
  .textual :global(.data-table td) {
    text-align: left;
  }

  .textual :global(.data-table th[scope='col']) {
    text-align: left;
  }

  /* Table wrapper: lets a wide table scroll within its own box instead of
     pushing the document wider than the viewport. */
  .table-wrap {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
  }

  /* Section's .body-col is a CSS grid item (grid-template-columns: 1fr
     below 900px, sharing its track with .margin-col). A grid item's
     automatic minimum size defaults to its content's min-content width —
     table-wrap's own overflow-x:auto does NOT stop that, because the
     min-size-zero-on-overflow rule only applies to the item that is
     itself the grid item, not to a scrolling descendant. The §5/§7
     DataTables are wide enough to blow that min-content past 360–390px,
     stretching the whole shared column (and margin-col with it) beyond
     the viewport. Overriding min-width to 0 on the body-col that holds
     our table-wrap lets the track size to the available space instead,
     so table-wrap's own overflow-x:auto can actually do its job.
     :global() is required since body-col belongs to Section.astro, not
     this file; :has(.table-wrap) keeps it scoped to columns that hold
     one of THIS page's tables ("table-wrap" is not used elsewhere). */
  :global(.body-col:has(.table-wrap)) {
    min-width: 0;
  }

  @media (max-width: 899px) {
    .textual :global(.data-table th),
    .textual :global(.data-table td) {
      padding-block: 8px;
      padding-inline: 2px;
    }
  }

  /* §7 basket: table on wide viewports, stacked cards below 900px. */
  .basket-cards {
    display: none;
  }

  @media (max-width: 899px) {
    .basket-table-wrap {
      display: none;
    }

    .basket-cards {
      display: block;
    }
  }

  .basket-cards-caption {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-bottom: var(--s-3);
  }

  .basket-cards-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .basket-card {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .basket-card:first-child {
    border-top: 1px solid var(--rule);
  }

  .basket-card-heading {
    font-family: var(--font-body);
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 var(--s-3);
  }

  .basket-card-fields {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .basket-card-field {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-2);
    font-family: var(--font-mono);
  }

  .basket-card-field dt {
    font-size: var(--t-caption);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .basket-card-field dt::after {
    content: ':';
  }

  .basket-card-field dd {
    font-size: var(--t-data);
    color: var(--ink);
    margin: 0;
  }

  .basket-card-field dd.win {
    color: var(--red-ink);
    font-weight: 500;
  }

  /* §1 photo (behind wb.photo.enabled) */
  .photo {
    margin: 0;
  }

  .prose + .photo {
    margin-top: var(--s-6);
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0;
  }

  .photo figcaption {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* §9 watch: lite-embed cards, mirroring VideoEmbed's facade pattern. */
  .watch-grid {
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  @media (min-width: 900px) {
    .watch-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .watch-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .watch-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--paper-raised);
    overflow: hidden;
  }

  .watch-facade {
    position: absolute;
    inset: 0;
    display: block;
    border: 0;
    padding: 0;
    background: transparent;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .watch-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .watch-poster[data-failed] {
    display: none;
  }

  .watch-plate {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    padding: 4px var(--s-2);
    background: var(--red-ink);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    color: var(--on-red);
  }

  .watch-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .watch-title {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }

  .watch-channel {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  .watch-why {
    font-family: var(--font-body);
    font-size: var(--t-caption);
    line-height: 1.5;
    color: var(--ink-body);
    margin: 0;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import PullQuote from '../../components/PullQuote.astro';
import CTASlab from '../../components/CTASlab.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { formatDate } from '../../lib/formatDate';
import { meta, cta, home, writingReflection as wr } from '../../data/copy';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: wr.title,
  description: meta.writingReflection.description,
  author: { '@type': 'Person', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  url: 'https://www.zoebnomi.com/writing/eval-harness-at-my-own-reflection/',
  mainEntityOfPage: 'https://www.zoebnomi.com/writing/eval-harness-at-my-own-reflection/',
  datePublished: wr.date,
  dateModified: wr.date,
  about: 'AI search evaluation, LLM-as-judge validation, self-published claims',
  isPartOf: { '@type': 'WebSite', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  ...(wr.audio && {
    audio: {
      '@type': 'AudioObject',
      contentUrl: 'https://www.zoebnomi.com/audio/eval-harness-at-my-own-reflection.mp3',
      encodingFormat: 'audio/mpeg',
      duration: 'PT5M55S',
      name: 'I pointed an eval harness at my own reflection — narration',
    },
  }),
};
---

<Base
  title={meta.writingReflection.title}
  description={meta.writingReflection.description}
  path="/writing/eval-harness-at-my-own-reflection/"
  ogImage="/og/eval-harness.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />

  <Masthead
    kicker={wr.kicker}
    h1={wr.title}
    standfirst={wr.dek}
    h1Max="24ch"
    narr
  >
    <Fragment slot="byline"><time datetime={wr.date}>{formatDate(wr.date)}</time> · {wr.readingTime} read</Fragment>
    {wr.audio && <AudioPlayer audio={wr.audio} articleId="eval-harness-reflection" />}
  </Masthead>

  <Section mark={wr.s1.mark} label={wr.s1.label} narrId="s1-cue">
    {wr.s1.paras.map((p, i) => <p class="prose" data-narr={`s1-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wr.s2.mark} label={wr.s2.label} narrId="s2-cue">
    {wr.s2.paras.map((p, i) => <p class="prose" data-narr={`s2-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wr.s3.mark} label={wr.s3.label} narrId="s3-cue">
    {wr.s3.paras.map((p, i) => <p class="prose" data-narr={`s3-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wr.s4.mark} label={wr.s4.label} narrId="s4-cue">
    {wr.s4.paras.map((p, i) => <p class="prose" data-narr={`s4-p${i}`}>{p}</p>)}
    <div class="lesson" data-narr="s4-quote">
      <PullQuote rule="red">{wr.s4.lessonQuote}</PullQuote>
    </div>
  </Section>

  <Section mark={wr.s5.mark} label={wr.s5.label} narrId="s5-cue">
    {wr.s5.paras.map((p, i) => <p class="prose" data-narr={`s5-p${i}`}>{p}</p>)}
    <p class="prose links-line">
      {wr.footer.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={wr.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .prose {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose {
    margin-top: var(--s-6);
  }

  .lesson {
    margin-top: var(--s-8);
  }

  .links-line {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
  }

  .links-line a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links-line .sep {
    color: var(--ink-muted);
  }
</style>

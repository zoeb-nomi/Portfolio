---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import CTASlab from '../../components/CTASlab.astro';
import { meta, cta, home, writingTwoLevers as wt } from '../../data/copy';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: wt.title,
  description: meta.writingTwoLevers.description,
  author: { '@type': 'Person', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  url: 'https://www.zoebnomi.com/writing/two-levers-that-did-not-move/',
  mainEntityOfPage: 'https://www.zoebnomi.com/writing/two-levers-that-did-not-move/',
  datePublished: wt.date,
  dateModified: wt.date,
  about: 'LLM résumé screening, paired evaluation design, screener noise',
  isPartOf: { '@type': 'WebSite', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
};
---

<Base
  title={meta.writingTwoLevers.title}
  description={meta.writingTwoLevers.description}
  path="/writing/two-levers-that-did-not-move/"
  ogImage="/og/screener-eval.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />

  <section class="masthead">
    <div class="masthead-inner">
      <aside class="margin-col" aria-label="Article kicker">
        <p class="kicker">{wt.kicker}</p>
      </aside>
      <div class="body-col">
        <h1 class="page-h1">{wt.title}</h1>
        <p class="standfirst">{wt.dek}</p>
        <p class="byline tabular">{wt.date} · {wt.readingTime} read</p>
      </div>
    </div>
  </section>

  <Section mark={wt.s1.mark} label={wt.s1.label}>
    {wt.s1.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wt.s2.mark} label={wt.s2.label}>
    {wt.s2.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wt.s3.mark} label={wt.s3.label}>
    {wt.s3.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wt.s4.mark} label={wt.s4.label}>
    {wt.s4.paras.map((p) => <p class="prose">{p}</p>)}
  </Section>

  <Section mark={wt.s5.mark} label={wt.s5.label}>
    {wt.s5.paras.map((p) => <p class="prose">{p}</p>)}
    <p class="prose links-line">
      {wt.footer.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={wt.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    border-bottom: 1px solid var(--rule-strong);
  }

  .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .body-col {
    padding: var(--s-9) var(--gutter) var(--s-11) var(--body-inset);
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--ink);
    margin-bottom: var(--s-6);
    max-width: 24ch;
  }

  .standfirst {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 62ch;
    margin-bottom: var(--s-4);
  }

  .byline {
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--ink-muted);
  }

  .prose {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose {
    margin-top: var(--s-6);
  }

  .links-line {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
  }

  .links-line a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links-line .sep {
    color: var(--ink-muted);
  }

  @media (max-width: 899px) {
    .masthead-inner {
      grid-template-columns: 1fr;
    }

    .margin-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: var(--s-6) var(--gutter);
    }

    .body-col {
      padding: var(--s-7) var(--gutter);
    }
  }
</style>

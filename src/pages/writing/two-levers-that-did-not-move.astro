---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import EssayFigure from '../../components/EssayFigure.astro';
import ForestPlot from '../../components/ForestPlot.astro';
import UnitChart from '../../components/UnitChart.astro';
import ParserCompare from '../../components/ParserCompare.astro';
import CTASlab from '../../components/CTASlab.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { articleJsonLd } from '../../lib/articleJsonLd';
import { formatDate } from '../../lib/formatDate';
import { isExternal } from '../../lib/isExternal';
import { meta, cta, home, writingTwoLevers as wt } from '../../data/copy';
import { jsonLdString } from '../../lib/jsonLdString';
import { forestData, flipData, parserData } from '../../lib/figureData';

const forest = forestData();
const flips = flipData();
const parsers = parserData();

const articleLd = articleJsonLd({
  slug: 'two-levers-that-did-not-move',
  headline: wt.title,
  description: meta.writingTwoLevers.description,
  date: wt.date,
  about: 'LLM résumé screening, paired evaluation design, screener noise',
  audio: wt.audio && { src: wt.audio.src, duration: wt.audio.duration },
});
---

<Base
  title={meta.writingTwoLevers.title}
  description={meta.writingTwoLevers.description}
  path="/writing/two-levers-that-did-not-move/"
  ogImage="/og/two-levers.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={jsonLdString(articleLd)} is:inline />

  <Masthead
    kicker={wt.kicker}
    h1={wt.title}
    standfirst={wt.dek}
    h1Max="24ch"
    narr
  >
    <Fragment slot="byline"><time datetime={wt.date}>{formatDate(wt.date)}</time> · {wt.readingTime} read</Fragment>
    {wt.audio && <AudioPlayer audio={wt.audio} articleId="two-levers" />}
  </Masthead>

  <Section mark={wt.s1.mark} label={wt.s1.label} narrId="s1-cue">
    {wt.s1.paras.map((p, i) => <p class="prose" data-narr={`s1-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wt.s2.mark} label={wt.s2.label} narrId="s2-cue">
    {wt.s2.paras.map((p, i) => <p class="prose" data-narr={`s2-p${i}`}>{p}</p>)}
    <EssayFigure n={1} replay title="Two levers against one screener" source="Source: screener-eval Table 1 (mean paired change in fit score, with a 95% bootstrap interval) and its between-screeners paragraph. 21 postings, 5 reps." href="/screener-eval/" hrefLabel="Case study →">
      <ForestPlot {...forest} />
    </EssayFigure>
  </Section>

  <Section mark={wt.s3.mark} label={wt.s3.label} narrId="s3-cue">
    {wt.s3.paras.map((p, i) => <p class="prose" data-narr={`s3-p${i}`}>{p}</p>)}
    <EssayFigure n={2} replay title="Same résumé, same posting, two screeners" source="Source: screener-eval Table 2 and its between-screeners paragraph. 21 postings, 5 reps each." href="/screener-eval/" hrefLabel="Case study →">
      <UnitChart rows={flips.rows} cols={flips.cols} filledMeans="postings where it happened" emptyMeans="postings where it did not" />
    </EssayFigure>
  </Section>

  <Section mark={wt.s4.mark} label={wt.s4.label} narrId="s4-cue">
    {wt.s4.paras.map((p, i) => <p class="prose" data-narr={`s4-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wt.s5.mark} label={wt.s5.label} narrId="s5-cue">
    {
      wt.s5.paras.map((p, i) => (
        <>
          <p class="prose" data-narr={`s5-p${i}`}>{p}</p>
          {i === 0 && (
            <EssayFigure n={3} replay title="Fields each parser read from the résumé" source="Source: screener-eval Table 3. Squares are grouped by outcome, not by field order. The three plain extractors had identical results." href="/screener-eval/" hrefLabel="Case study →">
              <ParserCompare rows={parsers.rows} />
            </EssayFigure>
          )}
        </>
      ))
    }
    <p class="prose links-line">
      {wt.footer.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a href={link.href} target={isExternal(link.href) ? '_blank' : undefined} rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}>{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={wt.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
</style>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import CTASlab from '../../components/CTASlab.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { formatDate } from '../../lib/formatDate';
import { meta, cta, home, writingTwoLevers as wt } from '../../data/copy';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: wt.title,
  description: meta.writingTwoLevers.description,
  author: { '@type': 'Person', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  url: 'https://www.zoebnomi.com/writing/two-levers-that-did-not-move/',
  mainEntityOfPage: 'https://www.zoebnomi.com/writing/two-levers-that-did-not-move/',
  datePublished: wt.date,
  dateModified: wt.date,
  about: 'LLM résumé screening, paired evaluation design, screener noise',
  isPartOf: { '@type': 'WebSite', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  ...(wt.audio && {
    audio: {
      '@type': 'AudioObject',
      contentUrl: 'https://www.zoebnomi.com/audio/two-levers-that-did-not-move.mp3',
      encodingFormat: 'audio/mpeg',
      duration: 'PT3M52S',
      name: '885 screenings, one résumé, and the two levers that did not move — narration',
    },
  }),
};
---

<Base
  title={meta.writingTwoLevers.title}
  description={meta.writingTwoLevers.description}
  path="/writing/two-levers-that-did-not-move/"
  ogImage="/og/two-levers.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />

  <Masthead
    kicker={wt.kicker}
    h1={wt.title}
    standfirst={wt.dek}
    h1Max="24ch"
    narr
  >
    <Fragment slot="byline"><time datetime={wt.date}>{formatDate(wt.date)}</time> · {wt.readingTime} read</Fragment>
    {wt.audio && <AudioPlayer audio={wt.audio} articleId="two-levers" />}
  </Masthead>

  <Section mark={wt.s1.mark} label={wt.s1.label} narrId="s1-cue">
    {wt.s1.paras.map((p, i) => <p class="prose" data-narr={`s1-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wt.s2.mark} label={wt.s2.label} narrId="s2-cue">
    {wt.s2.paras.map((p, i) => <p class="prose" data-narr={`s2-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wt.s3.mark} label={wt.s3.label} narrId="s3-cue">
    {wt.s3.paras.map((p, i) => <p class="prose" data-narr={`s3-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wt.s4.mark} label={wt.s4.label} narrId="s4-cue">
    {wt.s4.paras.map((p, i) => <p class="prose" data-narr={`s4-p${i}`}>{p}</p>)}
  </Section>

  <Section mark={wt.s5.mark} label={wt.s5.label} narrId="s5-cue">
    {wt.s5.paras.map((p, i) => <p class="prose" data-narr={`s5-p${i}`}>{p}</p>)}
    <p class="prose links-line">
      {wt.footer.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={wt.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .prose {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose {
    margin-top: var(--s-6);
  }

  .links-line {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
  }

  .links-line a {
    /* WCAG 2.5.8: a standalone link needs a 24px hit area. */
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .links-line .sep {
    color: var(--ink-muted);
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Section from '../../components/Section.astro';
import DataTable from '../../components/DataTable.astro';
import EssayFigure from '../../components/EssayFigure.astro';
import OwnershipGap from '../../components/OwnershipGap.astro';
import BarList from '../../components/BarList.astro';
import UnitChart from '../../components/UnitChart.astro';
import { formatDate } from '../../lib/formatDate';
import { meta, writingMisses as wm } from '../../data/copy';

const url = 'https://www.zoebnomi.com/writing/nobody-reports-the-misses/';
const f = wm.figures;
const summaryRows = f.summary.rows.map((r) => ({ label: r.label, cells: r.cells.map((text) => ({ text })) }));

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: wm.title,
  description: meta.writingMisses.description,
  author: { '@type': 'Person', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
  url,
  mainEntityOfPage: url,
  datePublished: wm.date,
  dateModified: wm.date,
  about: 'Counting missed items (false passes) in AI systems used for regulated work',
  isPartOf: { '@type': 'WebSite', name: 'Zoeb Nomi', url: 'https://www.zoebnomi.com' },
};
---

<Base
  title={meta.writingMisses.title}
  description={meta.writingMisses.description}
  path="/writing/nobody-reports-the-misses/"
  ogImage="/og/misses.png"
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />

  <Masthead kicker={wm.kicker} h1={wm.title} standfirst={wm.dek} h1Max="24ch" narr>
    <Fragment slot="byline"><time datetime={wm.date}>{formatDate(wm.date)}</time> · {wm.readingTime} read</Fragment>
    <div class="intro">
      {wm.intro.map((p, i) => <p class="prose" data-narr={`s0-p${i}`}>{p}</p>)}
    </div>
    <EssayFigure n={f.gap.n} title={f.gap.title} source={f.gap.source}>
      <OwnershipGap nodes={f.gap.nodes} />
    </EssayFigure>
  </Masthead>

  {
    wm.sections.map((s, i) => (
      <Section mark={s.mark} label={s.label} anchorId={s.id} narrId={`s${i + 1}-cue`}>
        {s.paras.map((p, j) => (
          <>
            <p class="prose" data-narr={`s${i + 1}-p${j}`}>
              {p}
            </p>
            {s.after?.[j] === 'crosssource' && (
              <EssayFigure n={f.crosssource.n} title={f.crosssource.title} source={f.crosssource.source} href={f.crosssource.href} hrefLabel={f.crosssource.hrefLabel}>
                <BarList heading={f.crosssource.scores.heading} max={f.crosssource.scores.max} rows={f.crosssource.scores.rows} />
                <BarList heading={f.crosssource.failures.heading} max={f.crosssource.failures.max} rows={f.crosssource.failures.rows} />
              </EssayFigure>
            )}
            {s.after?.[j] === 'judges' && (
              <EssayFigure n={f.judges.n} title={f.judges.title} source={f.judges.source} href={f.judges.href} hrefLabel={f.judges.hrefLabel}>
                <UnitChart rows={f.judges.rows} cols={f.judges.cols} filledMeans={f.judges.filledMeans} emptyMeans={f.judges.emptyMeans} />
              </EssayFigure>
            )}
            {s.after?.[j] === 'flips' && (
              <EssayFigure n={f.flips.n} title={f.flips.title} source={f.flips.source} href={f.flips.href} hrefLabel={f.flips.hrefLabel}>
                <UnitChart rows={f.flips.rows} cols={f.flips.cols} filledMeans={f.flips.filledMeans} emptyMeans={f.flips.emptyMeans} />
              </EssayFigure>
            )}
            {s.after?.[j] === 'summary' && (
              <div class="summary">
                <div class="summary-table">
                  <DataTable caption={f.summary.caption} columns={f.summary.columns} rows={summaryRows} />
                </div>
                <div class="summary-cards">
                  <p class="summary-cap">{f.summary.caption}</p>
                  <ul class="summary-list">
                    {f.summary.rows.map((r) => (
                      <li class="summary-card">
                        <p class="summary-kind">{r.label}</p>
                        <dl class="summary-fields">
                          {r.cells.map((c, k) => (
                            <div class="summary-field">
                              <dt>{f.summary.columns[k + 1]}</dt>
                              <dd>{c}</dd>
                            </div>
                          ))}
                        </dl>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </>
        ))}
      </Section>
    ))
  }
</Base>

<style>
  .prose {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose {
    margin-top: var(--s-6);
  }

  .intro {
    margin-top: var(--s-8);
  }

  /* A figure or table that follows a paragraph needs the same gap a paragraph
     would get. The figure supplies its own margin; the table wrapper does here. */
  .summary {
    margin-top: var(--s-8);
    max-width: 68ch;
  }

  /* Table 1 is text, not numbers: left-align it (DataTable defaults to the
     right-aligned numeric look). Scoped to this page's wrapper. */
  .summary :global(.data-table th),
  .summary :global(.data-table td) {
    text-align: left;
  }

  /* Wide screens: the table. Below 900px: one labelled card per row, so no
     sideways scrolling for prose. */
  .summary-cards {
    display: none;
  }

  @media (max-width: 899px) {
    .summary-table {
      display: none;
    }

    .summary-cards {
      display: block;
    }
  }

  .summary-cap {
    padding-bottom: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .summary-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .summary-card {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .summary-card:first-child {
    border-top: 1px solid var(--rule);
  }

  .summary-kind {
    margin-bottom: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink);
  }

  .summary-fields {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .summary-field {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    font-family: var(--font-mono);
  }

  .summary-field dt {
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .summary-field dd {
    margin: 0;
    font-size: var(--t-data);
    color: var(--ink);
  }

  /* Deep links (#kyb, #sox, ...): below 900px the header scrolls away, so keep
     the section band's own top padding in view; from 900px it is sticky, so
     leave room for it plus the section's top rule. Scoped to this page;
     headings without an id are untouched. */
  :global(.mark-label[id]) {
    scroll-margin-top: var(--s-6);
  }

  @media (min-width: 900px) {
    :global(.mark-label[id]) {
      scroll-margin-top: calc(var(--s-9) + var(--s-11));
    }
  }
</style>

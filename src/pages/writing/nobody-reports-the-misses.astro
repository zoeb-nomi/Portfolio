---
import Base from '../../layouts/Base.astro';
import EssayShell from '../../components/EssayShell.astro';
import EssayHeading from '../../components/EssayHeading.astro';
import TextTable from '../../components/TextTable.astro';
import EssayFigure from '../../components/EssayFigure.astro';
import OwnershipGap from '../../components/OwnershipGap.astro';
import BarList from '../../components/BarList.astro';
import UnitChart from '../../components/UnitChart.astro';
import { articleJsonLd } from '../../lib/articleJsonLd';
import CTASlab from '../../components/CTASlab.astro';
import { meta, writingMisses as wm, home, cta } from '../../data/copy';
import { jsonLdString } from '../../lib/jsonLdString';

const f = wm.figures;
// Missing authority is the dominant failure: its bar is the one red row.
const failureRows = f.crosssource.failures.rows.map((r, i) => ({ ...r, tone: i === 0 ? ('red' as const) : ('ink' as const) }));

const articleLd = articleJsonLd({
  slug: 'nobody-reports-the-misses',
  headline: wm.title,
  description: meta.writingMisses.description,
  date: wm.date,
  about: 'Counting missed items (false passes) in AI systems used for regulated work',
  audio: { src: wm.audio.src, duration: wm.audio.duration, captions: wm.audio.captions },
});
---

<Base
  title={meta.writingMisses.title}
  description={meta.writingMisses.description}
  path="/writing/nobody-reports-the-misses/"
  ogImage="/og/misses.png"
  ogType="article"
  page="writing"
>
  <script type="application/ld+json" set:html={jsonLdString(articleLd)} is:inline />

  <EssayShell
    slug="nobody-reports-the-misses"
    kicker={wm.kicker}
    title={wm.title}
    dek={wm.dek}
    date={wm.date}
    readingTime={wm.readingTime}
    audio={wm.audio}
    articleId="misses"
  >
    <p slot="head" class="wr-sub">
      The text below follows the audio as it plays. <a href={wm.audio.captions} download>Captions (WebVTT)</a>
    </p>

    {wm.intro.map((p, i) => <p data-narr={`s0-p${i}`}>{p}</p>)}
    <EssayFigure n={f.gap.n} title={f.gap.title} source={f.gap.source}>
      <OwnershipGap nodes={f.gap.nodes} />
    </EssayFigure>

    {
      wm.sections.map((s, i) => (
        <>
          <EssayHeading mark={s.mark} label={s.label} anchorId={s.id} narrId={`s${i + 1}-cue`} />
          {s.paras.map((p, j) => (
            <>
              {p.startsWith('A rule for autonomy.') ? (
                <blockquote data-narr={`s${i + 1}-p${j}`}>{p}</blockquote>
              ) : (
                <p data-narr={`s${i + 1}-p${j}`}>{p}</p>
              )}
              {s.after?.[j] === 'crosssource' && (
                <EssayFigure n={f.crosssource.n} title={f.crosssource.title} source={f.crosssource.source} href={f.crosssource.href} hrefLabel={f.crosssource.hrefLabel}>
                  <BarList heading={f.crosssource.scores.heading} max={f.crosssource.scores.max} rows={f.crosssource.scores.rows} />
                  <BarList heading={f.crosssource.failures.heading} max={f.crosssource.failures.max} rows={failureRows} />
                </EssayFigure>
              )}
              {s.after?.[j] === 'judges' && (
                <EssayFigure n={f.judges.n} title={f.judges.title} source={f.judges.source} href={f.judges.href} hrefLabel={f.judges.hrefLabel}>
                  <UnitChart rows={f.judges.rows} cols={f.judges.cols} filledMeans={f.judges.filledMeans} emptyMeans={f.judges.emptyMeans} />
                </EssayFigure>
              )}
              {s.after?.[j] === 'flips' && (
                <EssayFigure n={f.flips.n} title={f.flips.title} source={f.flips.source} href={f.flips.href} hrefLabel={f.flips.hrefLabel}>
                  <UnitChart rows={f.flips.rows} cols={f.flips.cols} filledMeans={f.flips.filledMeans} emptyMeans={f.flips.emptyMeans} emptyTone="red" />
                </EssayFigure>
              )}
              {s.after?.[j] === 'summary' && (
                <TextTable caption={f.summary.caption} columns={f.summary.columns} rows={f.summary.rows} wide />
              )}
            </>
          ))}
        </>
      ))
    }
  </EssayShell>

  <CTASlab
    marginLines={[home.ctaSlabMarginNow, home.ctaSlabMarginBefore]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

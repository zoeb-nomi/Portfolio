  .dz-checks li{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:10px;align-items:baseline;padding:11px 0;border-bottom:var(--line-hair);font:400 12.5px/1.4 var(--font-data);color:var(--color-text-body)}
  .dz-checks .vk{font-weight:500;color:var(--color-text-muted)}
  .dz-checks li.ok .vk{color:var(--color-text)}

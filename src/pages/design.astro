  .dz-ver .idea b{font-weight:normal;color:var(--color-text);font-variation-settings:"wght" 620}
  .dz-ver .src{display:block;max-width:72ch;margin-top:10px;font:400 11px/1.5 var(--font-data);color:var(--color-text-muted)}
  .dz-ver .links{display:flex;flex-wrap:wrap;gap:4px 20px;margin-top:10px}
  .dz-ver.now .no::after{content:attr(data-now);margin-left:10px;padding:3px 6px;border:var(--line-accent);color:var(--color-accent);letter-spacing:.12em}
  .dz-spc{border:var(--line-strong);background:var(--sp-bg);color:var(--sp-ink);padding:18px 18px 14px;min-width:0}
  .dz-spc .sp-h{font-family:var(--sp-face);font-size:30px;line-height:1.02;letter-spacing:-.02em;font-variation-settings:var(--sp-fvs,normal);font-weight:var(--sp-wt,400)}
  .dz-spc .sp-h u{text-decoration:none;box-shadow:inset 0 -.08em 0 var(--sp-red)}
  .dz-spc .sp-b{margin-top:8px;font-family:var(--sp-body);font-size:var(--t-data);line-height:var(--lh-snug);color:var(--sp-ink2)}
  .dz-spc .sp-sw{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:6px;margin-top:14px}
  .dz-spc .sp-sw i{height:22px;border-width:1px;border-style:solid;border-color:var(--sp-rule)}
  .dz-spc .sp-k{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:6px;margin-top:6px;font:400 var(--t-label)/1.3 "IBM Plex Mono",monospace;color:var(--sp-ink2)}
  @media (max-width:1099px){.dz-ver{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.dz-ver .dz-spc{grid-column:1 / -1}}
  .dz-ver .dz-spc{max-width:520px}
  @media (max-width:599px){.dz-ver{grid-template-columns:minmax(0,1fr)}}
  /* hover demo (replaces the retired magnet) */
  .dz-hrow{position:relative;isolation:isolate;width:80%;display:flex;justify-content:space-between;align-items:baseline;padding:14px 0;border-top:var(--line-strong);border-bottom:var(--line-strong);font-size:22px;letter-spacing:-.02em;font-variation-settings:"wdth" 86,"wght" 720}
  .dz-hrow::before{content:"";position:absolute;inset:0 -12px;background:var(--color-surface-raised);transform:scaleY(0);transform-origin:bottom;transition:transform .6s var(--ease-out);z-index:-1}
  .dz-hrow::after{content:"";position:absolute;left:-12px;top:0;bottom:0;width:2px;background:var(--color-accent);transform:scaleY(0);transform-origin:top;transition:transform .6s var(--ease-out) .05s}
  .dz-hrow .ba{font-family:var(--font-data);font-size:14px;color:var(--color-accent);transition:transform .5s var(--ease-out)}
  .dz-hrow.on::before{transform:scaleY(1);transform-origin:top}.dz-hrow.on::after{transform:scaleY(1)}.dz-hrow.on .ba{transform:translateX(6px)}
  @media (prefers-reduced-motion: reduce){.dz-swb:hover{transform:none}}


  .dz-curve path{fill:none}
  .dz-axis{stroke:var(--color-line-strong);stroke-width:1}
  .dz-cv{stroke:var(--color-accent);stroke-width:2}
  .dz-cdot{fill:var(--color-accent)}
  .dz-cline{stroke:var(--color-text-muted);stroke-width:1;stroke-dasharray:2 3}
  .dz-file{font-family:var(--font-data);font-size:var(--t-data);color:var(--color-text);white-space:nowrap;vertical-align:top}
  .dz-sub a{margin-left:6px}
  .tbl td.n+td:not(.n),.tbl th.n+th:not(.n){padding-left:28px}
</style>

<script>
  /* The design page: swatches read live token values, the axis pad drives Archivo's two axes, the
     ladder reports computed sizes, the motion demos loop only while on screen, and the copy check
     lints what you type. Without script the page is complete and static. */
  import { $, $$, motion, swap, revealNumber } from '../scripts/ds';
  import { gsap } from '../scripts/gsap';

  const d = document;
  const w = window;

  /* ---------- swatches: read live values, click to copy ---------- */
  const toast = $<HTMLElement>('#dz-copied')!;
  let toastT = 0;
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.classList.add('on');
    clearTimeout(toastT);
    toastT = window.setTimeout(() => toast.classList.remove('on'), 1400);
  };
  const toHex = (c: string) => {
    const m = c.match(/^rgba?\(([^)]+)\)$/);
    if (!m) return c;
    const p = m[1].split(',').map((x) => x.trim());
    if (p.length === 4 && +p[3] < 1) return c.replace(/\s+/g, '');
    return '#' + p.slice(0, 3).map((x) => (+x).toString(16).padStart(2, '0')).join('');
  };
  const readSwatches = () => {
    const rs = getComputedStyle(d.documentElement);
    $$<HTMLElement>('.dz-swb').forEach((b) => {
      const tok = b.dataset.tok!;
      const val = rs.getPropertyValue(tok).trim();
      if (!val) return;
      const probe = d.createElement('span');
      probe.style.color = `var(${tok})`;
      d.body.appendChild(probe);
      const c = getComputedStyle(probe).color;
      probe.remove();
      $('.h', b)!.textContent = toHex(c);
    });
  };
  readSwatches();
  w.addEventListener('ds:theme', readSwatches);
  const fallback = (text: string, ok0: string) => {
    const ta = d.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    d.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = d.execCommand('copy');
    } catch {
      ok = false;
    }
    ta.remove();
    say(ok ? `${ok0} ${text}` : text);
  };
  $$<HTMLElement>('.dz-swb').forEach((b) => {
    b.addEventListener('click', () => {
      const text = `var(${b.dataset.tok})`;
      const label = toast.dataset.copied ?? '';
      try {
        if (navigator.clipboard?.writeText) navigator.clipboard.writeText(text).then(() => say(`${label} ${text}`), () => fallback(text, label));
        else fallback(text, label);
      } catch {
        fallback(text, label);
      }
    });
  });

  /* ---------- axis pad ---------- */
  const word = $<HTMLElement>('#dz-word')!;
  const pad = $<HTMLElement>('#dz-pad')!;
  const knob = $<HTMLElement>('.dz-knob', pad)!;
  const hx = $<HTMLElement>('.dz-hx', pad)!;
  const hy = $<HTMLElement>('.dz-hy', pad)!;
  const rw = $<HTMLElement>('#dz-rw')!;
  const rg = $<HTMLElement>('#dz-rg')!;
  const fvs = $<HTMLElement>('#dz-fvs')!;
  const inW = $<HTMLInputElement>('#dz-w')!;
  const inG = $<HTMLInputElement>('#dz-g')!;
  const presets = $$<HTMLElement>('.dz-presets .chip');
  const W0 = 62;
  const W1 = 125;
  const G0 = 100;
  const G1 = 900;
  const st = { w: 100, g: 620 };
  let touched = false;
  let idleTw: gsap.core.Timeline | null = null;

  const render = () => {
    const wv = Math.round(st.w);
    const gv = Math.round(st.g);
    word.style.setProperty('--aw', st.w.toFixed(2));
    word.style.setProperty('--ag', st.g.toFixed(1));
    const x = (st.w - W0) / (W1 - W0);
    const y = 1 - (st.g - G0) / (G1 - G0);
    const r = pad.getBoundingClientRect();
    const px = x * r.width;
    const py = y * r.height;
    knob.style.transform = `translate3d(${px.toFixed(1)}px,${py.toFixed(1)}px,0)`;
    hx.style.transform = `translate3d(0,${py.toFixed(1)}px,0)`;
    hy.style.transform = `translate3d(${px.toFixed(1)}px,0,0)`;
    swap(rw, wv);
    swap(rg, gv);
    fvs.textContent = `"wdth" ${wv}, "wght" ${gv}`;
    if (+inW.value !== wv) inW.value = String(wv);
    if (+inG.value !== gv) inG.value = String(gv);
    presets.forEach((p) => p.setAttribute('aria-pressed', String(+p.dataset.w! === wv && +p.dataset.g! === gv)));
  };
  const stopIdle = () => {
    touched = true;
    if (idleTw) {
      idleTw.kill();
      idleTw = null;
    }
  };
  const goTo = (tw: number, tg: number, dur = 0.9) => {
    if (!motion()) {
      st.w = tw;
      st.g = tg;
      render();
      return;
    }
    gsap.to(st, { w: tw, g: tg, duration: dur, ease: 'expo.out', overwrite: true, onUpdate: render });
  };
  const fromPointer = (e: PointerEvent) => {
    const r = pad.getBoundingClientRect();
    const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    return { w: W0 + x * (W1 - W0), g: G0 + (1 - y) * (G1 - G0) };
  };
  let dragging = false;
  pad.addEventListener('pointerdown', (e) => {
    stopIdle();
    dragging = true;
    pad.setPointerCapture(e.pointerId);
    const v = fromPointer(e);
    goTo(v.w, v.g, 0.55);
  });
  pad.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const v = fromPointer(e);
    if (motion()) gsap.to(st, { w: v.w, g: v.g, duration: 0.35, ease: 'power3.out', overwrite: true, onUpdate: render });
    else {
      st.w = v.w;
      st.g = v.g;
      render();
    }
  });
  ['pointerup', 'pointercancel'].forEach((ev) => pad.addEventListener(ev, () => (dragging = false)));
  pad.addEventListener('keydown', (e) => {
    const sw = e.shiftKey ? 10 : 2;
    const sg = e.shiftKey ? 100 : 20;
    let tw = st.w;
    let tg = st.g;
    if (e.key === 'ArrowLeft') tw -= sw;
    else if (e.key === 'ArrowRight') tw += sw;
    else if (e.key === 'ArrowUp') tg += sg;
    else if (e.key === 'ArrowDown') tg -= sg;
    else return;
    e.preventDefault();
    stopIdle();
    goTo(Math.min(W1, Math.max(W0, tw)), Math.min(G1, Math.max(G0, tg)), 0.35);
  });
  inW.addEventListener('input', () => {
    stopIdle();
    goTo(+inW.value, st.g, 0.3);
  });
  inG.addEventListener('input', () => {
    stopIdle();
    goTo(st.w, +inG.value, 0.3);
  });
  presets.forEach((p) =>
    p.addEventListener('click', () => {
      stopIdle();
      goTo(+p.dataset.w!, +p.dataset.g!, 1.1);
    }),
  );
  w.addEventListener('resize', render);
  render();

  /* A slow drift through both axes until someone touches the controls. */
  const idle = () => {
    if (touched || !motion() || idleTw) return;
    const path = [{ w: 62, g: 200 }, { w: 125, g: 900 }, { w: 88, g: 800 }, { w: 100, g: 620 }];
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.6, onUpdate: render });
    path.forEach((p) => {
      tl.to(st, { w: p.w, g: p.g, duration: 1.8, ease: 'sine.inOut' });
      tl.to({}, { duration: 0.5 });
    });
    idleTw = tl;
  };
  if (motion() && 'IntersectionObserver' in w) {
    new IntersectionObserver(
      (es) =>
        es.forEach((en) => {
          if (en.isIntersecting) {
            if (idleTw) idleTw.resume();
            else idle();
          } else if (idleTw) idleTw.pause();
        }),
      { threshold: 0.25 },
    ).observe($('#dz-spec')!);
  }

  /* ---------- type ladder: live computed sizes ---------- */
  const sizes = () => {
    $$<HTMLElement>('#dz-ladder li').forEach((li) => {
      const sample = li.firstElementChild as HTMLElement;
      const el = sample.classList.contains('ro') ? $<HTMLElement>('.v', sample)! : sample;
      const s = $<HTMLElement>('[data-size]', li);
      if (s) s.textContent = `${Math.round(parseFloat(getComputedStyle(el).fontSize))}px at this width`;
    });
  };
  sizes();
  let sT = 0;
  w.addEventListener('resize', () => {
    clearTimeout(sT);
    sT = window.setTimeout(sizes, 150);
  });

  /* ---------- chip demo toggles ---------- */
  const cd = $<HTMLElement>('#dz-chipdemo')!;
  cd.addEventListener('click', () => cd.setAttribute('aria-pressed', String(cd.getAttribute('aria-pressed') !== 'true')));

  /* ---------- motion demos: loop only while visible ---------- */
  const demo = (stage: HTMLElement) => {
    const kind = stage.dataset.demo;
    let tl: gsap.core.Timeline | undefined;
    if (kind === 'reveal') {
      const rv = $<HTMLElement>('.dz-rv', stage)!;
      tl = gsap.timeline({ repeat: -1, repeatDelay: 0.9 });
      tl.set(rv, { autoAlpha: 0, y: 10 }).to(rv, { autoAlpha: 1, y: 0, duration: 1.1, ease: 'power2.out' }).to(rv, { autoAlpha: 0, duration: 0.4, delay: 1.4, ease: 'power1.in' });
    } else if (kind === 'number') {
      const n = $<HTMLElement>('.dz-num', stage)!;
      const o = { t: 0 };
      tl = gsap.timeline({ repeat: -1, repeatDelay: 1.2 });
      tl.set(n, { autoAlpha: 1 }).set(o, { t: 0 }).to(o, { t: 1, duration: 1.1, ease: 'none', onUpdate: () => revealNumber(n, o.t) }).to(n, { autoAlpha: 0, duration: 0.3, delay: 1.2, ease: 'power2.in' });
    } else if (kind === 'swap') {
      const k = $<HTMLElement>('.dz-swk', stage)!;
      const v = $<HTMLElement>('.dz-swv', stage)!;
      const vals = [['baseline', '0.981'], ['strict', '0.994']];
      let i = 0;
      tl = gsap.timeline({ repeat: -1 });
      tl.call(() => {
        i = 1 - i;
        swap(k, vals[i][0]);
        swap(v, vals[i][1]);
      }).to({}, { duration: 1.6 });
    } else if (kind === 'draw') {
      const u = $<HTMLElement>('.w i', stage)!;
      const b = $<HTMLElement>('.bar i', stage)!;
      tl = gsap.timeline({ repeat: -1, repeatDelay: 0.9 });
      tl.set([u, b], { scaleX: 0, transformOrigin: 'left' })
        .to(u, { scaleX: 1, duration: 0.8, ease: 'expo.out' })
        .to(b, { scaleX: 1, duration: 0.8, ease: 'expo.inOut' }, '-=.4')
        .set([u, b], { transformOrigin: 'right' }, '+=1')
        .to([u, b], { scaleX: 0, duration: 0.3, ease: 'power2.in' });
    } else if (kind === 'hover') {
      const row = $<HTMLElement>('.dz-hrow', stage)!;
      tl = gsap.timeline({ repeat: -1 });
      tl.call(() => row.classList.add('on')).to({}, { duration: 1.6 }).call(() => row.classList.remove('on')).to({}, { duration: 1.2 });
    } else if (kind === 'curve') {
      const dot = $('.dz-cdot', stage)!;
      const ln = $('.dz-cline', stage)!;
      const p = { t: 0 };
      // cubic-bezier(.16,1,.3,1) solved for y at x = t
      const ease = (t: number) => {
        let lo = 0;
        let hi = 1;
        let m = 0.5;
        for (let j = 0; j < 22; j++) {
          m = (lo + hi) / 2;
          const x = 3 * (1 - m) * (1 - m) * m * 0.16 + 3 * (1 - m) * m * m * 0.3 + m * m * m;
          if (x < t) lo = m;
          else hi = m;
        }
        m = (lo + hi) / 2;
        return 3 * (1 - m) * (1 - m) * m + 3 * (1 - m) * m * m + m * m * m;
      };
      tl = gsap.timeline({ repeat: -1, repeatDelay: 0.8 });
      tl.set(p, { t: 0 }).to(p, {
        t: 1,
        duration: 0.8,
        ease: 'none',
        onUpdate: () => {
          const x = 20 + p.t * 260;
          const y = 135 - ease(p.t) * 120;
          dot.setAttribute('cx', x.toFixed(1));
          dot.setAttribute('cy', y.toFixed(1));
          ln.setAttribute('x1', x.toFixed(1));
          ln.setAttribute('x2', x.toFixed(1));
          ln.setAttribute('y2', y.toFixed(1));
        },
      }).to({}, { duration: 0.9 });
    }
    return tl;
  };
  if (motion() && 'IntersectionObserver' in w) {
    $$<HTMLElement>('.dz-stage[data-demo]').forEach((stage) => {
      let tl: gsap.core.Timeline | undefined;
      new IntersectionObserver(
        (es) =>
          es.forEach((en) => {
            if (en.isIntersecting) {
              if (!tl) tl = demo(stage);
              else tl.resume();
            } else if (tl) tl.pause();
          }),
        { threshold: 0.35 },
      ).observe(stage);
    });
  } else {
    /* Reduced motion: final states, already in the HTML; the curve dot rests at the end. */
    const cd2 = $('.dz-cdot');
    const cl2 = $('.dz-cline');
    if (cd2 && cl2) {
      cd2.setAttribute('cx', '280');
      cd2.setAttribute('cy', '15');
      cl2.setAttribute('x1', '280');
      cl2.setAttribute('x2', '280');
    }
  }

  /* ---------- copy check: real counts of what you type ---------- */
  const inp = $<HTMLTextAreaElement>('#dz-in')!;
  const rows: Record<string, HTMLElement> = {};
  $$<HTMLElement>('#dz-checks li').forEach((li) => (rows[li.dataset.k!] = li));
  const graded = /\b(rigorous|world-class|deep|expert|leading|pioneer)\b/gi;
  const verdict = (li: HTMLElement, ok: boolean, val: string) => {
    li.classList.toggle('ok', ok);
    li.classList.toggle('no', !ok);
    swap($('.vk', li)!, ok ? '✓' : '✕');
    swap($('.vv', li)!, val);
  };
  const lint = () => {
    const t = inp.value;
    const words = t.trim() ? t.trim().split(/\s+/).length : 0;
    const dash = (t.match(/—/g) || []).length;
    const bang = (t.match(/!/g) || []).length;
    const grade = (t.match(graded) || []).length;
    const agent = /tradeframe/i.test(t) && /\bagents?\b/i.test(t);
    verdict(rows.words, words <= 8, `${words} / 8`);
    verdict(rows.dash, dash === 0, String(dash));
    verdict(rows.bang, bang === 0, String(bang));
    verdict(rows.grade, grade === 0, String(grade));
    verdict(rows.agent, !agent, agent ? inp.dataset.flagged! : inp.dataset.ok!);
  };
  inp.addEventListener('input', lint);
  lint();
</script>

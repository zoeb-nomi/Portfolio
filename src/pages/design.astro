  .dz-rules{list-style:none;display:grid;border-top:var(--line-hair);margin-top:22px}
  .dz-rules li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;padding:10px 0;border-bottom:var(--line-hair);font-size:var(--t-small);color:var(--color-text);font-variation-settings:"wght" 520}
  .dz-rules li span{font:500 11px/1.9 var(--font-data);color:var(--color-accent);letter-spacing:.1em}


  /* ---------- previous versions ---------- */
  .dz-vers{list-style:none;border-top:var(--line-heavy);margin-top:clamp(28px,5vh,48px)}
  .dz-ver{display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr) minmax(0,360px);gap:18px 40px;align-items:start;padding:26px 0;border-bottom:var(--line-hair)}

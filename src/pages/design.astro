---
// /design/ (The Pipeline): the design system page. It renders design/README.md: tokens read live from
// design/tokens.css, the kit from src/styles/ds.css, the motion hooks from src/scripts/ds.ts, and the
// history of the site's earlier versions. /design/components/ renders the kit itself.
// Copy: pipelineDesign in src/data/copy.ts. Past palettes are data in copy.ts, not tokens.
import Base from '../layouts/Base.astro';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/ibm-plex-sans/400.css';
import { meta, pipelineDesign as D } from '../data/copy';
import { arrowHtml } from '../lib/arrowHtml';
import { isExternal } from '../lib/isExternal';

const T = D.type;
const C = D.components;
const M = D.motion;
const V = D.versions;
const spec = (s: (typeof V.items)[number]['spec']) =>
  `--sp-bg:${s.bg};--sp-ink:${s.ink};--sp-ink2:${s.ink2};--sp-red:${s.red};--sp-rule:${s.rule};--sp-face:${s.face};--sp-body:${s.body}` +
  ('fvs' in s && s.fvs ? `;--sp-fvs:${s.fvs}` : '');
---

<Base title={meta.design.title} description={meta.design.description} path="/design/" ogImage="/og/design.png">
  <section class="page-head gut">
    <div class="in">
      <p class="kick">{D.kicker}</p>
      <h1 class="display split">{D.h1}</h1>
      <div class="byline meta">
        {D.byline.map((b, i) => <span>{i === 0 ? <b>{b}</b> : b}</span>)}
      </div>
      <div class="stats">
        {
          D.stats.map((s) => (
            <div class="ro">
              <p class="v" data-num>{s.v}</p>
              <p class="u">{s.u}</p>
              <p class="s">{s.s}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec gut" id="principles">
    <div class="in">
      <p class="kick">{D.principles.kicker}</p>
      <h2 class="h2 split">{D.principles.h2}</h2>
      <ol class="dz-pr" data-stagger>
        {
          D.principles.items.map((p, i) => (
            <li>
              <span class="vn">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h4">{p.h}</h3>
              <p>{p.p}</p>
            </li>
          ))
        }
      </ol>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>{D.files.caption}</caption>
          <thead><tr>{D.files.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>
            {D.files.rows.map((r) => <tr><td class="dz-file">{r[0]}</td><td>{r[1]}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec gut" id="colour">
    <div class="in">
      <p class="kick">{D.colour.kicker}</p>
      <h2 class="h2 split">{D.colour.h2}</h2>
      <p class="dz-sub">{D.colour.sub}</p>
      <ul class="dz-sw" data-stagger>
        {
          D.colour.swatches.map((s) => (
            <li>
              <button class="dz-swb" type="button" data-tok={s.tok}>
                <span class="dz-chip"><i style={`background:var(${s.tok})`}></i></span>
                <span class="dz-swm"><span class="t">{s.tok}</span><span class="h"></span><span class="r">{s.r}</span><span class="sr">{D.colour.copyLabel}</span></span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec gut" id="type">
    <div class="in">
      <p class="kick">{T.kicker}</p>
      <h2 class="h2 split">{T.h2}</h2>
      <p class="dz-sub">{T.sub}</p>
      <div class="dz-axes">
        <div class="dz-spec" id="dz-spec">
          <span class="lab tl-l">{T.specTl}</span>
          <span class="lab tr-l">{T.specTr}</span>
          <p class="dz-word" id="dz-word" aria-label={`${T.word}${T.wordDot}`}>{T.word}<span>{T.wordDot}</span></p>
          <span class="lab bl-l">{T.specBl}</span>
          <span class="lab br-l" id="dz-fvs"></span>
        </div>
        <div class="dz-pad-wrap">
          <div class="dz-pad" id="dz-pad" tabindex="0" role="group" aria-label={T.padLabel}>
            <span class="dz-hx" aria-hidden="true"></span><span class="dz-hy" aria-hidden="true"></span>
            <span class="dz-knob" aria-hidden="true"></span>
            <span class="ax x" aria-hidden="true">{T.padNarrow}</span><span class="ax x2" aria-hidden="true">{T.padWide}</span>
            <span class="ax y" aria-hidden="true">{T.padHeavy}</span>
          </div>
          <div class="dz-read" style="margin-top:22px">
            <div>{T.width}<b id="dz-rw">100</b></div>
            <div>{T.weight}<b id="dz-rg">620</b></div>
          </div>
          <div class="dz-ranges">
            <label for="dz-w">{T.width}<input id="dz-w" type="range" min="62" max="125" step="1" value="100" /></label>
            <label for="dz-g">{T.weight}<input id="dz-g" type="range" min="100" max="900" step="1" value="620" /></label>
          </div>
          <div class="dz-presets" role="group" aria-label={T.rolesLabel}>
            {T.presets.map((p) => <button class="chip" type="button" data-w={p.w} data-g={p.g} aria-pressed="false">{p.label}</button>)}
          </div>
        </div>
      </div>

      <div class="dz-voices">
        <div class="dz-voice" data-reveal>
          <span class="lab red">{T.voices[0].who}</span>
          <p class="s1">{T.voices[0].sample}</p>
          <p class="r">{T.voices[0].note}</p>
        </div>
        <div class="dz-voice" data-reveal>
          <span class="lab red">{T.voices[1].who}</span>
          <p class="s2">{T.voices[1].sampleA}<em>{T.voices[1].sampleB}</em></p>
          <p class="r">{T.voices[1].note}</p>
        </div>
      </div>

      <ol class="dz-ladder" id="dz-ladder" data-stagger>
        {
          T.ladder.map((l) => (
            <li>
              {l.cls === 'ro' ? (
                <div class="ro"><p class="v" set:html={arrowHtml(l.text)} /></div>
              ) : l.cls === 'display' ? (
                <p class="display" style="max-width:none">{l.text}</p>
              ) : l.cls === 'h2' ? (
                <p class="h2" style="margin:0;max-width:none">{l.text}</p>
              ) : (
                <p class={l.cls}>{l.text}</p>
              )}
              <p class="meta">
                <b>{l.meta}</b> · {l.tok}<br /><span data-size></span> · {l.axes}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sec gut" id="components">
    <div class="in">
      <p class="kick">{C.kicker}</p>
      <h2 class="h2 split">{C.h2}</h2>
      <p class="dz-sub">{C.sub} <a class="tl" href={C.catalogue.href}>{C.catalogue.label} →</a></p>
      <div class="dz-comp">
        <div class="dz-grid2">
          <div class="dz-cell">
            <span class="lab">{C.buttons.label}</span>
            <div class="ctas">
              <a class="btn" href="#components"><span class="mi">{C.buttons.primary}</span><span class="ar" aria-hidden="true">→</span></a>
              <a class="btn ghost" href="#components">{C.buttons.ghost}</a>
              <a class="tl" href="#components">{C.buttons.link}</a>
            </div>
            <span class="dz-cls">{C.buttons.cls}</span>
          </div>
          <div class="dz-cell">
            <span class="lab">{C.tags.label}</span>
            <div class="tags">
              <span class="tag">{C.tags.tags[0]}</span><span class="tag red">{C.tags.tags[1]}</span><span class="tag solid">{C.tags.tags[2]}</span>
            </div>
            <div style="margin-top:12px"><button class="chip" type="button" aria-pressed="false" id="dz-chipdemo">{C.tags.chip}</button></div>
            <span class="dz-cls">{C.tags.cls}</span>
          </div>
        </div>
        <div class="dz-grid2">
          <div class="dz-cell">
            <span class="lab">{C.card.label}</span>
            <article class="card">
              <div class="card-top"><span><span class="no">{C.card.top[0]}</span> / {C.card.top[1]}</span><span>{C.card.top[2]}</span></div>
              <h3>{C.card.h3}</h3>
              <div class="ros">
                {C.card.ros.map((r) => <div class="ro"><p class="v">{r.v}</p><p class="u">{r.u}</p><p class="s">{r.s}</p></div>)}
              </div>
            </article>
            <span class="dz-cls">{C.card.cls}</span>
          </div>
          <div class="dz-cell">
            <span class="lab">{C.hud.label}</span>
            <div class="hud">
              <div class="hud-in">
                {C.hud.cells.map((c) => <div class="hud-c"><span>{c.l}</span><b class={c.red ? 'r' : undefined}>{c.v}{c.small && <>{' '}<small>{c.small}</small></>}</b></div>)}
              </div>
            </div>
            <span class="dz-cls">{C.hud.cls}</span>
          </div>
        </div>
        <div class="dz-cell">
          <span class="lab">{C.list.label}</span>
          <ol class="blist">
            {
              C.list.rows.map((r) => (
                <li>
                  <a class="build" href={r.href}>
                    <span class="bn">{r.name}</span><span class="bk2">{r.kind}</span><span class="bv" set:html={arrowHtml(r.value)} /><span class="ba" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <span class="dz-cls">{C.list.cls}</span>
        </div>
        <div class="dz-cell">
          <span class="lab">{C.verbs.label}</span>
          <ul class="verb-row">
            {C.verbs.items.map((v) => <li class="verb"><span class="vn">{v.n}</span><h3>{v.h}</h3><span class="vp"><b set:html={arrowHtml(v.b)} />{v.t}</span></li>)}
          </ul>
          <span class="dz-cls">{C.verbs.cls}</span>
        </div>
        <div class="dz-cell">
          <span class="lab">{C.table.label}</span>
          <div class="tbl-wrap" style="margin-block:0">
            <table class="tbl">
              <caption>{C.table.caption}</caption>
              <thead><tr>{C.table.cols.map((c, i) => <th class={i ? 'n' : undefined}>{c}</th>)}</tr></thead>
              <tbody>
                {C.table.rows.map((r) => <tr><td>{r[0]}</td><td class="n">{r[1]}</td><td class={r[3] ? 'n win' : 'n'}>{r[2]}</td></tr>)}
              </tbody>
            </table>
          </div>
          <span class="dz-cls">{C.table.cls}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec gut" id="motion">
    <div class="in">
      <p class="kick">{M.kicker}</p>
      <h2 class="h2 split">{M.h2}</h2>
      <p class="dz-sub">{M.sub}</p>
      <ul class="dz-mo">
        {
          M.demos.map((d) => (
            <li>
              <div class="dz-stage" data-demo={d.kind}>
                {d.kind === 'reveal' && <p class="dz-rv" aria-label={M.reveal}>{M.reveal}</p>}
                {d.kind === 'number' && <p class="dz-num" aria-label={M.number}>{M.number}</p>}
                {
                  d.kind === 'swap' && (
                    <div class="dz-swp">
                      <div class="hud-c"><span>{M.swapLabels[0]}</span><b class="dz-swk">{M.swapKeys[0][0]}</b></div>
                      <div class="hud-c"><span>{M.swapLabels[1]}</span><b class="dz-swv">{M.swapKeys[0][1]}</b></div>
                    </div>
                  )
                }
                {d.kind === 'draw' && <div class="dz-draw"><span class="w">{M.drawWord}<i></i></span><div class="bar"><i></i></div></div>}
                {d.kind === 'hover' && <div class="dz-hrow" aria-hidden="true"><span>{M.hoverRow}</span><span class="ba">→</span></div>}
                {
                  d.kind === 'curve' && (
                    <svg class="dz-curve" viewBox="0 0 300 150" preserveAspectRatio="none" role="img" aria-label={M.curveLabel}>
                      <path class="dz-axis" d="M20 135 H280 M20 135 V15" />
                      <path class="dz-cv" d="M20 135 C61.6 15, 98 15, 280 15" />
                      <circle class="dz-cdot" cx="20" cy="135" r="5" />
                      <line class="dz-cline" x1="20" y1="135" x2="20" y2="15" />
                    </svg>
                  )
                }
              </div>
              <div class="dz-mm"><p class="t">{d.t} <span>{d.d}</span></p><p class="r">{d.r}</p></div>
            </li>
          ))
        }
      </ul>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>{M.hooks.caption}</caption>
          <thead><tr>{M.hooks.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{M.hooks.rows.map((r) => <tr><td class="dz-file">{r[0]}</td><td>{r[1]}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption>{M.durations.caption}</caption>
          <thead><tr>{M.durations.cols.map((c, i) => <th class={i === 1 ? 'n' : undefined}>{c}</th>)}</tr></thead>
          <tbody>{M.durations.rows.map((r) => <tr><td class="dz-file">{r[0]}</td><td class="n">{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec gut" id="copy">
    <div class="in">
      <p class="kick">{D.copy.kicker}</p>
      <h2 class="h2 split">{D.copy.h2}</h2>
      <div class="dz-lint">
        <div>
          <label class="lab" for="dz-in" style="display:block;margin-bottom:10px">{D.copy.inputLabel}</label>
          <textarea class="dz-input" id="dz-in" rows="2" spellcheck="false" data-flagged={D.copy.flagged} data-ok={D.copy.ok}>{D.copy.sample}</textarea>
          <ol class="dz-rules">
            {D.copy.rules.map((r, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{r}</li>)}
          </ol>
        </div>
        <div>
          <p class="lab" style="margin-bottom:10px">{D.copy.checksLabel}</p>
          <ul class="dz-checks" id="dz-checks" aria-live="polite">
            {D.copy.checks.map((c) => <li data-k={c.k}><span class="vk">✓</span><span>{c.l}</span><span class="vv"></span></li>)}
          </ul>
          <p class="dz-sub" style="margin-top:12px">{D.copy.graded}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec gut" id="versions">
    <div class="in">
      <p class="kick">{V.kicker}</p>
      <h2 class="h2 split">{V.h2}</h2>
      <p class="dz-sub">{V.sub}</p>
      <ol class="dz-vers" data-stagger>
        {
          V.items.map((v) => (
            <li class:list={['dz-ver', { now: v.now }]} data-now={V.now}>
              <div>
                <span class="no">{v.no}</span>
                <h3 class="h4">{v.name}</h3>
                <span class="when">{v.when}</span>
              </div>
              <div>
                <p class="idea"><b>{v.idea}</b>{v.rest}</p>
                <span class="src">{v.src}</span>
                {
                  v.links.length > 0 && (
                    <div class="links">
                      {v.links.map((l) => <a class="tl" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a>)}
                    </div>
                  )
                }
              </div>
              <div class="dz-spc" style={spec(v.spec)}>
                <p class="sp-h">{v.spec.head}<u>{v.spec.mark}</u>{v.spec.tail}</p>
                <p class="sp-b">{v.spec.line}</p>
                <div class="sp-sw">{v.spec.sw.map((c) => <i style={`background:${c}`} />)}</div>
                <div class="sp-k">{v.spec.keys.map((k) => <span>{k}</span>)}</div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sec gut" id="templates">
    <div class="in">
      <p class="kick">{D.templates.kicker}</p>
      <h2 class="h2 split">{D.templates.h2}</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr>{D.templates.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>
            {D.templates.rows.map((r) => <tr><td><a class="tl" href={r.href}>{r.label}</a></td><td>{r.order}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="ctas" style="margin-top:32px">
        <a class="btn" href={D.templates.cta.href}><span class="mi">{D.templates.cta.label}</span><span class="ar" aria-hidden="true">→</span></a>
        <a class="tl" href={D.templates.about.href}>{D.templates.about.label}</a>
      </div>
    </div>
  </section>

  <p class="dz-copied" id="dz-copied" role="status" aria-live="polite" data-copied={D.colour.copied}></p>
</Base>

<style>

  /* ---------- design page: shared ---------- */
  .dz-sub{margin-top:14px;font:400 12px/1.6 var(--font-data);color:var(--color-text-muted);max-width:62ch}
  .dz-sub b{font-weight:500;color:var(--color-text-body)}
  .dz-grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
  @media (max-width:899px){.dz-grid2{grid-template-columns:minmax(0,1fr)}}

  /* ---------- principles ---------- */
  .dz-pr{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:var(--line-heavy);margin-top:clamp(28px,5vh,48px)}
  .dz-pr li{padding:20px 24px 24px 0;border-right:var(--line-hair);margin-right:24px}
  .dz-pr li:last-child{border-right:0;margin-right:0}
  .dz-pr .vn{font:500 11px/1 var(--font-data);letter-spacing:.14em;color:var(--color-accent)}
  .dz-pr h3{margin-top:14px}
  .dz-pr p{margin-top:10px;font:400 12px/1.6 var(--font-data);color:var(--color-text-body)}
  @media (max-width:899px){.dz-pr{grid-template-columns:minmax(0,1fr)}.dz-pr li{border-right:0;margin-right:0;border-bottom:var(--line-hair)}}

  /* ---------- swatches ---------- */
  .dz-sw{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,190px),1fr));gap:12px;margin-top:clamp(28px,5vh,48px)}
  .dz-swb{display:block;width:100%;text-align:left;background:var(--color-panel);border:var(--line-hair);padding:0;color:var(--color-text);font:inherit;cursor:pointer;transition:border-color .3s var(--ease-out),transform .5s var(--ease-out)}
  .dz-swb:hover,.dz-swb:focus-visible{border-color:var(--color-line-strong);transform:translateY(-3px)}
  .dz-chip{height:84px;border-bottom:var(--line-hair);position:relative;background-image:linear-gradient(45deg,color-mix(in srgb,var(--color-text) 12%,transparent) 25%,transparent 25%,transparent 75%,color-mix(in srgb,var(--color-text) 12%,transparent) 75%),linear-gradient(45deg,color-mix(in srgb,var(--color-text) 12%,transparent) 25%,transparent 25%,transparent 75%,color-mix(in srgb,var(--color-text) 12%,transparent) 75%);background-size:12px 12px;background-position:0 0,6px 6px}
  .dz-chip i{position:absolute;inset:0;background:var(--sw)}
  .dz-swm{padding:10px 12px 12px;display:grid;gap:3px}
  .dz-swm .t{font:500 12px/1.3 var(--font-data);color:var(--color-text)}
  .dz-swm .h{font:400 11px/1.3 var(--font-data);color:var(--color-text-muted);font-variant-numeric:tabular-nums}
  .dz-swm .r{font:400 11.5px/1.4 var(--font-data);color:var(--color-text-body);margin-top:4px}
  .dz-copied{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);opacity:0;pointer-events:none;z-index:80;background:var(--color-text);color:var(--color-surface);font:500 12px/1 var(--font-data);letter-spacing:.06em;padding:11px 14px;transition:opacity .3s var(--ease-out),transform .5s var(--ease-out)}
  .dz-copied.on{opacity:1;transform:translate(-50%,0)}

  /* ---------- axis pad (signature) ---------- */
  .dz-axes{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.9fr);gap:clamp(20px,3vw,40px);margin-top:clamp(28px,5vh,48px);align-items:stretch}
  @media (max-width:899px){.dz-axes{grid-template-columns:minmax(0,1fr)}}
  .dz-spec{position:relative;border:var(--line-hair);background:var(--color-surface-sunk);min-height:clamp(240px,34vw,420px);display:flex;align-items:center;justify-content:center;overflow:hidden;padding:20px}
  .dz-word{font-size:clamp(44px,8vw,132px);line-height:.9;letter-spacing:-.04em;color:var(--color-text);white-space:nowrap;font-variation-settings:"wdth" var(--aw,100),"wght" var(--ag,620);will-change:font-variation-settings}
  .dz-word span{color:var(--color-accent)}
  .dz-spec .lab{position:absolute}
  .dz-spec .tl-l{left:14px;top:12px}.dz-spec .tr-l{right:14px;top:12px}.dz-spec .bl-l{left:14px;bottom:12px}.dz-spec .br-l{right:14px;bottom:12px;color:var(--color-text-body)}
  .dz-pad-wrap{display:flex;flex-direction:column;gap:14px}
  .dz-pad{position:relative;aspect-ratio:1/1;max-height:340px;border:var(--line-strong);background:var(--color-panel);touch-action:none;cursor:crosshair;outline-offset:4px;
    background-image:linear-gradient(var(--color-line) 1px,transparent 1px),linear-gradient(90deg,var(--color-line) 1px,transparent 1px);background-size:12.5% 12.5%}
  .dz-pad .ax{position:absolute;font:500 var(--t-label)/1 var(--font-data);letter-spacing:.12em;text-transform:uppercase;color:var(--color-text-muted);pointer-events:none}
  .dz-pad .ax.x{left:8px;bottom:-18px}.dz-pad .ax.x2{right:8px;bottom:-18px}
  .dz-pad .ax.y{left:-4px;top:8px;transform:translateX(-100%) rotate(-90deg);transform-origin:right top}
  .dz-hx,.dz-hy{position:absolute;background:color-mix(in srgb,var(--color-accent) 45%,transparent);pointer-events:none}

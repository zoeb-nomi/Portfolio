---
// Home, v4 (Red Pen, edited; 19 Nov 2026). One claim per screen: hero (claim, one proof, one action) beside
// the flat audit sheet; three readings; the compact Builds ledger; about with the four verbs; the CTA slab.
// The page never names its own parts (no "Fig. 0, step n", no "Next:" lines). Budget: 300 rendered words.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Readings from '../components/Readings.astro';
import BuildsLedger from '../components/BuildsLedger.astro';
import Button from '../components/Button.astro';
import Headshot from '../components/Headshot.astro';
import AuditSheet from '../components/AuditSheet.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, home, cta } from '../data/copy';
import { strip } from '../data/fig0-cells';

const v = home.v4;
---

<Base title={meta.home.title} description={meta.home.description} path="/" ogImage="/og/home.png" motion>
  <section class="hero has-grid" aria-labelledby="hero-h1">
    <div class="hero-in">
      <div class="hero-text">
        <h1 class="hero-h1" id="hero-h1">
          <span class="line1"
            >LLM products <span class="nowrap"
              >fail <span class="underline-wrap"
                >quietly.<span class="underline" aria-hidden="true" data-underline></span></span
              ></span
            ></span
          >
        </h1>
        <p class="lede">{v.lede}</p>

        <div class="proof" data-fig0-strip>
          <p class="proof-v">
            <span class="proof-num">{strip.value}</span>
            <span class="proof-text">{strip.unit} {strip.label} {v.proofCaught}</span>
          </p>
        </div>

        <div class="hero-cta">
          <Button href={cta.bookACall.href} variant="primary">{cta.bookACall.label}</Button>
          <a class="text-link" href={cta.email.href}>{v.emailLink}</a>
        </div>
        <p class="cta-note">{cta.bookACallNote}</p>
      </div>

      <div class="hero-fig">
        <AuditSheet />
      </div>
    </div>
  </section>

  <Section mark="§1" label={home.measuredLabel}>
    <h3 class="block-h2">{v.measuredH2}</h3>
    <Readings compact />
  </Section>

  <Section mark="§2" label={home.builds.kicker} grid>
    <h3 class="block-h2">{v.buildsH2}</h3>
    <BuildsLedger variant="compact" />
    <p class="all-link"><a href={home.builds.allLink.href}>{home.builds.allLink.label}</a></p>
  </Section>

  <Section mark="§3" label={v.aboutLabel}>
    <div class="about">
      <Headshot size="hero" alt="Zoeb Nomi" loading="lazy" />
      <div>
        <h3 class="block-h2">{v.aboutH2}</h3>
        <p class="about-p">{v.about}</p>
        <dl class="verbs">
          {
            v.verbs.map((m) => (
              <div class="verb">
                <dt>{m.name}</dt>
                <dd>{m.line}</dd>
              </div>
            ))
          }
        </dl>
        <p class="all-link"><a href={v.aboutLink.href}>{v.aboutLink.label}</a></p>
      </div>
    </div>
  </Section>

  <CTASlab
    marginLines={[home.ctaSlabMarginNow, home.ctaSlabMarginBefore]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

<style>
  /* ---------- hero: claim, one proof, one action; the flat sheet beside it ---------- */
  .hero {
    border-bottom: var(--line-ink);
  }

  .has-grid {
    background-image:
      linear-gradient(var(--grid-ink) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-ink) 1px, transparent 1px);
    background-size: var(--grid-step) var(--grid-step);
    background-position: -1px -1px;
  }

  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 1fr);
    column-gap: var(--s-12);
    align-items: center;
    padding: var(--s-12) var(--gutter) var(--s-12);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--ink);
  }

  .hero-h1 .line1 {
    display: block;
    font-size: var(--t-display);
    line-height: 0.96;
    letter-spacing: var(--track-display);
  }

  .nowrap {
    white-space: nowrap;
  }

  .underline-wrap {
    position: relative;
    display: inline-block;
  }

  /* The pen at display scale (the one exception to the line tiers). Final state in CSS; motion draws it. */
  .underline {
    position: absolute;
    left: 0;
    bottom: 0.04em;
    width: 100%;
    height: 0.03em;
    min-height: 2px;
    background: var(--red);
    transform-origin: left;
  }

  .lede {
    margin-top: var(--s-6);
    max-width: 24ch;
    font-size: var(--t-lede);
    line-height: var(--lh-heading);
    letter-spacing: var(--track-tight);
    color: var(--ink);
  }

  .proof {
    margin-top: var(--s-9);
    max-width: 30rem;
    border-top: var(--line-heavy);
    padding-top: var(--s-4);
  }

  .proof-v {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--s-4);
    align-items: baseline;
  }

  .proof-num {
    font-family: var(--font-display);
    font-size: var(--t-num);
    line-height: var(--lh-tight);
    color: var(--red-ink);
    font-variant-numeric: tabular-nums;
  }

  .proof-text {
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  /* Pre-reveal state, only under .motion: the proof waits for the sheet's scan line, then wipes in. */
  :global(.motion) [data-fig0-strip]:not(.is-in) {
    clip-path: inset(0 100% 0 0);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .cta-note {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  .hero-fig {
    min-width: 0;
  }

  @media (max-width: 1099px) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr) minmax(260px, .85fr);
      column-gap: var(--s-9);
    }
  }

  @media (max-width: 899px) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-11);
      padding-block: var(--s-9) var(--s-11);
    }
  }

  /* ---------- sections ---------- */
  .block-h2 {
    margin-bottom: var(--s-8);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--t-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 24ch;
    text-wrap: balance;
  }

  .all-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    margin-top: var(--s-4);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .about {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    column-gap: var(--s-9);
    align-items: start;
  }

  .about :global(.headshot) {
    width: 176px;
  }

  .about-p {
    max-width: var(--measure);
    line-height: var(--lh-prose);
    color: var(--ink-body);
  }

  .verbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-8);
    margin-top: var(--s-8);
    max-width: 44rem;
  }

  .verb {
    border-top: var(--line-hair);
    padding-top: var(--s-3);
  }

  .verb dt {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    color: var(--ink);
  }

  .verb dd {
    margin-top: var(--s-1);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  @media (max-width: 899px) {
    .about {
      grid-template-columns: 1fr;
      row-gap: var(--s-6);
    }

    .about :global(.headshot) {
      width: 120px;
    }
  }

  @media (max-width: 599px) {
    .verbs {
      grid-template-columns: 1fr;
    }
  }
</style>

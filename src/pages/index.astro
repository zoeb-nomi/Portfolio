---
// Home, Red Pen 5 "Live Ink" (19 Nov 2026). The page is a live audit:
//   1. Hero (paper): the claim, the word "quietly" going quiet, and the live audit sheet, where a model
//      answer streams in and the pen checks its claims.
//   2. Proof (ink): one mega number, then the audit sheet of all 167 outputs, swept on scroll.
//   3. Readings (paper): three numbers, each underlined by the pen as it arrives.
//   4. Builds (paper): one row per build; the pen circles a name when you point at it.
//   5. About, then the call to action (ink).
// The page never names its own parts. Copy: src/data/copy.ts (home.v5, home.v4, home).
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Headshot from '../components/Headshot.astro';
import AuditSheet from '../components/AuditSheet.astro';
import LiveAudit from '../components/LiveAudit.astro';
import { meta, home, cta, buildsLedger } from '../data/copy';
import { strip } from '../data/fig0-cells';

const v = home.v4;
const v5 = home.v5;
const builds = buildsLedger.filter((b) => b.compact);
const verbMarks = ['underline', 'box', 'circle', 'tick'] as const;
---

<Base title={meta.home.title} description={meta.home.description} path="/" ogImage="/og/home.png" motion>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-h1">
    <h1 class="hero-h1" id="hero-h1">
      LLM products fail <span class="quiet" data-pen="underline" data-pen-heavy data-pen-delay="1500" data-pen-key="h1">quietly.</span>
    </h1>

    <div class="hero-grid">
      <div class="hero-side">
        <p class="lede">{v.lede}</p>
        <div class="hero-cta">
          <Button href={cta.bookACall.href} variant="primary">{cta.bookACall.label}</Button>
          <a class="text-link" href={cta.email.href}>{v.emailLink}</a>
        </div>
        <p class="cta-note">{cta.bookACallNote}</p>
      </div>
      <div class="hero-sheet">
        <LiveAudit />
      </div>
    </div>
  </section>

  <!-- 2. Proof -->
  <section class="proof surface-ink bleed" aria-labelledby="proof-h2">
    <div class="proof-top" data-fig0-strip>
      <p class="mega" data-tally>{strip.value}</p>
      <div class="proof-words">
        <h2 class="proof-h2" id="proof-h2">{strip.unit} {strip.label}</h2>
        <p class="proof-sub">{v.proofCaught}</p>
      </div>
    </div>

    <div class="sheet-grid">
      <div class="sheet-text">
        <p class="sheet-h">{v5.sheetH2}</p>
        <p class="sheet-sub">{v5.sheetSub}</p>
      </div>
      <div class="sheet-fig">
        <AuditSheet />
      </div>
    </div>
  </section>

  <!-- 3. Readings -->
  <section class="block" aria-labelledby="readings-h2">
    <h2 class="block-h2" id="readings-h2">{v5.readingsH2}</h2>
    <ol class="readings">
      {
        home.readings.map((r) => (
          <li class="reading">
            <p class="r-num" data-pen="underline" data-pen-key={r.id}>
              <span data-pen-target>
                <span data-tally>{r.display}</span>
                {r.unit && <span class="r-unit">{r.unit}</span>}
              </span>
            </p>
            <p class="r-label">{r.label}</p>
            <p class="r-datum">
              {r.datum} · {r.n}
            </p>
            <p class="r-src">{r.source}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 4. Builds -->
  <section class="block" aria-labelledby="builds-h2">
    <div class="block-head">
      <h2 class="block-h2" id="builds-h2">{v5.buildsH2}</h2>
      <p class="block-sub">{v5.buildsSub}</p>
    </div>
    <ol class="builds">
      {
        builds.map((b, i) => (
          <li class="build" data-pen-zone>
            <a class="build-a" href={b.primary.href}>
              <span class="b-n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="b-main">
                <span class="b-name" data-pen="circle" data-pen-on="hover" data-pen-key={b.id}>
                  {b.name}
                </span>
                <span class="b-line">{b.homeLine ?? b.oneLine}</span>
              </span>
              <span class="b-kind">{b.kind}</span>
              <span class="b-go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="all-link"><a href={home.builds.allLink.href}>{home.builds.allLink.label}</a></p>
  </section>

  <!-- 5. About -->
  <section class="block about" aria-labelledby="about-h2">
    <Headshot size="hero" alt="Zoeb Nomi" loading="lazy" />
    <div>
      <p class="about-label">{v.aboutLabel}</p>
      <h2 class="block-h2" id="about-h2">{v.aboutH2}</h2>
      <p class="about-p">{v.about}</p>
      <dl class="verbs">
        {
          v.verbs.map((m, i) => (
            <div class="verb">
              <dt>
                <span data-pen={verbMarks[i]} data-pen-delay={String(i * 180)} data-pen-key={m.name}>
                  {m.name}
                </span>
              </dt>
              <dd>{m.line}</dd>
            </div>
          ))
        }
      </dl>
      <p class="all-link"><a href={v.aboutLink.href}>{v.aboutLink.label}</a></p>
    </div>
  </section>

  <!-- 6. Call -->
  <section class="call surface-ink bleed" aria-labelledby="call-h2">
    <h2 class="call-h2" id="call-h2">{home.ctaSlabBody}</h2>
    <div class="hero-cta">
      <Button href={cta.bookACall.href} variant="primary">{cta.bookACall.label}</Button>
      <a class="text-link" href={cta.email.href}>{v.emailLink}</a>
    </div>
    <p class="cta-note">{cta.bookACallNote}</p>
  </section>
</Base>

<style>
  /* ---------- 1. hero ---------- */
  .hero {
    position: relative;
    padding: var(--s-12) var(--gutter) var(--s-14);
    background-image:
      linear-gradient(var(--grid-ink) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-ink) 1px, transparent 1px);
    background-size: var(--grid-step) var(--grid-step);
    background-position: -1px -1px;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: var(--wght-claim);
    font-stretch: calc(var(--wdth-claim) * 1%);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    color: var(--ink);
    max-width: 14ch;
    text-wrap: balance;
  }

  /* "quietly" is set quiet: the lightest weight, muted ink. Under motion it starts at the claim's
     weight and fades to quiet, then the pen underlines it (pen-scroll.ts, data-pen). */
  .quiet {
    display: inline-block;
    font-weight: var(--wght-quiet);
    color: var(--ink-muted);
  }

  :global(.motion) .quiet {
    animation: go-quiet 1100ms var(--ease-draw) 350ms both;
  }

  @keyframes go-quiet {
    from {
      font-weight: var(--wght-claim);
      color: var(--ink);
    }
    to {
      font-weight: var(--wght-quiet);
      color: var(--ink-muted);
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    column-gap: var(--s-12);
    align-items: start;
    margin-top: var(--s-12);
  }

  .lede {
    font-size: var(--t-lede);
    font-weight: 500;
    line-height: var(--lh-heading);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 18ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    color: var(--red-ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .cta-note {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  /* ---------- 2. proof (ink) ---------- */
  .proof {
    padding-block: var(--s-14);
  }

  .proof-top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--s-9);
    align-items: end;
  }

  .mega {
    font-family: var(--font-display);
    font-size: var(--t-mega);
    font-weight: var(--wght-claim);
    font-stretch: calc(var(--wdth-tight) * 1%);
    line-height: 0.8;
    letter-spacing: var(--track-display);
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }

  .proof-h2 {
    font-size: var(--t-h2);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 16ch;
  }

  .proof-sub {
    margin-top: var(--s-3);
    font-size: var(--t-lede);
    color: var(--ink-body);
    max-width: 30ch;
  }

  .sheet-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    column-gap: var(--s-12);
    margin-top: var(--s-14);
    padding-top: var(--s-9);
    border-top: var(--line-hair);
  }

  .sheet-h {
    font-size: var(--t-h3);
    font-weight: var(--wght-head);
    font-stretch: calc(var(--wdth-head) * 1%);
    line-height: var(--lh-heading);
    color: var(--ink);
  }

  .sheet-sub {
    margin-top: var(--s-3);
    color: var(--ink-body);
  }

  .sheet-fig :global(.as-cell) {
    border-color: var(--rule);
  }

  /* ---------- shared block ---------- */
  .block {
    padding: var(--s-14) var(--gutter) 0;
  }

  .block-head {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: var(--s-12);
    align-items: end;
  }

  .block-h2 {
    font-size: var(--t-h2);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 18ch;
  }

  .block-sub {
    color: var(--ink-body);
    max-width: 36ch;
  }

  /* ---------- 3. readings ---------- */
  .readings {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--s-9);
    margin-top: var(--s-11);
  }

  .reading {
    border-top: var(--line-heavy);
    padding-top: var(--s-5);
  }

  .r-num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--t-stat);
    font-weight: var(--wght-claim);
    font-stretch: calc(var(--wdth-tight) * 1%);
    line-height: 1;
    letter-spacing: var(--track-display);
    color: var(--ink);
    padding-bottom: var(--s-2);
  }

  .r-unit {
    margin-left: var(--s-2);
    font-size: 0.42em;
    font-weight: var(--wght-head);
    letter-spacing: 0;
  }

  .r-label {
    margin-top: var(--s-4);
    font-weight: 500;
    color: var(--ink);
    max-width: 26ch;
  }

  .r-datum,
  .r-src {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .r-src {
    margin-top: var(--s-1);
    color: var(--red-ink);
  }

  /* ---------- 4. builds ---------- */
  .builds {
    list-style: none;
    margin-top: var(--s-11);
    border-top: var(--line-heavy);
  }

  .build {
    border-bottom: var(--line-hair);
  }

  .build-a {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 12rem 2rem;
    column-gap: var(--s-6);
    align-items: center;
    padding-block: var(--s-7);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur-base) var(--ease-draw), padding var(--dur-base) var(--ease-draw);
  }

  .build-a:hover,
  .build-a:focus-visible {
    background: var(--paper-raised);
  }

  .b-n {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--red-ink);
  }

  .b-main {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .b-name {
    font-family: var(--font-display);
    font-size: var(--t-num);
    font-weight: var(--wght-head);
    font-stretch: calc(var(--wdth-head) * 1%);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .b-line {
    color: var(--ink-body);
    max-width: 52ch;
  }

  .b-kind {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  .b-go {
    font-size: var(--t-h3);
    color: var(--red-ink);
    transition: transform var(--dur-base) var(--ease-draw);
  }

  .build-a:hover .b-go,
  .build-a:focus-visible .b-go {
    transform: translateX(6px);
  }

  .all-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    margin-top: var(--s-4);
    font-weight: 500;
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* ---------- 5. about ---------- */
  .about {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    column-gap: var(--s-12);
    align-items: start;
    padding-bottom: var(--s-14);
  }

  .about :global(.headshot) {
    width: 220px;
  }

  .about-label {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--red-ink);
    margin-bottom: var(--s-4);
  }

  .about-p {
    margin-top: var(--s-6);
    font-size: var(--t-lede);
    line-height: var(--lh-heading);
    color: var(--ink-body);
    max-width: 34ch;
  }

  .verbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6) var(--s-8);
    margin-top: var(--s-11);
  }

  .verb {
    border-top: var(--line-ink);
    padding-top: var(--s-4);
  }

  .verb dt {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: var(--wght-claim);
    font-stretch: calc(var(--wdth-claim) * 1%);
    line-height: var(--lh-heading);
    color: var(--ink);
  }

  .verb dt span {
    display: inline-block;
  }

  .verb dd {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  /* ---------- 6. call (ink) ---------- */
  .call {
    padding-block: var(--s-15) var(--s-14);
  }

  .call-h2 {
    font-size: var(--t-slab);
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 22ch;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1099px) {
    .hero-grid,
    .sheet-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-9);
    }

    .lede {
      max-width: 26ch;
    }

    .verbs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: var(--s-9) var(--s-12);
    }

    .hero-grid {
      margin-top: var(--s-8);
    }

    .proof,
    .call {
      padding-block: var(--s-12);
    }

    .proof-top {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-4);
    }

    .block {
      padding-top: var(--s-12);
    }

    .block-head {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-4);
    }

    .readings {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-9);
    }

    .build-a {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      padding-block: var(--s-5);
    }

    .b-kind {
      display: none;
    }

    .about {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-6);
      padding-bottom: var(--s-12);
    }

    .about :global(.headshot) {
      width: 140px;
    }
  }

  @media (max-width: 599px) {
    .verbs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

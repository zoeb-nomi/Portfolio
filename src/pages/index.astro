---
// Home, The Pipeline (20 Nov 2026). The page is a pitch in the order the prototype was approved in:
//   1. Hero and the pinned Pipeline scene (home/PipelineScene): the claim, then 167 real outputs through five
//      stations, with a visible Skip.
//   2. Shipped (home/Shipped): three before-to-after panels, the CrossSource precision as an odometer.
//   3. Agent harness (HarnessPanel): the live ledger, counted as it runs, on a raised band.
//   4. Builds: four rows, then About with the headshot and the four verbs (labels, not links).
//   5. The call to action. The header and footer are Base's.
// Copy: src/data/copy.ts (home, home.v4, home.v5.harness, pipelineHome). The page never types a visible string.
import Base from '../layouts/Base.astro';
import PipelineScene from '../components/home/PipelineScene.astro';
import Shipped from '../components/home/Shipped.astro';
import HarnessPanel from '../components/HarnessPanel.astro';
import { meta, home, pipelineHome as P, cta, site, buildsLedger } from '../data/copy';

const v = home.v4;
const hx = home.v5.harness;
const rows = P.builds.rows.map((r) => ({ ...r, build: buildsLedger.find((b) => b.id === r.id)! }));
---

<Base title={meta.home.title} description={meta.home.description} path="/" ogImage="/og/home.png" page="home">
  <PipelineScene />
  <Shipped />

  <section class="sec gut hz-sec" id="harness" aria-labelledby="h-harness">
    <div class="in">
      <p class="kick">{P.harness.kick}</p>
      <h2 class="h2" data-split id="h-harness">{hx.h2}</h2>
      <HarnessPanel />
    </div>
  </section>

  <section class="sec gut" id="builds" aria-labelledby="h-builds">
    <div class="in">
      <p class="kick">{P.builds.kick}</p>
      <h2 class="h2" data-split id="h-builds">{P.builds.h2}</h2>
      <ol class="blist" data-stagger>
        {
          rows.map((r) => (
            <li>
              <a class="build" id={`b-${r.id}`} href={r.href}>
                <span class="bn">{r.build.name}</span>
                <span class="bk2">{r.build.kind}</span>
                <span class="bv">{r.value}</span>
                <span class="ba" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sec gut" id="about" aria-labelledby="h-about">
    <div class="in">
      <p class="kick">{v.aboutLabel}</p>
      <h2 class="h2" data-split id="h-about">{v.aboutH2}</h2>
      <div class="ab" data-reveal>
        <div class="ab-ph">
          <picture>
            <source type="image/avif" srcset="/img/headshot-480.avif 480w, /img/headshot-960.avif 960w" sizes="(max-width: 599px) 132px, 184px" />
            <source type="image/webp" srcset="/img/headshot-480.webp 480w, /img/headshot-960.webp 960w" sizes="(max-width: 599px) 132px, 184px" />
            <img
              src="/img/headshot-480.jpg"
              srcset="/img/headshot-480.jpg 480w, /img/headshot-960.jpg 960w"
              sizes="(max-width: 599px) 132px, 184px"
              width="480"
              height="480"
              alt={site.name}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div>
          <p class="ab-l">{v.about}</p>
          <a class="tl" href={v.aboutLink.href}>{v.aboutLink.label}</a>
        </div>
      </div>
      <ul class="verb-row">
        {
          v.verbs.map((m, i) => (
            <li class="verb">
              <span class="vn">{String(i + 1).padStart(2, '0')}</span>
              <h3>{m.name}</h3>
              <span class="vp">{m.line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec contact gut" id="contact" aria-labelledby="h-contact">
    <div class="in">
      <p class="kick">{P.contactKick}</p>
      <h2 class="h2" data-split id="h-contact">{home.ctaSlabBody}</h2>
      <div class="ctas">
        <a class="btn" href={cta.bookACall.href} target="_blank" rel="noopener"><span class="mi">{cta.bookACall.label}</span><span class="ar" aria-hidden="true">→</span></a>
        <a class="tl" href={cta.email.href}>{v.emailLink}</a>
        <span class="lab">{cta.bookACallNote}</span>
      </div>
      <div class="soc">
        <a class="tl" href={cta.linkedin.href} target="_blank" rel="noopener">{cta.linkedin.label}</a>
        <a class="tl" href={cta.github.href} target="_blank" rel="noopener">{cta.github.label}</a>
        <a class="tl" href={cta.x.href} target="_blank" rel="noopener">{cta.x.label}</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
/* Harness band: the raised strip behind the ledger panel. */
.hz-sec{background:var(--color-surface-raised);border-top:var(--line-hair);border-bottom:var(--line-hair);margin-top:clamp(56px,9vh,104px);padding-bottom:clamp(56px,9vh,104px)}
.hz-sec .hz{border-top:var(--line-pen)}

/* About, with the headshot */
.ab{display:grid;grid-template-columns:auto minmax(0,1fr);gap:28px clamp(28px,5vw,72px);align-items:start;margin-top:clamp(28px,5vh,48px)}
.ab-ph{position:relative;width:clamp(132px,13vw,184px);aspect-ratio:4/5;border:var(--line-strong);overflow:hidden;background:var(--color-surface-sunk)}
.ab-ph img{display:block;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.04)}
.ab-ph::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--color-accent)}
.ab-l{font-size:clamp(18px,1.45vw,22px);line-height:var(--lh-snug);color:var(--color-text-body);max-width:52ch;margin-top:-.36em}
.ab .tl{margin-top:18px;display:inline-block}
@media (max-width:599px){.ab{grid-template-columns:minmax(0,1fr);align-items:start}}

/* Contact */
.contact .h2{font-size:clamp(40px,6.4vw,104px);max-width:15ch;line-height:.92}
.contact .ctas{margin-top:36px}
.contact .ctas .lab{color:var(--color-text-muted)}
.contact .soc{display:flex;gap:22px;flex-wrap:wrap;margin-top:22px}
</style>

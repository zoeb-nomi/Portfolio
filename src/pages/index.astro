---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MarginNote from '../components/MarginNote.astro';
import Readings from '../components/Readings.astro';
import BuildsLedger from '../components/BuildsLedger.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import Button from '../components/Button.astro';
import Headshot from '../components/Headshot.astro';
import Fig0 from '../components/Fig0.astro';
import PullQuote from '../components/PullQuote.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, home, cta, contributions } from '../data/copy';
---

<Base title={meta.home.title} description={meta.home.description} path="/" ogImage="/og/home.png" motion>
  <section class="hero has-grid" aria-labelledby="hero-h1">
    <div class="hero-in">
      <p class="eyebrow">{home.eyebrow}</p>

      <h1 class="hero-h1" id="hero-h1">
        <span class="line1"
          >LLM products <span class="nowrap"
            >fail <span class="underline-wrap"
              >quietly.<span class="underline" aria-hidden="true" data-underline></span></span
            ></span
          > <span class="unflagged" aria-hidden="true">{home.unflaggedMark}</span></span
        >
        <span class="line2">{home.h1Line2}</span>
      </h1>

      <div class="hero-fig">
        <Fig0 />
      </div>

      <div class="hero-lower">
        <figure class="portrait">
          <Headshot size="hero" alt="Zoeb Nomi" loading="eager" />
          <figcaption>{home.figure1Caption}</figcaption>
        </figure>
        <div class="hero-copy">
          <p class="subhead">
            {home.subheadPre}<span class="highlight">{home.subheadHighlight}</span>
          </p>
          <div class="hero-ctas">
            <Button href={cta.bookACall.href} variant="primary">{cta.bookACall.label}</Button>
            <Button href={cta.email.href} variant="secondary">{cta.email.label}</Button>
            <Button href={cta.linkedin.href} variant="secondary">{cta.linkedin.label}</Button>
          </div>
          <p class="cta-note">{cta.bookACallNote}</p>
          <MarginNote>{home.reviewerNote}</MarginNote>
        </div>
      </div>
    </div>
  </section>

  <Section
    mark="§1"
    label={home.measuredLabel}
    refLine={{ strong: home.readingsRef, text: home.readingsWhy }}
    next={home.readingsNext}
  >
    <Readings />
  </Section>

  <Section
    mark="§2"
    label={home.builds.kicker}
    refLine={{ strong: home.builds.ref, text: home.builds.why }}
    next={home.builds.next}
    grid
  >
    <p class="block-h2">{home.builds.h2}</p>
    <p class="hint">{home.builds.hint}</p>
    <BuildsLedger variant="compact" />
    <p class="close-line">{home.builds.closeLine}</p>
    <p class="all-link"><a href={home.builds.allLink.href}>{home.builds.allLink.label}</a></p>
  </Section>

  <Section
    mark="§3"
    label={contributions.kicker}
    refLine={{ strong: home.contribRef, text: home.contribWhy }}
    next={home.contribNext}
  >
    <p class="contrib-dek">{contributions.dek}</p>
    <ContributionGraph />
  </Section>

  <Section mark="§4" label={home.howIWorkLabel} refLine={{ strong: home.methodsRef, text: home.methodsWhy }}>
    <ol class="methods" role="list">
      {
        home.methods.map((m) => (
          <li class="method">
            <p class="method-n" aria-hidden="true">{m.n}</p>
            <h3 class="method-name">{m.name}</h3>
            <p class="method-desc">{m.description}</p>
          </li>
        ))
      }
    </ol>
    <div class="autonomy">
      <PullQuote rule="red">{home.autonomyQuote}</PullQuote>
      <p class="autonomy-src">
        {home.autonomySource.pre} <a href={home.autonomySource.href}>{home.autonomySource.label}</a>
      </p>
    </div>
  </Section>

  <div class="back-to-fig0 grid-margin">
    <div class="margin-col" aria-hidden="true"></div>
    <p class="body-col">
      <strong>{home.backToFig0.strong}</strong>
      {home.backToFig0.text} <a href="#fig-0">{home.backToFig0.link}</a>
    </p>
  </div>

  <CTASlab
    marginLines={[home.ctaSlabMarginNow, home.ctaSlabMarginBefore]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

<style>
  /* ---------- hero: H1 beside Fig. 0 on desktop, Fig. 0 under it on phones ---------- */
  .hero {
    border-bottom: var(--line-ink);
  }

  .has-grid {
    background-image:
      linear-gradient(var(--grid-ink) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-ink) 1px, transparent 1px);
    background-size: var(--grid-step) var(--grid-step);
    background-position: -1px -1px;
  }

  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, 1fr);
    grid-template-areas:
      'eyebrow fig'
      'h1 fig'
      'lower fig';
    grid-template-rows: auto auto 1fr;
    column-gap: var(--s-11);
    padding: var(--s-9) var(--gutter) var(--s-11);
  }

  .eyebrow {
    grid-area: eyebrow;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: var(--lh-label);
    margin-bottom: var(--s-6);
  }

  .hero-h1 {
    grid-area: h1;
    font-family: var(--font-display);
    color: var(--ink);
    margin-bottom: var(--s-8);
  }

  /* D-04: the display moment, up to 136px at 1440 beside Fig. 0 (measured: two
     lines, 591px of a 634px column at 1440; 9.4vw keeps the same ratio down to 900). */
  .hero-h1 .line1 {
    display: block;
    font-size: var(--t-display);
    line-height: 0.96;
    letter-spacing: var(--track-display);
  }

  .hero-h1 .line2 {
    display: block;
    margin-top: var(--s-4);
    font-size: var(--t-answer);
    line-height: var(--lh-title);
    font-style: italic;
    letter-spacing: var(--track-tight);
    max-width: 18ch;
  }

  .nowrap {
    white-space: nowrap;
  }

  .underline-wrap {
    position: relative;
    display: inline-block;
  }

  /* The one exception to the line tiers (DESIGN v3 §b rule 4): the pen at
     display scale, 0.03em. Final state in CSS; the motion layer draws it. */
  .underline {
    position: absolute;
    left: 0;
    bottom: 0.04em;
    width: 100%;
    height: 0.03em;
    min-height: 2px;
    background: var(--red);
    transform-origin: left;
  }

  .unflagged {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--red-ink);
    vertical-align: super;
    margin-left: 0.15em;
  }

  .hero-fig {
    grid-area: fig;
    align-self: start;
    min-width: 0;
  }

  .hero-lower {
    grid-area: lower;
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    column-gap: var(--s-7);
    align-items: start;
  }

  .portrait :global(.headshot) {
    width: 176px;
  }

  .portrait figcaption {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  .subhead {
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--ink-body);
    max-width: var(--measure);
  }

  .highlight {
    background-image: linear-gradient(transparent 62%, var(--red-tint) 62%);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .cta-note {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  @media (max-width: 1099px) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr) minmax(280px, .9fr);
      column-gap: var(--s-8);
    }

    .hero-lower {
      grid-template-columns: 1fr;
      row-gap: var(--s-5);
    }

    .portrait {
      display: grid;
      grid-template-columns: 120px 1fr;
      column-gap: var(--s-4);
      align-items: end;
    }

    .portrait :global(.headshot) {
      width: 120px;
    }
  }

  @media (max-width: 899px) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'eyebrow'
        'h1'
        'fig'
        'lower';
      grid-template-rows: none;
      padding-top: var(--s-7);
    }

    .hero-h1 {
      margin-bottom: var(--s-8);
    }

    .hero-fig {
      margin-bottom: var(--s-9);
    }

    .portrait {
      grid-template-columns: 88px 1fr;
    }

    .portrait :global(.headshot) {
      width: 88px;
    }
  }

  @media (max-width: 599px) {
    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas :global(.rp-button) {
      width: 100%;
    }
  }

  /* ---------- sections ---------- */
  .block-h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 24ch;
    text-wrap: balance;
  }

  .hint {
    margin-block: var(--s-3) var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  .close-line {
    margin-top: var(--s-6);
    max-width: var(--measure);
    color: var(--ink-body);
    line-height: var(--lh-body);
  }

  .all-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-nav);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .contrib-dek {
    line-height: var(--lh-body);
    color: var(--ink-body);
    max-width: var(--measure);
    margin-bottom: var(--s-6);
  }

  :global([data-contrib-graph] .cg-kicker) {
    display: none;
  }

  .methods {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-9) var(--s-8);
  }

  .method {
    border-top: var(--line-heavy);
    padding-top: var(--s-3);
  }

  .method-n {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--red-ink);
  }

  .method-name {
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    color: var(--ink);
  }

  .method-desc {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    line-height: var(--lh-body);
    color: var(--ink-body);
  }

  .autonomy {
    margin-top: var(--s-11);
    max-width: 52ch;
  }

  .autonomy-src {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  .autonomy-src a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .back-to-fig0 .body-col {
    padding-block: var(--s-9);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  .back-to-fig0 strong {
    font-weight: 500;
    color: var(--red-ink);
  }

  .back-to-fig0 a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  @media (max-width: 899px) {
    .methods {
      grid-template-columns: 1fr;
      row-gap: var(--s-8);
    }

    .back-to-fig0 > .margin-col {
      display: none;
    }

    .back-to-fig0 .body-col {
      padding-block: var(--s-8);
    }
  }
</style>

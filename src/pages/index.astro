---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MarginNote from '../components/MarginNote.astro';
import StatRow from '../components/StatRow.astro';
import HarnessLedger from '../components/HarnessLedger.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import Button from '../components/Button.astro';
import Figure from '../components/Figure.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, home, cta, contributions } from '../data/copy';
---

<Base title={meta.home.title} description={meta.home.description} path="/" ogImage="/og/home.png">
  <section class="hero">
    <div class="hero-inner grid-margin">
      <aside class="margin-col" aria-label="Profile photo and role">
        <p class="eyebrow">{home.eyebrow}</p>
        <Figure caption={home.figure1Caption} alt="Zoeb Nomi" eager />
      </aside>
      <div class="body-col">
        <h1 class="hero-h1">
          <span class="line1"
            >LLM products <span class="nowrap"
              >fail <span class="underline-wrap"
                >quietly.<span class="underline" aria-hidden="true"></span></span
              ></span
            > <span class="unflagged" aria-hidden="true">{home.unflaggedMark}</span></span
          >
          <span class="line2">{home.h1Line2}</span>
        </h1>

        <div class="hero-lower">
          <p class="subhead">
            {home.subheadPre}<span class="highlight">{home.subheadHighlight}</span>
          </p>
          <MarginNote>{home.reviewerNote}</MarginNote>
        </div>

        <div class="hero-ctas">
          <Button href={cta.bookACall.href} variant="primary">{cta.bookACall.label}</Button>
          <Button href={cta.email.href} variant="secondary">{cta.email.label}</Button>
          <Button href={cta.linkedin.href} variant="secondary">{cta.linkedin.label}</Button>
        </div>
      </div>
    </div>
  </section>

  <Section mark="§1" label={home.measuredLabel}>
    {home.proofStrip.map((s) => (
      <StatRow value={s.value} verdict={s.verdict} sub={s.sub} label={s.label} provenance={s.provenance} />
    ))}
  </Section>

  <Section mark="§2" label={home.evals.kicker}>
    <HarnessLedger
      variant="compact"
      h2={home.evals.h2}
      methodLine={home.evals.methodLine}
      closeLine={home.evals.closeLine}
    />
  </Section>

  <Section mark="§3" label={contributions.kicker}>
    <p class="contrib-dek">{contributions.dek}</p>
    <ContributionGraph />
  </Section>

  <Section mark="§4" label={home.howIWorkLabel}>
    <ul class="methods">
      {home.methods.map((m) => (
        <li class="method-row">
          <p class="method-n" aria-hidden="true">{m.n}</p>
          <h3 class="method-name">{m.name}</h3>
          <p class="method-desc">{m.description}</p>
        </li>
      ))}
    </ul>
  </Section>

  <CTASlab
    marginLines={[home.ctaSlabMarginNow, home.ctaSlabMarginBefore]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

<style>
  .hero-inner {
    border-bottom: 1px solid var(--rule-strong);
    --body-pad-end: var(--s-11);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: var(--lh-label);
    margin-bottom: var(--s-7);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: var(--t-hero);
    line-height: 0.98;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 18ch;
    margin-bottom: var(--s-8);
  }

  .hero-h1 .line1 {
    display: block;
  }

  .hero-h1 .line2 {
    display: block;
    font-style: italic;
  }

  /* "fail quietly." never splits: "fail" must not be stranded at a line end. */
  .nowrap {
    white-space: nowrap;
  }

  .underline-wrap {
    position: relative;
    display: inline-block;
  }

  .underline {
    position: absolute;
    left: 0;
    bottom: 0.06em;
    width: 100%;
    height: 2px;
    background: var(--rule-accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: draw-underline var(--dur-slow) var(--ease-draw) 250ms forwards;
  }

  @keyframes draw-underline {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .underline {
      animation: none;
      transform: scaleX(1);
    }
  }

  .unflagged {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-body);
    letter-spacing: var(--track-wide);
    color: var(--red-ink);
    vertical-align: super;
    margin-left: 0.15em;
  }

  .hero-lower {
    display: grid;
    grid-template-columns: 1fr 268px;
    gap: var(--s-10);
    margin-bottom: var(--s-9);
  }

  .subhead {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--ink-body);
    max-width: var(--measure);
  }

  .highlight {
    background-image: linear-gradient(transparent 62%, var(--red-tint) 62%);
  }

  .hero-ctas {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .contrib-dek {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--ink-body);
    max-width: 56ch;
    margin-bottom: var(--s-6);
  }

  /* Section's margin-col already carries "PM who ships code" as this
     section's kicker (mark="§3" label={contributions.kicker}) — hide
     ContributionGraph's own internal kicker line so it isn't repeated in
     the body column. The component itself is untouched. */
  :global([data-contrib-graph] .cg-kicker) {
    display: none;
  }

  .methods {
    list-style: none;
  }

  .method-row {
    display: grid;
    grid-template-columns: 46px 260px 1fr;
    gap: var(--s-6);
    align-items: baseline;
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule);
  }

  .method-row:first-child {
    border-top: 0;
  }

  .method-n {
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    color: var(--red-ink);
  }

  .method-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    color: var(--ink);
  }

  .method-desc {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--ink-body);
    max-width: 52ch;
  }

  @media (max-width: 1099px) {
    /* Below 1100px the subhead and the reviewer's note stack, which pushed the
       CTAs under both (below the fold on 900-1099px). CTAs go before the note so
       "Book a call" lands in the first viewport; DOM order (and wide desktop)
       unchanged. */
    .body-col {
      display: flex;
      flex-direction: column;
    }

    .hero-lower {
      display: contents;
    }

    .subhead {
      order: 1;
      margin-bottom: var(--s-6);
    }

    .hero-ctas {
      order: 2;
    }

    .hero-lower > :global(.margin-note) {
      order: 3;
      margin-top: var(--s-7);
    }
  }

  @media (max-width: 899px) {
    /* Kicker left, thumbnail right (Figure.astro dissolves into this grid),
       caption on its own row beneath — the H1 follows straight after. */
    .margin-col {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--s-13);
      column-gap: var(--s-4);
      align-items: start;
      padding: var(--s-5) var(--gutter);
    }

    .eyebrow {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
    }

    .method-row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }

  @media (max-width: 599px) {
    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas :global(.rp-button) {
      width: 100%;
      min-height: 48px;
    }

    .hero-ctas :global(.rp-button:first-child) {
      order: -1;
    }
  }
</style>

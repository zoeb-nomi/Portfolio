---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import DataTable from '../components/DataTable.astro';
import PullQuote from '../components/PullQuote.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, mirrorEval as me, mirrorEvalJsonLd, cta, home } from '../data/copy';

const table1Rows = me.s3.table1.rows.map((r) => ({
  label: r.engine,
  cells: [
    { text: r.site, win: r.bold },
    { text: r.repo, win: r.bold },
    { text: r.owned, win: r.bold },
  ],
}));

const table2Rows = me.s3.table2.rows.map((r) => ({
  label: r.surface,
  cells: [{ text: r.engine }, { text: r.count }],
}));
---

<Base
  title={meta.mirrorEval.title}
  description={meta.mirrorEval.description}
  path="/mirror-eval/"
  ogImage="/og/mirror-eval.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(mirrorEvalJsonLd)} is:inline />

  <section class="masthead">
    <div class="masthead-inner">
      <aside class="margin-col" aria-label="Case study specification">
        <p class="kicker">{me.kicker}</p>
        <dl class="spec-block">
          {me.specBlock.map((s) => (
            <div class="spec-row">
              <dt>{s.label}</dt>
              <dd class="tabular">{s.value}</dd>
            </div>
          ))}
        </dl>
        <a class="repo-link" href={me.repoHref} target="_blank" rel="noopener noreferrer">{me.repoLabel}</a>
      </aside>
      <div class="body-col">
        <h1 class="page-h1">{me.title}</h1>
        <p class="standfirst">{me.standfirst}</p>
      </div>
    </div>
  </section>

  <Section mark={me.s1.mark} label={me.s1.label}>
    <p class="prose">{me.s1.body}</p>
  </Section>

  <Section mark={me.s2.mark} label={me.s2.label}>
    <dl class="method-list">
      {me.s2.rows.map((row) => (
        <div class="method-row">
          <dt>{row.term}</dt>
          <dd>
            {row.kind === 'plain' && row.body}
            {row.kind === 'code' && (
              <>
                {row.bodyPre}
                <code>{row.code}</code>
                {row.bodyPost}
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section mark={me.s3.mark} label={me.s3.label}>
    <p class="prose intro">{me.s3.intro}</p>
    <div class="table-scroll">
      <DataTable caption={me.s3.table1.caption} columns={me.s3.table1.columns} rows={table1Rows} />
    </div>
    <p class="prose table-intro">{me.s3.table2Intro}</p>
    <div class="table-scroll">
      <DataTable caption={me.s3.table2.caption} columns={me.s3.table2.columns} rows={table2Rows} />
    </div>
    <p class="prose finding">
      <strong>{me.s3.findingLeadIn}</strong>{me.s3.findingBody}
    </p>
  </Section>

  <Section mark={me.s4.mark} label={me.s4.label}>
    <p class="prose">{me.s4.para1}</p>
    <p class="prose para2">
      {me.s4.para2Pre}<code>{me.s4.para2Code}</code>{me.s4.para2Post}
    </p>
    <div class="lesson">
      <PullQuote rule="red">{me.s4.lessonQuote}</PullQuote>
    </div>
  </Section>

  <Section mark={me.s5.mark} label={me.s5.label}>
    <p class="prose">{me.s5.body}</p>
  </Section>

  <Section mark={me.s6.mark} label={me.s6.label}>
    <p class="prose">{me.s6.body}</p>
  </Section>

  <Section mark={me.s7.mark} label={me.s7.label}>
    <p class="prose">{me.s7.body}</p>
  </Section>

  <Section mark={me.s8.mark} label={me.s8.label}>
    <p class="prose">{me.s8.body}</p>
    <p class="prose repo-cta">
      {me.repoCta.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <Section mark={me.relatedWriting.mark} label="Related writing">
    <p class="prose related-writing">
      <a href={me.relatedWriting.href}>{me.relatedWriting.text}</a>
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={me.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={me.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    border-bottom: 1px solid var(--rule-strong);
  }

  .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--s-7);
  }

  .spec-block {
    margin-bottom: var(--s-6);
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-data);
  }

  .spec-row:first-child {
    border-top: 0;
  }

  .spec-row dt {
    color: var(--ink-muted);
  }

  .spec-row dd {
    color: var(--ink);
  }

  .repo-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .body-col {
    padding: var(--s-9) var(--gutter) var(--s-11) var(--body-inset);
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--ink);
    margin-bottom: var(--s-6);
    max-width: 26ch;
  }

  .standfirst {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 62ch;
  }

  .prose {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose {
    margin-top: var(--s-6);
  }

  .prose code,
  .method-row code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper-raised);
    padding: 2px 4px;
  }

  .intro {
    margin-bottom: var(--s-5);
  }

  .table-intro {
    margin-top: var(--s-9);
    margin-bottom: var(--s-5);
  }

  /* Table 1's "github.com/zoeb-nomi" column header is one long unbroken
     token — give both findings tables a scroll container rather than let
     it force the page wider on narrow viewports. Grid items default to
     min-width: auto (content-based), so the Section body-col itself has to
     be told it is allowed to shrink below the table's content width before
     overflow-x: auto on .table-scroll can do anything. */
  .table-scroll {
    overflow-x: auto;
    max-width: 100%;
  }

  :global(.rp-section .body-col) {
    min-width: 0;
  }

  .related-writing a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .method-list {
    display: flex;
    flex-direction: column;
  }

  .method-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .method-row:first-child {
    border-top: 0;
  }

  .method-row dt {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .method-row dd {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-body);
    max-width: 60ch;
  }

  .finding {
    margin-top: var(--s-8);
  }

  .lesson {
    margin-top: var(--s-8);
  }

  .repo-cta {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
  }

  .repo-cta a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .repo-cta .sep {
    color: var(--ink-muted);
  }

  @media (max-width: 899px) {
    .masthead-inner {
      grid-template-columns: 1fr;
    }

    .margin-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: var(--s-6) var(--gutter);
    }

    .body-col {
      padding: var(--s-7) var(--gutter);
    }

    .method-row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import '../styles/case-study.css';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import DataTable from '../components/DataTable.astro';
import PullQuote from '../components/PullQuote.astro';
import CTASlab from '../components/CTASlab.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import EssayFigure from '../components/EssayFigure.astro';
import EvidenceStack from '../components/EvidenceStack.astro';
import Dumbbell from '../components/Dumbbell.astro';
import UnitChart from '../components/UnitChart.astro';
import { meta, mirrorEval as me, mirrorEvalJsonLd, cta, home } from '../data/copy';
import { jsonLdString } from '../lib/jsonLdString';
import { waveData, vacuumData, judgeData } from '../lib/figureData';

const waves = waveData();
const vacuum = vacuumData();
const judge = judgeData();

const table1Rows = me.s3.table1.rows.map((r) => ({
  label: r.engine,
  cells: [
    { text: r.site, win: r.bold },
    { text: r.repo, win: r.bold },
    { text: r.owned, win: r.bold },
  ],
}));

const table2Rows = me.s3.table2.rows.map((r) => ({
  label: r.surface,
  cells: [{ text: r.engine }, { text: r.count }],
}));
---

<Base
  title={meta.mirrorEval.title}
  description={meta.mirrorEval.description}
  path="/mirror-eval/"
  ogImage="/og/mirror-eval.png"
>
  <script type="application/ld+json" set:html={jsonLdString(mirrorEvalJsonLd)} is:inline />

  <Masthead
    label="Case study specification"
    kicker={me.kicker}
    h1={me.title}
    standfirst={me.standfirst}
    h1Max="26ch"
    spec={me.specBlock}
    switcher="mirror-eval"
    repo={{ href: me.repoHref, label: me.repoLabel }}
    narr
  >
    {me.audio && <AudioPlayer audio={me.audio} articleId="mirror-eval" />}
    <EssayFigure n={1} replay title="Every engine, every search probe" source="Source: Table 1 below, the owned (site or repo) column. Squares are grouped by outcome, so a square's position is not a probe id.">
      <EvidenceStack engines={waves.rows} of={waves.of} fromLabel={waves.fromLabel} toLabel={waves.toLabel} />
    </EssayFigure>
  </Masthead>

  <Section mark={me.s1.mark} label={me.s1.label} narrId="s1-cue">
    <p class="prose" data-narr="s1-p0">{me.s1.body}</p>
  </Section>

  <Section mark={me.s2.mark} label={me.s2.label} narrId="s2-cue">
    <dl class="method-list" data-narr="s2-list">
      {me.s2.rows.map((row) => (
        <div class="method-row">
          <dt>{row.term}</dt>
          <dd>
            {row.kind === 'plain' && row.body}
            {row.kind === 'code' && (
              <>
                {row.bodyPre}
                <code>{row.code}</code>
                {row.bodyPost}
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section mark={me.s3.mark} label={me.s3.label} narrId="s3-cue">
    <p class="prose intro" data-narr="s3-p0">{me.s3.intro}</p>
    <EssayFigure n={2} replay title="Probes citing my site or repo, by engine" source="Source: Table 1 below, the owned (site or repo) column.">
      <Dumbbell rows={waves.rows} max={waves.max} ticks={waves.ticks} fromLabel={waves.fromLabel} toLabel={waves.toLabel} unit={`of ${waves.of}`} />
    </EssayFigure>
    <div class="table-scroll" data-narr="s3-table1">
      <DataTable nowrap caption={me.s3.table1.caption} columns={me.s3.table1.columns} rows={table1Rows} />
    </div>
    <p class="prose table-intro" data-narr="s3-p1">{me.s3.table2Intro}</p>
    <EssayFigure n={3} replay title="What filled the gap" source="Source: Table 2 below. Each group has its own scale.">
      {vacuum.groups.map((g, gi) => (
        <Dumbbell showKey={gi === 0} heading={g.heading} rows={g.rows} max={g.max} ticks={g.ticks} fromLabel={vacuum.fromLabel} toLabel={vacuum.toLabel} />
      ))}
    </EssayFigure>
    <div class="table-scroll" data-narr="s3-table2">
      <DataTable nowrap caption={me.s3.table2.caption} columns={me.s3.table2.columns} rows={table2Rows} />
    </div>
    <p class="prose finding" data-narr="s3-p2">
      <strong>{me.s3.findingLeadIn}</strong>{me.s3.findingBody}
    </p>
  </Section>

  <Section mark={me.s4.mark} label={me.s4.label} narrId="s4-cue">
    <p class="prose" data-narr="s4-p0">{me.s4.para1}</p>
    <EssayFigure n={4} replay title="The judges against a blind human" source="Source: this section and the CrossSource blind check. A filled square is a judge output that agreed with the human label: the exact tag set in mirror-eval, the citation-precision verdict in CrossSource.">
      <UnitChart rows={judge.rows} cols={judge.cols} filledMeans="matched the human" emptyMeans="did not match" />
    </EssayFigure>
    <p class="prose" data-narr="s4-p1">
      {me.s4.para2Pre}<code>{me.s4.para2Code}</code>{me.s4.para2Post}
    </p>
    <div class="lesson" data-narr="s4-quote">
      <PullQuote rule="red">{me.s4.lessonQuote}</PullQuote>
    </div>
  </Section>

  <Section mark={me.s5.mark} label={me.s5.label} narrId="s5-cue">
    <p class="prose" data-narr="s5-p0">{me.s5.body}</p>
  </Section>

  <Section mark={me.s6.mark} label={me.s6.label} narrId="s6-cue">
    <p class="prose" data-narr="s6-p0">{me.s6.body}</p>
  </Section>

  <Section mark={me.s7.mark} label={me.s7.label} narrId="s7-cue">
    <p class="prose" data-narr="s7-p0">{me.s7.body}</p>
  </Section>

  <Section mark={me.s8.mark} label={me.s8.label} narrId="s8-cue">
    <p class="prose" data-narr="s8-p0">{me.s8.body}</p>
    <p class="prose repo-cta">
      {me.repoCta.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        </>
      ))}
    </p>
  </Section>

  <Section mark={me.relatedWriting.mark} label="Related writing">
    <p class="prose related-writing">
      <a href={me.relatedWriting.href}>{me.relatedWriting.text}</a>
    </p>
    <p class="prose related-writing">
      <a href={me.relatedScreenerEval.href}>{me.relatedScreenerEval.text}</a>
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={me.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={me.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

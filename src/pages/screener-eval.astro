---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import DataTable from '../components/DataTable.astro';
import PullQuote from '../components/PullQuote.astro';
import CTASlab from '../components/CTASlab.astro';
import EvalsSwitcher from '../components/EvalsSwitcher.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { meta, screenerEval as se, screenerEvalJsonLd, cta, home } from '../data/copy';

const table1Rows = se.s3.table1.rows.map((r) => ({
  label: r.lever,
  cells: [{ text: r.screener }, { text: r.delta }, { text: r.ci }, { text: r.p }],
}));

const table2Rows = se.s3.table2.rows.map((r) => ({
  label: r.measure,
  cells: [{ text: r.haiku }, { text: r.gpt }],
}));

const table3Rows = se.s5.table.rows.map((r) => ({
  label: r.parser,
  cells: [{ text: r.v41 }, { text: r.v42 }],
}));
---

<Base
  title={meta.screenerEval.title}
  description={meta.screenerEval.description}
  path="/screener-eval/"
  ogImage="/og/screener-eval.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(screenerEvalJsonLd)} is:inline />

  <section class="masthead">
    <div class="masthead-inner">
      <aside class="margin-col" aria-label="Case study specification">
        <p class="kicker">{se.kicker}</p>
        <dl class="spec-block" data-narr="s0-stats">
          {se.specBlock.map((s) => (
            <div class="spec-row">
              <dt>{s.label}</dt>
              <dd class="tabular">{s.value}</dd>
            </div>
          ))}
        </dl>
        <EvalsSwitcher current="screener-eval" />
        <a class="repo-link" href={se.repoHref} target="_blank" rel="noopener noreferrer">{se.repoLabel}</a>
      </aside>
      <div class="body-col">
        <h1 class="page-h1" data-narr="s0-title">{se.title}</h1>
        <p class="standfirst" data-narr="s0-dek">{se.standfirst}</p>
        {se.audio && <AudioPlayer audio={se.audio} articleId="screener-eval" />}
      </div>
    </div>
  </section>

  <Section mark={se.s1.mark} label={se.s1.label} narrId="s1-cue">
    <p class="prose" data-narr="s1-p0">{se.s1.body}</p>
  </Section>

  <Section mark={se.s2.mark} label={se.s2.label} narrId="s2-cue">
    <dl class="method-list" data-narr="s2-list">
      {se.s2.rows.map((row) => (
        <div class="method-row">
          <dt>{row.term}</dt>
          <dd>
            {row.parts.map((part) => {
              if ('code' in part) return <code>{part.code}</code>;
              if ('strong' in part) return <strong>{part.strong}</strong>;
              return part.text;
            })}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section mark={se.s3.mark} label={se.s3.label} narrId="s3-cue">
    <p class="prose intro" data-narr="s3-p0">{se.s3.intro}</p>
    <div class="table-scroll" data-narr="s3-table1">
      <DataTable caption={se.s3.table1.caption} columns={se.s3.table1.columns} rows={table1Rows} />
    </div>
    <p class="prose table-intro" data-narr="s3-p1">{se.s3.table2Intro}</p>
    <div class="table-scroll" data-narr="s3-table2">
      <DataTable caption={se.s3.table2.caption} columns={se.s3.table2.columns} rows={table2Rows} />
    </div>
    <p class="prose between" data-narr="s3-p2">{se.s3.betweenScreeners}</p>
    <p class="prose finding" data-narr="s3-p3">
      <strong>{se.s3.findingLeadIn}</strong>{se.s3.findingBody}
    </p>
    <div class="lesson" data-narr="s3-quote">
      <PullQuote rule="red">{se.s3.lessonQuote}</PullQuote>
    </div>
  </Section>

  <Section mark={se.s4.mark} label={se.s4.label} narrId="s4-cue">
    <p class="prose" data-narr="s4-p0">{se.s4.body}</p>
  </Section>

  <Section mark={se.s5.mark} label={se.s5.label} narrId="s5-cue">
    <p class="prose intro" data-narr="s5-p0">{se.s5.intro}</p>
    <div class="table-scroll" data-narr="s5-table">
      <DataTable caption={se.s5.table.caption} columns={se.s5.table.columns} rows={table3Rows} />
    </div>
    <p class="prose close" data-narr="s5-p1">{se.s5.close}</p>
  </Section>

  <Section mark={se.s6.mark} label={se.s6.label} narrId="s6-cue">
    <p class="prose" data-narr="s6-p0">{se.s6.body}</p>
  </Section>

  <Section mark={se.s7.mark} label={se.s7.label} narrId="s7-cue">
    <p class="prose" data-narr="s7-p0">{se.s7.body}</p>
  </Section>

  <Section mark={se.s8.mark} label={se.s8.label} narrId="s8-cue">
    <p class="prose" data-narr="s8-p0">{se.s8.body}</p>
    <p class="prose repo-cta">
      <a href={se.repoCta.href} target="_blank" rel="noopener noreferrer">{se.repoCta.label}</a>
    </p>
  </Section>

  <Section mark={se.relatedWriting.mark} label="Related writing">
    <p class="prose related-writing">
      <a href={se.relatedWriting.href}>{se.relatedWriting.text}</a>
    </p>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={se.ctaSlabBody}
    buttonLabel="View the repo →"
    buttonHref={se.repoHref}
    secondaryLabel={cta.bookACall.label}
    secondaryHref={cta.bookACall.href}
  />
</Base>

<style>
  .masthead-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
    border-bottom: 1px solid var(--rule-strong);
  }

  .margin-col {
    border-right: 1px solid var(--rule);
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--s-7);
  }

  .spec-block {
    margin-bottom: var(--s-6);
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-data);
  }

  .spec-row:first-child {
    border-top: 0;
  }

  .spec-row dt {
    color: var(--ink-muted);
  }

  .spec-row dd {
    color: var(--ink);
  }

  .repo-link {
    display: inline-block;
    /* Hit area >= 24px tall (WCAG 2.5.8): padding added, margin-top reduced by
       the same amount so the layout does not move. */
    padding-block: var(--s-1);
    min-height: 24px;
    margin-top: calc(var(--s-6) - var(--s-1));
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .body-col {
    /* min-width: 0 so the audio player's chapter-chip row (flex-nowrap +
       overflow-x: auto) can scroll on its own instead of stretching this
       grid item once chapters are filled in. */
    min-width: 0;
    padding: var(--s-9) var(--gutter) var(--s-11) var(--body-inset);
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: 1.02;
    letter-spacing: -.015em;
    color: var(--ink);
    margin-bottom: var(--s-6);
    max-width: 26ch;
  }

  .standfirst {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 62ch;
  }

  .prose {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .prose + .prose {
    margin-top: var(--s-6);
  }

  .prose code,
  .method-row code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--paper-raised);
    padding: 2px 4px;
  }

  .intro {
    margin-bottom: var(--s-5);
  }

  .table-intro {
    margin-top: var(--s-9);
    margin-bottom: var(--s-5);
  }

  .between {
    margin-top: var(--s-8);
  }

  .finding {
    margin-top: var(--s-8);
  }

  .close {
    margin-top: var(--s-6);
  }

  /* Findings and parser tables can carry long tokens (repo paths, four-part
     counts) — give them a scroll container rather than let the page grow
     wider on narrow viewports. */
  .table-scroll {
    overflow-x: auto;
    max-width: 100%;
  }

  :global(.rp-section .body-col) {
    min-width: 0;
  }

  .related-writing a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .method-list {
    display: flex;
    flex-direction: column;
  }

  .method-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .method-row:first-child {
    border-top: 0;
  }

  .method-row dt {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .method-row dd {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-body);
    max-width: 60ch;
  }

  .lesson {
    margin-top: var(--s-8);
  }

  .repo-cta {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
  }

  .repo-cta a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 899px) {
    .masthead-inner {
      grid-template-columns: 1fr;
    }

    .margin-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: var(--s-6) var(--gutter);
    }

    .body-col {
      padding: var(--s-7) var(--gutter);
    }

    .method-row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
  }
</style>

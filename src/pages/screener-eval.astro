---
import Base from '../layouts/Base.astro';
import '../styles/case-study.css';
import AudioPlayer from '../components/AudioPlayer.astro';
import CaseTabs from '../components/CaseTabs.astro';
import CsHead from '../components/CsHead.astro';
import CsSection from '../components/CsSection.astro';
import CsStrip from '../components/CsStrip.astro';
import CsSpecList from '../components/CsSpecList.astro';
import CsLegend from '../components/CsLegend.astro';
import CsTable from '../components/CsTable.astro';
import CsCall from '../components/CsCall.astro';
import CsList from '../components/CsList.astro';
import CsLinks from '../components/CsLinks.astro';
import CsContact from '../components/CsContact.astro';
import CsParts from '../components/CsParts.astro';
import { meta, screenerEval as se, screenerEvalJsonLd, pipelineCaseStudies as P } from '../data/copy';
import { jsonLdString } from '../lib/jsonLdString';
import { screenerFig, rich, screenerParts } from '../lib/caseStudy';

const x = P.screenerEval;
const s = screenerFig();
const v = x.variable;
const vf = v.fig;
const pf = x.parser.fig;
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const pc = (n: number) => `${Number(n.toFixed(3))}%`;
const total = s.parsers.total;
const CLS = ['f', '', 'r', 'g'];
const parserTile = (counts: number[], i: number) => {
  const edges = [counts[0], counts[0] + counts[1], counts[0] + counts[1] + counts[2], total];
  const k = edges.findIndex((e) => i < e);
  return k < 0 ? '' : CLS[k];
};
const bands = [
  { key: 'haiku', cls: 'se-b-h', stat: s.haiku },
  { key: 'gpt', cls: 'se-b-g', stat: s.gpt },
];
const flipRows = [
  { key: 'haiku', name: s.haiku.name, sub: vf.flipSub, r: s.flips.rows[0], ink: false },
  { key: 'gpt', name: s.gpt.name, sub: vf.flipSub, r: s.flips.rows[1], ink: false },
  { key: 'both', name: vf.both, sub: vf.bothSub, r: s.flips.rows[2], ink: true },
];
const readouts = {
  haiku: { t: s.haiku.name, r: s.haiku.readout, lab: vf.labels },
  gpt: { t: s.gpt.name, r: s.gpt.readout, lab: vf.labels },
  both: { t: vf.between, r: s.bothReadout, lab: vf.bothLabels },
};
const nullItems = x.nullSec.groups.map((g, i) => rich(g.map((n) => s.nullSentences[n]).join(' '), [x.nullSec.marks[i]]));
const nullDek = x.nullSec.dek.map((n) => s.nullSentences[n]).join(' ');
const t2rows = se.s3.table2.rows;
---

<Base
  title={meta.screenerEval.title}
  description={meta.screenerEval.description}
  path="/screener-eval/"
  ogImage="/og/screener-eval.png"
  page="builds"
>
  <script type="application/ld+json" set:html={jsonLdString(screenerEvalJsonLd)} is:inline />

  <CaseTabs current={2} repoHref={se.repoHref} repoLabel={se.repoLabel} />

  <CsHead kick={x.kick} h1={x.h1} find={rich(se.standfirst, x.findMarks)} hud={x.hud}>
    <div slot="find" class="se-shock" id="se-shock" role="img" aria-label={x.shock.aria}>
      {s.shock.map((r, i) => (
        <div class:list={['se-sr', r.red && 'se-big']}>
          <p class="se-sl">{x.shock.labels[i]}</p>
          <div class="se-st"><i class={r.red ? 'r' : undefined} style={`--k:${r.k}`}></i></div>
          <p class="se-sv">{r.text}</p>
        </div>
      ))}
      <div class="se-ax" aria-hidden="true"><span>{x.shock.axis[0]}</span><span>{x.shock.axis[1]}</span></div>
    </div>
    {se.audio && <AudioPlayer audio={se.audio} articleId="screener-eval" />}
  </CsHead>

  <CsSection id="why" kick={x.why.kick} h2={x.why.h2} wide>
    <Fragment slot="dek">{se.s1.body}</Fragment>
  </CsSection>

  <CsSection id="method" kick={x.method.kick} h2={x.method.h2}>
    <Fragment slot="dek"><CsParts parts={rich(x.method.dek, x.method.dekMarks)} /></Fragment>
    <CsStrip steps={x.method.steps} />
    <CsSpecList label={P.shared.methodDetail} items={se.s2.rows.map((r) => ({ dt: r.term, parts: screenerParts(r.parts) }))} />
  </CsSection>

  <CsSection id="findings" kick={x.findings.kick} h2={x.findings.h2}>
    <Fragment slot="dek"><CsParts parts={rich(x.findings.dek, x.findings.dekMarks)} /></Fragment>

    <figure class="cs-fig" id="se-forest">
      <div class="cs-fig-top">
        <p class="cs-fig-t"><span class="fno">{P.shared.figNo} 1</span>{x.findings.fig.title}</p>
        <CsLegend items={x.findings.fig.legend} />
      </div>
      <div class="cs-fig-body">
        <div class="se-fp">
          {s.forest.map((grp, gi) => (
            <>
              <p class="lab se-grp">{x.findings.fig.groups[gi]}</p>
              {grp.map((r) => (
                <div class="se-row">
                  <p class="se-rl">{r.screener}</p>
                  <div class="se-tr"><i class="se-ci" style={`--a:${pc(r.a)};--b:${pc(r.b)}`}></i><i class="se-dot" style={`--m:${pc(r.m)}`}></i></div>
                  <p class="se-rv">{r.delta} <small>{r.ci}</small></p>
                </div>
              ))}
            </>
          ))}
          <div class="se-row se-axr" aria-hidden="true">
            <p></p>
            <div class="se-tr se-axis">{x.findings.fig.axis.map((a, i) => <span style={`left:${i * 25}%`}>{a}</span>)}</div>
            <p></p>
          </div>
        </div>
      </div>
      <figcaption class="cs-fig-foot">{x.findings.fig.foot.map((t) => <span>{t}</span>)}</figcaption>
    </figure>

    <p class="cs-lead">{se.s3.intro}</p>
    <CsTable
      caption={se.s3.table1.caption}
      columns={se.s3.table1.columns}
      textCols={2}
      rows={se.s3.table1.rows.map((r) => ({ cells: [r.lever, r.screener, r.delta, r.ci, r.p] }))}
    />
  </CsSection>

  <CsSection id="screener" kick={v.kick} h2={se.s3.lessonQuote}>
    <Fragment slot="dek"><CsParts parts={rich(v.dek, v.dekMarks)} /></Fragment>

    <figure class="cs-fig" id="se-stab" data-readouts={JSON.stringify(readouts)}>
      <div class="cs-fig-top">
        <p class="cs-fig-t"><span class="fno">{P.shared.figNo} 2</span>{vf.title}</p>
        <CsLegend items={vf.legend} />
      </div>
      <div class="cs-fig-body">
        <div class="se-scale" aria-hidden="true">
          {bands.map((b) => (
            <div class={`se-band ${b.cls}`} data-s={b.key} style={`--m:${s.gapPct[b.key === 'haiku' ? 'a' : 'b']}%;--sd:${b.stat.sd}%`}>
              <i class="se-sd"></i><i class="se-mn"></i><span>{b.stat.name} · {b.stat.mean} ± {b.stat.sd}</span>
            </div>
          ))}
          <div class="se-gap" style={`--a:${s.gapPct.a}%;--b:${s.gapPct.b}%`}></div>
          <div class="se-ticks">{vf.ticks.map((t) => <span style={`left:${t}%`}>{t}</span>)}</div>
        </div>
        <p class="se-gapl"><span class="se-gk" aria-hidden="true"></span>{vf.gapLead} <b>{s.gap.mean}</b> · {vf.gapLargest} <b>{s.gap.largest}</b> · {vf.gapHigher} {s.gap.higher} {vf.postings}</p>
        <p class="cs-note se-sn">{vf.scaleNote}</p>
        <div class="se-stab">
          <div class="se-flips" id="se-flips">
            {flipRows.map((f) => (
              <button type="button" class="se-fr" data-s={f.key} data-k={f.r.filled} data-ink={f.ink ? '1' : undefined}>
                <span class="se-fn">{f.name}<small>{f.sub}</small></span>
                <span class="cs-tiles se-ft" aria-hidden="true">
                  {range(f.r.of).map((i) => <span class={`cs-t ${i < f.r.filled ? (f.ink ? 'f' : 'r') : ''}`}></span>)}
                </span>
                <span class="se-fv"><b>{f.r.filled}</b> of {f.r.of}</span>
              </button>
            ))}
          </div>
          <aside class="se-read" aria-live="polite">
            <p class="lab">{vf.readout}</p>
            <p class="se-rt" id="se-rt">{s.haiku.name}</p>
            <dl class="se-rd" id="se-rd">
              {vf.labels.map((l, i) => <div><dt>{l}</dt><dd id={`se-r${i + 1}`}>{s.haiku.readout[i]}</dd></div>)}
            </dl>
          </aside>
        </div>
      </div>
      <figcaption class="cs-fig-foot">{vf.foot.map((t) => <span>{t}</span>)}</figcaption>
    </figure>

    <p class="cs-lead">{se.s3.table2Intro}</p>
    <CsTable
      caption={se.s3.table2.caption}
      columns={se.s3.table2.columns}
      rows={t2rows.map((r, i) => ({ cells: [r.measure, r.haiku, r.gpt], win: [false, false, i === t2rows.length - 1] }))}
    />

    <p class="cs-body">{se.s3.betweenScreeners}</p>

    <CsCall label={se.s3.findingLeadIn.replace(/:$/, '')} long>{cap(se.s3.findingBody.trimStart())}</CsCall>
  </CsSection>

  <CsSection id="null" kick={x.nullSec.kick} h2={x.nullSec.h2}>
    <Fragment slot="dek">{nullDek}</Fragment>
    <CsList kind="lim" items={nullItems} />
  </CsSection>

  <CsSection id="parser" kick={x.parser.kick} h2={x.parser.h2}>
    <Fragment slot="dek">{se.s5.intro}</Fragment>

    <figure class="cs-fig" id="se-parse" data-words={JSON.stringify(pf.counts)} data-total={total}>
      <div class="cs-fig-top">
        <p class="cs-fig-t"><span class="fno">{P.shared.figNo} 3</span>{pf.title}</p>
        <div class="cs-seg" role="group" aria-label={pf.toggleLabel}>
          <button type="button" data-v="v41" aria-pressed="false">{pf.v41}</button>
          <button type="button" data-v="v42" aria-pressed="true">{pf.v42}</button>
        </div>
      </div>
      <div class="cs-fig-body">
        <div class="se-pp">
          {s.parsers.rows.map((r, ri) => (
            <div class="se-pr" data-v41={r.v1.join(',')} data-v42={r.v2.join(',')}>
              <p class="se-pn">{r.label}<small>{r.sub}{ri === 0 && ` · ${pf.identical}`}</small></p>
              <div class="cs-tiles se-pt" aria-hidden="true">
                {range(total).map((i) => <span class={`cs-t ${parserTile(r.v2, i)}`}></span>)}
              </div>
              <p class="se-pv">{r.v2.map((n, i) => `${n} ${pf.counts[i]}`).join(' · ')}</p>
            </div>
          ))}
        </div>
        <CsLegend items={pf.legend} below />
      </div>
      <figcaption class="cs-fig-foot">{pf.foot.map((t) => <span>{t}</span>)}</figcaption>
    </figure>

    <CsTable
      caption={se.s5.table.caption}
      columns={se.s5.table.columns}
      rows={se.s5.table.rows.map((r) => ({ cells: [r.parser, r.v41, r.v42] }))}
    />

    <CsCall label={x.parser.calloutLabel} long>{s.close.slice(0, 3).join(' ')}</CsCall>
    <p class="cs-note">{s.close[3]}</p>
  </CsSection>

  <CsSection id="limits" kick={x.limits.kick} h2={x.limits.h2}>
    <CsList kind="lim" items={s.limits.map((t, i) => rich(t, [x.limits.marks[i]]))} />
  </CsSection>

  <CsSection id="any-agent" kick={x.rules.kick} h2={x.rules.h2} wide>
    <Fragment slot="dek">{se.s6.body}</Fragment>
    <CsList kind="rules" items={x.rules.items.map((t) => [{ text: t }])} />
    <p class="cs-note cs-next">{se.s8.label}: {se.s8.body}</p>
  </CsSection>

  <CsSection id="code" kick={x.code.kick} h2={se.ctaSlabBody}>
    <CsLinks links={x.code.links.map((l) => ({ ...l, href: se.repoCta.href }))} />
    <div class="cs-related">
      <p class="lab">{P.shared.related}</p>
      <CsLinks sub links={x.code.related} />
    </div>
  </CsSection>

  <CsContact />
</Base>

<script>
  import { initScreenerEval } from '../scripts/case-study';
  initScreenerEval();
</script>

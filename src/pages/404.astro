---
// 404 (The Pipeline): a page-head, the one square of twelve that is missing, and the ways out as kit rows.
import Base from '../layouts/Base.astro';
import { notFound } from '../data/copy';
---

<Base title="404 · Zoeb Nomi" description="Page not found." path="/404/" ogImage="/og/404.png" noindex>
  <section class="page-head gut">
    <div class="in">
      <p class="kick">404</p>
      <h1 class="display split">{notFound.message}</h1>
      <div class="miss" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => <span class:list={['miss-cell', { 'is-missing': i === 7 }]} />)}
      </div>
      <p class="id miss-caption">{notFound.caption}</p>
    </div>
  </section>

  <section class="sec gut">
    <div class="in">
      <ol class="blist" data-stagger>
        {
          notFound.links.map((l) => (
            <li>
              <a class="build exit" href={l.href}>
                <span class="bn">{l.label}</span>
                <span class="ba" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .miss {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, var(--s-6)));
    gap: var(--s-1);
    inline-size: 100%;
    max-inline-size: 24rem;
    margin-top: var(--s-7);
  }

  .miss-cell {
    aspect-ratio: 1;
    border: var(--line-object);
    background: var(--color-text);
  }

  /* The page you asked for: drawn as an outline, because it is not there. */
  .miss-cell.is-missing {
    border: var(--line-propose);
    background: transparent;
  }

  .miss-caption {
    margin-top: var(--s-3);
  }

  /* One exit per row: the name and the arrow. */
  .exit {
    grid-template-columns: minmax(0, 1fr) 30px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { notFound } from '../data/copy';
---

<Base
  title="404 — Zoeb Nomi"
  description="Page not found."
  path="/404/"
  ogImage="/og/404.png"
  noindex
>
  <section class="not-found">
    <h1 class="code">{notFound.message}</h1>
    <div class="miss" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => <span class={`miss-cell${i === 7 ? ' is-missing' : ''}`} />)}
    </div>
    <p class="miss-caption">{notFound.caption}</p>
    <ul class="exits">
      {notFound.links.map((l) => <li><a class="home-link" href={l.href}>{l.label} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  </section>
</Base>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--s-6);
    padding: var(--s-13) var(--gutter);
  }

  /* Same setting as every other page h1 (Masthead .page-h1). */
  .code {
    font-family: var(--font-display);
    font-size: var(--t-page);
    line-height: var(--lh-display);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
  }

  .miss {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, var(--s-6)));
    gap: var(--s-1);
    inline-size: 100%;
    max-inline-size: 24rem;
  }

  .miss-cell {
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    background: var(--ink);
  }

  .miss-cell.is-missing {
    border: 2px dashed var(--red);
    background: transparent;
  }

  .miss-caption {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-muted);
  }

  .exits {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-link {
    /* Each way out of a dead end is a full 44px target. */
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    color: var(--ink);
  }

  .home-link:hover {
    color: var(--red-ink);
  }
</style>

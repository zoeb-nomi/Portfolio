---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import HarnessLedger from '../components/HarnessLedger.astro';
import DataTable from '../components/DataTable.astro';
import PullQuote from '../components/PullQuote.astro';
import CTASlab from '../components/CTASlab.astro';
import { meta, home, cta, evalsLedger } from '../data/copy';

// One table row per ledger entry — a fourth harness adds a row here too.
const tableRows = evalsLedger.map((e) => ({
  label: e.name,
  cells: [
    { text: e.question },
    { text: e.table.judge },
    { text: e.table.metric },
    { text: e.table.sample },
    { text: e.table.verdict },
  ],
}));
---

<Base title={meta.evals.title} description={meta.evals.description} path="/evals/" ogImage="/og/evals.png">
  <Masthead
    kicker={home.evals.kicker}
    h1={home.evals.h2}
    standfirst={home.evals.standfirst}
    h1Max="20ch"
    standfirstMax="58ch"
  />

  <Section mark="§1" label={home.evals.ledgerLabel}>
    <HarnessLedger entries={evalsLedger} closeLine={home.evals.closeLine} />
  </Section>

  <Section mark="§2" label={home.evals.tableLabel}>
    <div class="compare">
      <DataTable caption={home.evals.tableCaption} columns={home.evals.tableColumns} rows={tableRows} />
    </div>
    <div class="method-strip">
      <PullQuote rule="ink">{home.evals.methodLine}</PullQuote>
    </div>
  </Section>

  <CTASlab
    marginLines={[home.eyebrow.toUpperCase()]}
    body={home.ctaSlabBody}
    buttonLabel={cta.bookACall.label}
    buttonHref={cta.bookACall.href}
  />
</Base>

<style>
  /* The comparison table is prose in cells, not numerals: left-aligned, top-
     aligned, sans-width-friendly columns, scrolling sideways inside its own
     box below ~760px (DataTable owns the scroll wrapper). */
  .compare :global(.data-table) {
    min-width: 700px;
  }

  .compare :global(.data-table th),
  .compare :global(.data-table td) {
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    padding-inline-start: var(--s-3);
  }

  .compare :global(.data-table td) {
    font-family: var(--font-body);
    font-size: var(--t-small);
    line-height: var(--lh-body);
    color: var(--ink-body);
    padding-block: var(--s-4);
  }

  .compare :global(.data-table th[scope='row']) {
    padding-block: var(--s-3);
  }

  .compare :global(.data-table th[scope='row']) {
    font-family: var(--font-display);
    font-size: var(--t-quote);
    line-height: var(--lh-heading);
    color: var(--ink);
    white-space: nowrap;
    padding-inline-start: 0;
  }

  .compare :global(.data-table td:last-child) {
    color: var(--ink);
  }

  /* The PullQuote's strong rule closes the table — drop the last row's
     hairline so only one line sits between the two blocks. */
  .compare :global(.data-table tbody tr:last-child) {
    border-bottom: 0;
  }

  .method-strip {
    margin-top: var(--s-6);
  }
</style>

---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/reading.css';
import '../styles/figures.css';
import '../styles/motion.css';
import Motion from '../components/Motion.astro';
// theme-color must be a literal in <meta>; read it from the token file so the
// palette is still declared in one place (design/tokens.css).
import tokensCss from '../../design/tokens.css?raw';
import {
  site,
  personJsonLd,
  softwareSourceCodeJsonLd,
  googleSiteVerification,
  cloudflareBeaconToken,
} from '../data/copy';
import { jsonLdString } from '../lib/jsonLdString';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. '/', '/crosssource/'
  ogImage: string; // e.g. '/og/home.png'
  includeSoftwareSourceCode?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Load the motion layer (anime.js) and arm `.motion` in the head. */
  motion?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  includeSoftwareSourceCode = false,
  noindex = false,
  ogType = 'website',
  motion = false,
} = Astro.props;

const themeColor = /--paper:\s*(#[0-9a-fA-F]{6})/.exec(tokensCss)?.[1];

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={themeColor} />

    <!-- `.js` when scripts run. On motion pages, `.motion` too, when
         IntersectionObserver exists and reduced motion is off; removed again
         if the motion module has not booted in 4 s, so nothing stays hidden. -->
    <script is:inline define:vars={{ motion }}>
      (function (d) {
        d.classList.add('js');
        // Hash hop from an old-URL stub (src/components/Moved.astro): keep the
        // fragment the visitor asked for when the new page has that id.
        var fromHash = new URLSearchParams(window.location.search).get('from-hash');
        if (fromHash) {
          document.addEventListener('DOMContentLoaded', function () {
            var hit = document.getElementById(fromHash) ? fromHash : window.location.hash.slice(1);
            history.replaceState(null, '', window.location.pathname + (hit ? '#' + hit : ''));
            var el = hit && document.getElementById(hit);
            if (el) el.scrollIntoView();
          });
        }
        if (!motion || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        setTimeout(function () {
          if (!window.__zmMotion) d.classList.remove('motion');
        }, 4000);
      })(document.documentElement);
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <meta name="google-site-verification" content={googleSiteVerification} />

    <!-- Fonts: self-hosted, preload the three above-the-fold files only (display, body, mono) -->
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <script type="application/ld+json" set:html={jsonLdString(personJsonLd)} is:inline />
    {
      includeSoftwareSourceCode && (
        <script type="application/ld+json" set:html={jsonLdString(softwareSourceCodeJsonLd)} is:inline />
      )
    }

    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cloudflareBeaconToken}"}`}
      is:inline
    ></script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="794b2e27-f0e2-4298-9376-b76ff8cb4c1c" is:inline></script> 
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <SiteHeader currentPath={path} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    {motion && <Motion />}
  </body>
</html>

<style>
  .shell {
    max-width: var(--shell-max);
    margin-inline: auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>

---
// Click-to-play video facade (The Pipeline). Nothing third-party loads until someone asks to
// watch: the poster is self-hosted and the youtube-nocookie iframe is created on click, in place.
//
// Progressive enhancement: the markup ships an <a> to the watch page, so the poster is a working
// link with JavaScript off. The inline script upgrades that anchor into a real <button>
// (aria-label "Play: <title>"), reusing the same child nodes so the poster is never re-requested.
// Exactly one control exists in either mode.
interface Props {
  youtubeId: string;
  title: string;
  caption: string;
  /** Extensionless path to the self-hosted poster: <poster>.webp and <poster>.jpg under public/. */
  poster: string;
  /** Text on the red play tab. */
  play: string;
  /** Label of the link to the watch page. */
  open: string;
  /** Further links shown beside it. */
  links?: { label: string; href: string }[];
}

const { youtubeId, title, caption, poster, play, open, links = [] } = Astro.props;

const watchHref = `https://www.youtube.com/watch?v=${youtubeId}`;
const embedSrc = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1`;
const playLabel = `Play: ${title}`;
---

<figure class="vid" data-video-embed data-embed-src={embedSrc} data-embed-title={title} data-play-label={playLabel}>
  <div class="frame">
    <a class="facade" href={watchHref} target="_blank" rel="noopener noreferrer">
      <picture>
        <source type="image/webp" srcset={`${poster}.webp`} />
        <img class="poster" src={`${poster}.jpg`} width="1280" height="720" alt="" loading="lazy" decoding="async" />
      </picture>
      <span class="vplay">
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9.5-5.5z" fill="currentColor"></path></svg>{play}<span class="sr">: {title}</span>
      </span>
    </a>
  </div>
  <figcaption>
    <span>{caption}</span>
    <span class="vlinks">
      <a href={watchHref} target="_blank" rel="noopener noreferrer">{open}</a>
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
    </span>
  </figcaption>
</figure>

<style>
  .vid {
    margin-top: 18px;
    padding-top: 14px;
    border-top: var(--line-hair);
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-sunk);
    border: var(--line-hair);
    overflow: hidden;
  }

  .facade {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
    text-decoration: none;
  }

  .facade picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.02);
    transition: filter 0.4s ease;
  }

  .poster[data-failed] {
    display: none;
  }

  .facade:hover .poster,
  .facade:focus-visible .poster {
    filter: none;
  }

  /* .frame clips its children, so draw the focus ring inside. */
  .facade:focus-visible {
    outline-offset: -4px;
  }

  .vplay {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 16px 0 12px;
    background: var(--color-accent-fill);
    color: var(--color-on-accent);
    font: 500 var(--t-nav) / 1 var(--font-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .vplay svg {
    width: 14px;
    height: 14px;
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 20px;
    margin-top: 10px;
    font: 400 11.5px / var(--lh-base) var(--font-data);
    color: var(--color-text-muted);
  }

  .vlinks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .vlinks a {
    color: var(--color-text-body);
  }

  .vlinks a:hover,
  .vlinks a:focus-visible {
    color: var(--color-text);
  }

  @media (max-width: 599px) {
    .vplay {
      left: 10px;
      bottom: 10px;
      height: 34px;
      padding: 0 12px 0 10px;
    }
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-video-embed]')) {
    const anchor = fig.querySelector<HTMLAnchorElement>('a.facade');
    const frame = fig.querySelector<HTMLElement>('.frame');
    if (!anchor || !frame) continue;

    // A missing poster must not leave a broken-image marker on the page.
    const poster = fig.querySelector<HTMLImageElement>('img.poster');
    if (poster) {
      const markFailed = () => poster.setAttribute('data-failed', '');
      poster.addEventListener('error', markFailed);
      if (poster.complete && poster.naturalWidth === 0) markFailed();
    }

    // Upgrade the no-JS link into a real button, reusing its children so the poster is not fetched twice.
    const button = document.createElement('button');
    button.type = 'button';
    // Copy every attribute (class and Astro's data-astro-cid-* scoping attribute) so the .facade styles reach the button.
    for (const { name, value } of Array.from(anchor.attributes)) {
      if (name === 'href' || name === 'target' || name === 'rel') continue;
      button.setAttribute(name, value);
    }
    // The button's name comes from its visible text plus the visually hidden title it carries over.
    while (anchor.firstChild) button.appendChild(anchor.firstChild);
    anchor.replaceWith(button);

    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = fig.dataset.embedSrc ?? '';
      iframe.title = fig.dataset.embedTitle ?? '';
      iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');
      iframe.setAttribute('allowfullscreen', '');
      button.remove();
      frame.appendChild(iframe);
      iframe.focus();
    });
  }
</script>

---
// Horizontal bars for a short list of values on one scale. Each row is
// "label, bar, value" in a real list, so the numbers are text first; the bar is
// decoration. A row can carry a `tone` of red when its bar is a failure or the series under test.
interface Row {
  label: string;
  value: number;
  text: string;
  note?: string;
  /** Fill colour of this row's bar: ink (default) or red for a failure. */
  tone?: 'ink' | 'red';
}

interface Props {
  rows: Row[];
  /** The value that fills the whole track. */
  max: number;
  heading?: string;
}

const { rows, max, heading } = Astro.props;
---

<div class="bl">
  {heading && <p class="bl-heading">{heading}</p>}
  <ul class="bl-list">
    {
      rows.map((r) => (
        <li class:list={['bl-row', { 'is-red': r.tone === 'red' }]}>
          <span class="bl-label">{r.label}</span>
          <span class="bl-track" aria-hidden="true">
            <span class="bl-fill" style={`inline-size:${Math.min(100, (r.value / max) * 100)}%`} />
          </span>
          <span class="bl-value tabular">{r.text}</span>
          {r.note && <span class="bl-note">{r.note}</span>}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .bl + .bl {
    margin-top: var(--s-6);
  }

  .bl-heading {
    margin-bottom: var(--s-3);
    font-family: var(--font-data);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .bl-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bl-row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) 3.5rem;
    align-items: center;
    column-gap: var(--s-4);
    row-gap: var(--s-1);
    font-family: var(--font-data);
    font-size: var(--t-data);
    color: var(--color-text-body);
  }

  .bl-value {
    color: var(--color-text);
    text-align: right;
  }

  .bl-row + .bl-row {
    margin-top: var(--s-3);
  }

  .bl-track {
    display: block;
    block-size: var(--s-3);
    border: var(--line-strong);
    background: var(--color-surface-sunk);
  }

  .bl-fill {
    display: block;
    block-size: 100%;
    background: var(--color-text-body);
  }

  .bl-row.is-red .bl-fill {
    background: var(--color-accent);
  }

  .bl-note {
    grid-column: 2 / -1;
    font-size: var(--t-label);
    color: var(--color-text-muted);
  }

  @media (max-width: 599px) {
    .bl-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .bl-label {
      grid-column: 1;
    }

    .bl-value {
      grid-column: 2;
      grid-row: 1;
    }

    .bl-track {
      grid-column: 1 / -1;
    }

    .bl-note {
      grid-column: 1 / -1;
    }
  }
</style>

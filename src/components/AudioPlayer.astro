---
// The narration player (kit: `.ap`). Progressive enhancement: the markup starts as a working native <audio controls>,
// and the script swaps it for the player once it runs. The player is a red play/pause button, a red scrubber
// (`role="slider"`; the arrow keys seek 10 s, Home and End jump), the time, a speed button (1, 1.25, 1.5) and, when the
// piece has a .vtt file, a CC toggle that shows the caption for the current moment (read from that file).
//
// Read-along, when the data file has cues: each cue is a `data-narr` anchor on the page. The paragraph being read
// is marked (`.is-reading`), the page follows it until the reader scrolls, a click on a paragraph plays from it, and
// a bottom bar keeps play, time and Follow in reach once the player has scrolled away. The cues are exactly what
// `npm run audio:check` verifies against the page, so the anchors and their text must not drift.
import { pipelineWriting } from '../data/copy';

interface Chapter {
  id: string;
  title: string;
  start: number;
}

// Read-along cue tuple: [data-narr id, start seconds, end seconds].
type Cue = [string, number, number];

interface AudioData {
  src: string;
  duration: number;
  label: string;
  note: string;
  /** Path of the .vtt captions file. */
  captions?: string;
  chapters?: Chapter[];
  cues?: Cue[];
}

interface Props {
  audio: AudioData;
  articleId: string;
}

const { audio, articleId } = Astro.props;
const ui = pipelineWriting.player;

function formatTime(totalSeconds: number): string {
  const s = Math.max(0, Math.round(totalSeconds));
  return `${Math.floor(s / 60)}:${(s % 60).toString().padStart(2, '0')}`;
}

const totalLabel = audio.duration > 0 ? formatTime(audio.duration) : '\u2013:\u2013\u2013';
const minutes = audio.duration > 0 ? `${Math.max(1, Math.floor(audio.duration / 60))} ${ui.minutes}` : '';
const topLabel = minutes ? `${audio.label} · ${minutes}` : audio.label;
const storageKey = `audio:${articleId}`;
const cuesJson = audio.cues && audio.cues.length > 0 ? JSON.stringify(audio.cues) : '';
const uiJson = JSON.stringify({
  play: ui.play,
  pause: ui.pause,
  speed: ui.speed,
  loading: ui.loading,
  failed: ui.failed,
  cannotPlay: ui.cannotPlay,
  resumes: ui.resumes,
  playFromHere: ui.playFromHere,
  label: audio.label,
});
---

<section
  class="ap"
  id="listen"
  data-ap
  data-audio-player
  data-storage-key={storageKey}
  data-article-id={articleId}
  data-duration={audio.duration}
  data-cues={cuesJson}
  data-ui={uiJson}
  aria-label={audio.label}
>
  <audio class="ap-el" data-audio-el preload="metadata" controls aria-label={audio.label}>
    <source src={audio.src} type="audio/mpeg" />
    {audio.captions && <track kind="captions" srclang="en" label={ui.captionTrack} src={audio.captions} />}
  </audio>

  {/* No-JS readers get the browser's own player; keep the synthetic-voice disclosure and the captions file for them too. */}
  <noscript>
    <p class="ap-note">
      {audio.note}
      {audio.captions && <a href={audio.captions} download>{ui.captions}</a>}
    </p>
  </noscript>

  <div class="ap-ui" data-audio-enhanced hidden>
    <button type="button" class="ap-play" data-audio-play aria-label={ui.play}>
      <svg class="pl" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
      <svg class="pa" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor"></path></svg>
    </button>
    <div class="ap-main">
      <div class="ap-top">
        <span class="lab">{topLabel}</span>
        <span class="ap-time tnum" data-audio-time>
          <b class="ap-cur" data-audio-current>0:00</b> / <span class="ap-dur">{totalLabel}</span>
          <span class="ap-resume" data-audio-resume-tag hidden></span>
        </span>
      </div>
      <div
        class="ap-bar"
        data-audio-track
        role="slider"
        tabindex="0"
        aria-label="Seek"
        aria-valuemin="0"
        aria-valuemax={Math.round(audio.duration)}
        aria-valuenow="0"
        aria-valuetext={`0:00 of ${totalLabel}`}
      >
        <div class="ap-rail"><i class="ap-buf"></i><i class="ap-fill" data-audio-fill></i><i class="ap-knob" data-audio-thumb></i></div>
      </div>
      <div class="ap-foot">
        <span>{audio.note}</span>
        {audio.captions && <a href={audio.captions} download>{ui.captions}</a>}
        {audio.captions && <button type="button" class="ap-cc" data-audio-cc aria-pressed="false" hidden>CC</button>}
        <button type="button" class="ap-rate" data-audio-speed aria-label={`${ui.speed} 1×`}>1×</button>
      </div>
      {audio.captions && <p class="ap-capline" data-audio-capline hidden></p>}
      <p class="ap-status" data-audio-status role="status" aria-live="polite"></p>
    </div>
  </div>

  <div class="ap-float" data-audio-float hidden>
    <div class="ap-float-in">
      <button type="button" class="ap-play ap-play--s" data-audio-float-play aria-label={ui.play}>
        <svg class="pl" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
        <svg class="pa" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor"></path></svg>
      </button>
      <span class="ap-float-time tnum" data-audio-float-time>0:00</span>
      <button type="button" class="ap-fbtn" data-audio-float-follow aria-pressed="true">{ui.follow}</button>
      <button type="button" class="ap-fbtn" data-audio-float-up aria-label={ui.toPlayerLabel}>↑ {ui.toPlayer}</button>
      <button type="button" class="ap-fbtn ap-fclose" data-audio-float-close aria-label={ui.hide} title={ui.hide}>×</button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var fmt = function (s) {
      s = Math.max(0, Math.round(s || 0));
      return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2);
    };
    var track_ = function (name, data) {
      try {
        window.umami && window.umami.track(name, data);
      } catch (e) {}
    };

    Array.prototype.forEach.call(document.querySelectorAll('[data-audio-player]'), function (root) {
      var a = root.querySelector('[data-audio-el]');
      var enhanced = root.querySelector('[data-audio-enhanced]');
      if (!a || !enhanced) return;
      var UI = {};
      try {
        UI = JSON.parse(root.dataset.ui || '{}');
      } catch (e) {}
      var key = root.dataset.storageKey || 'audio:article';
      var articleId = root.dataset.articleId || '';
      var declared = parseFloat(root.dataset.duration || '0') || 0;
      var btn = root.querySelector('[data-audio-play]');
      var bar = root.querySelector('[data-audio-track]');
      var fill = root.querySelector('[data-audio-fill]');
      var knob = root.querySelector('[data-audio-thumb]');
      var cur = root.querySelector('[data-audio-current]');
      var resumeTag = root.querySelector('[data-audio-resume-tag]');
      var rate = root.querySelector('[data-audio-speed]');
      var statusEl = root.querySelector('[data-audio-status]');
      var ccBtn = root.querySelector('[data-audio-cc]');
      var capLine = root.querySelector('[data-audio-capline]');
      var setStatus = function (m) {
        if (statusEl) statusEl.textContent = m;
      };

      // Native controls give way to the player now that JS is running.
      a.removeAttribute('controls');
      a.hidden = true;
      enhanced.hidden = false;

      var total = function () {
        return isFinite(a.duration) && a.duration > 0 ? a.duration : declared;
      };
      var paint = function (t) {
        var T = total();
        var p = T ? Math.min(1, Math.max(0, t / T)) : 0;
        fill.style.width = (p * 100).toFixed(3) + '%';
        knob.style.left = (p * 100).toFixed(3) + '%';
        cur.textContent = fmt(t);
        bar.setAttribute('aria-valuenow', Math.round(t));
        bar.setAttribute('aria-valuemax', Math.round(T));
        bar.setAttribute('aria-valuetext', fmt(t) + ' of ' + fmt(T));
      };
      var setT = function (t) {
        var T = total();
        t = Math.max(0, Math.min(T || t, t));
        try {
          a.currentTime = t;
        } catch (e) {}
        paint(t);
      };
      var tryPlay = function () {
        var p = a.play();
        if (p && p.catch)
          p.catch(function (e) {
            if (e && e.name !== 'AbortError' && e.name !== 'NotAllowedError') setStatus(UI.cannotPlay || '');
          });
      };

      // Resume where the reader left off (a few seconds in, not at the very end).
      var stored = function () {
        try {
          var v = parseFloat(window.localStorage.getItem(key));
          return isFinite(v) ? v : 0;
        } catch (e) {
          return 0;
        }
      };
      var store = function (t) {
        try {
          window.localStorage.setItem(key, String(t));
        } catch (e) {}
      };
      var unstore = function () {
        try {
          window.localStorage.removeItem(key);
        } catch (e) {}
      };

      var fired = { 25: false, 50: false, 75: false, play: false, done: false };

      a.addEventListener('loadedmetadata', function () {
        var saved = stored();
        var T = total();
        if (saved > 5 && T > 0 && saved < T - 5) {
          a.currentTime = saved;
          paint(saved);
          if (resumeTag) {
            resumeTag.textContent = '· ' + (UI.resumes || 'resumes at') + ' ' + fmt(saved);
            resumeTag.hidden = false;
          }
        } else paint(0);
      });
      a.addEventListener('progress', function () {
        try {
          var b = root.querySelector('.ap-buf');
          if (a.buffered.length && b) b.style.width = ((a.buffered.end(a.buffered.length - 1) / total()) * 100).toFixed(2) + '%';
        } catch (e) {}
      });
      a.addEventListener('waiting', function () {
        setStatus(UI.loading || '');
      });
      a.addEventListener('playing', function () {
        setStatus('');
      });
      a.addEventListener('canplay', function () {
        setStatus('');
      });
      a.addEventListener('error', function () {
        setStatus(UI.failed || '');
        btn.disabled = true;
        root.dataset.state = 'error';
      });
      a.addEventListener('play', function () {
        root.classList.add('is-playing');
        btn.setAttribute('aria-label', UI.pause || 'Pause');
        if (resumeTag) resumeTag.hidden = true;
        if (!fired.play) {
          fired.play = true;
          track_('audio-play', { article: articleId });
        }
      });
      a.addEventListener('pause', function () {
        root.classList.remove('is-playing');
        btn.setAttribute('aria-label', UI.play || 'Play');
      });
      a.addEventListener('timeupdate', function () {
        var t = a.currentTime;
        if (!seeking) paint(t);
        store(t);
        var T = total();
        if (T > 0) {
          var pct = (t / T) * 100;
          [25, 50, 75].forEach(function (m) {
            if (!fired[m] && pct >= m) {
              fired[m] = true;
              track_('audio-progress', { article: articleId, percent: m });
            }
          });
          if (!fired.done && pct >= 98) {
            fired.done = true;
            track_('audio-complete', { article: articleId });
          }
        }
        caption(t);
      });
      a.addEventListener('ended', function () {
        root.classList.remove('is-playing');
        btn.setAttribute('aria-label', UI.play || 'Play');
        if (!fired.done) {
          fired.done = true;
          track_('audio-complete', { article: articleId });
        }
        unstore();
        a.currentTime = 0;
        paint(0);
      });
      btn.addEventListener('click', function () {
        if (a.paused) tryPlay();
        else a.pause();
      });

      // The scrubber: pointer (click and drag) and keyboard.
      var seeking = false;
      var at = function (e) {
        var r = bar.getBoundingClientRect();
        return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) * total();
      };
      bar.addEventListener('pointerdown', function (e) {
        seeking = true;
        root.classList.add('is-seeking');
        if (bar.setPointerCapture) bar.setPointerCapture(e.pointerId);
        paint(at(e));
      });
      bar.addEventListener('pointermove', function (e) {
        if (seeking) paint(at(e));
      });
      bar.addEventListener('pointerup', function (e) {
        if (!seeking) return;
        seeking = false;
        root.classList.remove('is-seeking');
        setT(at(e));
      });
      bar.addEventListener('pointercancel', function () {
        seeking = false;
        root.classList.remove('is-seeking');
      });
      bar.addEventListener('keydown', function (e) {
        var k = e.key;
        var t = a.currentTime;
        if (k === 'ArrowRight' || k === 'ArrowUp') {
          e.preventDefault();
          setT(t + 10);
        } else if (k === 'ArrowLeft' || k === 'ArrowDown') {
          e.preventDefault();
          setT(t - 10);
        } else if (k === 'Home') {
          e.preventDefault();
          setT(0);
        } else if (k === 'End') {
          e.preventDefault();
          setT(total());
        } else if (k === ' ' || k === 'Enter') {
          e.preventDefault();
          btn.click();
        }
      });

      // Speed: 1, 1.25, 1.5, then round.
      var rates = [1, 1.25, 1.5];
      var ri = 0;
      rate.addEventListener('click', function () {
        ri = (ri + 1) % rates.length;
        a.playbackRate = rates[ri];
        rate.textContent = rates[ri] + '×';
        rate.setAttribute('aria-label', (UI.speed || 'Playback speed') + ' ' + rates[ri] + '×');
        track_('audio-speed', { article: articleId, rate: rates[ri] });
      });

      // Captions: the .vtt file, parsed once, shown as one line for the current moment.
      var vtt = null;
      var ccOn = false;
      var capIdx = -1;
      var toSec = function (s) {
        var p = s.trim().replace(',', '.').split(':').map(parseFloat);
        return p.length === 3 ? p[0] * 3600 + p[1] * 60 + p[2] : p[0] * 60 + p[1];
      };
      var parseVtt = function (txt) {
        var out = [];
        txt.replace(/\r/g, '').split(/\n\n+/).forEach(function (blk) {
          var lines = blk.split('\n');
          var i = lines.findIndex(function (l) {
            return l.indexOf('-->') > -1;
          });
          if (i < 0) return;
          var m = lines[i].split('-->');
          out.push([toSec(m[0]), toSec(m[1].split(' ')[0] || m[1]), lines.slice(i + 1).join(' ')]);
        });
        return out;
      };
      var caption = function (t) {
        if (!ccOn || !vtt || !capLine) return;
        var idx = -1;
        for (var i = 0; i < vtt.length; i++) if (vtt[i][0] <= t && t < vtt[i][1]) idx = i;
        if (idx === capIdx) return;
        capIdx = idx;
        capLine.textContent = idx < 0 ? '' : vtt[idx][2];
      };
      if (ccBtn && root.querySelector('track')) {
        ccBtn.hidden = false;
        ccBtn.addEventListener('click', function () {
          ccOn = !ccOn;
          ccBtn.setAttribute('aria-pressed', ccOn ? 'true' : 'false');
          capLine.hidden = !ccOn;
          capIdx = -1;
          if (ccOn && !vtt) {
            vtt = [];
            fetch(root.querySelector('track').getAttribute('src'))
              .then(function (r) {
                return r.text();
              })
              .then(function (txt) {
                vtt = parseVtt(txt);
                caption(a.currentTime);
              })
              .catch(function () {
                vtt = null;
              });
          } else caption(a.currentTime);
        });
      }

      // ---- Read-along. Deferred to DOMContentLoaded: this script runs in the head of the page, before the
      // sections that hold the [data-narr] anchors have been parsed. ----
      var setupReadAlong = function () {
        var cues = [];
        try {
          cues = root.dataset.cues ? JSON.parse(root.dataset.cues) : [];
        } catch (e) {}
        if (!cues.length) return;

        var floatEl = root.querySelector('[data-audio-float]');
        var fPlay = root.querySelector('[data-audio-float-play]');
        var fTime = root.querySelector('[data-audio-float-time]');
        var fFollow = root.querySelector('[data-audio-float-follow]');
        var narr = {};
        Array.prototype.forEach.call(document.querySelectorAll('[data-narr]'), function (el) {
          narr[el.dataset.narr] = el;
        });
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        var activeId = null;
        var activeEl = null;
        var started = false;
        var follow = true;
        var playerInView = true;
        var dismissed = false;
        var nearEnd = false;
        var lastCue = 0;
        var lastSeekAt = 0;
        var ownScrollUntil = 0;

        // The active cue is the last whose start has been reached, so a short silent gap keeps the highlight.
        var findCue = function (t) {
          var r = null;
          for (var i = 0; i < cues.length; i++) {
            if (cues[i][1] <= t) r = cues[i];
            else break;
          }
          return r;
        };
        var syncFollow = function () {
          if (fFollow) fFollow.setAttribute('aria-pressed', follow ? 'true' : 'false');
        };
        var scrollToActive = function (el) {
          if (!follow || !el) return;
          var delta = el.getBoundingClientRect().top - window.innerHeight * 0.35;
          if (Math.abs(delta) < 4) return;
          ownScrollUntil = performance.now() + 900;
          window.scrollBy({ top: delta, behavior: reduced ? 'auto' : 'smooth' });
        };
        var midway = function () {
          var T = total();
          var t = a.currentTime;
          return t > 0.5 && (T <= 0 || t < T - 0.5);
        };
        var floatVisibility = function () {
          if (!floatEl) return;
          var focusIn = document.activeElement instanceof Node && floatEl.contains(document.activeElement);
          var show = !dismissed && !nearEnd && (focusIn || ((!a.paused || midway()) && !playerInView));
          floatEl.hidden = !show;
        };
        var setHighlight = function (cue) {
          if (!cue || cue[0] === activeId) return;
          if (activeEl) activeEl.classList.remove('is-reading');
          activeId = cue[0];
          activeEl = narr[activeId] || null;
          if (activeEl) {
            activeEl.classList.add('is-reading');
            scrollToActive(activeEl);
          }
        };

        if (floatEl) {
          new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                playerInView = en.isIntersecting;
              });
              floatVisibility();
            },
            { threshold: 0 },
          ).observe(root);
          // Nothing should cover the closing call to action or the footer.
          var endEls = Array.prototype.slice.call(document.querySelectorAll('[data-cta], .foot'));
          if (endEls.length) {
            var seen = new Map();
            var eio = new IntersectionObserver(function (entries) {
              entries.forEach(function (en) {
                seen.set(en.target, en.isIntersecting);
              });
              nearEnd = Array.from(seen.values()).some(Boolean);
              floatVisibility();
            });
            endEls.forEach(function (el) {
              eio.observe(el);
            });
          }
          root.querySelector('[data-audio-float-close]').addEventListener('click', function () {
            dismissed = true;
            floatVisibility();
          });
          a.addEventListener('play', function () {
            dismissed = false;
            floatVisibility();
          });
          floatEl.addEventListener('focusin', floatVisibility);
          floatEl.addEventListener('focusout', floatVisibility);
          fPlay.addEventListener('click', function () {
            if (a.paused) tryPlay();
            else a.pause();
          });
          fFollow.addEventListener('click', function () {
            follow = !follow;
            syncFollow();
            if (follow) scrollToActive(activeEl);
          });
          root.querySelector('[data-audio-float-up]').addEventListener('click', function () {
            root.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
          });
        }

        // Any scroll the reader starts switches Follow off; it never fights them.
        var unfollow = function () {
          if (!follow) return;
          follow = false;
          syncFollow();
        };
        window.addEventListener('wheel', unfollow, { passive: true });
        window.addEventListener('touchmove', unfollow, { passive: true });
        window.addEventListener('keydown', function (e) {
          if (['PageUp', 'PageDown', ' ', 'ArrowUp', 'ArrowDown'].indexOf(e.key) < 0) return;
          var t = e.target;
          if (t instanceof Node && (root.contains(t) || (floatEl && floatEl.contains(t)))) return;
          unfollow();
        });
        window.addEventListener(
          'scroll',
          function () {
            if (performance.now() > ownScrollUntil) unfollow();
          },
          { passive: true },
        );

        // Click a narrated paragraph to play from it. A drag, a selection, a link or a keyboard click never seeks.
        document.body.classList.add('audio-narr-ready');
        var downX = 0;
        var downY = 0;
        var downAt = 0;
        var downSel = '';
        var selText = function () {
          try {
            return window.getSelection ? window.getSelection().toString() : '';
          } catch (e) {
            return '';
          }
        };
        cues.forEach(function (c) {
          var el = narr[c[0]];
          if (!el) return;
          el.setAttribute('title', UI.playFromHere || '');
          el.addEventListener('pointerdown', function (e) {
            downX = e.clientX;
            downY = e.clientY;
            downAt = performance.now();
            downSel = selText();
          });
          el.addEventListener('click', function (e) {
            if (e.target instanceof Element && e.target.closest('a, button, iframe, input')) return;
            var now = performance.now();
            var had = downAt > 0 && now - downAt < 1500;
            var drifted = had && Math.hypot(e.clientX - downX, e.clientY - downY) > 6;
            var selAtDown = downSel;
            downAt = 0;
            downSel = '';
            if (drifted) return;
            var s = selText();
            if (s.length > 0 && s !== selAtDown) return;
            if (e.detail === 0 && !had) return;
            if (now - lastSeekAt < 80) return;
            lastSeekAt = now;
            var wasActive = el === activeEl;
            setT(c[1]);
            if (a.paused) tryPlay();
            if (wasActive) {
              follow = true;
              syncFollow();
            }
            track_('audio-seek', { article: articleId, id: c[0] });
          });
        });

        a.addEventListener('play', function () {
          started = true;
          root.classList.add('is-playing');
          floatVisibility();
        });
        a.addEventListener('pause', function () {
          floatVisibility();
        });
        a.addEventListener('timeupdate', function () {
          if (fTime) fTime.textContent = fmt(a.currentTime);
          var now = performance.now();
          if (now - lastCue < 240) return;
          lastCue = now;
          if (started) setHighlight(findCue(a.currentTime));
          floatVisibility();
        });
        a.addEventListener('ended', function () {
          if (activeEl) activeEl.classList.remove('is-reading');
          activeEl = null;
          activeId = null;
          started = false;
          if (floatEl) floatEl.hidden = true;
        });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupReadAlong);
      else setupReadAlong();

      paint(0);
    });
  })();
</script>

<style>
  .ap {
    display: block;
    max-width: 640px;
    margin-top: clamp(24px, 4vh, 36px);
  }

  .ap-el[hidden] {
    display: none;
  }

  .ap-el {
    width: 100%;
  }

  .ap-note {
    margin-top: var(--s-2);
    font: 400 var(--t-label) / var(--lh-snug) var(--font-data);
    color: var(--color-text-muted);
  }

  .ap-ui {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);

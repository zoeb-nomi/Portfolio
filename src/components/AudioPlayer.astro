---
// Compact in-page narration player. Progressive enhancement, same pattern
// as the §9 watch-card script: the markup starts as a working native
// <audio controls> element, and the inline script below swaps it for the
// custom row once it runs — so a no-JS reader still gets a full player,
// just the browser's own chrome instead of ours.
interface Chapter {
  id: string;
  title: string;
  start: number;
}

// Read-along cue tuple: [data-narr id, start seconds, end seconds].
type Cue = [string, number, number];

interface AudioData {
  src: string;
  duration: number;
  label: string;
  note: string;
  chapters?: Chapter[];
  cues?: Cue[];
}

interface Props {
  audio: AudioData;
  articleId: string;
}

const { audio, articleId } = Astro.props;

function formatTime(totalSeconds: number): string {
  const s = Math.max(0, Math.round(totalSeconds));
  const m = Math.floor(s / 60);
  const rem = s % 60;
  return `${m}:${rem.toString().padStart(2, '0')}`;
}

const totalLabel = audio.duration > 0 ? formatTime(audio.duration) : '–:––';
const minutesLabel = audio.duration > 0 ? `${Math.max(1, Math.floor(audio.duration / 60))} min` : '';
const captionText = minutesLabel ? `${audio.label} · ${minutesLabel}` : audio.label;
const storageKey = `audio:${articleId}`;
const cuesJson = audio.cues && audio.cues.length > 0 ? JSON.stringify(audio.cues) : '';
---

<div
  class="audio-player"
  data-audio-player
  data-storage-key={storageKey}
  data-article={articleId}
  data-duration={audio.duration}
  data-cues={cuesJson}
>
  <audio class="audio-el" data-audio-el preload="metadata" controls>
    <source src={audio.src} type="audio/mpeg" />
  </audio>

  <div class="audio-enhanced" data-audio-enhanced hidden>
    <p class="audio-caption">{captionText}</p>

    <div class="audio-row">
      <button type="button" class="audio-play" data-audio-play aria-label={`Play: ${audio.label}`}>
        <svg class="audio-icon audio-icon-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M4 2.5v11l10-5.5z" fill="currentColor" />
        </svg>
        <svg class="audio-icon audio-icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false" hidden>
          <rect x="3.5" y="2.5" width="3" height="11" fill="currentColor" />
          <rect x="9.5" y="2.5" width="3" height="11" fill="currentColor" />
        </svg>
      </button>

      <div class="audio-track-wrap">
        <div
          class="audio-track"
          data-audio-track
          role="slider"
          tabindex="0"
          aria-label="Seek"
          aria-valuemin="0"
          aria-valuemax={audio.duration}
          aria-valuenow="0"
          aria-valuetext={`0:00 of ${totalLabel}`}
        >
          <span class="audio-track-fill" data-audio-fill></span>
          <span class="audio-track-thumb" data-audio-thumb></span>
        </div>
        <p class="audio-time tabular" data-audio-time>
          <span data-audio-current>0:00</span> / {totalLabel}
          <span class="audio-resume-tag" data-audio-resume-tag hidden>· resumes at 0:00</span>
        </p>
      </div>

      <button type="button" class="audio-speed" data-audio-speed aria-label="Playback speed: 1×. Tap to change.">1×</button>
    </div>

    <p class="audio-note">{audio.note}</p>

    {audio.chapters && audio.chapters.length > 0 && (
      <ul class="audio-chapters" data-audio-chapters aria-label="Chapters">
        {audio.chapters.map((c) => (
          <li>
            <button
              type="button"
              class="audio-chip"
              data-audio-chapter
              data-start={c.start}
              data-chapter-id={c.id}
            >
              {c.title}
            </button>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="audio-float" data-audio-float hidden>
    <button type="button" class="audio-float-play" data-audio-float-play aria-label="Play">
      <svg class="audio-icon audio-icon-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M4 2.5v11l10-5.5z" fill="currentColor" />
      </svg>
      <svg class="audio-icon audio-icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false" hidden>
        <rect x="3.5" y="2.5" width="3" height="11" fill="currentColor" />
        <rect x="9.5" y="2.5" width="3" height="11" fill="currentColor" />
      </svg>
    </button>
    <span class="audio-float-time tabular" data-audio-float-time>0:00</span>
    <div class="audio-float-actions">
      <button type="button" class="audio-float-follow" data-audio-float-follow aria-pressed="true">
        <span class="audio-float-dot" aria-hidden="true"></span>Follow
      </button>
      <button type="button" class="audio-float-up" data-audio-float-up aria-label="Back to player" title="Back to player">↑<span class="audio-float-up-label"> Player</span></button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function formatTime(totalSeconds) {
      const s = Math.max(0, Math.round(totalSeconds || 0));
      const m = Math.floor(s / 60);
      const rem = s % 60;
      return `${m}:${rem < 10 ? '0' : ''}${rem}`;
    }

    for (const root of document.querySelectorAll('[data-audio-player]')) {
      const audioEl = root.querySelector('[data-audio-el]');
      const enhanced = root.querySelector('[data-audio-enhanced]');
      if (!audioEl || !enhanced) continue;

      const storageKey = root.dataset.storageKey || 'audio:article';
      const articleId = root.dataset.article || '';
      const declaredDuration = parseFloat(root.dataset.duration || '0') || 0;

      const playButton = root.querySelector('[data-audio-play]');
      const iconPlay = root.querySelector('.audio-icon-play');
      const iconPause = root.querySelector('.audio-icon-pause');
      const track = root.querySelector('[data-audio-track]');
      const fill = root.querySelector('[data-audio-fill]');
      const thumb = root.querySelector('[data-audio-thumb]');
      const currentEl = root.querySelector('[data-audio-current]');
      const resumeTag = root.querySelector('[data-audio-resume-tag]');
      const speedButton = root.querySelector('[data-audio-speed]');
      const chapterButtons = Array.from(root.querySelectorAll('[data-audio-chapter]'));

      // Swap native controls for the custom row now that JS is running.
      audioEl.removeAttribute('controls');
      audioEl.classList.add('audio-el--hidden');
      enhanced.hidden = false;

      const speeds = [1, 1.25, 1.5];
      let speedIndex = 0;

      const firedProgress = { 25: false, 50: false, 75: false };
      let firedPlay = false;
      let firedComplete = false;

      // SVG elements don't support the HTML `hidden` IDL property (it's
      // defined on HTMLElement, not SVGElement/HTMLOrSVGElement), so the
      // play/pause icon swap uses the attribute directly.
      function setHidden(el, isHidden) {
        if (isHidden) el.setAttribute('hidden', '');
        else el.removeAttribute('hidden');
      }

      function track_(name, data) {
        try {
          window.umami?.track(name, data);
        } catch {}
      }

      function readStoredTime() {
        try {
          const raw = window.localStorage.getItem(storageKey);
          const v = raw ? parseFloat(raw) : NaN;
          return Number.isFinite(v) ? v : 0;
        } catch {
          return 0;
        }
      }

      function storeTime(t) {
        try {
          window.localStorage.setItem(storageKey, String(t));
        } catch {}
      }

      function clearStoredTime() {
        try {
          window.localStorage.removeItem(storageKey);
        } catch {}
      }

      function duration() {
        return Number.isFinite(audioEl.duration) && audioEl.duration > 0 ? audioEl.duration : declaredDuration;
      }

      let lastActiveChapterId = null;

      function updateChapterState(current) {
        let activeId = null;
        for (const btn of chapterButtons) {
          const start = parseFloat(btn.dataset.start || '0');
          if (current >= start) activeId = btn.dataset.chapterId;
        }
        for (const btn of chapterButtons) {
          const isActive = btn.dataset.chapterId === activeId;
          btn.setAttribute('aria-current', isActive ? 'true' : 'false');
        }
        if (activeId !== null && activeId !== lastActiveChapterId) {
          lastActiveChapterId = activeId;
          const activeBtn = chapterButtons.find((b) => b.dataset.chapterId === activeId);
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          activeBtn?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', inline: 'center', block: 'nearest' });
        }
      }

      function updateUI(current) {
        const dur = duration();
        const ratio = dur > 0 ? Math.min(1, Math.max(0, current / dur)) : 0;
        fill.style.width = `${ratio * 100}%`;
        thumb.style.left = `${ratio * 100}%`;
        track.setAttribute('aria-valuenow', String(Math.round(current)));
        track.setAttribute('aria-valuemax', String(Math.round(dur)));
        track.setAttribute('aria-valuetext', `${formatTime(current)} of ${formatTime(dur)}`);
        currentEl.textContent = formatTime(current);
        updateChapterState(current);
      }

      function seekTo(t) {
        const dur = duration();
        const clamped = Math.min(Math.max(0, t), dur || t);
        audioEl.currentTime = clamped;
        updateUI(clamped);
      }

      // Resume position, once metadata (and so a real duration) is known.
      audioEl.addEventListener('loadedmetadata', () => {
        const saved = readStoredTime();
        const dur = duration();
        if (saved > 5 && dur > 0 && saved < dur - 5) {
          audioEl.currentTime = saved;
          updateUI(saved);
          if (resumeTag) {
            resumeTag.textContent = `· resumes at ${formatTime(saved)}`;
            resumeTag.hidden = false;
          }
        } else {
          updateUI(0);
        }
      });

      playButton.addEventListener('click', () => {
        if (audioEl.paused) {
          audioEl.play().catch(() => {});
        } else {
          audioEl.pause();
        }
      });

      audioEl.addEventListener('play', () => {
        setHidden(iconPlay, true);
        setHidden(iconPause, false);
        playButton.setAttribute('aria-label', 'Pause');
        if (resumeTag) resumeTag.hidden = true;
        if (!firedPlay) {
          firedPlay = true;
          track_('audio-play', { article: articleId });
        }
      });

      audioEl.addEventListener('pause', () => {
        setHidden(iconPlay, false);
        setHidden(iconPause, true);
        playButton.setAttribute('aria-label', 'Play');
      });

      audioEl.addEventListener('timeupdate', () => {
        const current = audioEl.currentTime;
        updateUI(current);
        storeTime(current);

        const dur = duration();
        if (dur > 0) {
          const pct = (current / dur) * 100;
          for (const mark of [25, 50, 75]) {
            if (!firedProgress[mark] && pct >= mark) {
              firedProgress[mark] = true;
              track_('audio-progress', { article: articleId, percent: mark });
            }
          }
          if (!firedComplete && pct >= 98) {
            firedComplete = true;
            track_('audio-complete', { article: articleId });
          }
        }
      });

      audioEl.addEventListener('ended', () => {
        if (!firedComplete) {
          firedComplete = true;
          track_('audio-complete', { article: articleId });
        }
        clearStoredTime();
        updateUI(0);
        audioEl.currentTime = 0;
      });

      // Track: click/drag to seek.
      let dragging = false;

      function ratioFromEvent(evt) {
        const rect = track.getBoundingClientRect();
        const x = Math.min(Math.max(evt.clientX - rect.left, 0), rect.width);
        return rect.width > 0 ? x / rect.width : 0;
      }

      track.addEventListener('pointerdown', (evt) => {
        dragging = true;
        track.setPointerCapture(evt.pointerId);
        seekTo(ratioFromEvent(evt) * duration());
      });

      track.addEventListener('pointermove', (evt) => {
        if (!dragging) return;
        seekTo(ratioFromEvent(evt) * duration());
      });

      const stopDrag = (evt) => {
        if (!dragging) return;
        dragging = false;
        try {
          track.releasePointerCapture(evt.pointerId);
        } catch {}
      };
      track.addEventListener('pointerup', stopDrag);
      track.addEventListener('pointercancel', stopDrag);

      track.addEventListener('keydown', (evt) => {
        const dur = duration();
        if (evt.key === 'ArrowRight' || evt.key === 'ArrowUp') {
          evt.preventDefault();
          seekTo(Math.min(dur, audioEl.currentTime + 5));
        } else if (evt.key === 'ArrowLeft' || evt.key === 'ArrowDown') {
          evt.preventDefault();
          seekTo(Math.max(0, audioEl.currentTime - 5));
        } else if (evt.key === 'Home') {
          evt.preventDefault();
          seekTo(0);
        } else if (evt.key === 'End') {
          evt.preventDefault();
          seekTo(dur);
        }
      });

      // Speed cycle: 1x -> 1.25x -> 1.5x -> 1x.
      speedButton.addEventListener('click', () => {
        speedIndex = (speedIndex + 1) % speeds.length;
        const rate = speeds[speedIndex];
        audioEl.playbackRate = rate;
        const label = `${rate}×`;
        speedButton.textContent = label;
        speedButton.setAttribute('aria-label', `Playback speed: ${label}`);
        track_('audio-speed', { article: articleId, rate });
      });

      // Chapters: seek only, no autoplay, no page scroll.
      for (const btn of chapterButtons) {
        btn.addEventListener('click', () => {
          const start = parseFloat(btn.dataset.start || '0');
          seekTo(start);
          track_('audio-chapter', { article: articleId, chapter: btn.dataset.chapterId || '' });
        });
      }

      // ---------------------------------------------------------------
      // Read-along: active-paragraph highlight, follow-scroll, click-to-
      // seek, and the floating control that travels with the highlight
      // once the main player scrolls out of view.
      //
      // This whole section is deferred to DOMContentLoaded: this script
      // is inline (not `defer`/`module`), so it runs the instant the HTML
      // parser reaches it — which is up in the masthead, well before the
      // rest of the article (every §-section's [data-narr] anchor) has
      // been parsed into the DOM. Querying for them here, synchronously,
      // would only ever find the masthead's own two (title, dek).
      // ---------------------------------------------------------------
      function setupReadAlong() {
      const cuesRaw = root.dataset.cues || '';
      let cues = [];
      try {
        cues = cuesRaw ? JSON.parse(cuesRaw) : [];
      } catch {
        cues = [];
      }
      if (cues.length === 0) return;

      const floatEl = root.querySelector('[data-audio-float]');
      const floatPlayButton = root.querySelector('[data-audio-float-play]');
      const floatIconPlay = floatPlayButton ? floatPlayButton.querySelector('.audio-icon-play') : null;
      const floatIconPause = floatPlayButton ? floatPlayButton.querySelector('.audio-icon-pause') : null;
      const floatTimeEl = root.querySelector('[data-audio-float-time]');
      const floatFollowButton = root.querySelector('[data-audio-float-follow]');
      const floatUpButton = root.querySelector('[data-audio-float-up]');

      // One player per page in practice, so a document-wide id lookup for
      // narrated anchors is safe.
      const narrEls = new Map();
      if (cues.length > 0) {
        for (const el of document.querySelectorAll('[data-narr]')) {
          const id = el.dataset.narr;
          if (id) narrEls.set(id, el);
        }
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const desktopQuery = window.matchMedia('(min-width: 900px)');

      let activeCueId = null;
      let activeEl = null;
      let highlightStarted = false; // resume never highlights until real playback starts
      let followMode = true;
      let playerInView = true;
      let lastCueCheck = 0;
      let lastSeekAt = 0;
      let programmaticScrollUntil = 0;

      // Cues are start-ordered and non-overlapping; the active one is the
      // last whose start has been reached, so a short silent gap between
      // paragraphs keeps the previous highlight instead of flickering off.
      function findActiveCue(t) {
        let result = null;
        for (const c of cues) {
          if (c[1] <= t) result = c;
          else break;
        }
        return result;
      }

      function updateFollowButton() {
        if (floatFollowButton) floatFollowButton.setAttribute('aria-pressed', followMode ? 'true' : 'false');
      }

      function scrollToActive(el) {
        if (!followMode || !el) return;
        const rect = el.getBoundingClientRect();
        const targetY = window.innerHeight * 0.35;
        const delta = rect.top - targetY;
        if (Math.abs(delta) < 4) return;
        // Mark this scroll as ours so the generic scroll listener below
        // doesn't mistake it for reader-initiated scrolling and switch
        // Follow off. Smooth scrolling can take a few hundred ms to
        // settle, so the window is generous.
        programmaticScrollUntil = performance.now() + 900;
        window.scrollBy({ top: delta, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
      }

      function isMidway() {
        const dur = duration();
        const t = audioEl.currentTime;
        return t > 0.5 && (dur <= 0 || t < dur - 0.5);
      }

      function rectsIntersect(a, b) {
        return !(a.right <= b.left || a.left >= b.right || a.bottom <= b.top || a.top >= b.bottom);
      }

      function positionFloatDesktop() {
        if (!floatEl) return;
        floatEl.classList.remove('audio-float--bar-fallback');
        const referenceEl = activeEl || root;
        const container = referenceEl.closest('.section-inner, .masthead-inner');
        const marginCol = container ? container.querySelector(':scope > .margin-col') : null;
        const elRect = referenceEl.getBoundingClientRect();
        const floatH = floatEl.offsetHeight || 150;
        const floatW = floatEl.offsetWidth || 220;
        const header = document.querySelector('.site-header');
        const headerBottom = header ? header.getBoundingClientRect().bottom : 0;
        const minTop = headerBottom + 12;
        const maxTop = window.innerHeight - floatH - 12;

        let top = elRect.top;
        top = Math.max(top, minTop);
        top = Math.min(top, maxTop);

        // Right-aligned to the margin column's inner edge (~20px gap before
        // the text column starts), not spanning its width — a compact
        // cluster, not a box.
        let right = 20;
        if (marginCol) {
          const mcRect = marginCol.getBoundingClientRect();
          right = Math.max(8, Math.round(window.innerWidth - (mcRect.right - 20)));
        }

        // The float must never sit on top of a margin note, disclaimer or
        // caption living in the same margin column: try above the note,
        // then below it, and only fall back to the fixed bottom-bar style
        // (for this cue only — re-decided every time the highlight moves)
        // if neither clear spot fits in the viewport.
        if (marginCol) {
          const noteEls = Array.from(marginCol.querySelectorAll('.margin-note, figcaption'));
          const floatLeft = window.innerWidth - right - floatW;
          const rectAt = (t) => ({ top: t, bottom: t + floatH, left: floatLeft, right: floatLeft + floatW });
          const collidesAt = (t) => noteEls.some((n) => rectsIntersect(rectAt(t), n.getBoundingClientRect()));
          const collided = noteEls.find((n) => rectsIntersect(rectAt(top), n.getBoundingClientRect()));
          if (collided) {
            const noteRect = collided.getBoundingClientRect();
            const above = noteRect.top - floatH - 12;
            const below = noteRect.bottom + 12;
            if (above >= minTop && !collidesAt(above)) {
              top = above;
            } else if (below <= maxTop && !collidesAt(below)) {
              top = below;
            } else {
              floatEl.classList.add('audio-float--bar-fallback');
              floatEl.style.top = '';
              floatEl.style.right = '';
              return;
            }
          }
        }

        floatEl.style.top = `${Math.round(top)}px`;
        floatEl.style.right = `${right}px`;
      }

      function positionFloat() {
        if (!floatEl || floatEl.hidden) return;
        if (desktopQuery.matches) {
          positionFloatDesktop();
        } else {
          // Mobile is a plain fixed bottom bar (CSS only) — clear any
          // inline top/right (and the desktop collision fallback) left
          // over from a desktop-width position.
          floatEl.classList.remove('audio-float--bar-fallback');
          floatEl.style.top = '';
          floatEl.style.right = '';
        }
      }

      function updateFloatVisibility() {
        if (!floatEl || cues.length === 0) return;
        const active = !audioEl.paused || isMidway();
        // Keyboard focus currently inside the float (e.g. Tab landed on
        // Follow or ↑ Player) keeps it visible even if the player has just
        // scrolled into view — otherwise it can disappear out from under
        // focus mid-Tab and flicker back.
        const focusInFloat = document.activeElement instanceof Node && floatEl.contains(document.activeElement);
        const shouldShow = focusInFloat || (active && !playerInView);
        if (shouldShow === !floatEl.hidden) {
          if (shouldShow) positionFloat();
          return;
        }
        floatEl.hidden = !shouldShow;
        if (shouldShow) positionFloat();
      }

      function setHighlight(cue) {
        if (!cue) return;
        const id = cue[0];
        if (id === activeCueId) return;
        if (activeEl) activeEl.classList.remove('is-reading');
        const el = narrEls.get(id) || null;
        activeCueId = id;
        activeEl = el;
        if (activeEl) {
          activeEl.classList.add('is-reading');
          scrollToActive(activeEl);
        }
        positionFloat();
      }

      if (floatEl && cues.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) playerInView = entry.isIntersecting;
            updateFloatVisibility();
          },
          { threshold: 0 }
        );
        io.observe(root);

        // Tab landing on/leaving a float control changes whether it
        // should stay visible; re-check immediately rather than waiting
        // for the next scroll/timeupdate tick.
        floatEl.addEventListener('focusin', updateFloatVisibility);
        floatEl.addEventListener('focusout', updateFloatVisibility);

        floatPlayButton?.addEventListener('click', () => {
          if (audioEl.paused) audioEl.play().catch(() => {});
          else audioEl.pause();
        });

        floatFollowButton?.addEventListener('click', () => {
          followMode = !followMode;
          updateFollowButton();
          if (followMode) scrollToActive(activeEl);
        });

        floatUpButton?.addEventListener('click', () => {
          root.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
        });

        // Any user scroll intent switches follow off — it never fights the
        // reader. Keys/wheel/touch that originate inside the player or the
        // float itself (seeking, the Follow toggle, arrow-key seek) don't
        // count as "the reader wants to scroll".
        const disableFollow = () => {
          if (!followMode) return;
          followMode = false;
          updateFollowButton();
        };
        window.addEventListener('wheel', disableFollow, { passive: true });
        window.addEventListener('touchmove', disableFollow, { passive: true });
        window.addEventListener('keydown', (evt) => {
          const keys = ['PageUp', 'PageDown', ' ', 'ArrowUp', 'ArrowDown'];
          if (!keys.includes(evt.key)) return;
          const target = evt.target;
          if (target instanceof Node && (root.contains(target) || floatEl.contains(target))) return;
          disableFollow();
        });

        // Belt-and-braces: ANY scroll that isn't the one we just issued
        // ourselves (scrollbar drag, keyboard scroll, another script)
        // switches Follow off, same as wheel/touchmove/keydown above.
        window.addEventListener(
          'scroll',
          () => {
            if (performance.now() > programmaticScrollUntil) disableFollow();
            positionFloat();
          },
          { passive: true }
        );
        window.addEventListener('resize', () => positionFloat());
        if (desktopQuery.addEventListener) desktopQuery.addEventListener('change', () => positionFloat());

        // Click-to-seek: any narrated anchor jumps playback to its cue
        // start (and plays, if paused). Clicks on a real link/button/embed
        // inside the anchor (e.g. the §9 watch cards) are left alone.
        document.body.classList.add('audio-narr-ready');
        // A click that's really the end of a text-selection drag (or a
        // link/button/iframe/input inside the anchor, or a keyboard-
        // triggered click) must never seek.
        let downX = 0;
        let downY = 0;
        const onPointerDown = (evt) => {
          downX = evt.clientX;
          downY = evt.clientY;
        };
        for (const [id] of cues) {
          const el = narrEls.get(id);
          if (!el) continue;
          el.setAttribute('title', 'Play from here');
          el.addEventListener('pointerdown', onPointerDown);
          el.addEventListener('click', (evt) => {
            const target = evt.target;
            if (target instanceof Element && target.closest('a, button, iframe, input')) return;
            if (evt.detail === 0) return; // keyboard-triggered click, not a pointer click
            const dx = evt.clientX - downX;
            const dy = evt.clientY - downY;
            if (Math.sqrt(dx * dx + dy * dy) > 6) return; // pointer moved: a drag, not a click
            const selection = window.getSelection ? window.getSelection() : null;
            if (selection && selection.toString().length > 0) return; // text was selected
            const now = performance.now();
            if (now - lastSeekAt < 80) return; // guard: once per click
            lastSeekAt = now;
            const cue = cues.find((c) => c[0] === id);
            if (!cue) return;
            const wasActive = el === activeEl;
            seekTo(cue[1]);
            if (audioEl.paused) audioEl.play().catch(() => {});
            if (wasActive) {
              followMode = true;
              updateFollowButton();
            }
            track_('audio-seek', { article: articleId, id });
          });
        }
      }

      // Extend play/pause/timeupdate to drive the read-along, on top of
      // the existing icon/progress/resume behaviour above.
      if (cues.length > 0) {
        audioEl.addEventListener('play', () => {
          highlightStarted = true;
          setHidden(floatIconPlay, true);
          setHidden(floatIconPause, false);
          floatPlayButton?.setAttribute('aria-label', 'Pause');
          updateFloatVisibility();
        });

        audioEl.addEventListener('pause', () => {
          setHidden(floatIconPlay, false);
          setHidden(floatIconPause, true);
          floatPlayButton?.setAttribute('aria-label', 'Play');
          updateFloatVisibility();
        });

        audioEl.addEventListener('timeupdate', () => {
          if (floatTimeEl) floatTimeEl.textContent = formatTime(audioEl.currentTime);

          const now = performance.now();
          if (now - lastCueCheck < 240) return; // ~4/s
          lastCueCheck = now;

          if (highlightStarted) {
            const cue = findActiveCue(audioEl.currentTime);
            if (cue) setHighlight(cue);
          }
          updateFloatVisibility();
        });

        audioEl.addEventListener('ended', () => {
          if (activeEl) activeEl.classList.remove('is-reading');
          activeEl = null;
          activeCueId = null;
          highlightStarted = false;
          if (floatEl) floatEl.hidden = true;
        });
      }
      } // setupReadAlong

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReadAlong);
      } else {
        setupReadAlong();
      }

      updateUI(0);
    }
  })();
</script>

<style>

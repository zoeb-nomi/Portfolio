---
// The page head (kit `.page-head`): kicker, h1, standfirst, a byline, then whatever the page puts in the default
// slot (the AudioPlayer, a finding line), then optional readouts (`stats`) and, for a case study, the spec strip.
//
//   default   kicker (or `crumbs`), h1, standfirst; `spec` becomes the HUD strip, `switcher` and `repo` a link row
//   plain     no kicker (Work)
//   photo     pass `thumbnail` or `portrait`: the headshot sits beside the title (About)
//
// Slots: `byline` (the dated line under the standfirst) and the default slot (anything under that).
// An essay or note head (it has a byline and no case-study props) is marked `data-article`: that switches on the
// red reading spine and in-place footnotes (scripts/reading.ts) for the sections below it. Pass `article` to
// force it on or off.
import Headshot from './Headshot.astro';
import EvalsSwitcher from './EvalsSwitcher.astro';

interface SpecRow {
  label: string;
  value: string;
}

interface Stat {
  v: string;
  u: string;
  s?: string;
}

interface Props {
  h1: string;
  kicker?: string;
  standfirst?: string;
  /** Accessible name for the case-study details (spec, switcher, repo link). */
  label?: string;
  variant?: 'default' | 'plain';
  thumbnail?: { alt: string };
  /** Any CSS length; ch is relative to the h1's own font size. */
  h1Max?: string;
  standfirstMax?: string;
  /** Read-along anchors (data-narr) on the h1, standfirst and spec block. */
  narr?: boolean;
  spec?: SpecRow[];
  switcher?: 'CrossSource' | 'mirror-eval' | 'screener-eval';
  repo?: { href: string; label: string };
  /** Breadcrumb under Builds/Writing. Replaces the kicker. */
  crumbs?: { label: string; href?: string }[];
  /** About: the portrait beside the title. */
  portrait?: { alt: string };
  /** Readouts under the head (`.stats > .ro`): value, unit, source. Rendered after the default slot. */
  stats?: Stat[];
  /** Mark this head as an article (spine and footnotes below it). Default: a byline and no case-study props. */
  article?: boolean;
}

const {
  h1,
  kicker,
  standfirst,
  label = 'Case study details',
  variant = 'default',
  thumbnail,
  h1Max,
  standfirstMax,
  narr = false,
  spec,
  switcher,
  repo,
  crumbs,
  portrait,
  stats,
  article,
} = Astro.props;

const photo = Boolean(thumbnail) || Boolean(portrait);
const plain = variant === 'plain';
const hasByline = Astro.slots.has('byline');
const hasExtras = Boolean(spec || switcher || repo);
const isArticle = article ?? (hasByline && !hasExtras && !crumbs && !photo && !plain);
---

<section class:list={['page-head', 'gut', { 'is-photo': photo }]} data-article={isArticle ? '' : undefined}>
  <div class="in">
    <div class:list={['mh', { 'mh--photo': photo }]}>
      {
        photo && (
          <div class="mh-photo">
            <Headshot size={portrait ? 'about' : 'thumb'} alt={(portrait ?? thumbnail)!.alt} loading="eager" />
          </div>
        )
      }
      <div class="mh-body">
        {
          crumbs ? (
            <nav class="kick crumbs" aria-label="Breadcrumb">
              <ol>
                {crumbs.map((c, i) => (
                  <li>
                    {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.label}</span>}
                  </li>
                ))}
              </ol>
            </nav>
          ) : (
            kicker && !photo && !plain && <p class="kick">{kicker}</p>
          )
        }
        {crumbs && kicker && <p class="mh-kicker lab">{kicker}</p>}
        <h1 class="display split" style={h1Max ? `max-width:${h1Max}` : undefined} data-narr={narr ? 's0-title' : undefined}>{h1}</h1>
        {
          standfirst && (
            <p class="dek" style={standfirstMax ? `max-width:${standfirstMax}` : undefined} data-narr={narr ? 's0-dek' : undefined}>
              {standfirst}
            </p>
          )
        }
        {
          hasByline && (
            <div class="byline meta">
              <slot name="byline" />
            </div>
          )
        }
        <slot />
        {
          stats && stats.length > 0 && (
            <div class="stats">
              {stats.map((s) => (
                <div class="ro">
                  <p class="v" data-num>{s.v}</p>
                  <p class="u">{s.u}</p>
                  {s.s && <p class="s">{s.s}</p>}
                </div>
              ))}
            </div>
          )
        }
        {
          spec && (
            <div class="hud mh-spec" role="group" aria-label={label} data-narr={narr ? 's0-stats' : undefined}>
              <dl class="hud-in">
                {spec.map((s) => (
                  <div class="hud-c">
                    <dt>{s.label}</dt>
                    <dd><b>{s.value}</b></dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
        {
          (switcher || repo) && (
            <div class="mh-links">
              {switcher && <EvalsSwitcher current={switcher} />}
              {repo && (
                <a class="tl" href={repo.href} target="_blank" rel="noopener noreferrer">
                  {repo.label}
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { reading } from '../scripts/reading';
  reading();
</script>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .crumbs li:not(:last-child)::after {
    content: '/';
    padding-inline: var(--s-2);
    color: var(--color-text-muted);
  }

  .crumbs a {
    color: var(--color-text-body);
    text-decoration: none;
  }

  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--color-text);
  }

  .mh-kicker {
    margin-top: var(--s-3);
  }

  /* The portrait sits beside the title and shares its bottom edge. */
  .mh--photo {
    display: flex;
    align-items: flex-end;
    gap: clamp(var(--s-5), 3vw, var(--s-9));
  }

  .mh-photo {
    flex: none;
    width: 120px;
  }

  .mh--photo .mh-body {
    min-width: 0;
  }

  @media (max-width: 599px) {
    .mh--photo {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* The spec strip and the switcher row sit under the readouts. */
  .mh-spec {
    margin-top: var(--s-6);
  }

  .mh-spec dl,
  .mh-spec dd {
    margin: 0;
  }

  .mh-spec dt {
    font: inherit;
  }

  .mh-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-7);
    margin-top: var(--s-5);
  }
</style>

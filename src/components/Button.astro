---
// A button or link in the kit's grammar. `primary` is the red `.btn` (the arrow nudges 3px, nothing else moves),
// `secondary` the outlined `.btn.ghost`, `link` (and the old `inverse`) the underlined mono `.tl`. A trailing → or ↗
// in the label is replaced by the button's own arrow. External hrefs open in a new tab.
import { isExternal } from '../lib/isExternal';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'inverse' | 'link';
  class?: string;
  /** Show the arrow on `.btn` buttons. */
  arrow?: boolean;
}

const { href, variant = 'secondary', class: className = '', arrow = true } = Astro.props;
const external = isExternal(href);
const raw = await Astro.slots.render('default');
const label = raw.replace(/\s*(?:→|↗|&rarr;)\s*$/, '').trim();
const isLink = variant === 'link' || variant === 'inverse';
const classes = isLink ? 'tl' : variant === 'primary' ? 'btn' : 'btn ghost';
const glyph = external ? '↗' : '→';
---

<a href={href} class:list={[classes, className]} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  {isLink ? <Fragment set:html={raw} /> : <><span class="mi" set:html={label} />{arrow && <span class="ar" aria-hidden="true">{glyph}</span>}</>}
</a>

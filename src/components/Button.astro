---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'inverse';
  class?: string;
}

const { href, variant = 'secondary', class: className = '' } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  class={`rp-button rp-button--${variant} ${className}`}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>

<style>
  .rp-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--hit-touch);
    padding: 13px 22px;
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: background-color var(--dur-fast) var(--ease-draw), color var(--dur-fast) var(--ease-draw),
      border-color var(--dur-fast) var(--ease-draw), transform var(--dur-fast) var(--ease-draw);
  }

  .rp-button:active {
    transform: translateY(1px);
  }

  .rp-button--primary {
    background: var(--red);
    color: var(--on-red);
    border-color: var(--red);
  }

  .rp-button--primary:hover {
    background: var(--red-ink);
    border-color: var(--red-ink);
  }

  .rp-button--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .rp-button--secondary:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .rp-button--inverse {
    background: var(--paper);
    color: var(--red-ink);
    border-color: var(--paper);
  }

  /* paper -> paper-raised was 1.06:1, i.e. no visible hover on the red slab.
     Same ink fill as the secondary variant. */
  .rp-button--inverse:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
</style>

---
// The agent harness panel (The Pipeline, home band): Zoeb's agent harness, counted as it runs.
//   A five-step flow (Filed, Agent runs, Checked, My review, Closed) with a dashed "caught before merge" branch
//   under Checked and My review; four tiles (closed and caught in 7 days, all-in cost per task, on time); and a
//   14-day grid, one square per closed task, caught ones red, the last 7 days shaded, days before the ledger starts
//   shown as a short line. "How these count" is a closed disclosure. One tab stop for the grid; arrows, Home and
//   End move between days and the readout line gives that day's counts.
//   Data: the snapshot (src/data/ledger-snapshot.json, refreshed by scripts/fetch-ledger.mjs at build) is the HTML.
//   On load the panel reads the agent ledger's public summary and holds its WebSocket, so numbers move while a
//   visitor watches (digits change with swap(), never a count-up). Any error leaves what is on screen.
//   Status: "Live, last event <time>" or "Last updated <date>". The band around it (heading, background) is the
//   page's; this component is the .hz block.
// Variants: none. Motion: none of its own; changed digits tick once (ds.ts swap).
// Copy: home.v5.harness and pipelineHome.harness in src/data/copy.ts. Every number is a snapshot or ledger field.
import { home, pipelineHome } from '../data/copy';
import snapshot from '../data/ledger-snapshot.json';

const h = home.v5.harness;
const hx = pipelineHome.harness;
const s = snapshot;

const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
const money = (n: number | null | undefined) => (typeof n === 'number' ? `$${n.toFixed(2)}` : 'n/a');
const dayLabel = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const o = s.outcomes;
const ro = o.readout as { on_time?: { x: number; y: number }; median_wait_for_review_min?: { value: number } };
const start = o.since;
const days = s.days.map((d, i) => ({ ...d, before: d.date < start, week: i >= s.days.length - 7 }));
const detail = (d: (typeof days)[number]) =>
  d.before ? fill(h.beforeDetail, { date: dayLabel(d.date) }) : fill(h.dayDetail, { date: dayLabel(d.date), s: d.shipped, c: d.caught });
const totals = days.reduce((a, d) => ({ s: a.s + d.shipped, c: a.c + d.caught }), { s: 0, c: 0 });
const readout = fill(h.readout, totals);
const startIdx = days.findIndex((d) => d.date === start);
const staleText = `${h.staleLabel} ${dayLabel(s.generated_at.slice(0, 10))}`;
// Reserve the grid's height from the snapshot's busiest day, so live data rarely moves the page.
const maxSq = Math.max(1, ...days.map((d) => d.shipped + d.caught));
const ROWS_MAX = 28; // a day taller than this is clipped at the top; the readout line still has its exact counts
const rows = Math.min(ROWS_MAX, Math.ceil(maxSq / 2));
const capParts = h.gridCaption.split('; ');
const step = hx.steps;
const wait = ro.median_wait_for_review_min?.value;
---

<div
  class="hz"
  data-hp
  data-ledger={h.ledgerUrl}
  data-live-label={h.liveLabel}
  data-stale-label={h.staleLabel}
  data-since={h.since}
  data-api-only={h.apiOnly}
  data-runs-sub={step[1].s}
  data-readout={h.readout}
  data-day-detail={h.dayDetail}
  data-before-detail={h.beforeDetail}
  data-from-tick={h.fromTick}
  data-today-tick={h.todayTick}
  data-start={start}
  style={`--rows:${rows}`}
>
  <div class="hz-bar">
    <span class="hz-st" data-hp-status><i aria-hidden="true"></i><span data-hp-label>{staleText}</span></span>
  </div>

  <ol class="hz-flow" aria-label={hx.flowLabel}>
    <li class="st s1">
      <span class="hf-k"><i>01</i>{step[0].k}</span><b class="hf-v t">{step[0].t}</b><span class="hf-s">{step[0].s}</span>
    </li>
    <li class="st s2">
      <span class="hf-k"><i>02</i>{step[1].k}</span><b class="hf-v"><span data-hp-live="0">{s.live.agent_runs_today}</span></b>
      <span class="hf-s" data-hp-runs>{fill(step[1].s, { n: s.live.subagent_runs_today })}</span>
    </li>
    <li class="st ck s3">
      <span class="hf-k"><i>03</i>{step[2].k}</span><b class="hf-v t">{step[2].t}</b><span class="hf-s">{step[2].s}</span>
    </li>
    <li class="st ck s4">
      <span class="hf-k"><i>04</i>{step[3].k}</span><b class="hf-v"><span data-hp-out="wait">{wait ?? 'n/a'}</span><small>{step[3].unit}</small></b>
      <span class="hf-s">{step[3].s}</span>
    </li>
    <li class="st end">
      <span class="hf-k"><i>05</i>{step[4].k}</span><b class="hf-v"><span data-hp-out="closedTotal">{o.shipped_total}</span></b><span class="hf-s">{step[4].s}</span>
    </li>
    <li class="catch">
      <span class="cb" aria-hidden="true"></span>
      <p><b data-hp-out="caughtTotal">{o.caught_total}</b>{hx.caught.label}</p>
      <span class="hf-s">{hx.caught.s}</span>
    </li>
  </ol>

  <dl class="hz-tiles">
    <div class="hz-t">
      <dt>{h.outcomeTiles[0]}</dt>
      <dd><span data-hp-out="closed7">{o.shipped_7d}</span></dd>
      <dd class="hs" data-hp-sub="closed7">{fill(h.since, { n: o.shipped_total })}</dd>
    </div>
    <div class="hz-t r">
      <dt>{h.outcomeTiles[1]}</dt>
      <dd><span data-hp-out="caught7">{o.caught_7d}</span></dd>
      <dd class="hs" data-hp-sub="caught7">{fill(h.since, { n: o.caught_total })}</dd>
    </div>
    <div class="hz-t">
      <dt>{h.outcomeTiles[2]}</dt>
      <dd><span data-hp-out="allin">{money(o.cost.all_in_per_shipped_usd)}</span></dd>
      <dd class="hs" data-hp-sub="allin">{fill(h.apiOnly, { api: money(o.cost.api_per_shipped_usd) })}</dd>
    </div>
    <div class="hz-t">
      <dt>{hx.onTime.label}</dt>
      <dd><span data-hp-out="onx">{ro.on_time?.x ?? 'n/a'}</span><small>/ <span data-hp-out="ony">{ro.on_time?.y ?? 'n/a'}</span></small></dd>
      <dd class="hs">{hx.onTime.sub}</dd>
    </div>
  </dl>

  <figure class="hz-g">
    <div class="v-cap"><span>{capParts[0]}</span><span>{capParts[1]}</span></div>
    <ol class="hz-days" data-hp-days aria-label={h.gridCaption}>
      {
        days.map((d, i) => (
          <li
            class:list={['hz-day', { wk: d.week, pre: d.before }]}
            tabindex={i === days.length - 1 ? 0 : -1}
            aria-label={detail(d)}
            data-date={d.date}
            data-detail={detail(d)}
          >
            <span class="hz-stk" aria-hidden="true">
              {Array.from({ length: d.caught }, () => <i class="c" />)}
              {Array.from({ length: d.shipped }, () => <i />)}
            </span>
          </li>
        ))
      }
    </ol>
    <p class="hz-ax lab" aria-hidden="true" data-hp-ticks>
      <span style="grid-column:1">{dayLabel(days[0].date)}</span>
      {startIdx > 0 && <span style={`grid-column:${startIdx + 1}`}>{fill(h.fromTick, { date: dayLabel(start) })}</span>}
      <span class="hz-tick-end">{h.todayTick}</span>
    </p>
    <p class="hz-read" aria-live="polite" data-hp-readout data-default={readout}>{readout}</p>
  </figure>

  <details class="hz-how">
    <summary>{h.how.summary}</summary>
    <ul>{h.how.items.map((t) => <li>{t}</li>)}</ul>
  </details>
</div>

<script>
  import { swap } from '../scripts/ds';

  type Day = { date: string; shipped: number; caught: number };
  type Summary = {
    last_event_at: string | null;
    live: { agent_runs_today: number; subagent_runs_today: number };
    outcomes: {
      since?: string;
      shipped_7d: number; shipped_total: number; caught_7d: number; caught_total: number;
      cost: { all_in_per_shipped_usd: number | null; api_per_shipped_usd: number | null };
      readout: { on_time?: { x: number; y: number }; median_wait_for_review_min?: { value: number } };
    };
    days: Day[];
  };
  const STALE_MS = 3 * 3600 * 1000;
  const POLL_MS = 60 * 1000;
  const MAX_POLLS = 30; // a fallback poll stops after half an hour
  const BACKOFF_MS = 10 * 60 * 1000; // after a refusal (rate limit, quota), wait before asking again
  const REFOCUS_MS = 30 * 1000; // at most one refetch per 30 s when the tab comes back

  // The ledger is a third party to this page: accept only finite non-negative numbers and ISO dates.
  const num = (v: unknown) => (typeof v === 'number' && Number.isFinite(v) && v >= 0 ? v : null);
  const isoDay = (v: unknown) => (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v : null);
  const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const money = (n: number | null) => (n === null ? 'n/a' : `$${n.toFixed(2)}`);
  const dayLabel = (iso: string) =>
    new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const timeIST = (iso: string) =>
    new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' }) + ' IST';

  document.querySelectorAll<HTMLElement>('[data-hp]').forEach((hp) => {
    const $ = <T extends HTMLElement>(sel: string) => hp.querySelector<T>(sel);
    const ds = hp.dataset;
    const readout = $('[data-hp-readout]')!;
    const ol = $('[data-hp-days]')!;
    let showing: string | null = null; // the date whose detail is in the readout

    const show = (li: HTMLElement | null) => {
      showing = li?.dataset.date ?? null;
      readout.textContent = li ? li.dataset.detail ?? '' : readout.dataset.default ?? '';
    };
    // One tab stop for the grid (roving tabindex); arrows, Home and End move between days.
    const cols = () => [...ol.querySelectorAll<HTMLElement>('.hz-day')];
    const focusDay = (li: HTMLElement) => {
      cols().forEach((c) => (c.tabIndex = c === li ? 0 : -1));
      li.focus();
    };
    ol.addEventListener('keydown', (e) => {
      const list = cols();
      const i = list.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const moves: Record<string, number> = { ArrowLeft: i - 1, ArrowRight: i + 1, Home: 0, End: list.length - 1 };
      const to = moves[e.key];
      if (to === undefined) return;
      e.preventDefault();
      focusDay(list[Math.max(0, Math.min(list.length - 1, to))]);
    });
    ol.addEventListener('focusin', (e) => show((e.target as HTMLElement).closest('.hz-day')));
    ol.addEventListener('focusout', () => show(null));
    ol.addEventListener('pointerover', (e) => show((e.target as HTMLElement).closest('.hz-day')));
    ol.addEventListener('pointerleave', () => show(ol.contains(document.activeElement) ? (document.activeElement as HTMLElement) : null));

    // Digits change through swap() (an instant change with a short opacity tick, never a count); sentences are set whole.
    const setNum = (key: string, value: string | number) => {
      const el = $(`[data-hp-out="${key}"]`);
      if (el) swap(el, value);
    };
    const setText = (sel: string, text: string) => {
      const el = $(sel);
      if (el && el.textContent !== text) el.textContent = text;
    };

    const render = (d: Summary) => {
      const live = d?.live, o = d?.outcomes;
      if (!live || !o || !Array.isArray(d.days)) return;
      const a = num(live.agent_runs_today), b = num(live.subagent_runs_today);
      const runs = $('[data-hp-live="0"]');
      if (a !== null && runs) swap(runs, a);
      if (b !== null) setText('[data-hp-runs]', fill(ds.runsSub ?? '', { n: b }));
      const s7 = num(o.shipped_7d), st = num(o.shipped_total), c7 = num(o.caught_7d), ct = num(o.caught_total);
      if (s7 !== null) setNum('closed7', s7);
      if (c7 !== null) setNum('caught7', c7);
      if (st !== null) { setNum('closedTotal', st); setText('[data-hp-sub="closed7"]', fill(ds.since ?? '', { n: st })); }
      if (ct !== null) { setNum('caughtTotal', ct); setText('[data-hp-sub="caught7"]', fill(ds.since ?? '', { n: ct })); }
      setNum('allin', money(num(o.cost?.all_in_per_shipped_usd)));
      setText('[data-hp-sub="allin"]', fill(ds.apiOnly ?? '', { api: money(num(o.cost?.api_per_shipped_usd)) }));
      const wait = num(o.readout?.median_wait_for_review_min?.value);
      if (wait !== null) setNum('wait', wait);
      const ot = o.readout?.on_time;
      const ox = num(ot?.x), oy = num(ot?.y);
      if (ox !== null) setNum('onx', ox);
      if (oy !== null) setNum('ony', oy);

      // Rebuild the 14 day columns from validated numbers only (createElement, never innerHTML).
      const start = isoDay(o.since) ?? ds.start ?? '';
      const days = d.days.slice(-14).map((x) => ({
        date: isoDay(x?.date), s: Math.min(num(x?.shipped) ?? 0, 99), c: Math.min(num(x?.caught) ?? 0, 99),
      }));
      if (days.length === 14 && days.every((x) => x.date)) {
        hp.style.setProperty('--rows', String(Math.min(28, Math.ceil(Math.max(1, ...days.map((x) => x.s + x.c)) / 2))));
        const focusedDate = ol.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.date : null;
        const tabDate = ol.querySelector<HTMLElement>('.hz-day[tabindex="0"]')?.dataset.date;
        const items = days.map((x, i) => {
          const before = x.date! < start;
          const text = before
            ? fill(ds.beforeDetail ?? '', { date: dayLabel(x.date!) })
            : fill(ds.dayDetail ?? '', { date: dayLabel(x.date!), s: x.s, c: x.c });
          const li = document.createElement('li');
          li.className = 'hz-day' + (i >= 7 ? ' wk' : '') + (before ? ' pre' : '');
          li.dataset.date = x.date!;
          li.dataset.detail = text;
          li.setAttribute('aria-label', text);
          const stack = document.createElement('span');
          stack.className = 'hz-stk';
          stack.setAttribute('aria-hidden', 'true');
          for (let k = 0; k < x.c; k++) stack.append(Object.assign(document.createElement('i'), { className: 'c' }));
          for (let k = 0; k < x.s; k++) stack.append(document.createElement('i'));
          li.append(stack);
          return li;
        });
        const keep = items.find((li) => li.dataset.date === tabDate) ?? items[13];
        items.forEach((li) => (li.tabIndex = li === keep ? 0 : -1));
        ol.replaceChildren(...items);
        const tot = days.reduce((acc, x) => (x.date! < start ? acc : { s: acc.s + x.s, c: acc.c + x.c }), { s: 0, c: 0 });
        readout.dataset.default = fill(ds.readout ?? '', tot);
        if (focusedDate) items.find((li) => li.dataset.date === focusedDate)?.focus();
        const restore = items.find((li) => li.dataset.date === showing);
        show(restore ?? null);
        const ticks = $('[data-hp-ticks]');
        const si = days.findIndex((x) => x.date === start);
        if (ticks) {
          const parts: HTMLElement[] = [Object.assign(document.createElement('span'), { textContent: dayLabel(days[0].date!), style: 'grid-column:1' })];
          if (si > 0) parts.push(Object.assign(document.createElement('span'), { textContent: fill(ds.fromTick ?? '', { date: dayLabel(start) }), style: `grid-column:${si + 1}` }));
          parts.push(Object.assign(document.createElement('span'), { className: 'hz-tick-end', textContent: ds.todayTick ?? '' }));
          ticks.replaceChildren(...parts);
        }
      }

      // Status: live while the newest event is recent; otherwise the date, muted.
      const last = typeof d.last_event_at === 'string' ? Date.parse(d.last_event_at) : NaN;
      const fresh = Number.isFinite(last) && Date.now() - last < STALE_MS;
      const status = $('[data-hp-status]')!;
      if (fresh) {
        setText('[data-hp-label]', `${ds.liveLabel} ${timeIST(d.last_event_at!)}`);
        status.setAttribute('data-live', '');
      } else {
        setText('[data-hp-label]', `${ds.staleLabel} ${dayLabel(new Date(Number.isFinite(last) ? last : Date.now()).toISOString().slice(0, 10))}`);
        status.removeAttribute('data-live');
      }
    };

    const base = ds.ledger;
    if (!base || !/^https:\/\//.test(base)) return;

    // Be gentle with the ledger (Workers Free, shared with ingest): one summary read, one socket; a capped,
    // visible-only poll if the socket fails; back off after a refusal; debounce refetch on tab return.
    let pausedUntil = 0, lastPull = 0, timer = 0, polls = 0;
    const pull = () => {
      if (Date.now() < pausedUntil) return Promise.resolve(false);
      lastPull = Date.now();
      return fetch(`${base}/v1/summary`, { cache: 'no-store' })
        .then((r) => {
          if (r.status === 429 || r.status >= 500) pausedUntil = Date.now() + BACKOFF_MS;
          return r.ok ? r.json().then((d) => (render(d), true)) : false;
        })
        .catch(() => ((pausedUntil = Date.now() + BACKOFF_MS), false));
    };
    const stopPoll = () => { if (timer) { clearInterval(timer); timer = 0; } };
    const poll = () => {
      if (timer || polls >= MAX_POLLS) return;
      timer = window.setInterval(() => {
        if (document.visibilityState !== 'visible') return;
        if (++polls >= MAX_POLLS) stopPoll();
        pull();
      }, POLL_MS);
    };
    // Off the production site (previews, local) the ledger refuses the socket by origin: poll instead.
    const socketAllowed = /(^|\.)zoebnomi\.com$/.test(location.hostname);
    const connect = (ok: boolean) => {
      if (!ok) return; // the ledger refused or is down: keep what is on screen, try again on tab return
      if (!socketAllowed) return poll();
      try {
        const ws = new WebSocket(base.replace(/^https:/, 'wss:') + '/v1/live');
        ws.addEventListener('message', (e) => {
          stopPoll();
          if (typeof e.data !== 'string' || e.data.length > 20000) return;
          try { render(JSON.parse(e.data)); } catch { /* ignore a bad frame */ }
        });
        ws.addEventListener('close', poll);
      } catch {
        poll();
      }
    };
    pull().then(connect);
    // Back on the tab (also rolls "today" over a new IST day), at most once per 30 s.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - lastPull > REFOCUS_MS) pull();
    });
  });
</script>

<style is:global>
.hz{margin-top:clamp(28px,5vh,52px);border-top:var(--line-heavy);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:0 clamp(28px,4vw,64px)}
.hz-bar{grid-column:1/-1;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 0;border-bottom:var(--line-hair)}
.hz-st{display:inline-flex;align-items:center;gap:8px;min-height:var(--hit-min);font:500 11px/1 var(--font-data);letter-spacing:.12em;text-transform:uppercase;color:var(--color-text-muted)}
.hz-st i{display:block;width:7px;height:7px;background:var(--color-text-muted)}
.hz-st[data-live]{color:var(--color-text)}
.hz-st[data-live] i{background:var(--color-accent)}
.hz-flow{grid-column:1/-1;list-style:none;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin:0;padding:26px 0 0;border-bottom:var(--line-hair)}
.hz-flow>li{position:relative;padding:24px 18px 22px 0;min-width:0}
.hz-flow>li.st::before{content:"";position:absolute;left:0;top:0;width:9px;height:9px;box-sizing:border-box;box-shadow:inset 0 0 0 1.5px var(--color-text-body);background:var(--color-surface-raised)}
.hz-flow>li.st:not(.end)::after{content:"";position:absolute;left:15px;right:6px;top:4px;height:1.5px;background:var(--color-line-strong)}
.hz-flow>li.st.end::before{background:var(--color-text);box-shadow:none}
.hz-flow>li.st.ck::before{box-shadow:inset 0 0 0 1.5px var(--color-accent)}
.hf-k{display:block;font:500 11px/1.3 var(--font-data);letter-spacing:.12em;text-transform:uppercase;color:var(--color-text-muted)}
.hf-k i{font-style:normal;color:var(--color-accent);margin-right:8px}
.hf-v{display:block;margin-top:10px;font-size:var(--t-num);line-height:1;letter-spacing:-.02em;font-variation-settings:"wdth" 90,"wght" 760;font-variant-numeric:tabular-nums;color:var(--color-text);white-space:nowrap}
.hf-v small{font:400 12px var(--font-data);letter-spacing:0;color:var(--color-text-muted);margin-left:4px}
.hf-v.t{font-size:clamp(17px,1.35vw,20px);line-height:1.15;letter-spacing:-.01em;font-variation-settings:"wdth" 92,"wght" 640;white-space:normal}
.hz-flow>li.st .hf-v{min-height:46px}
.hf-s{display:block;margin-top:6px;font:400 11px/1.4 var(--font-data);color:var(--color-text-muted)}
.hz-flow>li.catch{grid-column:3/5;grid-row:2;padding:0 18px 22px 0;margin-top:-4px}
.hz-flow>li.catch .cb{display:block;height:12px;border:var(--line-pen-dashed);border-top:0;margin-right:18px}
.hz-flow>li.catch p{margin-top:10px;font:500 12px/1.4 var(--font-data);color:var(--color-text-body)}
.hz-flow>li.catch p b{font-family:var(--font-text);font-size:var(--t-num);line-height:1;letter-spacing:-.02em;font-variation-settings:"wdth" 90,"wght" 760;font-weight:760;color:var(--color-accent);margin-right:8px;vertical-align:-2px}
.hz-tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:start}
.hz-t{padding:18px 16px 18px 0;border-bottom:var(--line-hair);min-width:0}
.hz-t dt{font:500 11px/1.3 var(--font-data);letter-spacing:.1em;text-transform:uppercase;color:var(--color-text-muted)}
.hz-t dd{margin:8px 0 0;font-size:var(--t-num);line-height:1;letter-spacing:-.02em;font-weight:760;font-variation-settings:"wdth" 90,"wght" 760;font-variant-numeric:tabular-nums;color:var(--color-text)}
.hz-t dd small{font:400 12px var(--font-data);letter-spacing:0;color:var(--color-text-muted);margin-left:4px}

---
// The harness panel (Red Pen 5, home): Zoeb's agent harness, counted as it runs, on the ink surface.
// Two groups kept apart: today (agent and subagent runs) and outcomes (closed and caught in the last 7 days, all-in
// cost per task with API only, review wait with on-time), then a 14-day unit grid: one square per closed task in
// the text colour, caught in the pen (annotation only), the last 7 days shaded, days before the ledger starts shown
// as a short line. One tab stop for the grid; arrow keys move between days and the readout gives that day's counts.
// Data: the snapshot (src/data/ledger-snapshot.json, refreshed by scripts/fetch-ledger.mjs at build) is the HTML;
// on load the panel reads the agent ledger's public summary and holds its WebSocket, so numbers move while a
// visitor watches. Any error leaves what is on screen. Status: "Live, last event <time>" or "Last updated <date>"
// in graphite. No motion: no count-up (a live number must never be rewound) and no pulse (red is the pen's).
import { home } from '../data/copy';
import snapshot from '../data/ledger-snapshot.json';

const h = home.v5.harness;
const s = snapshot;

const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
const money = (n: number | null | undefined) => (typeof n === 'number' ? `$${n.toFixed(2)}` : 'n/a');
const dayLabel = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const o = s.outcomes;
const ro = o.readout as { on_time?: { x: number; y: number }; median_wait_for_review_min?: { value: number } };
const start = o.since;
const outcomeValues = [
  { v: String(o.shipped_7d), sub: fill(h.since, { n: o.shipped_total }) },
  { v: String(o.caught_7d), sub: fill(h.since, { n: o.caught_total }) },
  { v: money(o.cost.all_in_per_shipped_usd), sub: fill(h.apiOnly, { api: money(o.cost.api_per_shipped_usd) }) },
  {
    v: String(ro.median_wait_for_review_min?.value ?? 'n/a'),
    unit: h.waitUnit,
    sub: fill(h.waitSub, { x: ro.on_time?.x ?? '?', y: ro.on_time?.y ?? '?' }),
  },
];
const liveValues = [s.live.agent_runs_today, s.live.subagent_runs_today];
const days = s.days.map((d, i) => ({ ...d, before: d.date < start, week: i >= s.days.length - 7 }));
const detail = (d: (typeof days)[number]) =>
  d.before ? fill(h.beforeDetail, { date: dayLabel(d.date) }) : fill(h.dayDetail, { date: dayLabel(d.date), s: d.shipped, c: d.caught });
const totals = days.reduce((a, d) => ({ s: a.s + d.shipped, c: a.c + d.caught }), { s: 0, c: 0 });
const readout = fill(h.readout, totals);
const startIdx = days.findIndex((d) => d.date === start);
const staleText = `${h.staleLabel} ${dayLabel(s.generated_at.slice(0, 10))}`;
// Reserve the grid's height from the snapshot's busiest day, so live data rarely moves the page.
const maxSq = Math.max(1, ...days.map((d) => d.shipped + d.caught));
const rows = { d: Math.ceil(maxSq / 3), m: Math.ceil(maxSq / 2) };
---

<div
  class="hp surface-ink"
  data-hp
  data-ledger={h.ledgerUrl}
  data-live-label={h.liveLabel}
  data-stale-label={h.staleLabel}
  data-since={h.since}
  data-api-only={h.apiOnly}
  data-wait-sub={h.waitSub}
  data-readout={h.readout}
  data-day-detail={h.dayDetail}
  data-before-detail={h.beforeDetail}
  data-from-tick={h.fromTick}
  data-today-tick={h.todayTick}
  data-start={start}
>
  <div class="hp-bar">
    <span class="hp-status" data-hp-status><i class="hp-dot" aria-hidden="true"></i><span data-hp-label>{staleText}</span></span>
  </div>

  <section class="hp-group hp-live" aria-labelledby="hp-g-live">
    <h3 class="hp-gh" id="hp-g-live">{h.groups.live}</h3>
    <dl class="hp-tiles">
      {
        liveValues.map((v, i) => (
          <div class="hp-tile">
            <dt class="hp-l">{h.liveTiles[i]}</dt>
            <dd class="hp-v hp-v-today" data-hp-live={i}>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="hp-group" aria-labelledby="hp-g-out">
    <h3 class="hp-gh" id="hp-g-out">{h.groups.outcomes}</h3>
    <p class="hp-s hp-means">{h.closedMeans}</p>
    <dl class="hp-tiles">
      {
        outcomeValues.map((t, i) => (
          <div class="hp-tile">
            <dt class="hp-l">{h.outcomeTiles[i]}</dt>
            <dd class="hp-v">
              <span data-hp-out={i}>{t.v}</span>
              {t.unit && <span class="hp-u">{t.unit}</span>}
            </dd>
            <dd class="hp-s" data-hp-sub={i}>{t.sub}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <figure class="hp-grid" style={`--rows-d:${rows.d};--rows-m:${rows.m}`}>
    <figcaption class="hp-cap">{h.gridCaption}</figcaption>
    <ol class="hp-days" data-hp-days aria-label={h.gridCaption}>
      {
        days.map((d, i) => (
          <li
            class:list={['hp-day', { 'is-week': d.week, 'is-before': d.before }]}
            tabindex={i === days.length - 1 ? 0 : -1}
            aria-label={detail(d)}
            data-date={d.date}
            data-detail={detail(d)}
          >
            <span class="hp-stack" aria-hidden="true">
              {Array.from({ length: d.caught }, () => <i class="hp-sq is-caught" />)}
              {Array.from({ length: d.shipped }, () => <i class="hp-sq" />)}
            </span>
          </li>
        ))
      }
    </ol>
    <p class="hp-ticks" aria-hidden="true" data-hp-ticks>
      {startIdx > 0 && <span style={`grid-column:${startIdx + 1}`}>{fill(h.fromTick, { date: dayLabel(start) })}</span>}
      <span class="hp-tick-end">{h.todayTick}</span>
    </p>
    <p class="hp-readout" aria-live="polite" data-hp-readout data-default={readout}>{readout}</p>
  </figure>

  <details class="hp-how">
    <summary>{h.how.summary}</summary>
    <ul>{h.how.items.map((t) => <li>{t}</li>)}</ul>
  </details>
</div>

<script>
  type Day = { date: string; shipped: number; caught: number };
  type Summary = {
    last_event_at: string | null;
    live: { agent_runs_today: number; subagent_runs_today: number };
    outcomes: {
      since?: string;
      shipped_7d: number; shipped_total: number; caught_7d: number; caught_total: number;
      cost: { all_in_per_shipped_usd: number | null; api_per_shipped_usd: number | null };
      readout: { on_time?: { x: number; y: number }; median_wait_for_review_min?: { value: number } };
    };
    days: Day[];
  };
  const STALE_MS = 3 * 3600 * 1000;
  const POLL_MS = 60 * 1000;
  const MAX_POLLS = 30; // a fallback poll stops after half an hour
  const BACKOFF_MS = 10 * 60 * 1000; // after a refusal (rate limit, quota), wait before asking again
  const REFOCUS_MS = 30 * 1000; // at most one refetch per 30 s when the tab comes back

  // The ledger is a third party to this page: accept only finite non-negative numbers and ISO dates.
  const num = (v: unknown) => (typeof v === 'number' && Number.isFinite(v) && v >= 0 ? v : null);
  const isoDay = (v: unknown) => (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v : null);
  const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const money = (n: number | null) => (n === null ? 'n/a' : `$${n.toFixed(2)}`);
  const dayLabel = (iso: string) =>
    new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const timeIST = (iso: string) =>
    new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' }) + ' IST';

  document.querySelectorAll<HTMLElement>('[data-hp]').forEach((hp) => {
    const $ = <T extends HTMLElement>(sel: string) => hp.querySelector<T>(sel);
    const ds = hp.dataset;
    const readout = $('[data-hp-readout]')!;
    const ol = $('[data-hp-days]')!;
    let showing: string | null = null; // the date whose detail is in the readout

    const show = (li: HTMLElement | null) => {
      showing = li?.dataset.date ?? null;
      readout.textContent = li ? li.dataset.detail ?? '' : readout.dataset.default ?? '';
    };
    // One tab stop for the grid (roving tabindex); arrows, Home and End move between days.
    const cols = () => [...ol.querySelectorAll<HTMLElement>('.hp-day')];
    const focusDay = (li: HTMLElement) => {
      cols().forEach((c) => (c.tabIndex = c === li ? 0 : -1));
      li.focus();
    };
    ol.addEventListener('keydown', (e) => {
      const list = cols();
      const i = list.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const moves: Record<string, number> = { ArrowLeft: i - 1, ArrowRight: i + 1, Home: 0, End: list.length - 1 };
      const to = moves[e.key];
      if (to === undefined) return;
      e.preventDefault();
      focusDay(list[Math.max(0, Math.min(list.length - 1, to))]);
    });
    ol.addEventListener('focusin', (e) => show((e.target as HTMLElement).closest('.hp-day')));
    ol.addEventListener('focusout', () => show(null));
    ol.addEventListener('pointerover', (e) => show((e.target as HTMLElement).closest('.hp-day')));
    ol.addEventListener('pointerleave', () => show(ol.contains(document.activeElement) ? (document.activeElement as HTMLElement) : null));

    const setText = (sel: string, text: string) => {
      const el = $(sel);
      if (el && el.textContent !== text) el.textContent = text;
    };

    const render = (d: Summary) => {
      const live = d?.live, o = d?.outcomes;
      if (!live || !o || !Array.isArray(d.days)) return;
      const a = num(live.agent_runs_today), b = num(live.subagent_runs_today);
      if (a !== null) setText('[data-hp-live="0"]', String(a));
      if (b !== null) setText('[data-hp-live="1"]', String(b));
      const s7 = num(o.shipped_7d), st = num(o.shipped_total), c7 = num(o.caught_7d), ct = num(o.caught_total);
      if (s7 !== null) setText('[data-hp-out="0"]', String(s7));
      if (c7 !== null) setText('[data-hp-out="1"]', String(c7));
      setText('[data-hp-out="2"]', money(num(o.cost?.all_in_per_shipped_usd)));
      const wait = num(o.readout?.median_wait_for_review_min?.value);
      if (wait !== null) setText('[data-hp-out="3"]', String(wait));
      if (st !== null) setText('[data-hp-sub="0"]', fill(ds.since ?? '', { n: st }));
      if (ct !== null) setText('[data-hp-sub="1"]', fill(ds.since ?? '', { n: ct }));
      setText('[data-hp-sub="2"]', fill(ds.apiOnly ?? '', { api: money(num(o.cost?.api_per_shipped_usd)) }));
      const ot = o.readout?.on_time;
      setText('[data-hp-sub="3"]', fill(ds.waitSub ?? '', { x: num(ot?.x) ?? '?', y: num(ot?.y) ?? '?' }));

      // Rebuild the 14 day columns from validated numbers only (createElement, never innerHTML).
      const start = isoDay(o.since) ?? ds.start ?? '';
      const days = d.days.slice(-14).map((x) => ({
        date: isoDay(x?.date), s: Math.min(num(x?.shipped) ?? 0, 99), c: Math.min(num(x?.caught) ?? 0, 99),
      }));
      if (days.length === 14 && days.every((x) => x.date)) {
        const focusedDate = ol.contains(document.activeElement) ? (document.activeElement as HTMLElement).dataset.date : null;
        const tabDate = ol.querySelector<HTMLElement>('.hp-day[tabindex="0"]')?.dataset.date;
        const items = days.map((x, i) => {
          const before = x.date! < start;
          const text = before
            ? fill(ds.beforeDetail ?? '', { date: dayLabel(x.date!) })
            : fill(ds.dayDetail ?? '', { date: dayLabel(x.date!), s: x.s, c: x.c });
          const li = document.createElement('li');
          li.className = 'hp-day' + (i >= 7 ? ' is-week' : '') + (before ? ' is-before' : '');
          li.dataset.date = x.date!;
          li.dataset.detail = text;
          li.setAttribute('aria-label', text);
          const stack = document.createElement('span');
          stack.className = 'hp-stack';
          stack.setAttribute('aria-hidden', 'true');
          for (let k = 0; k < x.c; k++) stack.append(Object.assign(document.createElement('i'), { className: 'hp-sq is-caught' }));
          for (let k = 0; k < x.s; k++) stack.append(Object.assign(document.createElement('i'), { className: 'hp-sq' }));
          li.append(stack);
          return li;
        });
        const keep = items.find((li) => li.dataset.date === tabDate) ?? items[13];
        items.forEach((li) => (li.tabIndex = li === keep ? 0 : -1));
        ol.replaceChildren(...items);
        const tot = days.reduce((acc, x) => (x.date! < start ? acc : { s: acc.s + x.s, c: acc.c + x.c }), { s: 0, c: 0 });
        readout.dataset.default = fill(ds.readout ?? '', tot);
        if (focusedDate) items.find((li) => li.dataset.date === focusedDate)?.focus();
        const restore = items.find((li) => li.dataset.date === showing);
        show(restore ?? null);
        const ticks = $('[data-hp-ticks]');
        const si = days.findIndex((x) => x.date === start);
        if (ticks) {
          const parts: HTMLElement[] = [];
          if (si > 0) parts.push(Object.assign(document.createElement('span'), { textContent: fill(ds.fromTick ?? '', { date: dayLabel(start) }), style: `grid-column:${si + 1}` }));
          parts.push(Object.assign(document.createElement('span'), { className: 'hp-tick-end', textContent: ds.todayTick ?? '' }));
          ticks.replaceChildren(...parts);
        }
      }

      // Status: live while the newest event is recent; otherwise the date, in graphite.
      const last = typeof d.last_event_at === 'string' ? Date.parse(d.last_event_at) : NaN;
      const fresh = Number.isFinite(last) && Date.now() - last < STALE_MS;
      const status = $('[data-hp-status]')!;
      if (fresh) {
        setText('[data-hp-label]', `${ds.liveLabel} ${timeIST(d.last_event_at!)}`);
        status.setAttribute('data-live', '');
      } else {
        setText('[data-hp-label]', `${ds.staleLabel} ${dayLabel(new Date(Number.isFinite(last) ? last : Date.now()).toISOString().slice(0, 10))}`);
        status.removeAttribute('data-live');
      }
    };

    const base = ds.ledger;
    if (!base || !/^https:\/\//.test(base)) return;

    // Be gentle with the ledger (Workers Free, shared with ingest): one summary read, one socket; a capped,
    // visible-only poll if the socket fails; back off after a refusal; debounce refetch on tab return.
    let pausedUntil = 0, lastPull = 0, timer = 0, polls = 0;
    const pull = () => {
      if (Date.now() < pausedUntil) return Promise.resolve(false);
      lastPull = Date.now();
      return fetch(`${base}/v1/summary`, { cache: 'no-store' })
        .then((r) => {
          if (r.status === 429 || r.status >= 500) pausedUntil = Date.now() + BACKOFF_MS;
          return r.ok ? r.json().then((d) => (render(d), true)) : false;
        })
        .catch(() => ((pausedUntil = Date.now() + BACKOFF_MS), false));
    };
    const stopPoll = () => { if (timer) { clearInterval(timer); timer = 0; } };
    const poll = () => {
      if (timer || polls >= MAX_POLLS) return;
      timer = window.setInterval(() => {
        if (document.visibilityState !== 'visible') return;
        if (++polls >= MAX_POLLS) stopPoll();
        pull();
      }, POLL_MS);
    };
    // Off the production site (previews, local) the ledger refuses the socket by origin: poll instead.
    const socketAllowed = /(^|\.)zoebnomi\.com$/.test(location.hostname);
    const connect = (ok: boolean) => {
      if (!ok) return; // the ledger refused or is down: keep what is on screen, try again on tab return
      if (!socketAllowed) return poll();
      try {
        const ws = new WebSocket(base.replace(/^https:/, 'wss:') + '/v1/live');
        ws.addEventListener('message', (e) => {
          stopPoll();
          if (typeof e.data !== 'string' || e.data.length > 20000) return;
          try { render(JSON.parse(e.data)); } catch { /* ignore a bad frame */ }
        });
        ws.addEventListener('close', poll);
      } catch {
        poll();
      }
    };
    pull().then(connect);
    // Back on the tab (also rolls "today" over a new IST day), at most once per 30 s.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - lastPull > REFOCUS_MS) pull();
    });
  });
</script>

<style>
  .hp {
    padding: var(--s-6);
    border: var(--line-object);
    box-shadow: 10px 10px 0 var(--color-pending);
  }

  .hp-bar {
    padding-bottom: var(--s-3);
    border-bottom: var(--line-hair);
    font-family: var(--font-data);
    font-size: var(--t-label);
  }

  .hp-status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--hit-min);
    color: var(--color-pending);
  }

  .hp-dot {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    border: var(--line-object);
    border-color: currentColor;
  }

  /* Live: a solid dot in the text colour. Never red (red is the pen) and never pulsing (red is the only thing
     that moves on its own). */
  .hp-status[data-live] {
    color: var(--color-text-muted);
  }

  .hp-status[data-live] .hp-dot {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .hp-group {
    margin-top: var(--s-6);
  }

  .hp-live {
    padding-bottom: var(--s-6);
    border-bottom: var(--line-hair);
  }

  .hp-gh {
    font-family: var(--font-data);
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .hp-means {
    margin-top: var(--s-1);
  }

  .hp-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-3);
  }

  .hp-tile {
    display: flex;
    flex-direction: column;
  }

  .hp-v {
    order: -1;
    font-family: var(--font-heading);
    font-size: var(--t-num);
    font-weight: var(--wght-claim);
    font-stretch: calc(var(--wdth-tight) * 1%);
    line-height: 1;
    letter-spacing: var(--track-display);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  /* Today is context; the outcomes carry the meaning, so today's numerals are a step smaller. */
  .hp-v-today {
    font-size: var(--t-h3);
  }

  .hp-u {
    margin-left: 2px;
    font-size: 0.5em;
  }

  .hp-l {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .hp-s,
  .hp-cap,
  .hp-ticks,
  .hp-readout,
  .hp-how {
    font-family: var(--font-data);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--color-text-muted);
  }

  .hp-s {
    margin-top: var(--s-1);
  }

  .hp-grid {
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: var(--line-hair);
  }

  .hp-days {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    align-items: end;
    gap: 2px;
    margin-top: var(--s-3);
    min-block-size: max(var(--s-13), calc(var(--rows-d) * 8px + var(--s-2)));
    border-bottom: var(--line-hair);
  }

  /* Day columns and squares are rebuilt by the script on every update, so they carry no Astro scope
     attribute: their rules are global under the scoped .hp-days list. */
  .hp-days :global(.hp-day) {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    align-self: stretch;
    min-block-size: var(--s-13);
    padding-bottom: var(--s-1);
    cursor: default;
  }

  .hp-days :global(.hp-day.is-week) {
    background: var(--color-surface-raised);
  }

  .hp-days :global(.hp-day:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .hp-days :global(.hp-stack) {
    display: flex;
    flex-wrap: wrap-reverse;
    align-content: flex-start;
    gap: 2px;
    inline-size: calc(3 * 6px + 2 * 2px);
  }

  /* Before the ledger starts: a short line on the baseline, not an empty column. */
  .hp-days :global(.hp-day.is-before .hp-stack) {
    block-size: 2px;
    background: var(--color-pending);
  }

  .hp-days :global(.hp-sq) {
    display: inline-block;
    inline-size: 6px;
    block-size: 6px;
    background: var(--color-text-body);
  }

  .hp-days :global(.hp-sq.is-caught) {
    background: var(--color-accent);
  }

  .hp-days :global(.hp-day:hover .hp-sq:not(.is-caught)),
  .hp-days :global(.hp-day:focus-visible .hp-sq:not(.is-caught)) {
    background: var(--color-text);
  }

  .hp-ticks {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 2px;
    margin-top: var(--s-1);
    white-space: nowrap;
  }

  .hp-ticks :global(.hp-tick-end) {
    grid-column: 14;
    justify-self: end;
  }

  .hp-readout {
    margin-top: var(--s-2);
    min-block-size: calc(2 * var(--lh-snug) * var(--t-label));
    color: var(--color-text);
  }

  .hp-how {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: var(--line-hair);
  }

  .hp-how summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--hit-touch);
    cursor: pointer;
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .hp-how ul {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-2);
    padding-left: var(--s-4);
    color: var(--color-text-body);
  }

  @media (min-width: 1100px) {
    .hp-days {
      min-block-size: max(var(--s-13), calc(var(--rows-d) * 10px + var(--s-2)));
    }


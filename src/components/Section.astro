---
// A page section: "§n LABEL" in the margin column (the § in red-ink), the body
// in the body column, closed by an Ink rule. A short red tick sits on the
// section's top rule at the margin column's x; the motion layer grows it when
// the section enters view (B-24, redrawn as A's pen). Final state in CSS.
//
// Optional story props (home): `refLine` = "Fig. 0, step n." lead-in with its
// sentence; `next` = the "Next:" link that ends the section.
import MarginNote from './MarginNote.astro';

interface Props {
  mark: string;
  label: string;
  note?: string;
  /** A small mono line under the label in the margin column (no MarginNote rule). */
  sub?: string;
  as?: 'section' | 'div';
  narrId?: string;
  anchorId?: string;
  refLine?: { strong: string; text: string };
  next?: { label: string; href: string };
  /** Draw the faint drafting grid behind this section (Builds ledger only). */
  grid?: boolean;
  class?: string;
}

const { mark, label, note, sub, as: Tag = 'section', narrId, anchorId, refLine, next, grid = false, class: className } = Astro.props;
const slug = label
  .toLowerCase()
  .replace(/['’]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const headingId = anchorId ?? `sec-${slug}`;
---

<Tag class:list={['rp-section', { 'has-grid': grid }, className]} data-section>
  <span class="tick" aria-hidden="true" data-tick></span>
  <div class="section-inner grid-margin grid-margin--compact">
    <div class="margin-col">
      <h2 class="mark-label" id={headingId} data-narr={narrId}>
        <span class="mark" aria-hidden="true">{mark}</span> <span class="label">{label}</span>
      </h2>
      {sub && <p class="mark-sub">{sub}</p>}
      <slot name="margin" />
      {note && <MarginNote label={`Note: ${label}`}>{note}</MarginNote>}
    </div>
    <div class="body-col">
      {
        refLine && (
          <p class="ref-line">
            <strong>{refLine.strong}</strong> {refLine.text}
          </p>
        )
      }
      <slot />
      {
        next && (
          <p class="next-line">
            <a href={next.href}>
              {next.label} <span aria-hidden="true">↓</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
</Tag>

<style>
  .rp-section {
    position: relative;
    border-bottom: var(--line-ink);
  }

  /* The red tick on the top rule (it overlaps the rule above this section). */
  .tick {
    position: absolute;
    top: -1px;
    left: var(--gutter);
    width: var(--s-11);
    border-top: var(--line-pen);
    transform-origin: left;
    pointer-events: none;
  }

  .has-grid {
    background-image:
      linear-gradient(var(--grid-ink) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-ink) 1px, transparent 1px);
    background-size: var(--grid-step) var(--grid-step);
    background-position: -1px -1px;
  }

  .mark-label[id] {
    scroll-margin-top: var(--s-6);
  }

  @media (min-width: 900px) {
    .mark-label[id] {
      scroll-margin-top: calc(var(--header-h) + var(--s-6));
    }
  }

  .mark-label {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: var(--lh-label);
  }

  .mark-label .mark {
    color: var(--red-ink);
  }

  .mark-sub {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .ref-line {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
    max-width: 72ch;
    margin-bottom: var(--s-6);
  }

  .ref-line strong {
    font-weight: 500;
    color: var(--red-ink);
  }

  .next-line {
    margin-top: var(--s-9);
  }

  .next-line a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--hit-touch);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .next-line a span {
    color: var(--red-ink);
    transition: transform var(--dur-base) var(--ease-draw);
  }

  .next-line a:hover span {
    transform: translateY(3px);
  }

  @media (max-width: 899px) {
    .ref-line {
      margin-bottom: var(--s-5);
    }
  }
</style>

---
import MarginNote from './MarginNote.astro';

interface Props {
  mark: string;
  label: string;
  note?: string;
  as?: 'section' | 'div';
  // Read-along anchor id (e.g. "s3-cue") for the section's own mark/label —
  // narration for a section's spoken cue line. Omitted on pages/sections with
  // no narration.
  narrId?: string;
}

const { mark, label, note, as: Tag = 'section', narrId } = Astro.props;
---

<Tag class="rp-section">
  <div class="section-inner grid-margin grid-margin--compact">
    <aside class="margin-col" aria-label={label}>
      <h2 class="mark-label" data-narr={narrId}>
        <span class="mark" aria-hidden="true">{mark}</span> <span class="label">{label}</span>
      </h2>
      <slot name="margin" />
      {note && <MarginNote as="div" label={`Note — ${label}`}>{note}</MarginNote>}
    </aside>
    <div class="body-col">
      <slot />
    </div>
  </div>
</Tag>

<style>
  .rp-section {
    border-bottom: 1px solid var(--rule-strong);
  }

  .mark-label {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.7;
  }
</style>

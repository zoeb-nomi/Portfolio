---
// One prose section of a long-form page: a heading carrying the red § mark (`.sec-no`), then the body. Consecutive
// Sections read as one article (an essay, a note, a case study): the reading spine runs down their left edge and ends
// under the last one (scripts/reading.ts, switched on by Masthead).
//
//   label="" renders no heading: an unlabelled opening, before §1.
//   `note` is a margin note beside the heading (rail at 1100px and up, under it below).
//   `sub` is a small mono line under the heading. `wide` lets children use the full shell instead of the measure.
//   The `margin` slot adds anything else to the rail beside the heading.
import MarginNote from './MarginNote.astro';

interface Props {
  mark: string;
  label: string;
  note?: string;
  /** A small mono line under the heading. */
  sub?: string;
  as?: 'section' | 'div';
  narrId?: string;
  anchorId?: string;
  /** Kept for old call sites; the drafting grid is retired. */
  grid?: boolean;
  /** Children may use the full shell width, not just the reading measure. */
  wide?: boolean;
  class?: string;
}

const { mark, label, note, sub, as: Tag = 'section', narrId, anchorId, wide = false, class: className } = Astro.props;
const slug = label
  .toLowerCase()
  .replace(/['’]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const headingId = anchorId ?? `sec-${slug}`;
const hasRail = Boolean(note) || Astro.slots.has('margin');
---

<Tag class:list={['rs', 'gut', { 'rs--wide': wide }, className]} data-section>
  <div class="in">
    <div class="rs-in">
      {
        label && (
          <div class:list={['rs-head', { article: hasRail }]}>
            <div class="rs-head-col">
              <h2 class="rs-h" id={headingId} data-narr={narrId}>
                <span class="sec-no" aria-hidden="true">{mark}</span> <span class="label">{label}</span>
              </h2>
              {sub && <p class="rs-sub lab">{sub}</p>}
            </div>
            {hasRail && (
              <aside aria-label={`Notes: ${label}`}>
                {note && <MarginNote as="div" label={`Note: ${label}`}>{note}</MarginNote>}
                <slot name="margin" />
              </aside>
            )}
          </div>
        )
      }
      <slot />
    </div>
  </div>
</Tag>

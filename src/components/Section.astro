---
import MarginNote from './MarginNote.astro';

interface Props {
  mark: string;
  label: string;
  note?: string;
  as?: 'section' | 'div';
  // Read-along anchor id (e.g. "s3-cue") for the section's own mark/label —
  // narration for a section's spoken cue line. Omitted on pages/sections with
  // no narration.
  narrId?: string;
  // Deep-link anchor: the id of the section's <h2>. Defaults to a slug of the
  // label ("sec-method"); pass one to choose a stable, human URL (#kyb).
  anchorId?: string;
}

const { mark, label, note, as: Tag = 'section', narrId, anchorId } = Astro.props;
const slug = label
  .toLowerCase()
  .replace(/['\u2019]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const headingId = anchorId ?? `sec-${slug}`;
---

<Tag class="rp-section">
  <div class="section-inner grid-margin grid-margin--compact">
    {/* A <div>, not <aside aria-label>: the margin column is layout. Labelling every section's
        margin as a complementary landmark gave 7-11 landmarks per page and put each heading
        inside one. Only a real margin note below is an <aside>. */}
    <div class="margin-col">
      <h2 class="mark-label" id={headingId} data-narr={narrId}>
        <span class="mark" aria-hidden="true">{mark}</span> <span class="label">{label}</span>
      </h2>
      <slot name="margin" />
      {note && <MarginNote label={`Note — ${label}`}>{note}</MarginNote>}
    </div>
    <div class="body-col">
      <slot />
    </div>
  </div>
</Tag>

<style>
  .rp-section {
    border-bottom: 1px solid var(--rule-strong);
  }

  /* Deep links must land below the sticky header (html scroll-padding-top covers the
     header from 900px) and keep the section's own top padding in view. */
  .mark-label[id] {
    scroll-margin-top: var(--s-6);
  }

  @media (min-width: 900px) {
    .mark-label[id] {
      scroll-margin-top: var(--s-9);
    }
  }

  .mark-label {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: var(--lh-label);
  }
</style>

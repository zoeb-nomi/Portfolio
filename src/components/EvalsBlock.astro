---
// Home — Evals block. Replaces the single FlagshipCard (copy-pack-additions.md
// §11, added 2026-09-10; extended to three cards, copy-pack-s17.md §19, added
// 2026-09-11). Three cards side by side on the body column at >=900px,
// stacked below. Three line tiers only (--rule / --rule-strong via the
// wrapping Section / --rule-accent — none introduced here); 400 weights only
// (no font-weight declared — the site loads only the 400 weight of each
// face, so anything else would fake-bold).
interface Card {
  name: string;
  description: string;
  linkLabel: string;
  linkHref: string;
}

interface Props {
  // Optional: /evals/ carries this text in its own masthead h1/standfirst
  // instead, and reuses this component for the cards + close line only.
  h2?: string;
  methodLine?: string;
  cards: Card[];
  closeLine: string;
}

const { h2, methodLine, cards, closeLine } = Astro.props;
---

<div class="evals-block">
  {h2 && <h2 class="evals-h2">{h2}</h2>}
  {methodLine && <p class="evals-method">{methodLine}</p>}
  <div class="evals-cards">
    {
      cards.map((c, i) => (
        <a class="evals-card" href={c.linkHref} aria-labelledby={`evals-card-name-${i}`}>
          <h3 class="evals-card-name" id={`evals-card-name-${i}`}>{c.name}</h3>
          <p class="evals-card-desc">{c.description}</p>
          <span class="evals-card-link" aria-hidden="true">{c.linkLabel}</span>
        </a>
      ))
    }
  </div>
  <p class="evals-close">{closeLine}</p>
</div>

<style>
  .evals-h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.05;
    letter-spacing: -.015em;
    color: var(--ink);
    max-width: 20ch;
    margin-bottom: var(--s-4);
  }

  .evals-method {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-body);
    max-width: 58ch;
    margin-bottom: var(--s-8);
  }

  .evals-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: var(--s-8);
  }

  /* The whole card is the link (title = accessible name); the visible link
     label inside is decoration, so there are no nested links. Hover moves the
     top rule up a tier and thickens the label underline — no lift. */
  .evals-card {
    display: block;
    border-top: 1px solid var(--rule);
    padding-top: var(--s-5);
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms var(--ease-draw);
  }

  .evals-card:hover {
    border-top-color: var(--rule-strong);
  }

  .evals-card:hover .evals-card-name {
    color: var(--red);
  }

  .evals-card:hover .evals-card-link {
    text-decoration-thickness: 2px;
  }

  .evals-card-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: var(--s-3);
    transition: color 120ms var(--ease-draw);
  }

  .evals-card-desc {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-body);
    max-width: 48ch;
  }

  .evals-card-link {
    display: inline-block;
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    letter-spacing: .04em;
    color: var(--red-ink);
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 3px;
  }

  .evals-close {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-body);
    max-width: 60ch;
    border-top: 1px solid var(--rule);
    padding-top: var(--s-6);
  }

  @media (max-width: 899px) {
    .evals-cards {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

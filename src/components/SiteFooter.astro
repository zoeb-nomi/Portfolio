---
// Site footer (DESIGN v3 §e, D-06): display-type name, role line, a links row
// with 44px targets, then a hair rule and a meta row with the nav and the
// labelled llms.txt link. No top rule: the CTA slab (or the page's last
// section rule) closes the page above it.
import { site, cta, nav } from '../data/copy';
import { isExternal } from '../lib/isExternal';

const links = [cta.bookACall, cta.email, cta.linkedin, cta.github];
const roleLine = site.footerLine.replace(`${site.name} · `, '');
---

<footer class="site-footer">
  <div class="footer-inner grid-margin">
    <div class="margin-col" aria-hidden="true"></div>
    <div class="body-col">
      <p class="ftr-name">{site.name}</p>
      <p class="ftr-role">{roleLine}</p>
      <ul class="ftr-links">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                target={isExternal(l.href) ? '_blank' : undefined}
                rel={isExternal(l.href) ? 'noopener noreferrer' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="ftr-meta">
        <nav aria-label="Footer">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
        <a class="llms-link" href="/llms.txt">llms.txt (for AI assistants)</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-inner {
    --body-pad-end: var(--s-11);
  }

  .ftr-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--track-tight);
    color: var(--ink);
  }

  .ftr-role {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  .ftr-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-6);
    list-style: none;
    margin-top: var(--s-4);
  }

  .ftr-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    font-family: var(--font-mono);
    font-size: var(--t-nav);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--red-ink);
    text-underline-offset: 4px;
  }

  .ftr-links a:hover,
  .ftr-meta a:hover {
    color: var(--red);
    text-decoration-thickness: 2px;
  }

  .ftr-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: var(--line-hair);
  }

  .ftr-meta ul {
    display: flex;
    gap: var(--s-6);
    list-style: none;
  }

  .ftr-meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    font-size: var(--t-label);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .llms-link {
    text-decoration: underline !important;
    text-underline-offset: var(--underline-offset);
  }

  @media (max-width: 899px) {
    .footer-inner > .margin-col {
      display: none;
    }

    .footer-inner > .body-col {
      padding-top: var(--s-9);
    }
  }
</style>

---
import { site, cta } from '../data/copy';

// The footer line is one string in copy.ts. Split at its separators so a wrapped
// line never starts with a stray "·" or "—": each separator is glued (with a
// non-breaking space) to the word before it.
const parts = site.footerLine.split(' · ').map((part) => part.replace(' — ', '\u00a0— '));
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-line">
      {parts.map((part, i) => (
        <>
          <span class="footer-part">{part}</span>
          {i < parts.length - 1 && ' '}
        </>
      ))}
    </p>
    <div class="footer-links">
      <ul class="footer-ctas">
        <li><a href={cta.bookACall.href}>{cta.bookACall.label}</a></li>
        <li><a href={cta.email.href}>{cta.email.label}</a></li>
        <li><a href={cta.linkedin.href}>{cta.linkedin.label}</a></li>
        <li><a href={cta.github.href}>{cta.github.label}</a></li>
      </ul>
      <a class="llms-link" href="/llms.txt">llms.txt</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--s-9) var(--gutter) var(--s-10);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-6);
  }

  .footer-line {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    color: var(--ink-muted);
    max-width: 34ch;
    order: 2;
  }

  .footer-part:not(:last-child)::after {
    content: '\00a0·';
  }

  /* llms.txt sits left-aligned under the CTA row, not hanging off its right
     edge — it reads as a footnote to the row above it. */
  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    order: 1;
  }

  .footer-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s-5);
    list-style: none;
  }

  .footer-ctas a,
  .llms-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--red-ink);
    color: var(--ink);
  }

  /* 44px tap target without changing the row's visual height. */
  .footer-ctas a {
    padding-block: 14px;
  }

  .footer-ctas a:hover,
  .llms-link:hover {
    color: var(--red);
    text-decoration-thickness: 2px;
  }

  .llms-link {
    /* WCAG 2.5.8: 24px minimum hit area. */
    min-height: var(--hit-min);
    padding-block: var(--s-1);
    color: var(--ink-muted);
    text-transform: none;
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
  }

  @media (max-width: 599px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-line {
      order: 2;
    }

    .footer-links {
      order: 1;
      align-items: flex-start;
    }

    .footer-ctas {
      flex-wrap: wrap;
      row-gap: var(--s-3);
    }
  }
</style>

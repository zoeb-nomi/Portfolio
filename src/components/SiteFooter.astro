---
// Site footer (The Pipeline, design/README.md §6): one line. Identity on the left; Writing,
// Design system, Email, LinkedIn, GitHub, X and llms.txt on the right. Styles: ds.css (.foot).
import { cta, designLink, llmsLink, writingLink, footerId } from '../data/copy';
import { isExternal } from '../lib/isExternal';

const links = [writingLink, designLink, cta.email, cta.linkedin, cta.github, cta.x, llmsLink];
---

<footer class="foot gut">
  <div class="in">
    <span class="foot-id">{footerId}</span>
    <nav aria-label="Footer">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={isExternal(l.href) ? '_blank' : undefined}
            rel={isExternal(l.href) ? 'noopener noreferrer' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

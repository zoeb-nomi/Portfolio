---
// Stat tiles (DESIGN v3 D-07): the proof tile without its figure. Heavy top
// bar, numeral, label, optional mono source. Used by /builds/#shipping.
// The numeral renders final; nothing counts (v3.1 review).
interface Tile {
  value: string;
  unit?: string;
  label: string;
  source?: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;

---

<ul class="tiles" role="list" style={`--n: ${tiles.length}`}>
  {
    tiles.map((t) => (
      <li class="tile">
        <p class="t-num">
          {t.value}
          {t.unit && <small>{t.unit}</small>}
        </p>
        <p class="t-lab">{t.label}</p>
        {t.source && <p class="t-src">{t.source}</p>}
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    gap: var(--s-8);
  }

  .tile {
    border-top: var(--line-heavy);
    padding-top: var(--s-3);
  }

  .t-num {
    font-family: var(--font-display);
    font-size: var(--t-stat);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .t-num small {
    font-size: 0.45em;
    margin-left: 2px;
  }

  .t-lab {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  .t-src {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  @media (max-width: 1099px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
// Stat tiles (DESIGN v3 D-07): the proof tile without its figure. Heavy top
// bar, numeral, label, optional mono source. Used by /builds/#shipping.
// The numeral renders final; nothing counts (v3.1 review).
interface Tile {
  value: string;
  unit?: string;
  label: string;
  source?: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;

---

<ul class="tiles" role="list" >
  {
    tiles.map((t) => (
      <li class="tile">
        <p class="t-num">
          {t.value}
          {t.unit && <small>{t.unit}</small>}
        </p>
        <p class="t-lab">{t.label}</p>
        {t.source && <p class="t-src">{t.source}</p>}
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    list-style: none;
    display: grid;
    /* Tiles wrap by the room they get, not by viewport, so a big numeral never runs into its neighbour. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--s-8);
  }

  .tile {
    container-type: inline-size;
    border-top: var(--line-heavy);
    padding-top: var(--s-3);
  }

  .t-num {
    font-family: var(--font-heading);
    font-stretch: calc(var(--wdth-head) * 1%);
    font-weight: var(--wght-head);
    /* The numeral fits its tile: full size when there is room, smaller in a narrow tile. */
    font-size: min(var(--t-stat), 30cqi);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .t-num small {
    font-size: 0.45em;
    margin-left: 2px;
  }

  .t-lab {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .t-src {
    margin-top: var(--s-2);
    font-family: var(--font-data);
    font-size: var(--t-label);
    color: var(--color-text-muted);
  }

</style>

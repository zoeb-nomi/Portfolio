---
// Stat tiles (DESIGN v3 D-07): the proof tile without its figure. Heavy top
// bar, numeral, label, optional mono source. Used by /builds/#shipping.
// The numeral counts up once in view (aria-hidden copy; the DOM keeps the value).
interface Tile {
  value: string;
  unit?: string;
  label: string;
  source?: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;

// Parse "12", "90%", "$0.07", "4.2" into a count spec from zero.
const spec = (v: string) => {
  const m = /^([^0-9]*)([0-9]+(?:\.[0-9]+)?)(.*)$/.exec(v);
  if (!m) return null;
  const decimals = m[2].includes('.') ? m[2].split('.')[1].length : 0;
  return JSON.stringify({ from: 0, to: Number(m[2]), decimals, prefix: m[1], suffix: m[3], final: v });
};
---

<ul class="tiles" role="list">
  {
    tiles.map((t) => (
      <li class="tile">
        <p class="t-num">
          <span class="cv" data-count={spec(t.value)}>
            <span class="cv-final">{t.value}</span>
            <span class="cv-run" aria-hidden="true" />
          </span>
          {t.unit && <small>{t.unit}</small>}
        </p>
        <p class="t-lab">{t.label}</p>
        {t.source && <p class="t-src">{t.source}</p>}
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-8);
  }

  .tile {
    border-top: var(--line-heavy);
    padding-top: var(--s-3);
  }

  .t-num {
    font-family: var(--font-display);
    font-size: var(--t-stat);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .t-num small {
    font-size: 0.45em;
    margin-left: 2px;
  }

  .cv {
    position: relative;
    display: inline-block;
  }

  .cv-run {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }

  .t-lab {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  .t-src {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }

  @media (max-width: 1099px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

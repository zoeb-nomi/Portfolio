---
// A captioned figure for essays: "Fig. N" proof mark + title above, source line
// below. The body is a slot, so charts, diagrams and tables share one frame.
interface Props {
  n: number;
  title: string;
  /** Where the numbers come from, in words. */
  source?: string;
  href?: string;
  hrefLabel?: string;
}

const { n, title, source, href, hrefLabel } = Astro.props;
---

<figure class="ef">
  <figcaption class="ef-title"><span class="ef-n">Fig. {n}</span> {title}</figcaption>
  <div class="ef-body"><slot /></div>
  {
    (source || href) && (
      <p class="ef-source">
        {source}
        {href && (
          <>
            {' '}
            <a href={href}>{hrefLabel}</a>
          </>
        )}
      </p>
    )
  }
</figure>

<style>
  .ef {
    margin-block: var(--s-8);
    max-width: var(--measure);
    padding-block: var(--s-5);
    border-block: 1px solid var(--rule);
  }

  .ef-title {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: var(--lh-label);
    margin-bottom: var(--s-5);
  }

  /* The figure number is a reviewer's proof mark: annotation, so red. */
  .ef-n {
    color: var(--red-ink);
    margin-inline-end: var(--s-2);
  }

  .ef-source {
    margin-top: var(--s-5);
    font-family: var(--font-body);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .ef-source a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
</style>

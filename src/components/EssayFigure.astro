---
import { pipelineWriting } from '../data/copy';
// A captioned figure for essays (kit `.fig`): the body sits in `.fig-frame` on the sunk surface, and the caption
// under it opens with the red "Fig. N", then the title, then the source line. The body is a slot, so charts,
// diagrams, images and tables share one frame. Figures that animate pass `replay` and show the Replay control
// (scripts/figure-motion.ts wires it).
interface Props {
  n: number;
  title: string;
  /** Where the numbers come from, in words. */
  source?: string;
  href?: string;
  hrefLabel?: string;
  /** The figure animates: show a small Replay link (shown by figure-motion.ts when motion is allowed). */
  replay?: boolean;
}

const { n, title, source, href, hrefLabel, replay = false } = Astro.props;
---

<figure class="fig ef">
  <div class="fig-frame ef-body">
    <slot />
    {replay && <button type="button" class="chip ef-replay" hidden>{pipelineWriting.replay}</button>}
  </div>
  <figcaption>
    <span class="fno">Fig. {n}</span>
    <span>{title}</span>
    {
      (source || href) && (
        <span class="fsrc">
          {source}
          {href && (
            <>
              {' '}
              <a href={href}>{hrefLabel}</a>
            </>
          )}
        </span>
      )
    }
  </figcaption>
</figure>

<style>
  .ef {
    max-width: var(--measure);
  }

  .ef-replay {
    margin-top: var(--s-3);
  }

  .fsrc a {
    color: var(--color-text-body);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: var(--underline-offset);
  }
</style>

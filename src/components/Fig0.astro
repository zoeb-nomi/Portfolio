---
// Fig. 0: the home hero's story figure (Take B B-05/B-19, redrawn in red ink on
// paper). Step 0 is the output: a memo line citing a passage that does not
// support its claim, ringed by a red revision cloud. Steps 1 to 4 are the four
// verbs, each with its proof, then a "Released" stamp.
// The HTML is the complete, final drawing. With motion allowed, the motion
// layer plays it once on load (steps rise in turn, connectors grow, the cloud
// draws, the stamp lands at about 3.2 s) and un-hides the Replay button.
import { home } from '../data/copy';

const f = home.fig0;
const icons = ['measure', 'trace', 'guard', 'ship'] as const;
---

<figure class="f0" id="fig-0" data-fig0 aria-labelledby="fig0-title">
  <figcaption class="f0-head">
    <span class="f0-n">{f.n}</span>
    <span id="fig0-title">{f.title}</span>
  </figcaption>

  <ol class="f0-steps" role="list">
    <li class="f0-step f0-out" data-f0-step>
      <span class="f0-sn" aria-hidden="true">{f.output.n}</span>
      <div class="f0-body">
        <p class="f0-name">{f.output.name}</p>
        <div class="f0-doc">
          <p class="f0-doc-k">{f.output.doc}</p>
          <span class="f0-line" aria-hidden="true"></span>
          <span class="f0-line f0-line--s" aria-hidden="true"></span>
          <p class="f0-miss">
            {f.output.miss}
            <svg class="f0-cloud" viewBox="-12 -6 324 52" preserveAspectRatio="none" aria-hidden="true">
              <path
                data-f0-cloud
                pathLength="100"
                d="M0,8 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a10,7 0 0 1 20,0 a7,12 0 0 1 0,24 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a10,7 0 0 1 -20,0 a7,12 0 0 1 0,-24 Z"
              ></path>
            </svg>
          </p>
          <span class="f0-line" aria-hidden="true"></span>
        </div>
        <p class="f0-note" data-f0-note><span class="f0-ball" aria-hidden="true">1</span>{f.output.note}</p>
      </div>
    </li>
    {
      f.steps.map((s, i) => (
        <li class="f0-step" data-f0-step>
          <span class="f0-conn" aria-hidden="true" data-f0-conn />
          <span class="f0-sn" aria-hidden="true">{s.n}</span>
          <svg class="f0-ic" viewBox="0 0 40 28" aria-hidden="true">
            {icons[i] === 'measure' && (
              <g>
                <line x1="2" y1="4" x2="2" y2="24" />
                <line x1="38" y1="4" x2="38" y2="24" />
                <line class="pen" x1="4" y1="14" x2="36" y2="14" />
                <polygon class="pen-fill" points="3,14 10,10.5 10,17.5" />
                <polygon class="pen-fill" points="37,14 30,10.5 30,17.5" />
              </g>
            )}
            {icons[i] === 'trace' && (
              <g>
                <rect x="9" y="1" width="22" height="15" />
                <line x1="13" y1="6" x2="27" y2="6" />
                <line x1="13" y1="11" x2="23" y2="11" />
                <line x1="20" y1="16" x2="20" y2="21" />
                <polygon class="ink-fill" points="14,27 26,27 20,21" />
              </g>
            )}
            {icons[i] === 'guard' && (
              <g>
                <rect x="1" y="6" width="38" height="16" />
                <line x1="13" y1="6" x2="13" y2="22" />
                <rect class="pen-fill" x="2.5" y="7.5" width="9" height="13" />
                <line x1="18" y1="14" x2="34" y2="14" stroke-dasharray="3 2" />
              </g>
            )}
            {icons[i] === 'ship' && (
              <g>
                <polygon points="14,2 26,24 2,24" />
                <line class="pen" x1="28" y1="13" x2="37" y2="13" />
                <polygon class="pen-fill" points="38,13 32,9.5 32,16.5" />
              </g>
            )}
          </svg>
          <div class="f0-body">
            <p class="f0-name">{s.name}</p>
            <p class="f0-text">{s.text}</p>
            <p class="f0-proof">{s.proof}</p>
            {i === f.steps.length - 1 && (
              <p class="f0-stamp" data-f0-stamp>
                {f.stamp}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="f0-cap">{f.caption}</p>
  <button class="f0-replay" type="button" data-replay="fig0" hidden>{f.replay} <span aria-hidden="true">↺</span></button>
</figure>

<style>
  .f0 {
    border-top: var(--line-heavy);
    padding-top: var(--s-3);
    background: var(--paper);
  }

  .f0-head {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: var(--s-4);
  }

  .f0-n {
    color: var(--red-ink);
    font-weight: 500;
    margin-right: var(--s-2);
  }

  .f0-steps {
    list-style: none;
  }

  .f0-step {
    position: relative;
    display: grid;
    grid-template-columns: 20px 40px minmax(0, 1fr);
    column-gap: var(--s-3);
    align-items: start;
    padding-block: var(--s-3);
  }

  .f0-step:first-child {
    padding-top: 0;
  }

  .f0-out {
    grid-template-columns: 20px minmax(0, 1fr);
  }

  /* Connector: a short ink stem joining each step to the one above. */
  .f0-conn {
    position: absolute;
    left: 3px;
    top: -10px;
    height: 16px;
    border-left: var(--line-object);
    transform-origin: top;
  }

  .f0-sn {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--red-ink);
    padding-top: 3px;
  }

  .f0-ic {
    width: 40px;
    height: 28px;
    color: var(--ink);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
  }

  .f0-ic .pen {
    stroke: var(--red);
    stroke-width: 1.6;
  }

  .f0-ic .pen-fill {
    fill: var(--red);
    stroke: none;
  }

  .f0-ic .ink-fill {
    fill: var(--ink);
    stroke: none;
  }

  .f0-name {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: var(--lh-heading);
    color: var(--ink);
  }

  .f0-text {
    margin-top: 2px;
    font-size: var(--t-small);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  .f0-proof {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  /* Step 0: the memo. A box around an object (D-01 rule 3). */
  .f0-doc {
    margin-top: var(--s-2);
    padding: var(--s-3) var(--s-4) var(--s-3);
    border: var(--line-object-muted);
    background: var(--paper-raised);
  }

  .f0-doc-k {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
    margin-bottom: var(--s-2);
  }

  .f0-line {
    display: block;
    height: 0;
    border-top: var(--line-hair);
    margin-block: 7px;
    width: 92%;
  }

  .f0-line--s {
    width: 64%;
  }

  .f0-miss {
    position: relative;
    display: inline-block;
    margin-block: var(--s-2);
    padding: 3px var(--s-2);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink);
  }

  .f0-cloud {
    position: absolute;
    inset: -7px -10px;
    width: calc(100% + 20px);
    height: calc(100% + 14px);
    overflow: visible;
    fill: none;
    stroke: var(--red);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .f0-cloud path {
    vector-effect: non-scaling-stroke;
  }

  .f0-note {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--red-ink);
  }

  .f0-ball {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border: var(--line-pen);
    border-radius: 50%;
    font-size: var(--t-label);
    line-height: 1;
  }

  .f0-stamp {
    display: inline-block;
    margin-top: var(--s-3);
    padding: 3px var(--s-3);
    border: var(--line-pen);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--red-ink);
    transform: rotate(-3deg);
  }

  .f0-cap {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: var(--line-hair);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .f0-replay {
    margin-top: var(--s-2);
    min-height: var(--hit-touch);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    padding: 0;
  }

  .f0-replay:hover {
    color: var(--red);
  }

  .f0-replay[hidden] {
    display: none;
  }

  /* Pre-reveal states exist only under .motion (set by the head script when
     JS runs, IntersectionObserver exists and reduced motion is off). The
     motion layer then plays them to the final state above. */
  /* Steps are wiped in left to right (a clip, not a fade), so text is never
     drawn at a partial opacity that would fail a contrast check mid-reveal. */
  :global(.motion) [data-fig0]:not(.is-done) [data-f0-step] {
    clip-path: inset(0 100% 0 0);
    transform: translateY(8px);
  }

  :global(.motion) [data-fig0]:not(.is-done) [data-f0-conn] {
    transform: scaleY(0);
  }

  :global(.motion) [data-fig0]:not(.is-done) [data-f0-cloud] {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  :global(.motion) [data-fig0]:not(.is-done) [data-f0-note],
  :global(.motion) [data-fig0]:not(.is-done) [data-f0-stamp] {
    clip-path: inset(0 100% 0 0);
  }
</style>

---
// BuildsLedger (The Pipeline): one row per build, each a button that opens its panel in place.
// A row is `.build` (name, kind, value, a plus that turns to a cross); its panel holds the one-line
// description, the guard / measure / ship chain, a small figure and the links. Rows come from
// `buildsLedger`; the headline value and figure are in `pipelineBuilds.rows`. All panels are in the
// HTML: without script every panel is open and the page is complete. The open / close motion is in
// the page script (src/pages/builds.astro). The first row can start open.
import { buildsLedger, builds, pipelineBuilds as PB } from '../data/copy';
import type { BuildEntry } from '../data/copy';
import TradeFrameFlow from './TradeFrameFlow.astro';
import { arrowHtml } from '../lib/arrowHtml';
import { isExternal } from '../lib/isExternal';

interface Props {
  entries?: BuildEntry[];
  /** Open the first row on load. */
  openFirst?: boolean;
}

const { entries = buildsLedger, openFirst = false } = Astro.props;
const lead = (b: BuildEntry) => PB.rows[b.id];
// "20 Oct 2026, v0.3" -> value "20 Oct 2026", extra "v0.3".
// A build shipped after tracking began with no planned date (`shippedOn`) says so instead of "before tracking".
const ship = (b: BuildEntry) => {
  const [when, ...rest] = (b.shippedOn ?? b.shippedBeforeLedger ?? '').split(', ');
  return { when, extra: rest.join(', '), note: b.shippedOn ? PB.noPlan : PB.untracked };
};
const kind = (b: BuildEntry) => (b.tag ? b.tag.replace(/[[\]]/g, '') : '');
const plain = (label: string) => label.replace(/\s*→$/, '');
const pc = (n: number) => `${n}%`;
---

<ol class="bd-list" data-ledger>
  {
    entries.map((b, i) => {
      const row = lead(b);
      const open = openFirst && i === 0;
      const s = ship(b);
      return (
        <li class:list={['bd-item', { open }]} id={`b-${b.id}`}>
          <button class="build bd-row" type="button" aria-expanded={open ? 'true' : 'false'} aria-controls={`d-${b.id}`} id={`r-${b.id}`}>
            <span class="bn">{b.name}</span>
            <span class="bk2">
              {b.kind === 'eval harness' ? (
                <>
                  Eval harness · <span class="bd-j">{kind(b)}</span>
                </>
              ) : (
                b.kind
              )}
            </span>
            <span class="bv" set:html={arrowHtml(row.bv)} />
            <span class="ba" aria-hidden="true" />
          </button>
          <div class="bd-detail" id={`d-${b.id}`} role="region" aria-labelledby={`r-${b.id}`}>
            <p class="bd-what">{b.oneLine}</p>
            {b.figure?.kind === 'flow' && <TradeFrameFlow />}
            <div class="bd-grid">
              <ol class="bd-chain" aria-label={`${builds.expand.guard}, ${builds.columns.measured}, ${builds.expand.shipped}`}>
                <li class="bd-node">
                  <span class="lab red">{builds.expand.guard}</span>
                  <p>{b.guarded}</p>
                </li>
                <li class="bd-node">
                  <span class="lab red">{builds.columns.measured}</span>
                  {row.big ? (
                    <>
                      <p class="bd-v bd-n" set:html={arrowHtml(row.big)} />
                      <p class="bd-u">{row.unit}</p>
                    </>
                  ) : (
                    <p>{b.measured.headline}</p>
                  )}
                </li>
                <li class="bd-node">
                  <span class="lab red">{builds.expand.shipped}</span>
                  <p class="bd-v bd-n">{s.when}</p>
                  <p class="bd-u">{s.extra ? `${s.extra} · ` : ''}{s.note}</p>
                </li>
              </ol>
              <div>
                {row.fig && (
                  <figure class="bd-fig">
                    <figcaption class="bd-fcap">
                      <span>{row.fig.cap[0]}</span>
                      <b>{row.fig.cap[1]}</b>
                    </figcaption>
                    {row.fig.rows.map((r) => (
                      <div class="bd-fr">
                        <span class="bd-fl">{r.label}</span>
                        <span class="bd-tr">
                          {r.x !== undefined && <i class:list={['bd-b', { r: r.red }]} style={`--x:${pc(r.x)}`} />}
                          {r.a !== undefined && (
                            <span class="bd-dd" style={`--a:${pc(r.a)};--b:${pc(r.b ?? 0)}`}>
                              <i class="p0" />
                              <i class="p1" />
                            </span>
                          )}
                        </span>
                        <span class:list={['bd-fv', { r: r.red }]} set:html={arrowHtml(r.v)} />
                      </div>
                    ))}
                    <div class="bd-ax">
                      <span />
                      <span>{row.fig.axis.map((a) => <i>{a}</i>)}</span>
                      <span />
                    </div>
                    {row.fig.note && <p class="bd-fn">{row.fig.note}</p>}
                  </figure>
                )}
                <div class:list={['bd-links', { 'bd-res': !row.fig }]}>
                  {b.links.map((l) => (
                    <a class="tl" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {plain(l.label)}
                      {isExternal(l.href) && <small>↗</small>}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .bd-list {
    list-style: none;
    border-top: var(--line-heavy);
    margin-top: clamp(28px, 5vh, 56px);
  }

  .bd-item {
    position: relative;
  }

  .bd-row {
    width: 100%;
    background: none;
    border: 0;
    border-bottom: var(--line-hair);
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--color-text);
  }

  .bd-row .bd-j {
    color: var(--color-text-body);
  }

  .bd-row .ba {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    transition: transform 0.6s var(--ease-out);
  }

  .bd-row .ba::before {
    content: '+';
    font: 400 22px / 1 var(--font-data);
  }

  .bd-item.open .bd-row .ba {
    transform: rotate(45deg);
  }

  .bd-item.open .bd-row::before {
    transform: scaleY(1);
    transform-origin: top;
  }

  .bd-item.open .bd-row::after {
    transform: scaleY(1);
  }

  .bd-item.open .bd-row .bn {
    font-variation-settings: 'wdth' 100, 'wght' 880;
  }

  .bd-row:hover .ba,
  .bd-row:focus-visible .ba {
    transform: none;
  }

  .bd-item.open .bd-row:hover .ba {
    transform: rotate(45deg);
  }

  /* With script, a closed row hides its panel; without it every panel stays open. */
  :global(.bd-js) .bd-item:not(.open) .bd-detail {
    display: none;
  }

  /* ---------- panel ---------- */
  .bd-detail {
    position: relative;
    padding: 28px 0 40px clamp(22px, 3vw, 44px);
    border-bottom: var(--line-hair);
  }

  .bd-detail::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(var(--sp, 1));
  }

  .bd-what {
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: var(--lh-snug);
    color: var(--color-text);
    max-width: 52ch;
    font-variation-settings: 'wdth' 94, 'wght' 520;
  }

  .bd-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 28px clamp(28px, 4vw, 64px);
    margin-top: 26px;
    align-items: start;
  }

  @media (max-width: 899px) {
    .bd-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* guard, measure, ship: one red line through three nodes */
  .bd-chain {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-top: 22px;
  }

  .bd-chain::before {
    content: '';
    position: absolute;
    left: 4px;
    right: 0;
    top: 4px;
    height: 2px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--k, 1));
  }

  .bd-node {
    position: relative;
    min-width: 0;
  }

  .bd-node::before {
    content: '';
    position: absolute;
    left: 0;
    top: -22px;
    width: 10px;
    height: 10px;
    background: var(--color-surface);
    border: var(--line-pen);
    opacity: var(--d, 1);
  }

  .bd-node::after {
    content: '→';
    position: absolute;
    right: -16px;
    top: -24px;
    padding: 0 3px;
    background: var(--color-surface);
    font: 400 14px / 1 var(--font-data);
    color: var(--color-accent);
    opacity: var(--d, 1);
  }

  .bd-node:last-child::after {
    content: none;
  }

  .bd-node .lab {
    display: block;
    margin-bottom: 8px;
  }

  .bd-node p {
    font-size: 14.5px;
    line-height: var(--lh-snug);
    color: var(--color-text-body);
  }

  .bd-node .bd-v {
    font-size: var(--t-num);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
    color: var(--color-text);
    font-variation-settings: 'wdth' var(--w-num), 'wght' var(--g-num);
    font-variant-numeric: tabular-nums;
    transform-origin: left bottom;
  }

  .bd-node .bd-u {
    font: 400 var(--t-label) / var(--lh-snug) var(--font-data);
    color: var(--color-text-muted);
    margin-top: 6px;
  }

  @media (max-width: 599px) {
    .bd-chain {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 0;
      padding-left: 26px;
      gap: 20px;
    }

    .bd-chain::before {
      left: 4px;
      right: auto;
      top: 4px;
      bottom: 6px;
      width: 2px;
      height: auto;
      transform-origin: top;
      transform: scaleY(var(--k, 1));
    }

    .bd-node::before {
      left: -26px;
      top: 0;
    }

    .bd-node::after {
      content: none;
    }
  }

  /* ---------- small figure ---------- */
  .bd-fig {
    border: var(--line-hair);
    background: var(--color-surface-sunk);
    padding: 16px 18px 14px;
  }

  .bd-fcap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font: 500 var(--t-label) / var(--lh-label) var(--font-data);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 9px;
    border-bottom: var(--line-hair);
    margin-bottom: 14px;
  }

  .bd-fcap b {
    font-weight: 500;
    color: var(--color-accent);
  }

  .bd-fr {
    display: grid;
    grid-template-columns: minmax(0, 11em) minmax(0, 1fr) minmax(0, 5.6em);
    gap: 12px;
    align-items: center;
    padding: 7px 0;
  }

  .bd-fl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    font: 400 11.5px / var(--lh-label) var(--font-data);
    color: var(--color-text-body);
  }

  .bd-fv {
    font: 500 12.5px / 1.2 var(--font-data);
    color: var(--color-text);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bd-fv.r {
    color: var(--color-accent);
  }

  .bd-tr {
    position: relative;
    height: 12px;
    background: linear-gradient(var(--color-line-strong), var(--color-line-strong)) 0 50% / 100% 1px no-repeat;
  }

  .bd-b {
    position: absolute;
    left: 0;
    top: 2px;
    height: 8px;
    width: var(--x);
    background: var(--color-text-body);
    transform-origin: left;
    transform: scaleX(var(--k, 1));
  }

  .bd-b.r {
    background: var(--color-accent);
  }

  .bd-dd {
    position: absolute;
    inset: 0;
  }

  .bd-dd::before {
    content: '';
    position: absolute;
    left: min(var(--a), var(--b));
    width: max(calc(var(--b) - var(--a)), calc(var(--a) - var(--b)));
    top: 5px;
    height: 2px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--k, 1));
  }

  .bd-dd i {
    position: absolute;
    top: 2px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    background: var(--color-text-muted);
  }

  .bd-dd i.p0 {
    left: var(--a);
  }

  .bd-dd i.p1 {
    left: var(--b);
    background: var(--color-text);
    opacity: var(--d, 1);
  }

  .bd-ax {
    display: grid;
    grid-template-columns: minmax(0, 11em) minmax(0, 1fr) minmax(0, 5.6em);
    gap: 12px;
    margin-top: 4px;
  }

  .bd-ax span:nth-child(2) {
    display: flex;
    justify-content: space-between;
    font: 400 var(--t-label) / 1 var(--font-data);
    color: var(--color-text-muted);
  }

  .bd-ax i {
    font-style: normal;
  }

  .bd-fn {
    margin-top: 10px;
    font: 400 var(--t-label) / var(--lh-base) var(--font-data);
    color: var(--color-text-muted);
  }

  @media (max-width: 599px) {
    .bd-fr,
    .bd-ax {
      grid-template-columns: minmax(0, 1fr) minmax(0, 4.6em);
    }

    .bd-fr .bd-fl {
      grid-column: 1 / -1;
    }

    .bd-ax span:first-child {
      display: none;
    }
  }

  .bd-res {
    margin-top: 18px;
  }

  .bd-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 20px;
  }

  .bd-links .tl small {
    font-size: var(--t-label);
    color: var(--color-text-muted);
    margin-left: 2px;
  }
</style>

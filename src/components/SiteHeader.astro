---
import { site, nav } from '../data/copy';
import MobileNav from './MobileNav.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="bar">
    <a class="wordmark" href="/">{site.name.toUpperCase()}</a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => {
            const isCurrent = currentPath === item.href;
            return (
              <li>
                <a href={item.href} aria-current={isCurrent ? 'page' : undefined} class:list={[{ current: isCurrent }]}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <p class="standing-line" aria-hidden="true">{site.standingLine}</p>

    <MobileNav currentPath={currentPath} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }

  /* Desktop: sticky, ink rule, paper fill, no shadow — see build-note in Base.astro
     re: the JS-budget constraint (§1 permits only the mobile-nav toggle script),
     so the "sticks after 400px scroll + 150ms fade-in" trigger is approximated
     as always-sticky rather than scroll-observed. */
  @media (min-width: 900px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
    }
  }

  /* minmax(0, 1fr) — not 1fr — on the side tracks. A bare 1fr floors at the
     track's min-content, and .standing-line is nowrap, so its min-content is
     the full string: the right track blew past its share and dragged the nav
     off centre until the standing line read as a fifth nav item. */
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--s-8);
    padding-block: 14px;
    padding-inline: var(--gutter);
  }
  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    justify-self: start;
    white-space: nowrap;
  }

  .primary-nav {
    justify-self: center;
  }

  .primary-nav ul {
    display: flex;
    gap: var(--s-6);
    list-style: none;
  }

  .primary-nav a {
    position: relative;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
    padding-bottom: 4px;
  }

  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 120ms var(--ease-draw);
  }

  .primary-nav a:hover {
    color: var(--ink);
  }

  .primary-nav a:hover::after {
    transform: scaleX(1);
  }

  .primary-nav a:active {
    opacity: .7;
  }

  .primary-nav a.current {
    color: var(--red-ink);
  }

    .standing-line {
    justify-self: end;
    min-width: 0;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
    /* The standing line is decorative (aria-hidden) and the first thing to go
     when the bar is tight. */
  @media (max-width: 1099px) {
    .standing-line {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .primary-nav {
      display: none;
    }

    .bar {
      grid-template-columns: 1fr auto;
    }
  }
</style>

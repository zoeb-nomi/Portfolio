---
// Site header (DESIGN v3 §e, D-05): wordmark + role line, the four nav items at
// every width (no hamburger), and a red "Book a call →" action on desktop.
// The header is named for view transitions so it holds still between pages.
import { site, nav, isNavCurrent, cta } from '../data/copy';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="bar">
    <a class="wordmark" href="/">
      <span class="wm-name">{site.name}</span>
      <span class="wm-role">{site.role}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => {
            const isCurrent = isNavCurrent(item, currentPath);
            return (
              <li>
                <a href={item.href} aria-current={isCurrent ? 'page' : undefined} class:list={[{ current: isCurrent }]}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a class="hdr-cta" href={cta.bookACall.href} target="_blank" rel="noopener noreferrer">{cta.bookACallHeader}</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--line-ink);
    background: var(--paper);
    view-transition-name: site-header;
  }

  @media (min-width: 900px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: var(--z-nav);
    }
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: var(--s-8);
    min-height: var(--header-h);
    padding-inline: var(--gutter);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    text-decoration: none;
    color: var(--ink);
    min-height: var(--hit-touch);
    align-self: center;
    padding-block: var(--s-3);
  }

  .wm-name {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--t-nav);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wm-role {
    font-family: var(--font-body);
    font-size: var(--t-label);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .primary-nav ul {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-7);
    list-style: none;
  }

  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    font-family: var(--font-mono);
    font-size: var(--t-nav);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  /* The bar under a nav item: drawn for the current page, wipes in on hover. */
  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    border-top: var(--line-pen);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-draw);
  }

  .primary-nav a:hover::after,
  .primary-nav a.current::after {
    transform: scaleX(1);
  }

  .primary-nav a.current {
    color: var(--red-ink);
  }

  .hdr-cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-touch);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--t-nav);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }

  .hdr-cta:hover {
    color: var(--red);
    text-decoration-thickness: 2px;
  }

  /* Role line from 1100px only (D-05); under that the bar is wordmark + nav. */
  @media (max-width: 1099px) {
    .wm-role {
      display: none;
    }
  }

  /* Phones and tablets: role line under the wordmark, then the four items on
     one row, each 44px tall. The header action lives in the hero instead. */
  @media (max-width: 899px) {
    .bar {
      grid-template-columns: 1fr;
      row-gap: 0;
      padding-top: var(--s-3);
    }

    .wordmark {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      min-height: 0;
      padding-block: var(--s-1);
    }

    .wm-role {
      display: block;
      white-space: normal;
    }

    .primary-nav ul {
      justify-content: space-between;
      gap: 0;
    }

    .primary-nav li {
      flex: 1 1 0;
    }

    .primary-nav li:last-child a {
      justify-content: flex-end;
    }

    .primary-nav li:nth-child(2) a,
    .primary-nav li:nth-child(3) a {
      justify-content: center;
    }

    .primary-nav a {
      display: flex;
      width: 100%;
    }

    .primary-nav a::after {
      bottom: 6px;
    }

    .hdr-cta {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .primary-nav a::after {
      left: 50%;
      right: auto;
      width: 3.2em;
      transform: translateX(-50%) scaleX(0);
      transform-origin: center;
    }

    .primary-nav li:first-child a::after {
      left: 0;
      transform: scaleX(0);
      transform-origin: left;
    }

    .primary-nav li:last-child a::after {
      left: auto;
      right: 0;
      transform: scaleX(0);
      transform-origin: right;
    }

    .primary-nav a.current::after,
    .primary-nav a:hover::after {
      transform: translateX(-50%) scaleX(1);
    }

    .primary-nav li:first-child a.current::after,
    .primary-nav li:first-child a:hover::after,
    .primary-nav li:last-child a.current::after,
    .primary-nav li:last-child a:hover::after {
      transform: scaleX(1);
    }
  }
</style>

---
import { site, nav } from '../data/copy';
import MobileNav from './MobileNav.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="bar">
    <a class="wordmark" href="/">{site.name.toUpperCase()}</a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => {
            const isCurrent = currentPath === item.href;
            return (
              <li>
                <a href={item.href} aria-current={isCurrent ? 'page' : undefined} class:list={[{ current: isCurrent }]}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <MobileNav currentPath={currentPath} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }

  @media (min-width: 900px) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
    }
  }

  /* Two-column header: wordmark left, nav right. Standing line retired 2026-08-20;
     its positioning info now lives elsewhere: the footer line and the Home hero
     eyebrow each carry it in their own words. Retiring it removed the nowrap-in-
     1fr-track trap behind the earlier header bug and freed the right side for a
     5-item nav. */
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--s-8);
    padding-block: 14px;
    padding-inline: var(--gutter);
  }
  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .primary-nav {
    min-width: 0;
  }

  .primary-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    position: relative;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
    padding-bottom: 4px;
    white-space: nowrap;
  }

  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 120ms var(--ease-draw);
  }

  .primary-nav a:hover { color: var(--ink); }
  .primary-nav a:hover::after { transform: scaleX(1); }
  .primary-nav a:active { opacity: .7; }
  .primary-nav a.current { color: var(--red-ink); }

  @media (max-width: 899px) {
    .primary-nav { display: none; }
  }
</style>

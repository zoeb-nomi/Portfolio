---
// Site header (The Pipeline, design/README.md §6): brand, the four nav items, the
// theme toggle and an Email action, on a sticky glass bar. Phones drop Home (the brand
// links home) and Email (it is in the footer). Styles live in src/styles/ds.css (.site).
import { site, nav, isNavCurrent, cta, headerUi } from '../data/copy';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const pageKey = (href: string) => (href === '/' ? 'home' : href.replace(/\//g, ''));
---

<header class="site gut">
  <div class="in">
    <a class="brand" href="/">{site.name}</a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class="nl"
            data-page={pageKey(item.href)}
            href={item.href}
            aria-current={isNavCurrent(item, currentPath) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-t" type="button" aria-label={headerUi.themeToLight}>
      <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="8" r="3"></circle><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M3 13l1.4-1.4M11.6 4.4L13 3"></path></svg>
      <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z"></path></svg>
    </button>
    <a class="hcta" href={cta.email.href}>{headerUi.email}</a>
  </div>
</header>

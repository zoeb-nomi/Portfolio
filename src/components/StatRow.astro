---
interface Props {
  value: string;
  verdict?: string | null;
  sub?: string | null;
  label: string;
  provenance?: string | null;
}

const { value, verdict = null, sub = null, label, provenance = null } = Astro.props;
---

<div class="stat-row">
  <p class="stat-figure tabular">
    {value}
    {verdict && <span class="verdict" aria-hidden="true">{verdict}</span>}
    {sub && <span class="stat-sub">{sub}</span>}
  </p>
  <p class="stat-label">
    {label}
    {provenance && <span class="provenance"> {provenance}</span>}
  </p>
</div>

<style>
  .stat-row {
    display: grid;
    grid-template-columns: 300px 1fr;
    align-items: baseline;
    gap: var(--s-9);
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
    transition: border-color var(--dur-fast) var(--ease-draw);
  }

  .stat-row:first-child {
    border-top: 0;
  }

  @media (hover: hover) {
    .stat-row:hover {
      border-top-color: var(--rule-strong);
    }
  }

  .stat-figure {
    font-family: var(--font-display);
    font-size: var(--t-stat);
    line-height: 0.9;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    white-space: nowrap;
  }

  .verdict {
    color: var(--red-ink);
    font-size: var(--t-quote);
    vertical-align: super;
    margin-left: var(--s-1);
  }

  .stat-sub {
    font-family: var(--font-mono);
    font-size: var(--t-quote);
    color: var(--ink-muted);
    margin-left: var(--s-2);
    letter-spacing: var(--track-normal);
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--t-small);
    color: var(--ink-body);
    line-height: var(--lh-snug);
  }

  .provenance {
    font-family: var(--font-mono);
    font-size: var(--t-label-lg);
    color: var(--ink-muted);
  }

  @media (max-width: 899px) {
    .stat-row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
      padding-block: var(--s-3);
    }
  }
</style>

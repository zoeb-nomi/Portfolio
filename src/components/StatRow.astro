---
// One readout in the kit's .ro grammar: a big whole number, what it counts, and where it comes from.
// Place several inside a `.stats` row (or `.ros` grid). The number appears whole, never counted up.
interface Props {
  value: string;
  verdict?: string | null;
  sub?: string | null;
  label: string;
  provenance?: string | null;
}

const { value, verdict = null, sub = null, label, provenance = null } = Astro.props;
---

<div class="ro stat-row">
  <p class="v tabular" data-num>
    {value}
    {verdict && <span class="verdict" aria-hidden="true">{verdict}</span>}
    {sub && <span class="stat-sub">{sub}</span>}
  </p>
  <p class="u">{label}</p>
  {provenance && <p class="s">{provenance}</p>}
</div>

<style>
  .verdict {
    color: var(--color-accent);
    margin-left: var(--s-1);
  }

  .stat-sub {
    font-family: var(--font-data);
    font-size: var(--t-label);
    color: var(--color-text-muted);
    margin-left: var(--s-2);
  }
</style>

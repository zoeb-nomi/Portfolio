---
// A pull quote: the kit's prose blockquote (2px red rule, medium weight), set a little larger than the text.
// `rule` is kept for old call sites: the rule is always the red line now. `kicker` adds a small mono label above.
interface Props {
  kicker?: string;
  rule?: 'ink' | 'red';
}

const { kicker } = Astro.props;
---

<blockquote class="pq">
  {kicker && <p class="pq-kick lab red">{kicker}</p>}
  <p class="pq-text"><slot /></p>
</blockquote>

<style>
  .pq {
    margin-block: var(--s-7);
    border-left: var(--line-pen);
    padding: var(--s-1) 0 var(--s-1) var(--s-5);
    max-width: var(--measure);
  }

  .pq-kick {
    margin-bottom: var(--s-2);
  }

  .pq-text {
    font-size: var(--t-quote);
    line-height: var(--lh-snug);
    letter-spacing: -0.015em;
    color: var(--color-text);
    font-variation-settings: 'wdth' 92, 'wght' 520;
    text-wrap: balance;
  }
</style>

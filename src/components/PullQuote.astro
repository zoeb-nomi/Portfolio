---
interface Props {
  kicker?: string;
  rule?: 'ink' | 'red';
}

const { kicker, rule = 'ink' } = Astro.props;
---

<blockquote class:list={['pull-quote', `rule-${rule}`, { 'no-kicker': !kicker, 'grid-margin': kicker }]}>
  {kicker && <p class="kicker margin-col">{kicker}</p>}
  <p class:list={['quote', { 'body-col': kicker }]}><slot /></p>
</blockquote>

<style>
  /* With a kicker the quote sits on the site grid (layout.css): kicker in the
     margin column, quote in the body column. The columns are bare — no rule,
     no padding — because the quote is already inside a body column. */
  .pull-quote {
    gap: var(--s-6);
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-7);
    margin: 0;
  }

  .pull-quote.rule-red {
    border-top-color: var(--rule-accent);
    border-top-width: 2px;
  }

  .pull-quote > .margin-col,
  .pull-quote > .body-col {
    border: 0;
    padding: 0;
  }

  .pull-quote.no-kicker .quote {
    max-width: 46ch;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--red-ink);
    line-height: var(--lh-label);
  }

  .quote {
    font-family: var(--font-display);
    font-size: var(--t-quote);
    line-height: 1.3;
    letter-spacing: var(--track-tight);
    color: var(--ink);
  }

  @media (max-width: 899px) {
    .pull-quote {
      gap: var(--s-3);
    }
  }
</style>

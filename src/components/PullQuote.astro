---
interface Props {
  kicker?: string;
  rule?: 'ink' | 'red';
}

const { kicker, rule = 'ink' } = Astro.props;
---

<blockquote class:list={['pull-quote', `rule-${rule}`, { 'no-kicker': !kicker }]}>
  {kicker && <p class="kicker">{kicker}</p>}
  <p class="quote"><slot /></p>
</blockquote>

<style>
  .pull-quote {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--s-6);
    border-top: 1px solid var(--ink);
    padding-top: var(--s-7);
    margin: 0;
  }

  .pull-quote.rule-red {
    border-top-color: var(--red);
    border-top-width: 2px;
  }

  .pull-quote.no-kicker {
    grid-template-columns: 1fr;
  }

  .pull-quote.no-kicker .quote {
    max-width: 46ch;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--red-ink);
    line-height: 1.7;
  }

  .quote {
    font-family: var(--font-display);
    font-size: var(--t-quote);
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  @media (max-width: 899px) {
    .pull-quote {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>

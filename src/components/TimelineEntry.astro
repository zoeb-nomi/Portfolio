---
import { renderMetrics } from '../utils/metrics';
import MarginNote from './MarginNote.astro';

interface Achievement {
  kicker: string | null;
  text: string;
  metrics?: string[];
}

interface Logo {
  src: string;
  width: number;
  height: number;
}

interface Props {
  company: string;
  role: string;
  dateRange: string;
  descriptor?: string | null;
  standfirst?: string | null;
  achievements: Achievement[];
  primary?: boolean;
  logo?: Logo | null;
  note?: string | null;
}

const {
  company,
  role,
  dateRange,
  descriptor = null,
  standfirst = null,
  achievements,
  primary = false,
  logo = null,
  note = null,
} = Astro.props;
---

<div class:list={['entry', 'grid-margin', { primary }]}>
  <aside class="margin-col" aria-label={`${company} — ${dateRange}`}>
    {logo && (
      <img
        class="company-logo"
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    )}
    <p class="date-range">{dateRange}</p>
    <p class="role">{role}</p>
    {note && <MarginNote as="div" label={`Note — ${company}`}>{note}</MarginNote>}
  </aside>
  <div class="body-col">
    <h2 class="company">{company}</h2>
    {descriptor && <p class="descriptor">{descriptor}</p>}
    {standfirst && <p class="standfirst">{standfirst}</p>}
    <slot name="video" />
    <ul class="achievements">
      {
        achievements.map((a) => (
          <li>
            {a.kicker && <p class="kicker">{a.kicker}</p>}
            <p class="achievement-text" set:html={renderMetrics(a.text, a.metrics)} />
          </li>
        ))
      }
    </ul>
    <slot name="record" />
  </div>
</div>

<style>
  .entry {
    border-bottom: 1px solid var(--rule-strong);
  }

  .company-logo {
    display: block;
    height: 22px;
    width: auto;
    opacity: 0.85;
    margin-bottom: var(--s-4);
  }

  .date-range,
  .role {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .entry.primary .body-col {
    padding-top: var(--s-11);
    padding-bottom: var(--s-11);
  }

  .entry.primary .company {
    font-size: var(--t-display-xl);
  }

  .company {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--s-4);
  }

  /* One lede setting for every employer: sans at body size (V12). Serif is
     display-only and needs >= 20px, so a body-size italic dek does not fit. */
  .descriptor,
  .standfirst {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.62;
    margin-bottom: var(--s-7);
  }

  .descriptor {
    color: var(--ink-body);
  }

  .standfirst {
    color: var(--ink);
  }

  /* One measure for every paragraph in the entry (was 58/60/68ch). */
  .entry p {
    max-width: 68ch;
  }

  .achievements {
    list-style: none;
  }

  .achievements li {
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .achievements li:first-child {
    border-top: 0;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--s-2);
  }

  .achievement-text {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.62;
    color: var(--ink-body);
    max-width: 68ch;
  }

  .achievement-text :global(.metric) {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 899px) {
    .margin-col {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-4);
    }

    /* A slotted note drops to its own full-width line rather than squeezing
       into the logo + dates row. */
    .margin-col :global(.margin-note) {
      flex-basis: 100%;
      margin-top: 0;
    }

    .company-logo {
      height: 18px;
      margin-bottom: 0;
    }
  }
</style>

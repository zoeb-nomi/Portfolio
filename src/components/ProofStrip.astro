---
// Four counts from the case studies, each linking to the one that earned it. The numbers tick up once as the strip
// scrolls into view; with reduced motion, or no script, they simply read as their final values.
interface Item {
  value: number;
  suffix: string;
  label: string;
  href: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="pf" data-proof>
  {
    items.map((it) => (
      <li>
        <a href={it.href}>
          <span class="pf-n tabular"><span data-count={it.value}>{it.value}</span>{it.suffix && <small>{it.suffix}</small>}</span>
          <span class="pf-l">{it.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  import { motionAllowed } from '../scripts/figure-motion';

  if (motionAllowed()) {
    const ease = (k: number) => 1 - Math.pow(1 - k, 3);
    document.querySelectorAll<HTMLElement>('[data-proof]').forEach((root) => {
      const nums = Array.from(root.querySelectorAll<HTMLElement>('[data-count]'));
      nums.forEach((n) => (n.textContent = '0'));
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          let t0 = 0;
          const step = (now: number) => {
            if (!t0) t0 = now;
            const k = Math.min(1, (now - t0) / 1100);
            nums.forEach((n) => (n.textContent = String(Math.round(Number(n.dataset.count) * ease(k)))));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        },
        { threshold: 0.5 },
      );
      io.observe(root);
    });
  }
</script>

<style>
  .pf {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--rule-strong);
  }

  .pf li + li {
    border-inline-start: 1px solid var(--rule);
  }

  .pf a {
    display: block;
    block-size: 100%;
    padding: var(--s-5) var(--s-4) var(--s-4);
    color: inherit;
    text-decoration: none;
  }

  .pf-n {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-tight);
    color: var(--ink);
  }

  .pf-n small {
    margin-inline-start: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    letter-spacing: var(--track-normal);
    color: var(--ink-muted);
  }

  .pf-l {
    display: block;
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: var(--lh-snug);
    color: var(--ink-muted);
  }

  .pf a:hover .pf-l {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  @media (max-width: 899px) {
    .pf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pf li:nth-child(3) {
      border-inline-start: 0;
    }

    .pf li:nth-child(n + 3) {
      border-block-start: 1px solid var(--rule);
    }
  }
</style>

---
// The home "Shipped" section: three before-to-after panels on a spine (Instead run time, Keka Background
// Verification, CrossSource precision). Each panel is a left column of facts and a right-hand visual.
//   Markup: everything is rendered here in its FINAL state (the visuals included), so no-JS and reduced motion
//   show the finished page and nothing shifts when scripts load.
//   Behaviour: src/scripts/shipped.ts replays each panel as a latched scrub (plays forward once, never reverses),
//   turns the CrossSource figure into an odometer, and runs ambient ticks only while a panel is on screen.
// Variants: panel key `instead` | `keka` | `crosssource`. Motion: whole-number reveals, no count-ups.
// Copy: pipelineHome.shipped in src/data/copy.ts.
import { pipelineHome as P } from '../../data/copy';

const SH = P.shipped;
const f1 = (n: number) => n.toFixed(1);

// ---- Instead: 15-minute dial and run-time bar (geometry constants only; the labels are copy) ----
const IN = SH.instead;
const dialMax = parseFloat(IN.axis[IN.axis.length - 1]); // 15 minutes full scale
const bandFrom = parseFloat(IN.band.split(' ')[0]);
const finalMin = 0.9; // "under 1 min": drawn as 0.9 of a minute
const eNow = finalMin / dialMax;
const DX = 60, DY = 70, DR = 46, Dr = 23, Dc = 2 * Math.PI * Dr;
const dialTicks = Array.from({ length: 15 }, (_, i) => {
  const a = (i / 15) * Math.PI * 2 - Math.PI / 2, mj = i % 5 === 0, l = mj ? 9 : 5;
  return { x1: DX + Math.cos(a) * DR, y1: DY + Math.sin(a) * DR, x2: DX + Math.cos(a) * (DR - l), y2: DY + Math.sin(a) * (DR - l), mj };
});

// ---- CrossSource: precision gauge ----
const CS = SH.crosssource;
const gMin = parseFloat(CS.gauge.min), gMax = parseFloat(CS.gauge.max);
const vBase = parseFloat(CS.gauge.base), vStrict = parseFloat(CS.gauge.strict);
const GX = 500, GY = 520, GR = 400;
const gA = (v: number) => 200 + ((v - gMin) / (gMax - gMin)) * 140; // 200 to 340 degrees
const gP = (a: number, r: number) => [GX + r * Math.cos((a * Math.PI) / 180), GY + r * Math.sin((a * Math.PI) / 180)];
const iBase = Math.round((vBase - gMin) / 0.001), iStrict = Math.round((vStrict - gMin) / 0.001);
const gTicks = Array.from({ length: 31 }, (_, i) => {
  const a = gA(gMin + i * 0.001), hi = i === iBase || i === iStrict, mj = i % 5 === 0, len = hi ? 70 : mj ? 40 : 20;
  const p1 = gP(a, GR), p2 = gP(a, GR - len);
  return { x1: f1(p1[0]), y1: f1(p1[1]), x2: f1(p2[0]), y2: f1(p2[1]), cls: 'g-tick' + (hi ? ' hi' : mj ? ' mj' : '') };
});
const gs = gP(200, GR), ge = gP(340, GR);
const arcD = `M${f1(gs[0])} ${f1(gs[1])} A${GR} ${GR} 0 0 1 ${f1(ge[0])} ${f1(ge[1])}`;
const lMin = gP(200, GR + 30), lMax = gP(340, GR + 30), lBase = gP(gA(vBase), GR + 42), lStrict = gP(gA(vStrict), GR + 42);
const gg1 = gP(gA(vBase), GR - 96), gg2 = gP(gA(vStrict), GR - 96);
const gainD = `M${f1(gg1[0])} ${f1(gg1[1])} A${GR - 96} ${GR - 96} 0 0 1 ${f1(gg2[0])} ${f1(gg2[1])}`;
const needleRot = (gA(vStrict) - 270).toFixed(3);

// ---- Keka: integration flow ----
const KK = SH.keka;
const nodes = [10, 390, 770];
---

<section class="sec spined shipped gut" id="shipped" aria-labelledby="h-shipped">
  <div class="spine" aria-hidden="true"></div>
  <div class="in">
    <p class="kick">{SH.kick}</p>
    <h2 class="h2" data-split id="h-shipped">{SH.h2}</h2>

    {
      SH.panels.map((p, pi) => (
        <article class="panel" aria-labelledby={`p${pi + 1}-t`}>
          <div data-stagger>
            <p class="ph"><span class="pi">{p.pi}</span><span>{p.src}</span></p>
            <h3 class="pt" id={`p${pi + 1}-t`}>{p.title}</h3>
            <dl class="how">
              {p.how.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
            </dl>
            <p class="srcl">{p.srcl}</p>
          </div>
          <div class="viz" data-viz={p.key}>
            {p.key === 'instead' && (
              <>
                <div class="v-vals">
                  <div class="v-val v-before"><span class="v-num">{IN.before.v}<i class="v-strike" style="--k:1"></i></span><span class="lab">{IN.before.l}</span></div>
                  <span class="v-arrow" aria-hidden="true">→</span>
                  <div class="v-val"><span class="v-num v-after">{IN.after.v}</span><span class="lab">{IN.after.l}</span></div>
                </div>
                <div class="vi-row">
                  <div>
                    <div class="v-cap"><span>{IN.cap[0]}</span><span>{IN.cap[1]}</span></div>
                    <div class="vi-chart" aria-hidden="true">
                      <div class="vi-band" style={`left:${((bandFrom / dialMax) * 100).toFixed(3)}%;width:${(((dialMax - bandFrom) / dialMax) * 100).toFixed(3)}%;opacity:.45`}><span>{IN.band}</span></div>
                      <div class="vi-bar" style={`transform:scaleX(${eNow.toFixed(4)})`}></div>
                      <div class="vi-one" style={`left:${((1 / dialMax) * 100).toFixed(3)}%`}><span>{IN.one}</span></div>
                      <div class="vi-axis">
                        {IN.axis.map((a) => <span style={`left:${((parseFloat(a) / dialMax) * 100).toFixed(3)}%`}>{a}</span>)}
                      </div>
                    </div>
                  </div>
                  <svg class="vi-watch" viewBox="0 0 120 134" aria-hidden="true" data-dial={`${dialMax} ${bandFrom} ${finalMin}`}>
                    <rect x="55" y="14" width="10" height="7" class="w-crown"></rect>
                    <circle cx={DX} cy={DY} r={Dr} stroke-width={2 * Dr} class="w-range" transform={`rotate(-90 ${DX} ${DY})`} stroke-dasharray={`${((Dc * (dialMax - bandFrom)) / dialMax).toFixed(2)} ${Dc.toFixed(2)}`} stroke-dashoffset={(-(Dc * bandFrom) / dialMax).toFixed(2)} style="opacity:.4"></circle>
                    <circle cx={DX} cy={DY} r={Dr} stroke-width={2 * Dr} class="w-sweep" transform={`rotate(-90 ${DX} ${DY})`} stroke-dasharray={`${(eNow * Dc).toFixed(2)} ${Dc.toFixed(2)}`}></circle>
                    <circle cx={DX} cy={DY} r={DR} class="w-face"></circle>
                    {dialTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={'w-tick' + (t.mj ? ' mj' : '')}></line>)}
                    <line x1={DX} y1={DY + 7} x2={DX} y2={DY - DR + 6} class="w-hand" transform={`rotate(${(eNow * 360).toFixed(2)} ${DX} ${DY})`}></line>
                    <circle cx={DX} cy={DY} r="3.6" class="w-hub"></circle>
                    <text x={DX} y="132" text-anchor="middle" class="w-lab">{IN.dial}</text>
                  </svg>
                </div>
              </>
            )}
            {p.key === 'keka' && (
              <>
                <div class="v-vals">
                  <div class="v-val v-before"><span class="v-num">{KK.before.v}</span><span class="lab">{KK.before.l}</span></div>
                  <span class="v-arrow" aria-hidden="true">→</span>
                  <div class="v-val"><span class="v-num v-after">{KK.after.v}</span><span class="lab">{KK.after.l}</span></div>
                </div>
                <div class="v-cap m28"><span>{KK.cap1[0]}</span><span>{KK.cap1[1]}</span></div>
                <svg class="vk-flow" viewBox="0 0 1000 110" aria-hidden="true">
                  {nodes.map((x, i) => (
                    <>
                      <rect x={x} y="22" width="220" height="64" class={'s-box' + (i === 1 ? ' me' : '')}></rect>
                      <text x={x + 110} y="62" text-anchor="middle" class="s-t">{KK.nodes[i]}</text>
                      {i === 1 && <text x={x + 220} y="14" text-anchor="end" class="s-me">{KK.mine}</text>}
                    </>
                  ))}
                  <path d="M232 54 L382 54" class="s-wire" pathLength="1" stroke-dasharray="1" stroke-dashoffset="0"></path>
                  <path d="M612 54 L762 54" class="s-wire" pathLength="1" stroke-dasharray="1" stroke-dashoffset="0"></path>
                  <path d="M232 54 L382 54" class="s-ants" style="opacity:.9"></path>
                  <path d="M612 54 L762 54" class="s-ants" style="opacity:.9"></path>
                  <path d="M382 54 l-10 -6 v12 z" class="s-head"></path>
                  <path d="M762 54 l-10 -6 v12 z" class="s-head"></path>
                </svg>
                <div class="v-cap m26"><span>{KK.cap2[0]}</span><span class="vk-tally"><b>{KK.cap2[1]}</b></span></div>
                <div class="vk-cl" aria-hidden="true">{Array.from({ length: parseInt(KK.cap2[1], 10) }, () => <i></i>)}</div>
                <p class="vk-tag">{KK.tag}</p>
              </>
            )}
            {p.key === 'crosssource' && (
              <>
                <div class="v-vals">
                  <div class="v-val v-before"><span class="v-num">{CS.before.v}</span><span class="lab">{CS.before.l}</span></div>
                  <span class="v-arrow" aria-hidden="true">→</span>
                  <div class="v-val"><span class="v-num v-after">{CS.after.v}</span><span class="lab">{CS.after.l}</span></div>
                </div>
                <div class="vc-res">
                  <div>
                    <div class="v-cap"><span>{CS.cap1[0]}</span><span>{CS.cap1[1]}</span></div>
                    <svg class="vc-gauge" viewBox="-40 0 1080 548" preserveAspectRatio="xMidYMid meet" aria-hidden="true" data-g={`${GX} ${GY} ${GR} ${gMin} ${gMax}`}>
                      <path d={arcD} class="g-arc"></path>
                      {gTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.cls}></line>)}
                      <text x={f1(lMin[0])} y={f1(lMin[1] + 12)} text-anchor="end" class="g-end">{CS.gauge.min}</text>
                      <text x={f1(lMax[0])} y={f1(lMax[1] + 12)} text-anchor="start" class="g-end">{CS.gauge.max}</text>
                      <text x={f1(lBase[0])} y={f1(lBase[1] - 4)} text-anchor="middle" class="g-cv">{CS.gauge.base}</text>
                      <text x={f1(lBase[0])} y={f1(lBase[1] - 72)} text-anchor="middle" class="g-cl">{CS.gauge.baseL}</text>
                      <g class="g-strict">
                        <text x={f1(lStrict[0] + 20)} y={f1(lStrict[1] - 4)} text-anchor="middle" class="g-cv">{CS.gauge.strict}</text>
                        <text x={f1(lStrict[0] + 20)} y={f1(lStrict[1] - 72)} text-anchor="middle" class="g-cl">{CS.gauge.strictL}</text>
                      </g>
                      <path d={gainD} class="g-gain"></path>
                      <g class="g-needle-g" transform={`rotate(${needleRot} ${GX} ${GY})`}>
                        <line x1={GX} y1={GY + 26} x2={GX} y2={GY - GR + 22} class="g-needle"></line>
                      </g>
                      <circle cx={GX} cy={GY} r="16" class="g-hub"></circle>
                      <circle cx={GX} cy={GY} r="6" class="g-hub2"></circle>
                    </svg>
                    <p class="v-fine">{CS.fine}</p>
                  </div>
                  <div>
                    <div class="v-cap"><span>{CS.cap2[0]}</span><span>{CS.cap2[1]}</span></div>
                    <div class="vc-rows">
                      {CS.rows.map((r) => (
                        <div class="vc-r">
                          <span class="lbl">{r.l}</span>
                          <span class="vc-u">
                            {r.b === 0 && <em>{CS.none}</em>}
                            {Array.from({ length: r.b }, (_, k) =>
                              k >= r.s ? (
                                <i data-gone style="opacity:.2"><b style="transform:rotate(-40deg) scaleX(1)"></b></i>
                              ) : (
                                <i><b></b></i>
                              ),
                            )}
                          </span>
                          <span class={'vc-d' + (r.win ? ' win' : '')}>{r.d}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import '../../scripts/shipped';
</script>

<style is:global>
/* ---------- Shipped panel visuals ---------- */
.shipped{padding-top:clamp(36px,6vh,72px)}
.viz{min-width:0}
.vi-row{display:grid;grid-template-columns:minmax(0,1fr) clamp(84px,8vw,118px);gap:clamp(14px,2.2vw,30px);align-items:end;margin-top:clamp(16px,2.6vh,28px)}
.vi-chart{position:relative;height:96px}
.vi-band{position:absolute;left:66.667%;width:33.333%;top:30px;height:28px;background:repeating-linear-gradient(135deg,transparent 0 6px,var(--color-line-strong) 6px 7.5px);box-shadow:inset 1.5px 0 0 var(--color-text-muted)}
.vi-band span{position:absolute;left:8px;background:var(--color-surface);padding:0 4px;margin-left:-4px;bottom:calc(100% + 6px);font:500 11px/1 var(--font-data);color:var(--color-text-muted);white-space:nowrap}
.vi-bar{position:absolute;left:0;top:30px;height:28px;width:100%;background:var(--color-text);transform-origin:left}
.vi-one{position:absolute;left:6.667%;top:20px;height:48px;border-left:var(--line-pen-dashed)}
.vi-one span{position:absolute;left:6px;top:-6px;font:500 11px/1 var(--font-data);color:var(--color-accent);white-space:nowrap}
.vi-axis{position:absolute;left:0;right:0;top:68px;height:24px;background:linear-gradient(var(--color-text-muted),var(--color-text-muted)) top/100% 1px no-repeat}
.vi-axis span{position:absolute;top:7px;transform:translateX(-50%);font:400 11px/1 var(--font-data);color:var(--color-text-muted);white-space:nowrap}
.vi-axis span::before{content:"";position:absolute;left:50%;top:-7px;width:1px;height:5px;background:var(--color-text-muted)}
.vi-axis span:first-child{transform:none}.vi-axis span:first-child::before{left:0}
.vi-axis span:last-child{transform:translateX(-100%)}.vi-axis span:last-child::before{left:100%}
.vi-watch{width:100%;height:auto;display:block;overflow:visible}
.w-face{fill:none;stroke:var(--color-text);stroke-width:1.5}
.w-tick{stroke:var(--color-text-muted);stroke-width:1}.w-tick.mj{stroke:var(--color-text);stroke-width:1.6}
.w-sweep{fill:none;stroke:var(--color-accent);opacity:.9}
.w-range{fill:none;stroke:var(--color-line-strong)}
.w-hand{stroke:var(--color-text);stroke-width:2.2;stroke-linecap:round}
.w-hub,.w-crown{fill:var(--color-text)}
.w-lab{fill:var(--color-text-muted);font-family:var(--font-data);font-size:10px;letter-spacing:.08em}
.vk-flow{width:100%;height:auto;display:block;overflow:visible}
.s-box{fill:none;stroke:var(--color-line-strong);stroke-width:1.5}.s-box.me{stroke:var(--color-accent);stroke-width:2.5}
.s-t{fill:var(--color-text);font-family:var(--font-text);font-size:24px;font-variation-settings:"wght" 720}
.s-me{fill:var(--color-accent);font-family:var(--font-data);font-size:var(--t-data);letter-spacing:.12em}
.s-wire{fill:none;stroke:var(--color-text-body);stroke-width:1.8}
.s-ants{fill:none;stroke:var(--color-accent);stroke-width:2.4;stroke-dasharray:4 12;stroke-linecap:round}
.s-head{fill:var(--color-text-body)}
.vk-tally b{color:var(--color-accent);font-weight:500}
.vc-res{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(16px,2.4vw,34px);margin-top:clamp(16px,2.6vh,28px)}
.vc-gauge{width:100%;height:clamp(110px,18vh,186px);display:block;overflow:visible}
.g-arc{fill:none;stroke:var(--color-text-muted);stroke-width:2}
.g-tick{stroke:var(--color-text-muted);stroke-width:2}.g-tick.mj{stroke:var(--color-text);stroke-width:3}.g-tick.hi{stroke:var(--color-accent);stroke-width:5}
.g-gain{fill:none;stroke:var(--color-accent);stroke-width:16;opacity:.9}
.g-needle{stroke:var(--color-text);stroke-width:6;stroke-linecap:round}
.g-hub{fill:var(--color-text)}.g-hub2{fill:var(--color-surface)}
.g-cv{fill:var(--color-text);font-family:var(--font-text);font-size:66px;font-variation-settings:"wght" 780}
.g-cl{fill:var(--color-text-muted);font-family:var(--font-data);font-size:30px;letter-spacing:.1em}
.g-end{fill:var(--color-text-muted);font-family:var(--font-data);font-size:32px}
.vc-rows{display:grid;gap:9px}
.vc-r{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) auto;gap:10px;align-items:center;font-size:13.5px;line-height:var(--lh-label);color:var(--color-text-body);padding-bottom:9px;border-bottom:var(--line-hair)}
.vc-r .lbl{color:var(--color-text)}
.vc-u{display:flex;gap:4px;flex-wrap:wrap;align-items:center;min-height:12px}
.vc-u i{position:relative;display:block;width:12px;height:12px;background:var(--color-text)}
.vc-u i b{position:absolute;left:-3px;right:-3px;top:5px;height:2px;background:var(--color-accent);transform:rotate(-40deg) scaleX(0)}
.vc-u em{font:400 11px/1 var(--font-data);font-style:normal;color:var(--color-text-muted)}
.vc-d{font:500 11px/1.2 var(--font-data);color:var(--color-text-muted);text-align:right;white-space:nowrap}
.vc-d.win{color:var(--color-accent)}
.v-fine{margin-top:10px;font:400 11px/1.5 var(--font-data);color:var(--color-text-muted)}
@media (max-width:599px){.vc-res{grid-template-columns:minmax(0,1fr)}}

/* ---------- before -> after values: arrow centred on the numerals ---------- */
.v-vals{align-items:flex-start}
.v-arrow{align-self:flex-start;display:flex;align-items:center;height:calc(clamp(34px,4.3vw,74px) * .92);padding:0;line-height:1}

/* ---------- odometer (CrossSource 0.981 -> 0.994) ---------- */
.odo{display:inline-flex;align-items:flex-start;height:.92em;line-height:.92;overflow:hidden;vertical-align:top}
.odo .oc{display:block;height:.92em;overflow:hidden}
.odo .ocs{display:block;will-change:transform}
.odo .ocs span{display:block;height:.92em;line-height:.92}
.odo .ofix{display:block}

/* ---------- Keka panel: 28 clients as 28 squares ---------- */
.vk-cl{display:grid;grid-template-columns:repeat(28,minmax(0,1fr));gap:clamp(3px,.45vw,6px)}
@media (max-width:599px){.vk-cl{grid-template-columns:repeat(14,minmax(0,1fr))}}
.vk-cl i{display:block;aspect-ratio:1;background:var(--color-text);opacity:1}
.vk-tag{display:inline-flex;align-items:center;gap:10px;margin-top:14px;font:500 11px/1.3 var(--font-data);letter-spacing:.12em;text-transform:uppercase;color:var(--color-text-body)}
.vk-tag::before{content:"";width:18px;height:1.5px;background:var(--color-accent)}

/* ---------- Shipped: content on the page's left line; the spine sits in the gutter ---------- */
#shipped.spined .in{padding-left:0}
#shipped .spine{left:max(6px,calc((100% - var(--shell-max)) / 2 - 22px))}


.v-cap.m28{margin-top:28px}
.v-cap.m26{margin-top:26px}
</style>

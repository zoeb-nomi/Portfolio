---
// "Who decides what runs" (The Pipeline, Fig. 1): TradeFrame's decision path. Dashed node = proposes
// only; solid = decides. Every label is printed in the SVG; the script moves one token along the path
// (propose, validate, confirm, execute and record), alternating the US and India book, and once in
// three runs the kill switch fires. It runs only while the figure is on screen and visible, and
// reduced motion shows the finished path with all four steps lit. On phones (599px and below) the SVG would
// shrink its labels under the 11px floor, so a stacked list of the same nodes (builds.tradeframeFlow) replaces it.
// Copy: pipelineBuilds.flow.
import { builds, pipelineBuilds } from '../data/copy';

const f = pipelineBuilds.flow;
const N = f.nodes;
---

<div class="bd-flow-wrap" data-tf-flow>
  <svg class="bd-flow" viewBox="0 0 1010 300" role="img" aria-label={f.label}>
    <path class="ed dash" id="tf-p1" d="M220 150 L300 150"></path>
    <path class="ed" id="tf-p2" d="M520 150 C560 150 550 60 590 60"></path>
    <path class="ed" id="tf-p3" d="M520 150 C560 150 550 240 590 240"></path>
    <path class="ed" id="tf-p4" d="M810 60 C830 60 815 150 835 150"></path>
    <path class="ed" id="tf-p5" d="M810 240 C830 240 815 150 835 150"></path>
    <text class="el" x="260" y="136" text-anchor="middle">{f.proposes}</text>
    <text class="el el-gap" x="556" y="154" text-anchor="middle">{f.decides}</text>

    <g class="nd dash" id="tf-a">
      <rect x="20" y="118" width="200" height="64"></rect>
      <text class="t" x="34" y="145">{N.ai[0]}</text>
      <text class="s" x="34" y="166">{N.ai[1]}</text>
    </g>
    <g class="nd" id="tf-b">
      <rect x="300" y="118" width="220" height="64"></rect>
      <text class="t" x="314" y="145">{N.det[0]}</text>
      <text class="s" x="314" y="166">{N.det[1]}</text>
    </g>
    <g class="nd" id="tf-us">
      <rect x="590" y="28" width="220" height="64"></rect>
      <text class="t" x="604" y="55">{N.us[0]}</text>
      <text class="s" x="604" y="76">{N.us[1]}</text>
    </g>
    <g class="nd" id="tf-in">
      <rect x="590" y="208" width="220" height="64"></rect>
      <text class="t" x="604" y="235">{N.india[0]}</text>
      <text class="s" x="604" y="256">{N.india[1]}</text>
    </g>
    <g class="nd" id="tf-log">
      <rect x="835" y="118" width="165" height="64"></rect>
      <text class="t" x="849" y="145">{N.log[0]}</text>
      <text class="s" x="849" y="166">{N.log[1]}</text>
      <line class="logl" x1="958" x2="986" y1="132" y2="132"></line>
      <line class="logl" x1="958" x2="986" y1="137" y2="137"></line>
      <line class="logl" x1="958" x2="986" y1="142" y2="142"></line>
      <line class="logl" x1="958" x2="986" y1="147" y2="147"></line>
    </g>
    <g class="ks" id="tf-ks-us"><rect x="590" y="96" width="220" height="4"></rect><text x="590" y="112">{f.kill}</text></g>
    <g class="ks" id="tf-ks-in"><rect x="590" y="200" width="220" height="4"></rect><text x="590" y="194">{f.kill}</text></g>
    <text class="tick" id="tf-t-us" x="796" y="48" text-anchor="end">{f.tickUs}</text>
    <text class="tick" id="tf-t-in" x="796" y="228" text-anchor="end">{f.tickIn}</text>
    <text class="stop" id="tf-stop" x="555" y="290" text-anchor="middle">{f.stop}</text>
    <rect class="tok" id="tf-tok" x="-5" y="-5" width="10" height="10" opacity="0"></rect>
  </svg>
  <ol class="bd-flow-list">
    {builds.tradeframeFlow.steps.map((st) => (
      <li class:list={['bd-fl-node', st.propose && 'is-propose']}><span class="bd-fl-n">{st.n}</span><b>{st.name}</b><span>{st.text}</span></li>
    ))}
    {builds.tradeframeFlow.base.map((b) => (
      <li class="bd-fl-node is-base"><b>{b.name}</b><span>{b.text}</span></li>
    ))}
  </ol>
  <ol class="bd-steps" aria-label={f.stepsLabel}>
    {builds.tradeframeFlow.stepLabels.map((s, i) => <li data-tf-step={i + 1}><b>{i + 1}</b>{s}</li>)}
  </ol>
  <p class="bd-flowcap"><span class="fno">{f.figNo}</span>{builds.tradeframeFlow.title}</p>
</div>

<style>
  .bd-flow-list {
    display: none;
  }


  .bd-flow-wrap {
    overflow-x: auto;
    margin-top: 26px;
    border: var(--line-hair);
    background: var(--color-surface-sunk);
  }

  .bd-flow {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
  }

  .nd rect {
    fill: var(--color-surface);
    stroke: var(--color-line-strong);
    stroke-width: 1.2;
    transition: stroke 0.35s var(--ease-out);
  }

  .nd.dash rect {
    stroke-dasharray: 5 5;
  }

  .nd.hot rect {
    stroke: var(--color-accent);
  }

  .nd .t {
    font: 600 15px var(--font-text);
    fill: var(--color-text);
    font-variation-settings: 'wdth' 88, 'wght' 720;
  }

  .nd .s {
    font: 400 11px var(--font-data);
    fill: var(--color-text-muted);
  }

  .ed {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 1.5;
  }

  .ed.dash {
    stroke-dasharray: 5 5;
  }

  .ed.on {
    stroke: var(--color-text-body);
  }

  .el {
    font: 500 10.5px var(--font-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--color-text-muted);
  }

  .el-gap {
    paint-order: stroke;
    stroke: var(--color-surface-sunk);
    stroke-width: 6px;
  }

  .ks rect {
    fill: var(--color-accent);
    opacity: 0.22;
    transition: opacity 0.3s var(--ease-out);
  }

  .ks.on rect {
    opacity: 1;
  }

  .ks text {
    font: 500 9.5px var(--font-data);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-accent);
  }

  .tok {
    fill: var(--color-text-muted);
  }

  .tok.ok {
    fill: var(--color-text);
  }

  .tick {
    font: 500 11px var(--font-data);
    fill: var(--color-accent);
    opacity: 0;
  }

  .logl {
    stroke: var(--color-text-body);
    stroke-width: 2;
    opacity: 0;
  }

  .stop {
    font: 500 10.5px var(--font-data);
    letter-spacing: 0.06em;
    fill: var(--color-accent);
    opacity: 0;
  }

  .bd-steps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: var(--line-hair);
  }

  .bd-steps li {
    flex: 1 1 140px;
    padding: 10px 14px 11px 0;
    font: 500 var(--t-label) / var(--lh-label) var(--font-data);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    position: relative;
    transition: color 0.35s var(--ease-out);
  }

  .bd-steps li b {
    color: var(--color-accent);
    font-weight: 500;
    margin-right: 8px;
  }

  .bd-steps li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 14px;
    top: -1px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }

  .bd-steps li.on {
    color: var(--color-text);
  }

  .bd-steps li.on::before {
    transform: scaleX(1);
  }

  .bd-flowcap {
    padding: 10px 14px 12px;
    border-top: var(--line-hair);
    font: 400 var(--t-note) / var(--lh-base) var(--font-data);
    color: var(--color-text-body);
  }

  .bd-flowcap .fno {
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-right: 12px;
  }
  @media (max-width: 599px) {
    .bd-flow,
    .bd-steps {
      display: none;
    }
    .bd-flow-wrap {
      border: 0;
      background: none;
    }
    .bd-flow-list {
      display: grid;
      gap: var(--s-2);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .bd-fl-node {
      display: grid;
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 2px var(--s-2);
      padding: var(--s-3) var(--s-3);
      border: var(--line-object);
      background: var(--color-surface-sunk);
    }
    .bd-fl-node.is-propose {
      border: var(--line-propose);
    }
    .bd-fl-node.is-base {
      grid-template-columns: minmax(0, 1fr);
      border: var(--line-hair);
    }
    .bd-fl-n {
      grid-row: span 2;
      font: 500 var(--t-label-lg) / var(--lh-label) var(--font-data);
      color: var(--color-accent-text);
    }
    .bd-fl-node b {
      font-size: var(--t-small);
      font-weight: 600;
      color: var(--color-text);
    }
    .bd-fl-node span:last-child {
      font: 400 var(--t-label-lg) / var(--lh-snug) var(--font-data);
      color: var(--color-text-muted);
    }
  }
</style>

<script>
  import { $, $$, motion } from '../scripts/ds';

  for (const wrap of $$<HTMLElement>('[data-tf-flow]')) {
    const svg = $<SVGSVGElement>('.bd-flow', wrap)!;
    const g = (id: string) => $<SVGGeometryElement>('#' + id, svg)!;
    const tok = g('tf-tok');
    const P = { p1: g('tf-p1'), p2: g('tf-p2'), p3: g('tf-p3'), p4: g('tf-p4'), p5: g('tf-p5') } as Record<string, SVGGeometryElement>;
    const [nA, nB, nUS, nIN, nLOG] = ['tf-a', 'tf-b', 'tf-us', 'tf-in', 'tf-log'].map(g);
    const ksUS = g('tf-ks-us');
    const ksIN = g('tf-ks-in');
    const tUS = g('tf-t-us');
    const tIN = g('tf-t-in');
    const stop = g('tf-stop');
    const logs = $$<SVGElement>('.logl', svg);
    const steps = $$<HTMLElement>('.bd-steps li', wrap);
    const L: Record<string, number> = {};
    Object.keys(P).forEach((k) => (L[k] = P[k].getTotalLength()));

    const step = (n: number) => steps.forEach((s) => s.classList.toggle('on', n > 0 && Number(s.dataset.tfStep) <= n));
    const reset = () => {
      [nA, nB, nUS, nIN, nLOG].forEach((n) => n.classList.remove('hot'));
      [P.p2, P.p3, P.p4, P.p5].forEach((p) => p.classList.remove('on'));
      ksUS.classList.remove('on');
      ksIN.classList.remove('on');
      tUS.style.opacity = '0';
      tIN.style.opacity = '0';
      stop.style.opacity = '0';
      tok.classList.remove('ok');
    };

    // Reduced motion: the finished path, every step lit.
    if (!motion()) {
      reset();
      [P.p2, P.p3, P.p4, P.p5].forEach((p) => p.classList.add('on'));
      steps.forEach((s) => s.classList.add('on'));
      continue;
    }

    // Timeline (s): 0-.9 propose · .9-1.5 validate · 1.5-2.4 to the book · 2.4-3.0 confirm · 3.0-3.8 to the log · 3.8-4.4 rest
    const T = 4.4;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const at = (p: string, u: number) => {
      const pt = P[p].getPointAtLength(L[p] * u);
      tok.setAttribute('x', String(pt.x - 5));
      tok.setAttribute('y', String(pt.y - 5));
    };
    let running = false;
    let visible = false;
    let raf = 0;
    let t0 = 0;
    let cycle = 0;
    let logN = 0;
    let last = -1;

    const frame = (now: number) => {
      if (!running) return;
      if (!t0) t0 = now;
      let s = (now - t0) / 1000;
      if (s >= T) {
        t0 = now;
        s = 0;
        cycle++;
      }
      const us = cycle % 2 === 0;
      const kill = cycle % 3 === 2;
      const phase = s < 0.9 ? 0 : s < 1.5 ? 1 : s < 2.4 ? 2 : s < 3.0 ? 3 : s < 3.8 ? 4 : 5;
      if (phase !== last) {
        if (phase === 0) {
          reset();
          step(1);
          nA.classList.add('hot');
          tok.setAttribute('opacity', '1');
        }
        if (phase === 1) {
          nA.classList.remove('hot');
          nB.classList.add('hot');
          step(2);
        }
        if (phase === 2) {
          tok.classList.add('ok');
          nB.classList.remove('hot');
          (us ? P.p2 : P.p3).classList.add('on');
        }
        if (phase === 3) {
          if (kill) {
            (us ? ksUS : ksIN).classList.add('on');
            stop.style.opacity = '1';
            tok.setAttribute('opacity', '0');
          } else {
            step(3);
            (us ? nUS : nIN).classList.add('hot');
            (us ? tUS : tIN).style.opacity = '1';
          }
        }
        if (phase === 4 && !kill) {
          (us ? nUS : nIN).classList.remove('hot');
          (us ? P.p4 : P.p5).classList.add('on');
          step(4);
        }
        if (phase === 5) {
          if (!kill) {
            nLOG.classList.add('hot');
            logs[logN % logs.length].style.opacity = '1';
            logN++;
            if (logN % logs.length === 0) setTimeout(() => logs.forEach((l) => (l.style.opacity = '0')), 500);
          }
          tok.setAttribute('opacity', '0');
        }
        last = phase;
      }
      if (phase === 0) at('p1', ease(s / 0.9));
      else if (phase === 1) at('p1', 1);
      else if (phase === 2) at(us ? 'p2' : 'p3', ease((s - 1.5) / 0.9) * (kill ? 0.8 : 1));
      else if (phase === 4 && !kill) at(us ? 'p4' : 'p5', ease((s - 3.0) / 0.8));
      raf = requestAnimationFrame(frame);
    };

    const sync = () => {
      const want = visible && !document.hidden;
      if (want && !running) {
        running = true;
        t0 = 0;
        last = -1;
        raf = requestAnimationFrame(frame);
      } else if (!want && running) {
        running = false;
        cancelAnimationFrame(raf);
        reset();
        step(0);
      }
    };

    // A closed ledger row is display:none, so the figure is not intersecting and the loop rests.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
        sync();
      }, { threshold: 0.15 }).observe(svg);
    } else {
      visible = true;
    }
    document.addEventListener('visibilitychange', sync);
  }
</script>

---
// Unit chart: one square per case, filled when the thing being counted
// happened. "3 of 40" is easier to feel as 3 filled squares in a field of 40
// than as a percentage. The squares are decoration (aria-hidden); the row's
// visible text carries the numbers, so screen readers get them too.
interface Row {
  label: string;
  filled: number;
  of: number;
  /** Visible value, e.g. "3 of 40 · 8%". */
  text: string;
  /** Colour of this row's filled squares: ink (default) or red when the count is a failure or the series under test. */
  tone?: 'ink' | 'red';
}

interface Props {
  rows: Row[];
  /** Squares per line. */
  cols: number;
  /** What a filled square means, shown as the key. */
  filledMeans: string;
  emptyMeans: string;
  /** Draw the empty squares in red outline: the thing being counted is the ones that stayed empty (a failure). */
  emptyTone?: 'ink' | 'red';
}

const { rows, cols, filledMeans, emptyMeans, emptyTone = 'ink' } = Astro.props;
const keyRed = rows.length > 0 && rows.every((r) => r.tone === 'red');
---

<div class:list={['uc', { 'uc--empty-red': emptyTone === 'red' }]} data-fig="units" style={`--cols:${cols}`}>
  {
    rows.map((r, row) => (
      <div class:list={['uc-row', { 'is-red': r.tone === 'red' }]} style={`--row:${row}`}>
        <p class="uc-head">
          <span class="uc-label">{r.label}</span>
          <span class="uc-value tabular">{r.text}</span>
        </p>
        <div class="uc-cells" aria-hidden="true">
          {Array.from({ length: r.of }, (_, i) => (
            <span class:list={['uc-cell', { on: i < r.filled }]} style={`--i:${i}`} />
          ))}
        </div>
      </div>
    ))
  }
  <p class="uc-key">
    <span class:list={['uc-key-item', { 'is-red': keyRed }]}><span class="uc-cell on uc-key-cell" aria-hidden="true"></span>{filledMeans}</span>
    <span class="uc-key-item"><span class="uc-cell uc-key-cell" aria-hidden="true"></span>{emptyMeans}</span>
  </p>
</div>

<script>
  import { mountFigures } from '../scripts/figure-motion';
  mountFigures('[data-fig="units"]');
</script>

<style>
  .uc-row + .uc-row {
    margin-top: var(--s-5);
  }

  .uc-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    margin-bottom: var(--s-2);
    font-family: var(--font-data);
    font-size: var(--t-data);
    color: var(--color-text-body);
  }

  .uc-value {
    color: var(--color-text);
  }

  /* Columns shrink with the container, so the field never overflows on a phone. */
  .uc-cells {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, var(--s-4)));
    gap: var(--s-1);
  }

  .uc-cell {
    aspect-ratio: 1;
    border: var(--line-strong);
    background: transparent;
  }

  .uc--empty-red .uc-cell:not(.on) {
    border-color: var(--color-accent);
  }

  .uc-cell.on {
    border-color: var(--color-text);
    background: var(--color-text);
    transition: opacity var(--dur-base) ease;
    transition-delay: calc(var(--row, 0) * 160ms + var(--i, 0) * 14ms);
  }

  .uc-row.is-red .uc-cell.on,
  .uc-key-item.is-red .uc-cell.on {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  /* Start frame: the counted squares are held back, then fade in once. */
  .uc[data-state='pre'] .uc-cells .uc-cell.on {
    opacity: 0;
    transition: none;
  }

  .uc-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
    font-family: var(--font-data);
    font-size: var(--t-label);
    color: var(--color-text-muted);
  }

  .uc-key-item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .uc-key-cell {
    flex: none;
    inline-size: var(--s-3);
    block-size: var(--s-3);
    aspect-ratio: auto;
  }
</style>

---
import Button from './Button.astro';

interface Props {
  marginLines: string[];
  body: string;
  buttonLabel: string;
  buttonHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { marginLines, body, buttonLabel, buttonHref, secondaryLabel, secondaryHref } = Astro.props;
---

<div class="cta-slab">
  <div class="slab-inner">
    <aside class="margin-col">
      {marginLines.map((line) => <p>{line}</p>)}
    </aside>
    <div class="body-col">
      <p class="slab-body">{body}</p>
      <div class="slab-actions">
        <Button href={buttonHref} variant="inverse">{buttonLabel}</Button>
        {secondaryLabel && secondaryHref && (
          <Button href={secondaryHref} variant="inverse">{secondaryLabel}</Button>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .cta-slab {
    background: var(--red);
  }

  .slab-inner {
    display: grid;
    grid-template-columns: var(--margin-col) 1fr;
  }

  .margin-col {
    padding: var(--s-9) var(--s-5) var(--s-9) var(--gutter);
  }

  .margin-col p {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--on-red-muted);
    line-height: 1.7;
  }

  .body-col {
    padding: var(--s-9) var(--gutter) var(--s-9) var(--body-inset);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-7);
  }

  .slab-body {
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1.15;
    color: var(--on-red);
    max-width: 26ch;
  }

  .slab-actions {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  @media (max-width: 899px) {
    .slab-inner {
      grid-template-columns: 1fr;
    }

    .margin-col {
      padding: var(--s-6) var(--gutter);
    }

    .body-col {
      padding: var(--s-7) var(--gutter);
      flex-direction: column;
      align-items: flex-start;
    }

    .slab-body {
      font-size: clamp(26px, 6vw, 34px);
    }
  }

  @media (max-width: 599px) {
    .slab-actions {
      width: 100%;
    }

    .slab-actions :global(.rp-button) {
      width: 100%;
      min-height: 48px;
    }
  }
</style>

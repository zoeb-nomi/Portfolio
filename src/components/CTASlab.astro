---
// The closing call to action (kit: `.sec` + kicker, h2, a `.ctas` row with one `.btn` and text links).
// Props are the old slab's: `marginLines` is accepted and not drawn (the kicker is the contact label), `body` is the
// heading, `buttonLabel`/`buttonHref` the one red button, `secondaryLabel`/`secondaryHref` a text link, and `buttonNote`
// a mono line under the row (default "30 min · intro call" for Book a call). `links` adds more text links.
import Button from './Button.astro';
import { cta, pipelineWriting } from '../data/copy';

interface Props {
  marginLines?: string[];
  body: string;
  buttonLabel: string;
  buttonHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Mono line under the button; defaults to "30 min · intro call" for Book a call. */
  buttonNote?: string | null;
  /** More text links after the secondary one (LinkedIn, GitHub, X). */
  links?: { label: string; href: string }[];
  /** The small label above the heading. */
  kicker?: string;
}

const { body, buttonLabel, buttonHref, secondaryLabel, secondaryHref, links = [], kicker = pipelineWriting.contact.kick } = Astro.props;
const buttonNote =
  Astro.props.buttonNote === undefined ? (buttonHref === cta.bookACall.href ? cta.bookACallNote : null) : Astro.props.buttonNote;
---

<section class="sec gut" data-cta>
  <div class="in">
    <p class="kick">{kicker}</p>
    <h2 class="h2">{body}</h2>
    <div class="ctas cta-row">
      <Button href={buttonHref} variant="primary">{buttonLabel}</Button>
      {secondaryLabel && secondaryHref && <Button href={secondaryHref} variant="link">{secondaryLabel}</Button>}
      {links.map((l) => <Button href={l.href} variant="link">{l.label}</Button>)}
    </div>
    {buttonNote && <p class="lab cta-note">{buttonNote}</p>}
  </div>
</section>

<style>
  .cta-row {
    margin-top: var(--s-7);
  }

  .cta-note {
    margin-top: var(--s-3);
  }
</style>

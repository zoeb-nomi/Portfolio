---
import Button from './Button.astro';
import { cta } from '../data/copy';

interface Props {
  marginLines: string[];
  body: string;
  buttonLabel: string;
  buttonHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Mono line under the button; defaults to "30 min · intro call" for Book a call. */
  buttonNote?: string | null;
}

const { marginLines, body, buttonLabel, buttonHref, secondaryLabel, secondaryHref } = Astro.props;
const buttonNote =
  Astro.props.buttonNote === undefined ? (buttonHref === cta.bookACall.href ? cta.bookACallNote : null) : Astro.props.buttonNote;
---

<div class="cta-slab">
  <div class="slab-inner grid-margin">
    <div class="margin-col">
      {marginLines.map((line) => <p>{line}</p>)}
    </div>
    <div class="body-col">
      <p class="slab-body">{body}</p>
      <div class="slab-actions">
        <div class="slab-btns">
          <Button href={buttonHref} variant="inverse">{buttonLabel}</Button>
          {secondaryLabel && secondaryHref && (
            <Button href={secondaryHref} variant="inverse">{secondaryLabel}</Button>
          )}
        </div>
        {buttonNote && <p class="slab-note">{buttonNote}</p>}
      </div>
    </div>
  </div>
</div>

<style>
  .cta-slab {
    background: var(--red);
  }

  /* The slab draws no column rule. */
  .margin-col {
    border: 0;
  }

  .margin-col p {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--on-red-muted);
    line-height: var(--lh-label);
  }

  .body-col {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-7);
  }

  .slab-body {
    font-family: var(--font-display);
    font-size: var(--t-slab);
    line-height: var(--lh-heading);
    color: var(--on-red);
    max-width: 26ch;
  }

  .slab-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
  }

  .slab-btns {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .slab-note {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--on-red-muted);
  }

  @media (max-width: 899px) {
    .body-col {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 599px) {
    .slab-actions,
    .slab-btns {
      width: 100%;
    }

    .slab-actions :global(.rp-button) {
      width: 100%;
      min-height: 48px;
    }
  }
</style>

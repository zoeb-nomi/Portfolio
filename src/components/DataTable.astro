---
// A data table in the kit's booktabs style (`.tbl`: a 2px ink rule top and bottom, a 1px rule under the head).
// A column whose every cell reads as a number (23, 0.894, 87 of 100, 83.2%, +0.07) is set as a numeric column:
// right-aligned, in the mono face. Pass `numeric` to say which data columns are numeric when that guess is wrong.
// Wide tables scroll sideways inside their own box; pass `stack` to stack the rows into label and value pairs
// at 599px and below instead.
interface Cell {
  text: string;
  win?: boolean;
}

interface Row {
  label: string;
  cells: Cell[];
}

interface Props {
  caption: string;
  columns: string[]; // first column header is the row-label header
  rows: Row[];
  /** Kept for old call sites: cells never break mid-token in the kit table. */
  nowrap?: boolean;
  /** At 599px and below the table stacks into label/value rows instead of scrolling. */
  stack?: boolean;
  /** Per data column (not counting the label column): true = numeric. Default: guessed from the cells. */
  numeric?: boolean[];
  /** Set the last row as a total (heavier text). */
  totalRow?: boolean;
}

const { caption, columns, rows, stack = false, numeric, totalRow = false } = Astro.props;
const [labelHeader, ...dataHeaders] = columns;

const NUM = /^[~+\-\u2212\u2013]?[$₹]?\d[\d,]*(?:\.\d+)?\s*(?:%|×|x|ms|s|pp|pts?|points?|cents?|k|M)?(?:\s*(?:of|to|vs|→|·|\/|\u2013|-)\s*[~+\-\u2212\u2013]?[$₹]?\d[\d,]*(?:\.\d+)?\s*(?:%|×|x|ms|s|pp|pts?|points?|cents?|k|M)?)*$/i;
const isNum = (t: string) => NUM.test(t.trim());
const numCols = dataHeaders.map((_, i) => numeric?.[i] ?? (rows.length > 0 && rows.every((r) => r.cells[i] && isNum(r.cells[i].text))));
---

<div class:list={['tbl-wrap', 'dt', { 'dt--stack': stack }]} tabindex="0" role="region" aria-label={caption}>
  <table class="tbl">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{labelHeader}</th>
        {dataHeaders.map((h, i) => <th scope="col" class:list={[{ n: numCols[i] }]}>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, r) => (
          <tr class:list={[{ 'dt-total': totalRow && r === rows.length - 1 }]}>
            <th scope="row">{row.label}</th>
            {row.cells.map((cell, i) => (
              <td class:list={[{ n: numCols[i], win: cell.win }]} data-l={dataHeaders[i]}>{cell.text}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* A row label is a header cell for assistive tech and reads like the kit's first column. */
  .tbl tbody th {
    padding: 11px 14px 11px 0;
    border-bottom: var(--line-hair);
    font-size: var(--t-small);
    font-weight: normal;
    text-align: left;
    color: var(--color-text);
    vertical-align: baseline;
  }

  .tbl tbody tr:last-child th {
    border-bottom: var(--line-heavy);
  }

  /* A text column that follows a number gets breathing room. */
  .tbl :global(td.n + td:not(.n)),
  .tbl :global(th.n + th:not(.n)) {
    padding-left: 28px;
  }

  .dt-total th,
  .dt-total td {
    color: var(--color-text);
    font-variation-settings: 'wght' 640;
  }

  .dt-total td.n {
    font-weight: 500;
  }

  .tbl td.win {
    color: var(--color-accent);
  }

  @media (max-width: 599px) {
    .dt--stack .tbl {
      min-width: 0;
    }

    .dt--stack .tbl thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .dt--stack .tbl,
    .dt--stack .tbl tbody,
    .dt--stack .tbl tr,
    .dt--stack .tbl tbody th,
    .dt--stack .tbl td {
      display: block;
    }

    .dt--stack .tbl tr {
      padding-block: var(--s-3);
      border-bottom: var(--line-hair);
    }

    .dt--stack .tbl tbody th,
    .dt--stack .tbl td {
      padding: var(--s-1) 0;
      border: 0;
    }

    .dt--stack .tbl td {
      display: flex;
      justify-content: space-between;
      gap: var(--s-4);
      text-align: right;
    }

    .dt--stack .tbl td::before {
      content: attr(data-l);
      text-align: left;
      color: var(--color-text-muted);
    }
  }
</style>

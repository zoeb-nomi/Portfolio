---
interface Cell {
  text: string;
  win?: boolean;
}

interface Row {
  label: string;
  cells: Cell[];
}

interface Props {
  caption: string;
  columns: string[]; // first column header is the row-label header
  rows: Row[];
  // Keep every data cell on one line (numbers, ids, ranges: "claude-haiku-4-5", "-3.05 to +2.76").
  // Wide tables then scroll sideways instead of breaking a value mid-token. Leave off for prose cells.
  nowrap?: boolean;
}

const { caption, columns, rows, nowrap = false } = Astro.props;
const [labelHeader, ...dataHeaders] = columns;
---

<div class="data-table-scroll">
{/* The visible caption sits outside the scroller so it is as wide as the visible
    box (not the whole table) and can leave room for the "scroll" hint beside it.
    The <caption> inside the table stays, visually hidden, for assistive tech. */}
<p class="dt-caption" aria-hidden="true">{caption}</p>
<div class="data-table-wrap" tabindex="0" role="region" aria-label={caption} data-label={caption}>
<table class:list={['data-table', { 'data-table--nowrap': nowrap }]}>
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">{labelHeader}</th>
      {dataHeaders.map((h) => <th scope="col">{h}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {row.cells.map((cell) => (
            <td class:list={[{ win: cell.win }]}>{cell.text}</td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>
</div>
<span class="scroll-hint" aria-hidden="true">scroll &rarr;</span>
</div>

<style>
  /* Wide tables (5-7 columns) scroll sideways inside their own box on narrow
     screens instead of squeezing headers into each other. */
  .data-table-scroll {
    position: relative;
    /* The wrap's inline padding keeps the focus ring off the first glyphs;
       the matching negative margin keeps the table aligned to the column. */
    margin-inline: calc(-1 * var(--s-1));
    timeline-scope: --dt-x;
  }

  .data-table-wrap {
    overflow-x: auto;
    max-width: 100%;
    padding-inline: var(--s-1);
    scroll-timeline: --dt-x inline;
  }

  /* Sideways-scroll cue: a paper fade on the right edge + a "scroll ->" note.
     Both are driven by the wrap's own scroll position, so they exist only while
     the table overflows and fade out at the far end. Hidden by default, so
     browsers without scroll-driven animations simply show no cue. */
  .data-table-scroll::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--s-8);
    background: linear-gradient(to left, var(--paper), transparent);
    pointer-events: none;
    opacity: 0;
  }

  .scroll-hint {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    line-height: 1;
    color: var(--ink-muted);
    pointer-events: none;
    opacity: 0;
    z-index: 1; /* above the edge fade */
  }

  @supports (animation-timeline: --dt-x) {
    .data-table-scroll::after,
    .scroll-hint {
      animation: dt-cue linear both;
      animation-timeline: --dt-x;
      animation-range: calc(100% - var(--s-6)) 100%;
    }
  }

  @keyframes dt-cue {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .data-table {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--t-data);
  }

  .dt-caption {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-bottom: var(--s-3);
    /* Matches the wrap's inline padding so the caption stays aligned with the table. */
    padding-inline: var(--s-1);
    /* Room for the "scroll" hint at the block's top-right (it is absolutely
       positioned): a long caption wraps before it rather than printing under it. */
    padding-inline-end: var(--s-12);
  }

  .data-table th,
  .data-table td {
    padding-block: var(--s-3);
    padding-inline-start: var(--s-4);
    text-align: right;
    font-weight: 400;
    vertical-align: baseline;
  }

  /* Headers may wrap between words but never mid-word; the inline gap above
     keeps neighbouring right-aligned headers ("BASELINE" | "STRICT") apart. */
  .data-table thead th {
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .data-table th[scope='col']:first-child,
  .data-table th[scope='row'] {
    padding-inline-start: 0;
  }

  @media (max-width: 599px) {
    .data-table thead th {
      letter-spacing: var(--track-wide);
    }
  }

  .data-table thead th {
    border-bottom: 1px solid var(--rule-strong);
    font-size: var(--t-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .data-table th[scope='col']:first-child,
  .data-table th[scope='row'] {
    text-align: left;
  }

  .data-table th[scope='row'] {
    color: var(--ink-body);
  }

  .data-table tbody tr {
    border-bottom: 1px solid var(--rule);
    transition: background-color var(--dur-fast) var(--ease-draw);
  }

  .data-table tbody tr:hover {
    background: var(--paper-raised);
  }

  .data-table td {
    color: var(--ink-muted);
  }

  .data-table--nowrap td {
    white-space: nowrap;
  }

  /* On narrow screens a scrolling table keeps its row label in view (the first column is a row
     header, so the reader never loses which row a number belongs to). */
  @media (max-width: 899px) {
    .data-table th[scope='row'] {
      position: sticky;
      inset-inline-start: 0;
      z-index: 1;
      background: var(--paper);
      padding-inline-end: var(--s-3);
    }

    .data-table tbody tr:hover th[scope='row'] {
      background: var(--paper-raised);
    }
  }

  .data-table td.win {
    color: var(--red-ink);
    font-weight: 500;
  }

  .data-table td:last-child,
  .data-table th[scope='col']:last-child {
    color: var(--ink);
  }

  .data-table td.win:last-child {
    color: var(--red-ink);
  }
</style>

<script>
  // A scroll region is a tab stop and a landmark only while it actually scrolls. Without
  // overflow it is just a table: no extra Tab stop, no extra region to announce. (With
  // JavaScript off the attributes stay, which is the safe default.)
  const wraps = document.querySelectorAll<HTMLElement>('.data-table-wrap');
  function sync(w: HTMLElement) {
    if (w.scrollWidth > w.clientWidth + 1) {
      w.setAttribute('tabindex', '0');
      w.setAttribute('role', 'region');
      w.setAttribute('aria-label', w.dataset.label ?? '');
    } else {
      w.removeAttribute('tabindex');
      w.removeAttribute('role');
      w.removeAttribute('aria-label');
    }
  }
  const ro = new ResizeObserver((entries) => entries.forEach((e) => sync(e.target as HTMLElement)));
  wraps.forEach((w) => {
    sync(w);
    ro.observe(w);
    const t = w.querySelector('table');
    if (t) ro.observe(t);
  });
</script>

---
// The About record as a vertical timeline, newest first. A spine runs down the left and fills as you read. Each
// row has a marker (hollow until you pass it, red while it is the row you are reading) and a bar drawn to the year
// scale, so you can see how long each role or course ran and where they overlap. All of the text is always on
// the page; the motion only adds the reading progress and the bars drawing in. A row with a source link shows it,
// and a row without one shows nothing: a row with no link is a claim taken on trust, and the page does not
// imply otherwise.
import { n2 } from '../lib/pct';

interface Item {
  year: string;
  body: string;
  source: { label: string; href: string } | null;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

// "2019" is the year 2019; "2021–2022" runs to the end of 2022; "2025–present" runs to today.
const today = new Date();
const now = today.getUTCFullYear() + today.getUTCMonth() / 12;
const span = (year: string): [number, number] => {
  const m = /^(\d{4})(?:\s*[–-]\s*(\d{4}|present))?$/.exec(year.trim());
  if (!m) throw new Error(`CareerTimeline: could not read the years in "${year}"`);
  const a = Number(m[1]);
  return [a, m[2] === 'present' ? now : m[2] ? Number(m[2]) + 1 : a + 1];
};

const spans = items.map((i) => span(i.year));
const first = Math.min(...spans.map((s) => s[0]));
const last = Math.ceil(Math.max(...spans.map((s) => s[1])));
const pct = (y: number) => n2(((y - first) / (last - first)) * 100);
// A year tick that would sit under the "now" label is left out.
const ticks = Array.from({ length: Math.floor((last - first) / 2) + 1 }, (_, i) => first + i * 2).filter(
  (y) => y < last && pct(now) - pct(y) > 24,
);
const rows = items
  .map((item, i) => ({ item, left: pct(spans[i][0]), width: n2(pct(spans[i][1]) - pct(spans[i][0])), start: spans[i][0] }))
  .sort((a, b) => b.start - a.start);
---

<div class="tl" data-tl>
  <div class="tl-axis" aria-hidden="true">
    <p class="tl-key">Bars show when, to the year.</p>
    <div class="tl-ticks">
      {ticks.map((y) => <span style={`--x:${pct(y)}`}>{y}</span>)}
      <span class="tl-now" style={`--x:${pct(now)}`}>now</span>
    </div>
  </div>
  <ol class="tl-list">
    {
      rows.map(({ item, left, width }) => (
        <li class="tl-item">
          <span class="tl-mark" aria-hidden="true"></span>
          <p class="tl-year">{item.year}</p>
          <div class="tl-body">
            <p class="tl-text">{item.body}</p>
            {
              item.source && (
                <p class="tl-source">
                  <a href={item.source.href} target="_blank" rel="noopener noreferrer">{item.source.label}</a>
                </p>
              )
            }
          </div>
          <span class="tl-span" aria-hidden="true"><i style={`--l:${left};--w:${width}`}></i></span>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { motionAllowed } from '../scripts/figure-motion';

  if (motionAllowed()) {
    document.querySelectorAll<HTMLElement>('[data-tl]').forEach((root) => {
      const list = root.querySelector<HTMLElement>('.tl-list')!;
      const items = Array.from(list.querySelectorAll<HTMLElement>('.tl-item'));
      root.dataset.live = '';
      let queued = false;

      const update = () => {
        queued = false;
        const mid = window.innerHeight * 0.5;
        const box = list.getBoundingClientRect();
        list.style.setProperty('--p', String(Math.min(1, Math.max(0, (mid - box.top) / box.height))));
        items.forEach((li) => {
          const r = li.getBoundingClientRect();
          li.classList.toggle('is-passed', r.top + 20 < mid);
          li.classList.toggle('is-now', r.top <= mid && r.bottom > mid);
        });
      };
      const queue = () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);

      // Each row's bar draws in the first time the row is on screen.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-drawn');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.4 },
      );
      items.forEach((li) => io.observe(li));
      update();
    });
  }
</script>

<style>
  .tl {
    --tl-mark: var(--s-5);
    margin-block: var(--s-9);
  }

  .tl-axis,
  .tl-item {
    display: grid;
    grid-template-columns: var(--tl-mark) 8.5rem minmax(0, 1fr) 11rem;
    column-gap: var(--s-5);
  }

  .tl-axis {
    align-items: end;
    padding-bottom: var(--s-3);
  }

  .tl-key {
    grid-column: 2 / 4;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-muted);
  }

  .tl-ticks {
    position: relative;
    grid-column: 4;
    block-size: var(--s-5);
    margin-inline: 0;
  }

  .tl-ticks span {
    position: absolute;
    inset-inline-start: calc(var(--x) * 1%);
    inset-block-start: 0;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .tl-ticks .tl-now {
    transform: translateX(-100%);
    color: var(--red-ink);
  }

  .tl-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    --p: 1;
  }

  /* The spine: a hairline for the whole record, and a red line that fills down it as you read. */
  .tl-list::before,
  .tl-list::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--tl-mark) / 2);
    border-inline-start: 1px solid var(--rule);
  }

  .tl-list::after {
    border-inline-start: 2px solid var(--red);
    margin-inline-start: -1px;
    transform-origin: top;
    transform: scaleY(var(--p));
  }

  .tl-item {
    position: relative;
    align-items: baseline;
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--rule);
  }

  .tl-item:first-child {
    border-block-start: 0;
  }

  .tl-mark {
    position: relative;
    z-index: 1;
    inline-size: var(--s-3);
    block-size: var(--s-3);
    margin-inline-start: calc((var(--tl-mark) - var(--s-3)) / 2);
    border: 1px solid var(--ink);
    background: var(--ink);
    transform: translateY(var(--s-1));
    transition: background var(--dur-base) ease;
  }

  .tl-year {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .tl-text {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--ink-body);
  }

  .tl-source {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    overflow-wrap: anywhere;
  }

  .tl-source a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* The year bar: a hairline track with the span drawn on it, to the same scale as the axis above. */
  .tl-span {
    position: relative;
    block-size: var(--s-2);
    border-block-end: 1px solid var(--rule);
    align-self: center;
  }

  .tl-span i {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--l) * 1%);
    inline-size: calc(var(--w) * 1%);
    background: var(--ink);
    transform-origin: left;
    transition: transform 700ms var(--ease-draw), background var(--dur-base) ease;
  }

  /* While the page is live, a marker is hollow until you pass it, and red while you are reading its row. */
  .tl[data-live] .tl-mark {
    background: var(--paper);
  }

  .tl[data-live] .tl-item.is-passed .tl-mark {
    background: var(--ink);
  }

  .tl[data-live] .tl-item.is-now .tl-mark {
    border: 0;
    background: var(--red);
  }

  .tl[data-live] .tl-item.is-now .tl-text {
    color: var(--ink);
  }

  .tl[data-live] .tl-item.is-now .tl-span i {
    background: var(--red);
  }

  .tl[data-live] .tl-item:not(.is-drawn) .tl-span i {
    transform: scaleX(0);
  }

  @media (max-width: 899px) {
    .tl-axis,
    .tl-item {
      grid-template-columns: var(--tl-mark) minmax(0, 1fr);
      column-gap: var(--s-4);
    }

    .tl-key {
      grid-column: 2;
    }

    .tl-ticks {
      grid-column: 2;
    }

    .tl-axis {
      row-gap: var(--s-2);
    }

    .tl-year {
      grid-column: 2;
    }

    .tl-mark {
      grid-row: 1 / span 3;
      align-self: start;
    }

    .tl-body,
    .tl-span {
      grid-column: 2;
    }

    .tl-span {
      margin-top: var(--s-3);
    }
  }
</style>

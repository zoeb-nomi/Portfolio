---
// The About record as a vertical timeline, newest first, current role on top. The dates sit on the left, a spine
// runs down the middle, and each entry reads: organisation (the headline), then role and detail, then a source
// link if one exists. As you read down, the spine fills red, each marker fills as you pass it, and the entries
// you have not reached yet are set in the muted ink. Everything is always on the page; reduced motion and no
// script show it fully lit and still. A row with no link shows none: it is a claim taken on trust, and the page
// does not imply otherwise.
interface Item {
  year: string;
  body: string;
  source: { label: string; href: string } | null;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

// "2019" is the year 2019; "2021–2022" runs to the end of 2022; "2025–present" has no end.
const bounds = (year: string): { start: number; end: number } => {
  const m = /^(\d{4})(?:\s*[–-]\s*(\d{4}|present))?$/.exec(year.trim());
  if (!m) throw new Error(`CareerTimeline: could not read the years in "${year}"`);
  const start = Number(m[1]);
  return { start, end: m[2] === 'present' ? Infinity : m[2] ? Number(m[2]) + 1 : start + 1 };
};

// "Product Manager, Instead · owning production LLM output quality" -> org "Instead", role "Product Manager",
// detail "owning production LLM output quality". The copy stays one string in copy.ts.
const parse = (body: string) => {
  const [head, ...rest] = body.split(' · ');
  const comma = head.indexOf(', ');
  return {
    org: comma === -1 ? head : head.slice(comma + 2),
    role: comma === -1 ? '' : head.slice(0, comma),
    detail: rest.join(' · '),
  };
};

// Newest first: whatever is still running, then by when it ended, then by when it began.
const rows = items
  .map((item) => ({ item, ...bounds(item.year), ...parse(item.body) }))
  .sort((a, b) => (b.end === a.end ? b.start - a.start : b.end - a.end));
---

<div class="tl" data-tl>
  <ol class="tl-list">
    {
      rows.map(({ item, org, role, detail }) => (
        <li class="tl-item">
          <p class="tl-when">{item.year}</p>
          <span class="tl-mark" aria-hidden="true"></span>
          <div class="tl-what">
            <h3 class="tl-org">{org}</h3>
            {(role || detail) && <p class="tl-role">{[role, detail].filter(Boolean).join(' · ')}</p>}
            {
              item.source && (
                <p class="tl-source">
                  <a href={item.source.href} target="_blank" rel="noopener noreferrer">{item.source.label}</a>
                </p>
              )
            }
          </div>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { motionAllowed } from '../scripts/figure-motion';

  if (motionAllowed()) {
    document.querySelectorAll<HTMLElement>('[data-tl]').forEach((root) => {
      const list = root.querySelector<HTMLElement>('.tl-list')!;
      const items = Array.from(list.querySelectorAll<HTMLElement>('.tl-item'));
      root.dataset.live = '';
      let queued = false;

      const update = () => {
        queued = false;
        const line = window.innerHeight * 0.6;
        const box = list.getBoundingClientRect();
        list.style.setProperty('--p', String(Math.min(1, Math.max(0, (line - box.top) / box.height))));
        let now: HTMLElement | null = null;
        items.forEach((li) => {
          const r = li.getBoundingClientRect();
          const reached = r.top + 24 < line;
          li.classList.toggle('is-reached', reached);
          if (reached) now = li;
        });
        items.forEach((li) => li.classList.toggle('is-now', li === now));
      };
      const queue = () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      };
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
      update();
    });
  }
</script>

<style>
  .tl {
    --tl-when: 9rem;
    --tl-mark: var(--s-5);
    margin-block: var(--s-9);
  }

  .tl-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    --p: 1;
  }

  /* The spine: a hairline for the whole record, and a red line that fills down it as you read. */
  .tl-list::before,
  .tl-list::after {
    content: '';
    position: absolute;
    inset-block: var(--s-3);
    inset-inline-start: calc(var(--tl-when) + var(--s-5) + var(--tl-mark) / 2);
    border-inline-start: 1px solid var(--rule);
  }

  .tl-list::after {
    border-inline-start: 2px solid var(--red);
    margin-inline-start: -1px;
    transform-origin: top;
    transform: scaleY(var(--p));
  }

  .tl-item {
    display: grid;
    grid-template-columns: var(--tl-when) var(--tl-mark) minmax(0, 1fr);
    column-gap: var(--s-5);
    align-items: start;
    padding-block: var(--s-6);
  }

  .tl-when {
    padding-top: var(--s-2);
    text-align: end;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--track-wide);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .tl-mark {
    position: relative;
    z-index: 1;
    inline-size: var(--s-3);
    block-size: var(--s-3);
    margin: var(--s-2) 0 0 calc((var(--tl-mark) - var(--s-3)) / 2);
    border: 1px solid var(--ink);
    background: var(--ink);
    transition: background var(--dur-base) ease;
  }

  .tl-org {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: var(--lh-title);
    letter-spacing: var(--track-tight);
    color: var(--ink);
    transition: color var(--dur-base) ease;
  }

  .tl-role {
    margin-top: var(--s-2);
    max-inline-size: var(--measure);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: var(--lh-snug);
    color: var(--ink-body);
    transition: color var(--dur-base) ease;
  }

  .tl-source {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-note);
    line-height: var(--lh-snug);
    overflow-wrap: anywhere;
  }

  .tl-source a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* While live: a marker is hollow until you reach it, red while it is the entry you are on, and the entries
     below the reading line are in the muted ink until you get to them. */
  .tl[data-live] .tl-mark {
    background: var(--paper);
  }

  .tl[data-live] .tl-item.is-reached .tl-mark {
    background: var(--ink);
  }

  .tl[data-live] .tl-item.is-now .tl-mark {
    border: 0;
    background: var(--red);
  }

  .tl[data-live] .tl-item:not(.is-reached) .tl-org,
  .tl[data-live] .tl-item:not(.is-reached) .tl-role {
    color: var(--ink-muted);
  }

  @media (max-width: 899px) {
    .tl {
      --tl-when: 0rem;
    }

    .tl-list::before,
    .tl-list::after {
      inset-inline-start: calc(var(--tl-mark) / 2);
    }

    .tl-item {
      grid-template-columns: var(--tl-mark) minmax(0, 1fr);
      column-gap: var(--s-4);
      padding-block: var(--s-5);
    }

    .tl-when {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0;
      text-align: start;
    }

    .tl-mark {
      grid-column: 1;
      grid-row: 1;
      margin-top: var(--s-1);
    }

    .tl-what {
      grid-column: 2;
      grid-row: 2;
      margin-top: var(--s-1);
    }
  }
</style>

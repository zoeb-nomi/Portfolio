---
import Headshot from './Headshot.astro';

interface Props {
  caption: string;
  alt: string;
  eager?: boolean;
  size?: 'small' | 'large'; // small = hero/margin (200-260px), large = a wider plate
}

const { caption, alt, eager = false, size = 'small' } = Astro.props;
---

<figure class:list={['rp-figure', `rp-figure--${size}`]}>
  <Headshot size="hero" {alt} loading={eager ? 'eager' : 'lazy'} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .rp-figure {
    width: 100%;
  }

  /* Break the plate out of the margin-column's text padding so it fills
     noticeably more of the column than the eyebrow/caption text does.
     Parent .margin-col padding is asymmetric on desktop/tablet
     (var(--gutter) left, var(--s-5) right) and symmetric on mobile
     (var(--gutter) both sides) — the two rule sets below mirror that. */
  .rp-figure--small {
    --figure-inset: var(--s-4);
  }

  .rp-figure--large {
    --figure-inset: var(--s-2);
  }

  .rp-figure--small,
  .rp-figure--large {
    margin-left: calc(var(--figure-inset) - var(--gutter));
    margin-right: calc(var(--figure-inset) - var(--s-5));
    width: calc(100% + var(--gutter) + var(--s-5) - 2 * var(--figure-inset));
  }

  @media (max-width: 899px) {
    .rp-figure--small,
    .rp-figure--large {
      margin-right: calc(var(--figure-inset) - var(--gutter));
      width: calc(100% + 2 * var(--gutter) - 2 * var(--figure-inset));
    }
  }

  .rp-figure figcaption {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-wide);
    color: var(--ink-muted);
  }

  /* Mobile: the plate becomes a thumbnail beside the parent's kicker. The <figure> dissolves into its parent's
     grid: picture -> column 2 / row 1, caption -> full-width row 2. The
     parent (.margin-col) must be a two-column grid on this breakpoint. */
  @media (max-width: 899px) {
    .rp-figure--small,
    .rp-figure--large {
      display: contents;
    }

    .rp-figure :global(.headshot) {
      grid-column: 2;
      grid-row: 1;
      width: var(--s-13);
      height: var(--s-13);
    }

    .rp-figure figcaption {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: var(--s-3);
    }
  }
</style>

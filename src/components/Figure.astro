---
interface Props {
  caption: string;
  alt: string;
  eager?: boolean;
  size?: 'small' | 'large'; // small = hero/margin (200-260px), large = a wider plate
}

const { caption, alt, eager = false, size = 'small' } = Astro.props;

const srcset = (ext: string) => `/img/headshot-480.${ext} 480w, /img/headshot-960.${ext} 960w`;
// The plate renders ~240 CSS px wide, so 480w covers 2x DPR.
const sizes = '240px';
---

<figure class:list={['rp-figure', `rp-figure--${size}`]}>
  <picture>
    <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
    <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
    <img
      src="/img/headshot-960.jpg"
      srcset={srcset('jpg')}
      sizes={sizes}
      width="960"
      height="960"
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
    />
  </picture>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .rp-figure {
    width: 100%;
  }

  /* Break the plate out of the margin-column's text padding so it fills
     noticeably more of the column than the eyebrow/caption text does.
     Parent .margin-col padding is asymmetric on desktop/tablet
     (var(--gutter) left, var(--s-5) right) and symmetric on mobile
     (var(--gutter) both sides) — the two rule sets below mirror that. */
  .rp-figure--small {
    --figure-inset: var(--s-4);
  }

  .rp-figure--large {
    --figure-inset: var(--s-2);
  }

  .rp-figure--small,
  .rp-figure--large {
    margin-left: calc(var(--figure-inset) - var(--gutter));
    margin-right: calc(var(--figure-inset) - var(--s-5));
    width: calc(100% + var(--gutter) + var(--s-5) - 2 * var(--figure-inset));
  }

  @media (max-width: 899px) {
    .rp-figure--small,
    .rp-figure--large {
      margin-right: calc(var(--figure-inset) - var(--gutter));
      width: calc(100% + 2 * var(--gutter) - 2 * var(--figure-inset));
    }
  }

  /* Unboxed: the plate is the photograph, not a framed exhibit. The only
     lines on the page are the grid's own. */
  .rp-figure picture {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .rp-figure img {
    display: block;
    width: 100%;
    /* The HTML width/height attributes (kept for CLS prevention before the
       image loads) otherwise win over `aspect-ratio` for a replaced element —
       height must be forced back to auto so aspect-ratio can take over. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center 12%;
  }

  .rp-figure figcaption {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-caption);
    letter-spacing: .04em;
    color: var(--ink-muted);
  }
</style>

---
// A margin note (kit `.margin-note`): a red hairline, mono text, beside the paragraph it annotates. Put it in the
// `aside` of an `.article` row (`<div class="article"><p class="prose">…</p><aside><MarginNote title="…">…</MarginNote></aside></div>`)
// and it sits in the rail at 1100px and up and under the paragraph below that. It never carries a fact that exists
// nowhere else. Renders as <aside> (a landmark) by default; inside another aside (Section's rail) pass as="div".
interface Props {
  label?: string;
  as?: 'aside' | 'div';
  /** A short mono heading above the note ("The run"). */
  title?: string;
}
const { label = 'Margin note', as: Tag = 'aside', title } = Astro.props;
const ariaProps = Tag === 'aside' ? { 'aria-label': label } : {};
---

<Tag class="margin-note" {...ariaProps}>
  {title && <b>{title}</b>}
  <slot />
</Tag>

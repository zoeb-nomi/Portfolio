---
// The case-study switcher: lets a reader on one eval case study jump to the other two without going back through
// the nav. A row of kit tags; the current one is red and carries aria-current.
import { evalsSwitcher, evalsSwitcherLabel } from '../data/copy';

interface Props {
  current: 'CrossSource' | 'mirror-eval' | 'screener-eval';
}

const { current } = Astro.props;
---

<nav class="evals-switch" aria-label={evalsSwitcherLabel}>
  <p class="lab">{evalsSwitcherLabel}</p>
  <ul class="tags">
    {
      evalsSwitcher.map((s) => (
        <li>
          {s.name === current ? (
            <span class="tag red" aria-current="page">{s.name}</span>
          ) : (
            <a class="tag" href={s.href}>{s.name}</a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .evals-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
  }

  .evals-switch ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .evals-switch a.tag {
    text-decoration: none;
    transition: border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }

  .evals-switch a.tag:hover,
  .evals-switch a.tag:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
</style>
